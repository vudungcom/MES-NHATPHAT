<Project Sdk="Microsoft.NET.Sdk">
  <!-- [T1 2026-10-31] Thử nhiều người cùng lưu trên SQL Server THẬT (DB MES_TEST) bằng code thật của MES.Web.
       Chạy: dotnet run -c Release (tham số tuỳ chọn: xem README.md) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlDongThoi</RootNamespace>
    <StartupObject>SqlDongThoi.Host</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="TuKiem/**" />   <!-- bản tự kiểm trên DB giả (Claude dùng trong sandbox), không biên dịch chung -->
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../MES.Web/MES.Web.csproj" />
  </ItemGroup>
</Project>
