@rendermode InteractiveServer

<div>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label small mb-1">
            @Label
            @if (IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    @if (Attributes != null && Attributes.Any())
    {
        <div class="position-relative">
            <input class="form-control form-control-sm @InputCssClass"
                   style="padding-right: 28px; @(AllowFreeText ? "" : "cursor: pointer; background-color: #fff;")"
                   value="@_value"
                   @oninput="OnInputChanged"
                   @onfocus="OpenDropdown"
                   @onclick="OpenDropdown"
                   @onblur="HideDropdown"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@(!AllowFreeText)" />
            
            <i class="bi bi-chevron-down position-absolute"
               style="right: 10px; top: 50%; transform: translateY(-50%); font-size: 12px; color: #6c757d; pointer-events: none;"></i>

            @if (_showDropdown && !Disabled)
            {
                <div class="position-absolute bg-white border rounded shadow-sm w-100"
                     style="z-index: 1050; max-height: 220px; overflow-y: auto; top: 100%; left: 0; margin-top: 2px;"
                     @onmousedown:preventDefault="true">

                    @foreach (var attr in FilteredAttributes)
                    {
                        <button type="button"
                                class="dropdown-item small py-2 text-start"
                                @onmousedown="() => SelectAttribute(attr.Value)">
                            @if (attr.IsDefault)
                            {
                                <span class="text-success fw-semibold">★ @attr.Value (Mặc định)</span>
                            }
                            else
                            {
                                <span>@attr.Value</span>
                            }
                        </button>
                    }

                    @if (AllowFreeText && !string.IsNullOrWhiteSpace(_value) &&
                         !Attributes.Any(a => string.Equals(a.Value, _value.Trim(), StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="border-top px-3 py-2 small text-muted bg-light">
                            <i class="bi bi-plus-circle text-primary me-1"></i>
                            Giá trị mới: <strong>@_value</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <input class="form-control form-control-sm @InputCssClass"
               value="@_value"
               @oninput="OnInputChanged"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@(!AllowFreeText)" />
    }

    @* ĐÃ SỬA: Dùng chung cờ ShowSetDefaultCheckbox để ẩn TOÀN BỘ khối cảnh báo (cả text lẫn checkbox) *@
    @if (ShowSetDefaultCheckbox && _isValueDifferentFromDefault && !string.IsNullOrEmpty(_value) && !Disabled)
    {
        <div class="mt-1">
            <div class="small text-warning">
                <i class="bi bi-exclamation-triangle"></i>
                @if (string.IsNullOrEmpty(_defaultValue))
                {
                    <span>Chưa có giá trị mặc định (★) cho mục này.</span>
                }
                else
                {
                    <span>Khác với mặc định (<code>@_defaultValue</code>)</span>
                }
            </div>

            <div class="form-check form-check-sm mt-1">
                <input class="form-check-input"
                       type="checkbox"
                       id="@_checkboxId"
                       checked="@IsSetAsDefault"
                       @onchange="OnSetDefaultToggled" />
                <label class="form-check-label small text-muted" for="@_checkboxId">
                    Đặt <code>@_value</code> làm giá trị mặc định (★) mới (cần nhập PIN xác nhận)
                </label>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowFreeText { get; set; } = true; 
    [Parameter] public bool ShowSetDefaultCheckbox { get; set; } = true;
    [Parameter] public List<PartMasterAttribute>? Attributes { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool IsSetAsDefault { get; set; }
    [Parameter] public EventCallback<bool> IsSetAsDefaultChanged { get; set; }

    private string? _value;
    private string? _defaultValue;
    private bool _isValueDifferentFromDefault;
    private bool _showDropdown;
    private bool _showAll; 

    private string _checkboxId = "cb-" + Guid.NewGuid().ToString("N").Substring(0, 8);

    // ĐÃ SỬA: Nếu tắt Checkbox (đang ở tab Kế Hoạch) thì cũng TẮT luôn viền vàng cảnh báo
    private string InputCssClass =>
        (_isValueDifferentFromDefault && !string.IsNullOrEmpty(_value) && ShowSetDefaultCheckbox)
            ? "border-warning"
            : (IsAutoFilledFromDefault ? "bg-success bg-opacity-10" : "");

    private bool IsAutoFilledFromDefault =>
        !string.IsNullOrEmpty(_value) &&
        !string.IsNullOrEmpty(_defaultValue) &&
        string.Equals(_value.Trim(), _defaultValue.Trim(), StringComparison.OrdinalIgnoreCase);

    private IEnumerable<PartMasterAttribute> FilteredAttributes
    {
        get
        {
            if (Attributes == null) return Enumerable.Empty<PartMasterAttribute>();

            var baseList = Attributes
                .Where(a => !string.IsNullOrEmpty(a.Value))
                .GroupBy(a => a.Value)
                .Select(g => g.OrderByDescending(a => a.IsDefault).First())
                .OrderByDescending(a => a.IsDefault)
                .ThenBy(a => a.Value);

            if (!AllowFreeText || _showAll || string.IsNullOrWhiteSpace(_value))
            {
                return baseList;
            }

            return baseList.Where(a => a.Value.Contains(_value.Trim(), StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override void OnParametersSet()
    {
        _defaultValue = Attributes?.FirstOrDefault(a => a.IsDefault)?.Value;

        if (_value != Value)
        {
            _value = Value;
        }
        
        RecalcDifference();
    }

    private void RecalcDifference()
    {
        if (string.IsNullOrEmpty(_value))
        {
            _isValueDifferentFromDefault = false;
            return;
        }

        _isValueDifferentFromDefault = !string.Equals(_value.Trim(), _defaultValue?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (!AllowFreeText) return; 

        _value = e.Value?.ToString();
        _showAll = false;
        _showDropdown = true;

        RecalcDifference();

        if (!_isValueDifferentFromDefault && IsSetAsDefault)
        {
            IsSetAsDefault = false;
            await IsSetAsDefaultChanged.InvokeAsync(false);
        }

        await ValueChanged.InvokeAsync(_value);
    }

    private void OpenDropdown()
    {
        if (Attributes != null && Attributes.Any())
        {
            _showDropdown = true;
            _showAll = true;
        }
    }

    private void HideDropdown()
    {
        _showDropdown = false;
    }

    private async Task SelectAttribute(string value)
    {
        _value = value;
        _showAll = false;
        
        RecalcDifference();

        if (!_isValueDifferentFromDefault && IsSetAsDefault)
        {
            IsSetAsDefault = false;
            await IsSetAsDefaultChanged.InvokeAsync(false);
        }

        await ValueChanged.InvokeAsync(_value);
        _showDropdown = false;
    }

    private async Task OnSetDefaultToggled(ChangeEventArgs e)
    {
        var newVal = e.Value is bool b && b;
        IsSetAsDefault = newVal;
        await IsSetAsDefaultChanged.InvokeAsync(newVal);
    }
}