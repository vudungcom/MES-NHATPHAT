@page "/hieu-suat-may"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject MachineEfficiencyService EffSvc

<PageTitle>Hiệu suất máy - MES</PageTitle>

<style>
    .timeline-bar { position:relative; height:22px; min-width:600px; border-radius:3px; overflow:hidden; background:#e9ecef; }
    .timeline-seg { position:absolute; height:100%; top:0; cursor:pointer; transition:opacity .15s; }
    .timeline-seg:hover { opacity:.80; }
    .seg-running      { background:#198754; }
    .seg-breakdown    { background:#dc3545; }
    .seg-maintenance  { background:#ffc107; }
    .seg-idle         { background:#ced4da; }
    .timeline-ruler   { position:relative; min-width:600px; height:16px; }
    .ruler-tick       { position:absolute; transform:translateX(-50%); font-size:.68rem; color:#6c757d; white-space:nowrap; }
    .machine-row-detail { background:#f8f9fa; border-left:3px solid #0d6efd; }
    .legend-dot       { width:11px; height:11px; border-radius:50%; display:inline-block; }
    .shift-btn        { font-size:.78rem; }
    .tbl-machine th, .tbl-machine td { vertical-align:middle; padding:4px 8px; font-size:.82rem; }
    @@keyframes spin { to { transform:rotate(360deg); } }
    .spin { display:inline-block; animation:spin 1s linear infinite; }
</style>

@* ── Header + Pie tổng ── *@
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Hiệu suất máy</h1>
        <p class="text-muted small mb-0">
            <span class="legend-dot bg-success me-1"></span>Chạy &nbsp;
            <span class="legend-dot bg-danger me-1"></span>Hỏng &nbsp;
            <span class="legend-dot" style="background:#ffc107;"></span>&nbsp;Bảo trì &nbsp;
            <span class="legend-dot bg-secondary me-1"></span>Rảnh
        </p>
    </div>
    @if (_result != null)
    {
        <div class="card shadow-sm" style="min-width:200px;">
            <div class="card-body p-2 text-center">
                <div class="small fw-semibold text-muted mb-1">Tổng hiệu suất — @_result.Rows.Count máy</div>
                @BuildPieSvg(_result.RunPct, _result.DownPct, 0, _result.IdlePct, 90)
                <div class="d-flex justify-content-center gap-2 mt-1 flex-wrap" style="font-size:.7rem;">
                    <span><span class="legend-dot bg-success me-1"></span>Chạy @_result.RunPct%</span>
                    <span><span class="legend-dot bg-danger me-1"></span>Hỏng @_result.DownPct%</span>
                    <span><span class="legend-dot bg-secondary me-1"></span>Rảnh @_result.IdlePct%</span>
                </div>
            </div>
        </div>
    }
</div>

@* ── Filter bar ── *@
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">Ngày</label>
                <input type="date" class="form-control form-control-sm" style="width:150px;"
                       @bind="_selectedDate" @bind:after="OnDateChanged" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">Ca làm việc</label>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm shift-btn @(_shiftCls0)" @onclick="SetShiftHC">Ca HC (7–17h)</button>
                    <button class="btn btn-sm shift-btn @(_shiftCls1)" @onclick="SetShift1">Ca 1 (6–18h)</button>
                    <button class="btn btn-sm shift-btn @(_shiftCls2)" @onclick="SetShiftEvening">Ca chiều (12–20h)</button>
                    <button class="btn btn-sm shift-btn @(_shiftCls3)" @onclick="SetShiftFull">Toàn ngày</button>
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">Nhóm máy</label>
                <select class="form-select form-select-sm" style="width:140px;" @bind="_filterGroup">
                    <option value="">Tất cả</option>
                    @foreach (var g in _groups)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            @if (_loading)
            {
                <div class="col-auto">
                    <span class="text-muted small"><i class="bi bi-arrow-repeat spin me-1"></i>Đang tải...</span>
                </div>
            }
        </div>
    </div>
</div>

@* ── Bảng Gantt ── *@
@if (_result != null)
{
    var visibleRows = string.IsNullOrEmpty(_filterGroup)
        ? _result.Rows
        : _result.Rows.Where(r => r.Machine.BoPhan == _filterGroup).ToList();

    var totalMinutes = (int)(_toTime - _fromTime).TotalMinutes;
    if (totalMinutes <= 0) { totalMinutes = 1; }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0 tbl-machine">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;">Số máy</th>
                            <th style="width:65px;">Nhóm</th>
                            <th style="width:68px; text-align:right;" class="text-success">Chạy(ph)</th>
                            <th style="width:68px; text-align:right;" class="text-danger">Dừng(ph)</th>
                            <th style="width:68px; text-align:right;" class="text-secondary">Rảnh(ph)</th>
                            <th>
                                <div class="timeline-ruler">
                                    @for (int h = _fromTime.Hour; h <= _toTime.Hour; h++)
                                    {
                                        var spanH = _toTime.Hour - _fromTime.Hour;
                                        if (spanH <= 0) { spanH = 1; }
                                        var pct = (double)(h - _fromTime.Hour) / spanH * 100.0;
                                        <span class="ruler-tick" style="left:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;">@h<sup>h</sup></span>
                                    }
                                </div>
                                <span class="small text-muted fw-normal">Timeline @_fromTime.ToString("HH:mm")–@_toTime.ToString("HH:mm")</span>
                            </th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in visibleRows)
                        {
                            var isExpanded = _expandedMachines.Contains(row.Machine.ThietBiId);
                            <tr @key="row.Machine.ThietBiId">
                                <td class="fw-semibold">@row.Machine.SoMay</td>
                                <td><span class="badge bg-secondary">@row.Machine.BoPhan</span></td>
                                <td style="text-align:right;" class="text-success fw-semibold">@((int)row.RunMinutes)</td>
                                <td style="text-align:right;" class="text-danger fw-semibold">@((int)row.DownMinutes)</td>
                                <td style="text-align:right;" class="text-secondary">@((int)row.IdleMinutes)</td>
                                <td>
                                    <div class="timeline-bar">
                                        @foreach (var seg in row.Segments)
                                        {
                                            var fromDt = _selectedDate.ToDateTime(_fromTime);
                                            var leftPct  = (seg.Start - fromDt).TotalMinutes / totalMinutes * 100.0;
                                            var widthPct = seg.Minutes / totalMinutes * 100.0;
                                            if (widthPct < 0.1) { continue; }
                                            if (leftPct  < 0)   { leftPct = 0; }
                                            var cssClass = seg.Type switch
                                            {
                                                SegmentType.Running     => "seg-running",
                                                SegmentType.Breakdown   => "seg-breakdown",
                                                SegmentType.Maintenance => "seg-maintenance",
                                                _                       => "seg-idle",
                                            };
                                            var tooltip = seg.Type switch
                                            {
                                                SegmentType.Running     => $"{seg.Start:HH:mm}–{seg.End:HH:mm} | {seg.WorkerName} | NC:{seg.NC} | PO:{seg.PurchaseOrder}",
                                                SegmentType.Breakdown   => $"Hỏng {seg.Start:HH:mm}–{seg.End:HH:mm}{(seg.IsOpen?" (đang hỏng)":"")} | {seg.Reason}",
                                                SegmentType.Maintenance => $"Bảo trì {seg.Start:HH:mm}–{seg.End:HH:mm}{(seg.IsOpen?" (đang bảo trì)":"")} | {seg.Reason}",
                                                _                       => $"Rảnh {seg.Start:HH:mm}–{seg.End:HH:mm}",
                                            };
                                            <div class="timeline-seg @cssClass"
                                                 style="left:@leftPct.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)%;width:@widthPct.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)%;"
                                                 title="@tooltip">
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="text-center" @onclick:stopPropagation="true">
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleExpand(row.Machine.ThietBiId)" title="Chi tiết">
                                        <i class="bi @(isExpanded ? "bi-chevron-up text-primary" : "bi-chevron-down")"></i>
                                    </button>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr @key="@($"det_{row.Machine.ThietBiId}")" class="machine-row-detail">
                                    <td colspan="8" class="p-3">
                                        <div class="row g-3">
                                            @* WTS log table *@
                                            <div class="col-md-7">
                                                <div class="small fw-semibold text-muted mb-1">
                                                    <i class="bi bi-clock-history me-1"></i>WTS — @row.Machine.SoMay @row.Machine.TenMay
                                                </div>
                                                @if (!row.WtsDetails.Any())
                                                {
                                                    <div class="text-muted small fst-italic">Không có log WTS trong khung giờ này.</div>
                                                }
                                                else
                                                {
                                                    <table class="table table-sm table-bordered mb-0" style="font-size:.78rem;">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Công nhân</th>
                                                                <th>Bắt đầu</th>
                                                                <th>Kết thúc</th>
                                                                <th class="text-end">Phút</th>
                                                                <th>NC</th>
                                                                <th>PO / PartNo</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var log in row.WtsDetails.OrderBy(x => x.StartTime))
                                                            {
                                                                <tr @key="log.WtsLogId">
                                                                    <td>@(log.Worker?.FullName ?? "?")</td>
                                                                    <td>@log.StartTime.ToString("HH:mm")</td>
                                                                    <td>@log.EndTime.ToString("HH:mm")</td>
                                                                    <td class="text-end">@((int)(log.EndTime - log.StartTime).TotalMinutes)</td>
                                                                    <td>@(log.NC ?? "—")</td>
                                                                    <td class="text-muted">
                                                                        @(log.KhPlanDetail?.PurchaseOrder ?? "")
                                                                        @if (!string.IsNullOrEmpty(log.KhPlanDetail?.PartNo))
                                                                        {
                                                                            <span class="ms-1 badge bg-light text-dark border">@log.KhPlanDetail.PartNo</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            </div>
                                            @* Pie mini + thông tin máy *@
                                            <div class="col-md-2 text-center">
                                                <div class="small fw-semibold text-muted mb-1">
                                                    <i class="bi bi-pie-chart me-1"></i>Hiệu suất
                                                </div>
                                                @BuildPieSvg(row.RunPct, row.DownPct, 0, row.IdlePct, 70)
                                                <div class="mt-1" style="font-size:.72rem;">
                                                    <div><span class="legend-dot bg-success me-1"></span>Chạy: <b>@row.RunPct%</b></div>
                                                    <div><span class="legend-dot bg-danger me-1"></span>Hỏng: <b>@row.DownPct%</b></div>
                                                    <div><span class="legend-dot bg-secondary me-1"></span>Rảnh: <b>@row.IdlePct%</b></div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="small fw-semibold text-muted mb-1">
                                                    <i class="bi bi-cpu me-1"></i>Thông tin máy
                                                </div>
                                                <div style="font-size:.78rem;">
                                                    <div><span class="text-muted">Số máy:</span> <b>@row.Machine.SoMay</b></div>
                                                    @if (!string.IsNullOrEmpty(row.Machine.TenMay))  { <div><span class="text-muted">Tên:</span> @row.Machine.TenMay</div> }
                                                    @if (!string.IsNullOrEmpty(row.Machine.LoaiMay)) { <div><span class="text-muted">Loại:</span> @row.Machine.LoaiMay</div> }
                                                    <div class="mt-1">
                                                        @if (row.Machine.TrangThai == "Hoạt động")
                                                        {
                                                            <span class="badge bg-success">Hoạt động</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">@row.Machine.TrangThai</span>
                                                            @if (row.Machine.ThoiGianDungTu.HasValue)
                                                            {
                                                                <div class="text-muted" style="font-size:.7rem;">Từ @row.Machine.ThoiGianDungTu.Value.ToString("HH:mm dd/MM")</div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (!_loading)
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-1"></i>Chọn ngày để xem hiệu suất máy.</div>
}

@code {
    // ── State ──────────────────────────────────────────────────────────────
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly _fromTime     = new(7, 0);
    private TimeOnly _toTime       = new(17, 0);
    private int      _activeShift  = 0;
    private string   _filterGroup  = "";
    private bool     _loading      = false;

    private MachineEfficiencyResult? _result;
    private HashSet<int> _expandedMachines = new();
    private List<string> _groups = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    // ── Ca làm việc ────────────────────────────────────────────────────────
    private async Task SetShiftHC()      { _activeShift=0; _fromTime=new(7,0);  _toTime=new(17,0); await LoadDataAsync(); }
    private async Task SetShift1()       { _activeShift=1; _fromTime=new(6,0);  _toTime=new(18,0); await LoadDataAsync(); }
    private async Task SetShiftEvening() { _activeShift=2; _fromTime=new(12,0); _toTime=new(20,0); await LoadDataAsync(); }
    private async Task SetShiftFull()    { _activeShift=3; _fromTime=new(0,0);  _toTime=new(23,59); await LoadDataAsync(); }
    private async Task OnDateChanged()   { await LoadDataAsync(); }

    // ── Load ───────────────────────────────────────────────────────────────
    private async Task LoadDataAsync()
    {
        _loading = true;
        _expandedMachines.Clear();
        StateHasChanged();
        try
        {
            _result = await EffSvc.GetAsync(_selectedDate, _fromTime, _toTime);
            _groups = _result.Rows
                .Select(r => r.Machine.BoPhan)
                .Where(b => !string.IsNullOrWhiteSpace(b))
                .Distinct().OrderBy(b => b).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Shift class helpers (avoid nested quotes in markup) ──────────────
    private string _shiftCls0 => _activeShift == 0 ? "btn-primary" : "btn-outline-secondary";
    private string _shiftCls1 => _activeShift == 1 ? "btn-primary" : "btn-outline-secondary";
    private string _shiftCls2 => _activeShift == 2 ? "btn-primary" : "btn-outline-secondary";
    private string _shiftCls3 => _activeShift == 3 ? "btn-primary" : "btn-outline-secondary";

    // ── Expand ─────────────────────────────────────────────────────────────
    private void ToggleExpand(int id)
    {
        if (!_expandedMachines.Remove(id)) _expandedMachines.Add(id);
    }

    // ── Pie chart SVG (pure C# render, không lambda trong markup) ──────────
    private RenderFragment BuildPieSvg(double runPct, double downPct, double maintPct, double idlePct, int size)
    {
        return builder =>
        {
            int seq = 0;
            double cx = size / 2.0, cy = size / 2.0, r = size / 2.0 - 4;

            // Mảng: [runPct, downPct, maintPct, idlePct]
            var slices = new[] {
                (pct: runPct,   color: "#198754"),
                (pct: downPct,  color: "#dc3545"),
                (pct: maintPct, color: "#ffc107"),
                (pct: idlePct,  color: "#ced4da"),
            };

            builder.OpenElement(seq++, "svg");
            builder.AddAttribute(seq++, "width",   size);
            builder.AddAttribute(seq++, "height",  size);
            builder.AddAttribute(seq++, "viewBox", $"0 0 {size} {size}");

            double startAngle = -90.0; // bắt đầu từ 12h

            // Nếu tất cả = 0 → vẽ circle xám
            bool allZero = slices.All(s => s.pct <= 0);
            if (allZero)
            {
                builder.OpenElement(seq++, "circle");
                builder.AddAttribute(seq++, "cx", cx.ToString(System.Globalization.CultureInfo.InvariantCulture));
                builder.AddAttribute(seq++, "cy", cy.ToString(System.Globalization.CultureInfo.InvariantCulture));
                builder.AddAttribute(seq++, "r",  r.ToString(System.Globalization.CultureInfo.InvariantCulture));
                builder.AddAttribute(seq++, "fill", "#ced4da");
                builder.CloseElement();
            }
            else
            {
                foreach (var slice in slices)
                {
                    if (slice.pct <= 0) continue;

                    double angle = slice.pct / 100.0 * 360.0;
                    double endAngle = startAngle + angle;

                    double x1 = cx + r * Math.Cos(startAngle * Math.PI / 180.0);
                    double y1 = cy + r * Math.Sin(startAngle * Math.PI / 180.0);
                    double x2 = cx + r * Math.Cos(endAngle   * Math.PI / 180.0);
                    double y2 = cy + r * Math.Sin(endAngle   * Math.PI / 180.0);
                    int largeArc = angle > 180 ? 1 : 0;

                    string d = $"M {cx.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} {cy.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} " +
                               $"L {x1.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} {y1.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} " +
                               $"A {r.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} {r.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} 0 {largeArc} 1 " +
                               $"{x2.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} {y2.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)} Z";

                    builder.OpenElement(seq++, "path");
                    builder.AddAttribute(seq++, "d",    d);
                    builder.AddAttribute(seq++, "fill", slice.color);
                    builder.CloseElement();

                    startAngle = endAngle;
                }
            }

            // Vòng viền
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx",           cx.ToString(System.Globalization.CultureInfo.InvariantCulture));
            builder.AddAttribute(seq++, "cy",           cy.ToString(System.Globalization.CultureInfo.InvariantCulture));
            builder.AddAttribute(seq++, "r",            r.ToString(System.Globalization.CultureInfo.InvariantCulture));
            builder.AddAttribute(seq++, "fill",         "none");
            builder.AddAttribute(seq++, "stroke",       "#fff");
            builder.AddAttribute(seq++, "stroke-width", "1.5");
            builder.CloseElement();

            builder.CloseElement(); // </svg>
        };
    }
}
