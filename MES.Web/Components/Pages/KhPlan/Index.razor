@page "/kh-plan"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Components.Shared
@inject KhPlanService KhSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Kế Hoạch - MES</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Kế Hoạch KH</h1>
        <p class="text-muted small mb-0">Mỗi dòng = 1 PO. <strong>Double-click</strong> để xem chi tiết. Bấm nút Sửa / Tách để thao tác.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/kh-plan/bulk-update-std" class="btn btn-outline-warning">
            <i class="bi bi-file-earmark-excel"></i> Sửa STD hàng loạt (Excel)
        </a>
        <a href="/kh-plan/create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Tạo phiếu KH mới
        </a>
    </div>
</div>

<div class="row mb-3 g-2">
    <div class="col-md-5">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Tìm theo PO / Old PO / Part No / Khách / Số phiếu..."
                   @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button class="btn btn-outline-secondary" @onclick="() => _search = string.Empty">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="_statusFilter">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="WaitingSupplierOrder">Chờ đặt Order VL</option>
            <option value="Ordered">Đã đặt Order VL</option>
            <option value="PartialReceived">Nhập 1 phần</option>
            <option value="FullyReceived">Nhập đủ</option>
            <option value="InProduction">Đang SX</option>
            <option value="Completed">Hoàn thành</option>
            <option value="Cancelled">Hủy</option>
        </select>
    </div>
    <div class="col-md-4 text-end">
        <small class="text-muted">
            Hiển thị @Filtered.Count / @(_rows?.Count ?? 0) dòng
        </small>
    </div>
</div>

@if (_rows == null)
{
    <p><em>Đang tải...</em></p>
}
else if (_rows.Count == 0)
{
    <div class="alert alert-secondary">
        <i class="bi bi-inbox"></i> Chưa có phiếu KH nào. Bấm "Tạo phiếu KH mới" để bắt đầu.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover table-bordered align-middle small" style="font-size: 0.8rem;">
            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                <tr>
                    <th>Số phiếu</th>
                    <th>Ngày lập</th>
                    <th>Ngày nhận</th>
                    <th>Khách hàng</th>
                    <th><strong>PO</strong></th>
                    <th>Old PO</th>
                    <th><strong>Part No</strong></th>
                    <th class="text-end">SL</th>
                    <th>STD</th>
                    <th>Loại</th>
                    <th>Ưu tiên</th>
                    <th>Material</th>
                    <th>Cấu hình phôi</th>
                    <th>Ghi chú Hàng</th>
                    <th>Order VL</th>
                    <th>Vị trí</th>
                    <th>Trạng thái</th>
                    <th style="width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Filtered)
                {
                    <tr @ondblclick="() => OpenView(r)" style="cursor: pointer;" title="Double-click để xem chi tiết">
                        <td><a href="@($"/kh-plan/{r.KhPlanId}")" @onclick:stopPropagation><code>@r.PlanNo</code></a></td>
                        <td class="text-nowrap">@r.PlanDate.ToString("dd/MM/yy")</td>
                        <td class="text-nowrap">
                            @if (r.ReceivedDate.HasValue)
                            {
                                @r.ReceivedDate.Value.ToString("dd/MM/yy")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-truncate" style="max-width: 180px;" title="@r.CustomerName">@r.CustomerName</td>
                        <td><code>@r.PurchaseOrder</code></td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.OldPurchaseOrder))
                            {
                                <code class="text-muted" title="Tách từ PO này">@r.OldPurchaseOrder</code>
                            }
                        </td>
                        <td><code>@r.PartNo</code></td>
                        <td class="text-end text-nowrap">@r.Quantity.ToString("N0") @r.Unit</td>
                        <td class="text-nowrap">
                            @r.STD.ToString("dd/MM/yy")
                            @if (r.STD < DateTime.Today)
                            {
                                <i class="bi bi-exclamation-triangle text-danger ms-1" title="Quá hạn"></i>
                            }
                            else if (r.STD < DateTime.Today.AddDays(7))
                            {
                                <i class="bi bi-clock text-warning ms-1" title="Sắp hạn"></i>
                            }
                        </td>
                        <td>@r.Type</td>
                        <td>@r.Priority</td>
                        <td class="font-monospace text-truncate" style="max-width: 120px;" title="@r.Material">@r.Material</td>
                        <td class="font-monospace text-truncate" style="max-width: 100px;" title="@r.MaterialConfig">@r.MaterialConfig</td>
                        <td class="text-truncate" style="max-width: 140px;" title="@r.PartNotes">@r.PartNotes</td>
                        <td class="font-monospace">@r.OrderVL</td>
                        <td>@r.Location</td>
                        <td><span class="badge bg-@GetStatusColor(r.Status)">@r.Status</span></td>
                        <td @onclick:stopPropagation class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary py-0 px-1" href="@($"/kh-plan/{r.KhPlanId}/edit")" title="Sửa phiếu">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-warning py-0 px-1" @onclick="() => OpenSplit(r)" title="Tách PO">
                                <i class="bi bi-diagram-3"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => OpenHistory(r)" title="Lịch sử sửa">
                                <i class="bi bi-clock-history"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ==== Modal Tách PO ==== *@
<SplitPOModal
    IsOpen="_showSplitModal"
    Source="_splitSource"
    OnSplitDone="OnSplitDoneAsync"
    OnCancelled="CloseSplit" />

@* ==== Modal xem lịch sử ==== *@
@if (_history != null)
{
    @* Backdrop: KHÔNG có @onclick — click ra ngoài không đóng modal.
       Chỉ có nút X ở header và nút "Đóng" ở footer mới đóng modal. *@
    <div class="mes-modal-backdrop">
        <div class="mes-modal mes-modal-lg" @onclick:stopPropagation>
            <div class="mes-modal-header">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i> Lịch sử sửa —
                    <code>@_historyRow?.PurchaseOrder</code> / <code>@_historyRow?.PartNo</code>
                </h5>
                <button class="btn-close" @onclick="CloseHistory"></button>
            </div>
            <div class="mes-modal-body">
                @if (_history.Count == 0)
                {
                    <div class="alert alert-secondary py-2 small mb-0">
                        <i class="bi bi-info-circle"></i> Chưa có lịch sử sửa cho dòng này.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-bordered small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Field</th>
                                <th>Giá trị cũ</th>
                                <th>Giá trị mới</th>
                                <th>Nguồn</th>
                                <th>Người sửa</th>
                                <th>Lý do</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _history)
                            {
                                <tr>
                                    <td class="text-nowrap">@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><code>@h.FieldName</code></td>
                                    <td class="text-danger"><del>@h.OldValue</del></td>
                                    <td class="text-success"><strong>@h.NewValue</strong></td>
                                    <td>
                                        @if (h.ChangeSource == "ExcelImport")
                                        {
                                            <span class="badge bg-warning text-dark">Excel #@h.ImportBatchId</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@h.ChangeSource</span>
                                        }
                                    </td>
                                    <td>@h.ChangedByUser?.FullName</td>
                                    <td><em>@h.Reason</em></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="mes-modal-footer">
                <button class="btn btn-sm btn-secondary ms-auto" @onclick="CloseHistory">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    private List<KhPlanDetailRow>? _rows;
    private string _search = "";
    private string _statusFilter = "";

    // Split modal
    private bool _showSplitModal;
    private KhPlanDetailRow? _splitSource;

    // History modal
    private List<KhPlanDetailChangeLog>? _history;
    private KhPlanDetailRow? _historyRow;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        _rows = await KhSvc.GetDetailRowsAsync();
    }

    private List<KhPlanDetailRow> Filtered
    {
        get
        {
            if (_rows == null) return new();
            var q = _rows.AsEnumerable();

            if (!string.IsNullOrEmpty(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                q = q.Where(r =>
                    r.PurchaseOrder.ToLowerInvariant().Contains(s) ||
                    (r.OldPurchaseOrder ?? "").ToLowerInvariant().Contains(s) ||
                    r.PartNo.ToLowerInvariant().Contains(s) ||
                    r.CustomerName.ToLowerInvariant().Contains(s) ||
                    r.PlanNo.ToLowerInvariant().Contains(s) ||
                    (r.OrderVL ?? "").ToLowerInvariant().Contains(s));
            }
            if (!string.IsNullOrEmpty(_statusFilter))
            {
                q = q.Where(r => r.Status == _statusFilter);
            }
            return q.ToList();
        }
    }

    private void OpenView(KhPlanDetailRow row)
    {
        Nav.NavigateTo($"/kh-plan/{row.KhPlanId}");
    }

    private void OpenSplit(KhPlanDetailRow row)
    {
        _splitSource = row;
        _showSplitModal = true;
    }

    private void CloseSplit()
    {
        _showSplitModal = false;
        _splitSource = null;
    }

    private async Task OnSplitDoneAsync()
    {
        _showSplitModal = false;
        _splitSource = null;
        await Reload();
    }

    private async Task OpenHistory(KhPlanDetailRow row)
    {
        _historyRow = row;
        _history = await KhSvc.GetChangeHistoryAsync(row.KhPlanDetailId);
    }

    private void CloseHistory()
    {
        _history = null;
        _historyRow = null;
    }

    private string GetStatusColor(string status) => status switch
    {
        "WaitingSupplierOrder" => "info",
        "Ordered" => "primary",
        "PartialReceived" => "primary",
        "FullyReceived" => "success",
        "InProduction" => "success",
        "Completed" => "success",
        "Cancelled" => "secondary",
        _ => "secondary"
    };
}
