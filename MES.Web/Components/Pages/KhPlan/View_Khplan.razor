@page "/kh-plan/{Id:int}/detail/{DetailId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using MES.Web.Services
@using MES.Web.Components.Shared
@inject KhPlanService KhSvc
@inject HandoverLedgerService LedgerSvc
@inject KhoVatLieuService KhoSvc
@inject NavigationManager Nav

<PageTitle>Xem phiếu KH - MES</PageTitle>

@if (_plan == null || _detail == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">Phiếu KH <code>@_plan.PlanNo</code></h1>
            <p class="text-muted mb-0 small">
                <i class="bi bi-calendar"></i> Ngày lập: @_plan.PlanDate.ToString("dd/MM/yyyy") ·
                @if (_plan.ReceivedDate.HasValue)
                {
                    <span><i class="bi bi-inbox"></i> Ngày nhận: @_plan.ReceivedDate.Value.ToString("dd/MM/yyyy") ·</span>
                }
                <i class="bi bi-building"></i> @_plan.Customer?.CustomerName ·
                <span class="badge @LedgerStatusBadge">@LedgerStatusText</span> ·   @* [GN-WHERE] trạng thái theo sổ Giao nhận (trước: Status nhập tay, không bao giờ đổi) *@
                @* [WORKFLOW] Badge hiển thị trạng thái áp dụng workflow *@
                @if (_plan.ApplyWorkflow)
                {
                    <span class="badge bg-success bg-opacity-75 me-1"><i class="bi bi-diagram-3 me-1"></i>Workflow ON</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark me-1"><i class="bi bi-unlock me-1"></i>Workflow OFF</span>
                }
                <span class="text-muted">Tạo bởi @_plan.CreatedByUser?.FullName lúc @_plan.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/kh-plan" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Danh sách
            </a>
            <a href="@($"/kh-plan/{_plan.KhPlanId}/detail/{_detail.KhPlanDetailId}/edit")" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Sửa phiếu
            </a>
        </div>
    </div>

    <div class="alert alert-secondary py-2 small">
        <i class="bi bi-eye"></i> Chế độ <strong>chỉ xem</strong>.
        Bấm "Sửa phiếu" để chỉnh sửa (bắt buộc nhập lý do).
        @if (!string.IsNullOrEmpty(_detail.OldPurchaseOrder))
        {
            <span>· Dòng này được <strong>tách từ PO cũ</strong> <code>@_detail.OldPurchaseOrder</code>.</span>
        }
    </div>

    @* ── Thông tin phiếu ── *@
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="text-secondary"><i class="bi bi-file-earmark-text"></i> Thông tin phiếu</h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label small text-muted">Số phiếu</label>
                    <input class="form-control form-control-sm font-monospace bg-light" value="@_plan.PlanNo" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Ngày lập PO khách</label>
                    <input class="form-control form-control-sm bg-light" value="@_plan.PlanDate.ToString("dd/MM/yyyy")" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Ngày nhận PO</label>
                    <input class="form-control form-control-sm bg-light"
                           value="@(_plan.ReceivedDate?.ToString("dd/MM/yyyy") ?? "(chưa điền)")" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Khách hàng</label>
                    <input class="form-control form-control-sm bg-light" value="@_plan.Customer?.CustomerName" readonly />
                </div>
                @if (!string.IsNullOrEmpty(_plan.Notes))
                {
                    <div class="col-12">
                        <label class="form-label small text-muted">Ghi chú chung</label>
                        <input class="form-control form-control-sm bg-light" value="@_plan.Notes" readonly />
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Chi tiết Part ── *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                <div>
                    <strong>Chi tiết Part</strong>
                    <span class="badge @LedgerStatusBadge ms-2">@LedgerStatusText</span>
                    @if (!string.IsNullOrEmpty(_detail.OldPurchaseOrder))
                    {
                        <span class="badge bg-info ms-1" title="Tách từ PO cũ">
                            <i class="bi bi-diagram-3"></i> Old PO: <code>@_detail.OldPurchaseOrder</code>
                        </span>
                    }
                </div>
            </div>

            <p class="small text-secondary fw-500 mb-2">A. Thông tin Part từ PO khách</p>
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label small text-muted">PO</label>
                    <input class="form-control form-control-sm font-monospace bg-light" value="@_detail.PurchaseOrder" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Part No</label>
                    <input class="form-control form-control-sm font-monospace bg-light" value="@_detail.PartNo" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">SL</label>
                    <input class="form-control form-control-sm text-end bg-light" value="@_detail.Quantity.ToString("0.####")" readonly />
                </div>
                <div class="col-md-1">
                    <label class="form-label small text-muted">Đvị</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.Unit" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">STD (deadline)</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.STD.ToString("dd/MM/yyyy")" readonly />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Loại hàng</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.Type" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Ưu tiên</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.Priority" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Ghi chú Hàng</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.PartNotes" readonly />
                </div>
            </div>

            <p class="small text-secondary fw-500 mb-2 mt-3">B. Thông tin kỹ thuật</p>
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Mã vật liệu</label>
                    <input class="form-control form-control-sm font-monospace bg-light" value="@_detail.Material" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Cấu hình phôi</label>
                    <input class="form-control form-control-sm font-monospace bg-light" value="@_detail.MaterialConfig" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Ghi chú Phôi</label>
                    <input class="form-control form-control-sm bg-light" value="@_detail.MaterialNotes" readonly />
                </div>
                <div class="col-md-12">
                    <label class="form-label small text-muted">Ghi chú mạ</label>
                    <textarea class="form-control form-control-sm bg-light" rows="2"
                              readonly
                              placeholder="— Chưa có —">@(_detail.GhiChuMa ?? "")</textarea>
                </div>
            </div>

            <p class="small text-secondary fw-500 mb-2 mt-3">
                C. Thông tin nội bộ
                <span class="text-muted fw-normal ms-2" style="font-size:0.78rem;">
                    <i class="bi bi-box-seam me-1"></i>Lấy từ module Quản lý Kho — chỉ xem.
                    @if (_khoItem == null)
                    {
                        <a href="/kho" class="text-warning ms-1"><i class="bi bi-exclamation-triangle"></i> Chưa có dữ liệu kho — vào Quản lý Kho để nhập</a>
                    }
                </span>
            </p>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Order VL <small class="text-muted">(Cột K - Kho)</small></label>
                    <input class="form-control form-control-sm font-monospace bg-light"
                           value="@(_khoItem?.OrderVatLieu ?? "—")" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Vị trí kho <small class="text-muted">(Cột L - Kho)</small></label>
                    <input class="form-control form-control-sm font-monospace bg-light"
                           value="@(_khoItem?.ViTriDePhoi ?? "—")" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Tình trạng phôi <small class="text-muted">(Cột M - Kho)</small></label>
                    <input class="form-control form-control-sm bg-light"
                           value="@(_khoItem?.TinhTrangPhoi ?? "—")" readonly />
                </div>
            </div>
        </div>
    </div>

    @* ── [GN-WHERE 2026-10-27] PO đang ở đâu + đường đi (sổ Giao nhận) ── *@
    @if (_ledgerRow != null)
    {
        <div class="card mb-3 border-primary">
            <div class="card-header py-2 bg-primary bg-opacity-10">
                <i class="bi bi-geo-alt me-1"></i> <strong>PO đang ở đâu</strong>
                <span class="text-muted small ms-2">số lượng hiện tại theo sổ Giao nhận — tổng mọi ô = phôi nhận</span>
            </div>
            <div class="card-body py-2">
                <PoViTri Row="_ledgerRow" Steps="_ledgerSteps" />
            </div>
        </div>
    }

    @* ── Quy trình sản xuất (Snapshot tại thời điểm tạo phiếu) ── *@
    @if (_snapshot != null)
    {
        <div class="card mb-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span class="fw-semibold">
                    <i class="bi bi-diagram-3 me-1"></i> Quy trình sản xuất
                    <span class="badge bg-secondary ms-1" title="Snapshot tại thời điểm tạo phiếu">Snapshot</span>
                </span>
                @if (_snapshot.HasAny)
                {
                    <small class="text-muted">
                        Được copy từ Part Master lúc tạo phiếu — không tự thay đổi theo Part Master.
                    </small>
                }
            </div>
            <div class="card-body p-2">
                @if (!_snapshot.HasAny)
                {
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        Chưa có snapshot quy trình. Part này chưa có quy trình trong Part Master tại thời điểm tạo phiếu,
                        hoặc phiếu được tạo trước khi tính năng này có mặt.
                    </div>
                }
                else
                {
                    @* B. Machining *@
                    @if (_snapshot.Machining.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold small py-1 px-2 rounded mb-1" style="background:#1a73e8;color:white;">
                                <i class="bi bi-gear-wide-connected me-1"></i> B. Quy trình gia công (@_snapshot.Machining.Count bước)
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">
                                    <thead class="table-light">
                                        @* Hàng 1: nhóm cột *@
                                        <tr>
                                            <th rowspan="2" style="width:30px;" class="text-center align-middle">#</th>
                                            <th rowspan="2" style="width:55px;" class="align-middle">NC</th>
                                            <th rowspan="2" class="align-middle">Máy đăng ký</th>
                                            <th rowspan="2" class="align-middle">Máy đồng dạng</th>
                                            <th rowspan="2" class="align-middle">Đồ gá</th>
                                            <th rowspan="2" class="align-middle">Loại dao</th>
                                            <th rowspan="2" class="align-middle text-center" style="width:100px;">Worker</th>
                                            <th rowspan="2" class="align-middle text-center" style="width:60px;">SL chạy</th>
                                            <th rowspan="2" class="align-middle text-center" style="width:110px;">T.Bắt đầu</th>
                                            <th rowspan="2" class="align-middle text-center" style="width:110px;">T.Hoàn thành</th>
                                            <th colspan="2" class="text-center">T.Gá lắp</th>
                                            <th colspan="2" class="text-center">T.Gia công</th>
                                            <th colspan="2" class="text-center">T.Kiểm tra</th>
                                            <th colspan="2" class="text-center">T.Chuẩn bị</th>
                                            <th colspan="2" class="text-center">T.Chạy thử</th>
                                            <th rowspan="2" class="text-center align-middle" style="width:80px;">Trạng thái</th>
                                        </tr>
                                        @* Hàng 2: Chuẩn / Thực tế *@
                                        <tr>
                                            <th class="text-end text-muted fw-normal" style="width:50px; font-size:0.7rem;">Chuẩn</th>
                                            <th class="text-end fw-normal" style="width:50px; font-size:0.7rem; color:#0d6efd;">Thực tế</th>
                                            <th class="text-end text-muted fw-normal" style="width:50px; font-size:0.7rem;">Chuẩn</th>
                                            <th class="text-end fw-normal" style="width:50px; font-size:0.7rem; color:#0d6efd;">Thực tế</th>
                                            <th class="text-end text-muted fw-normal" style="width:50px; font-size:0.7rem;">Chuẩn</th>
                                            <th class="text-end fw-normal" style="width:50px; font-size:0.7rem; color:#0d6efd;">Thực tế</th>
                                            <th class="text-end text-muted fw-normal" style="width:50px; font-size:0.7rem;">Chuẩn</th>
                                            <th class="text-end fw-normal" style="width:50px; font-size:0.7rem; color:#0d6efd;">Thực tế</th>
                                            <th class="text-end text-muted fw-normal" style="width:50px; font-size:0.7rem;">Chuẩn</th>
                                            <th class="text-end fw-normal" style="width:50px; font-size:0.7rem; color:#0d6efd;">Thực tế</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in _snapshot.Machining)
                                        {
                                            var gcLogs    = GetLogsFor("GC", s.NC);
                                            var badgeColor = QtyColor("GC", s.NC);   @* [GN-WHERE][V5] theo sổ Giao nhận *@
                                            var gcQText  = QtyText("GC", s.NC);
                                            var gcQTitle = QtyTitle("GC", s.NC);

                                            @* Tính rowspan: 1 (dòng NC) + logs máy đăng ký + placeholder nếu rỗng
                                               + mỗi timing row: 1 + logs timing đó + placeholder nếu rỗng *@
                                            var regLogs   = gcLogs.Where(l => l.MachineUsed == s.MachineRegistered ||
                                                                               string.IsNullOrEmpty(l.MachineUsed) ||
                                                                               !s.TimingRows.Any(t => t.SoMay == l.MachineUsed)).ToList();
                                            var regRowCount  = regLogs.Count == 0 ? 1 : regLogs.Count;
                                            var timingTotal  = s.TimingRows.Sum(t => {
                                                var tLogs = gcLogs.Where(l => l.MachineUsed == t.SoMay).ToList();
                                                return 1 + (tLogs.Count == 0 ? 1 : tLogs.Count);
                                            });
                                            var totalRowspan = 1 + regRowCount + timingTotal;

                                            @* Dòng NC chính (chuẩn) *@
                                            <tr class="@(s.IsBackup ? "table-warning" : "")">
                                                <td class="text-center">@s.StepOrder</td>
                                                <td><code>@s.NC</code> @if (s.IsBackup) { <span class="badge bg-warning text-dark" style="font-size:0.65rem;">DP</span> }</td>
                                                <td>@(s.MachineRegistered ?? "—")</td>
                                                <td class="text-muted small">—</td>
                                                <td>@(s.FixtureType ?? "—")</td>
                                                <td>@(s.ToolType ?? "—")</td>
                                                <td class="text-muted text-center fst-italic small" colspan="4">← Thực tế từ WTS công nhân</td>
                                                <td class="text-end text-muted">@FmtTime(s.SetupTime)</td>
                                                <td class="text-end"></td>
                                                <td class="text-end text-muted">@FmtTime(s.MachiningTime)</td>
                                                <td class="text-end"></td>
                                                <td class="text-end text-muted">@FmtTime(s.InspectionTime)</td>
                                                <td class="text-end"></td>
                                                <td class="text-end text-muted">@FmtTime(s.PreparationTime)</td>
                                                <td class="text-end"></td>
                                                <td class="text-end text-muted">@FmtTime(s.TrialRunTime)</td>
                                                <td class="text-end"></td>
                                                <td class="text-center" rowspan="@totalRowspan">
                                                    <span class="badge bg-@badgeColor" title="@gcQTitle">@gcQText</span>
                                                </td>
                                            </tr>

                                            @* WTS logs của máy đăng ký (hoặc log không khớp timing nào) *@
                                            @if (regLogs.Count == 0)
                                            {
                                                <tr class="bg-light" style="border-left: 3px solid #0d6efd;">
                                                    <td></td><td></td><td></td><td></td><td></td><td></td>
                                                    <td class="text-muted fst-italic small" colspan="15">Chưa có dữ liệu sản xuất</td>
                                                </tr>
                                            }
                                            @foreach (var log in regLogs)
                                            {
                                                <tr class="bg-light" style="border-left: 3px solid #0d6efd;">
                                                    <td></td><td></td><td></td><td></td><td></td><td></td>
                                                    <td class="fw-semibold text-primary small text-center">@(log.Worker?.FullName ?? $"#{log.WorkerId}")</td>
                                                    <td class="text-center fw-bold small" style="color:#0d6efd;">@log.QtyDone.ToString("0.##")</td>
                                                    <td class="text-center small">@log.StartTime.ToString("dd/MM HH:mm")</td>
                                                    <td class="text-center small">@log.EndTime.ToString("dd/MM HH:mm")</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#0d6efd;">@FmtTime(log.SetupTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#0d6efd;">@FmtTime(log.MachiningTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#0d6efd;">@FmtTime(log.InspectionTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#0d6efd;">@FmtTime(log.PreparationTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#0d6efd;">@FmtTime(log.TrialRunTime_Actual)</td>
                                                </tr>
                                            }

                                            @* Timing sub-rows — mỗi máy đồng dạng 1 dòng chuẩn + WTS logs của máy đó *@
                                            @foreach (var tr in s.TimingRows)
                                            {
                                                var trLogs = gcLogs.Where(l => l.MachineUsed == tr.SoMay).ToList();
                                                @* Dòng chuẩn timing *@
                                                <tr style="background:#f0f7ff;">
                                                    <td></td>
                                                    <td></td>
                                                    <td class="text-muted small">—</td>
                                                    <td class="small fw-semibold" style="color:#185fa5;">@tr.SoMay</td>
                                                    <td class="text-muted small">@(tr.FixtureType ?? "—")</td>
                                                    <td class="text-muted small">@(tr.ToolType ?? "—")</td>
                                                    <td class="text-muted text-center fst-italic small" colspan="4">← Thực tế từ WTS công nhân</td>
                                                    <td class="text-end text-muted">@FmtTime(tr.SetupTime)</td>
                                                    <td class="text-end"></td>
                                                    <td class="text-end text-muted">@FmtTime(tr.MachiningTime)</td>
                                                    <td class="text-end"></td>
                                                    <td class="text-end text-muted">@FmtTime(tr.InspectionTime)</td>
                                                    <td class="text-end"></td>
                                                    <td class="text-end text-muted">@FmtTime(tr.PreparationTime)</td>
                                                    <td class="text-end"></td>
                                                    <td class="text-end text-muted">@FmtTime(tr.TrialRunTime)</td>
                                                    <td class="text-end"></td>
                                                </tr>
                                                @* WTS logs của timing row này *@
                                                @if (trLogs.Count == 0)
                                                {
                                                    <tr class="bg-light" style="border-left: 3px solid #185fa5;">
                                                        <td></td><td></td><td></td><td></td><td></td><td></td>
                                                        <td class="text-muted fst-italic small" colspan="15">Chưa có dữ liệu sản xuất</td>
                                                    </tr>
                                                }
                                                @foreach (var log in trLogs)
                                                {
                                                    <tr class="bg-light" style="border-left: 3px solid #185fa5;">
                                                        <td></td><td></td><td></td><td></td><td></td><td></td>
                                                        <td class="fw-semibold small text-center" style="color:#185fa5;">@(log.Worker?.FullName ?? $"#{log.WorkerId}")</td>
                                                        <td class="text-center fw-bold small" style="color:#185fa5;">@log.QtyDone.ToString("0.##")</td>
                                                        <td class="text-center small">@log.StartTime.ToString("dd/MM HH:mm")</td>
                                                        <td class="text-center small">@log.EndTime.ToString("dd/MM HH:mm")</td>
                                                        <td class="text-end text-muted">—</td>
                                                        <td class="text-end" style="color:#185fa5;">@FmtTime(log.SetupTime_Actual)</td>
                                                        <td class="text-end text-muted">—</td>
                                                        <td class="text-end" style="color:#185fa5;">@FmtTime(log.MachiningTime_Actual)</td>
                                                        <td class="text-end text-muted">—</td>
                                                        <td class="text-end" style="color:#185fa5;">@FmtTime(log.InspectionTime_Actual)</td>
                                                        <td class="text-end text-muted">—</td>
                                                        <td class="text-end" style="color:#185fa5;">@FmtTime(log.PreparationTime_Actual)</td>
                                                        <td class="text-end text-muted">—</td>
                                                        <td class="text-end" style="color:#185fa5;">@FmtTime(log.TrialRunTime_Actual)</td>
                                                    </tr>
                                                }
