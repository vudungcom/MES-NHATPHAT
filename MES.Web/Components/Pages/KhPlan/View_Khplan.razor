@code {
    [Parameter] public int Id { get; set; }        // KhPlanId
    [Parameter] public int DetailId { get; set; }  // KhPlanDetailId

    private KhPlan? _plan;
    private KhPlanDetail? _detail;
    private KhoVatLieuViewItem? _khoItem;
    private RouteSnapshotData? _snapshot;
    private List<WtsProductionLog> _wtsLogs = new();
    private Dictionary<string, decimal> _wtsQtySummary = new();

    protected override async Task OnInitializedAsync()
    {
        var (plan, detail) = await KhSvc.GetDetailByIdAsync(DetailId);

        if (plan != null && detail != null && plan.KhPlanId == Id)
        {
            _plan   = plan;
            _detail = detail;

            _khoItem = await KhoSvc.GetByDetailIdAsync(DetailId);

            // Load snapshot quy trình B→E
            _snapshot = await KhSvc.GetRouteSnapshotAsync(DetailId);

            // Load WTS production logs
            _wtsLogs = await KhSvc.GetWtsLogsAsync(DetailId);
            _wtsQtySummary = await KhSvc.GetWtsQtySummaryAsync(DetailId);
            // [GN-WHERE][V5] Sổ Giao nhận của PO: số từng NC / mã CV + PO đang ở đâu + đường đi
            _ledgerRow   = await LedgerSvc.GetLedgerForDetailAsync(DetailId);
            _ledgerSteps = await LedgerSvc.GetStepsForDetailAsync(DetailId);
        }
    }

    // Lấy logs cho 1 NC cụ thể
    private List<WtsProductionLog> GetLogsFor(string processGroup, string? nc)
        => _wtsLogs.Where(x => x.ProcessGroup == processGroup
                             && x.NC == nc
                             && !x.IsVoided).ToList();

    // Lấy logs cho 1 WtsCode (công đoạn C/D/E)
    private List<WtsProductionLog> GetLogsForWts(string processGroup, string? wtsCode)
        => _wtsLogs.Where(x => x.ProcessGroup == processGroup
                             && x.WtsCode == wtsCode
                             && !x.IsVoided).ToList();

    // Tổng SL đã hoàn thành theo key
    private decimal GetQtyDone(string processGroup, string? nc, string? wtsCode = null)
    {
        var key = nc != null ? $"{processGroup}|{nc}" : $"{processGroup}|{wtsCode}";
        return _wtsQtySummary.TryGetValue(key, out var v) ? v : 0;
    }

    // ── [GN-WHERE][V5 2026-10-27] Số từng NC / mã CV đọc từ sổ Giao nhận (cùng hàm với trang Giao nhận + trần WTS) ──
    //   Trước: Σ QtyDone (OK + NG gộp) so với SL PO → NC làm 38 OK + 2 NG hiện 40/40 xanh, lệch trang Giao nhận.
    //   Nay: OK / nhận vào NC (mã CV) + NG riêng. Dòng NC dự phòng (gộp số vào NC chính) chỉ hiện OK của chính nó.
    private LedgerRow? _ledgerRow;
    private List<LedgerStepRow> _ledgerSteps = new();

    private string LedgerStatusText
    {
        get
        {
            if (_ledgerRow == null) return "—";
            var w = HandoverLedgerService.WhereIs(_ledgerRow);
            var lbl = HandoverLedgerService.WhereSummary.StatusLabel(w.Status);
            return w.Loi > 0 ? $"{lbl} · lỗi {w.Loi:0.##}" : lbl;
        }
    }
    private string LedgerStatusBadge => _ledgerRow == null ? "bg-secondary" : HandoverLedgerService.WhereIs(_ledgerRow).Status switch
    {
        "AM" => "bg-danger", "CHUA_PHOI" => "bg-secondary", "DU" => "bg-success", _ => "bg-primary"
    };

    private LedgerStepLine? StepLine(string pg, string? code)
    {
        if (_ledgerRow == null || string.IsNullOrEmpty(code)) return null;
        var g = pg switch { "GC" => "GC", "TARO" or "BAVIA" or "WASHING" => "HTSP", "KCS" => "KCS", "PKG" => "PKG", _ => "" };
        return g == "" ? null : _ledgerRow.G(g).Steps.FirstOrDefault(x => x.Pg == pg && x.Code == code);
    }

    private decimal RawOk(string pg, string? code)
        => _wtsLogs.Where(x => x.ProcessGroup == pg && !x.IsVoided && (pg == "GC" ? x.NC == code : x.WtsCode == code))
                   .Sum(x => x.QtyOk ?? (x.QtyDone - (x.QtyNg ?? 0)));

    private string QtyText(string pg, string? code)
    {
        var l = StepLine(pg, code);
        if (l == null) return $"OK {RawOk(pg, code):0.##}" + (pg == "GC" ? " (gộp NC chính)" : "");
        if (l.IsPrep) return "chuẩn bị";
        return $"OK {l.Ok:0.##} / vào {(l.In ?? 0):0.##}" + (l.Ng > 0 ? $" · NG {l.Ng:0.##}" : "");
    }

    private string QtyColor(string pg, string? code)
    {
        var l = StepLine(pg, code);
        if (l == null || l.IsPrep || (l.In ?? 0) <= 0) return "secondary";
        if ((l.Waiting ?? 0) < 0) return "danger";
        if (l.Ok <= 0) return "danger";
        return (l.Waiting ?? 0) <= 0 ? "success" : "warning";
    }

    private string QtyTitle(string pg, string? code)
    {
        var l = StepLine(pg, code);
        if (l == null) return "NC dự phòng / mã chưa có trong sổ: số đã gộp vào NC (mã) chính";
        return $"OK {l.Ok:0.##} · NG {l.Ng:0.##} · nhận vào {(l.In ?? 0):0.##} · còn chờ {(l.Waiting ?? 0):0.##} (theo sổ Giao nhận)";
    }

    private static string FmtTime(decimal? t) => t.HasValue ? t.Value.ToString("0.##") : "—";

    /// <summary>Sub-table cho C/D/E — header 2 tầng, Thời gian Chuẩn/Thực tế</summary>
    private RenderFragment WtsSimpleSubTable(List<WtsProductionLog> logs) => __builder =>
    {
        <table class="table table-sm mb-0" style="font-size:0.72rem; border-left: 3px solid #198754;">
            <thead class="text-muted">
                <tr>
                    <th rowspan="2" style="width:120px;" class="align-middle">Worker</th>
                    <th rowspan="2" style="width:70px;" class="text-center align-middle">SL chạy</th>
                    <th rowspan="2" style="width:110px;" class="align-middle">Máy dùng</th>
                    <th rowspan="2" style="width:110px;" class="text-center align-middle">T.Bắt đầu</th>
                    <th rowspan="2" style="width:110px;" class="text-center align-middle">T.Hoàn thành</th>
                    <th colspan="2" class="text-center">Thời gian</th>
                    <th rowspan="2" class="align-middle">Ghi chú</th>
                </tr>
                <tr>
                    <th class="text-end fw-normal" style="width:60px; font-size:0.7rem;">Chuẩn</th>
                    <th class="text-end fw-normal" style="width:60px; font-size:0.7rem; color:#198754;">Thực tế</th>
                </tr>
            </thead>
            <tbody>
                @if (logs.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-1 fst-italic">Chưa có dữ liệu sản xuất</td></tr>
                }
                @foreach (var log in logs)
                {
                    <tr>
                        <td class="fw-semibold text-success">@(log.Worker?.FullName ?? $"#{log.WorkerId}")</td>
                        <td class="text-center fw-bold" style="color:#198754;">@log.QtyDone.ToString("0.##")</td>
                        <td>@(log.MachineUsed ?? "—")</td>
                        <td class="text-center">@log.StartTime.ToString("dd/MM HH:mm")</td>
                        <td class="text-center">@log.EndTime.ToString("dd/MM HH:mm")</td>
                        <td class="text-end text-muted">—</td>
                        <td class="text-end" style="color:#198754;">—</td>
                        <td class="text-muted">@log.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private string GetStatusColor(string status) => status switch
    {
        "WaitingSupplierOrder" => "info",
        "Ordered"              => "primary",
        "PartialReceived"      => "primary",
        "FullyReceived"        => "success",
        "InProduction"         => "success",
        "Completed"            => "success",
        "Cancelled"            => "secondary",
        _                      => "secondary"
    };
}
