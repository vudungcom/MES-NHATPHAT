    private async Task OnGroupMachineChanged(WtsGroup grp, string? machine)   // [MACHINE-OVERLAP-LIVE] void → async Task
    {
        grp.MachineUsed = machine;
        foreach (var sub in grp.SubRows) { sub.MachineUsed = machine; }
        // Fill std values cho tất cả sub-rows
        if (grp.UseStdAsDefault)
            foreach (var sub in grp.SubRows) TryFillStdValues(sub);
        await CheckMachineOverlapLiveAsync(grp);   // [MACHINE-OVERLAP-LIVE]

    }

    private List<string> GetGroupMachineOptions(WtsGroup grp)

    {

        if (string.IsNullOrEmpty(grp.NC)) return new();

        var snap = grp.AvailableNCs.FirstOrDefault(s => s.NC == grp.NC);

        if (snap == null) return new();

        var machines = new List<string>();

        if (!string.IsNullOrEmpty(snap.MachineRegistered)) machines.Add(snap.MachineRegistered);

        foreach (var tr in snap.TimingRows)

        {

            foreach (var m in (tr.SoMay ?? "").Split(',', ';').Select(x => x.Trim()).Where(x => x.Length > 0))

                if (!machines.Contains(m)) machines.Add(m);

        }

        return machines;

    }

