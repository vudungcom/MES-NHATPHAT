    // ── WtsGroup: nhóm nhiều KH cùng Part/NC/Máy ──────────────────────────

    public class WtsGroup

    {

        public string? PartNo        { get; set; }

        public string? NC            { get; set; }

        public string? MachineUsed   { get; set; }

        public string  ProductionMode{ get; set; } = "serial";

        public bool    UseStdAsDefault { get; set; } = true;

        public bool    IsCollapsed   { get; set; } = false;

        public bool    IsSaving      { get; set; } = false;

        public string? ErrorMsg      { get; set; }

        // NCs có sẵn từ snapshot — load khi chọn PartNo

        public List<KhPlanRouteSnapshotMachining> AvailableNCs { get; set; } = new();

        // WTS items cho non-GC (Mã CV + tên công đoạn)

        public List<WtsItem> WtsItems { get; set; } = new();

        // Nhóm nhỏ HTSP: "Taro" | "Bavia" | "Rua" — chỉ dùng khi IsHtspGroup

        public string HtspSubGroup { get; set; } = "";

        // Tăng ca — không validate khung giờ ca, ghi IsOvertime=true vào DB

        public bool IsOvertime { get; set; } = false;

        public List<WtsRow> SubRows { get; set; } = new();

    }

    // ── T.Kết thúc dự kiến theo công thức (dùng để màu xanh/đỏ) ──────────

    // Với 1 sub-row: StartTime + cycle × SL

    // Với nhiều sub-row: StartTime hàng đầu + (SL hàng này / SL tổng) × tổng cycle × SL tổng

    private DateTime? CalcEstimatedEndTime(WtsGroup grp, WtsRow sub)

    {

        // Dự kiến = dùng timing CHUẨN từ snapshot để so sánh với thực tế user nhập

        if (sub.StartTime == default) return null;

        if (!sub.KhPlanDetailId.HasValue) return null;

        // Dùng SL thực tế nếu đã nhập, fallback SL PO nếu chưa nhập

        var sl = sub.QtyDone > 0

            ? sub.QtyDone

            : (_allRows.FirstOrDefault(r => r.KhPlanDetailId == sub.KhPlanDetailId)?.Quantity ?? 0m);

        // [FLAT-CODE] Non-GC, Mã CV 1V/1T/1K/1G: T.bắt đầu + T.thực tế + T.PS + T.nghỉ = T.kết thúc
        // (T.thực tế là tổng phút công nhân nhập — KHÔNG nhân SL; giống "Chạy thử" bên gia công)
        if (!IsGcGroup && IsFlatTimeCode(sub))
        {
            if (!sub.ActualTimePerPc.HasValue || sub.ActualTimePerPc.Value <= 0) return null;
            var flatMin = (double)sub.ActualTimePerPc.Value + sub.ExtraMinutes;
            return AddEffectiveMinutes(sub.StartTime, flatMin, SelectedCa);
        }

        if (sl <= 0) return null;

        // [FIX4] Non-GC (các mã CV còn lại): (SL OK + SL NG) × T.chuẩn/pc + T.PS + T.nghỉ
        // Nếu công nhân đã nhập T.thực tế/pc thì dùng số đó thay T.chuẩn.
        if (!IsGcGroup)
        {
            // Ưu tiên T.Thực tế/pc nếu công nhân đã nhập; fallback T.Chuẩn/pc (mã CV thường).
            var timePerPc = (sub.ActualTimePerPc.HasValue && sub.ActualTimePerPc.Value > 0)
                ? sub.ActualTimePerPc.Value
                : GetStdTimeForSubRow(sub);
            if (!timePerPc.HasValue || timePerPc.Value <= 0) return null;
            var prodMin4 = (double)(timePerPc.Value * sl) + sub.ExtraMinutes;
            return AddEffectiveMinutes(sub.StartTime, prodMin4, SelectedCa);
        }

        var std = GetStdTiming(sub.KhPlanDetailId.Value, grp.NC, grp.MachineUsed);

        // [FIX-ACTUAL-EST] Nếu không có std, vẫn tính nếu công nhân đã nhập actual
        if (std == null
            && sub.SetupTime_Actual      == null && sub.MachiningTime_Actual  == null
            && sub.InspectionTime_Actual == null && sub.PreparationTime_Actual == null
            && sub.TrialRunTime_Actual   == null) return null;

        double prodMin;

        if (grp.ProductionMode == "serial")

        {

            // Hàng loạt: dùng actual khi đã nhập, fallback về std
            // (T.Gá + max(T.GC, T.Ktra)) × SL

            // [SERIAL-EST-ACTUAL] Cùng quy tắc với Chạy thử [TRIAL-EST-ACTUAL]: chuẩn chỉ để tham khảo, KHÔNG trộn vào số thực tế.
            // Đã nhập ít nhất 1 ô (T.Gá / T.GC / T.Ktra) → chỉ tính bằng ô thực tế, ô trống = 0.
            // Cả 3 ô đều trống → Dự kiến hiện theo chuẩn để công nhân có mốc ước lượng (chốt với anh Hùng 20/10).
            // Trước: mỗi ô trống tự lấy chuẩn riêng → Dự kiến trộn thực tế + chuẩn.
            var _serialHasActual = sub.SetupTime_Actual.HasValue
                                || sub.MachiningTime_Actual.HasValue
                                || sub.InspectionTime_Actual.HasValue;

            var setup   = _serialHasActual ? (sub.SetupTime_Actual      ?? 0m) : (std?.SetupTime      ?? 0m);

            var machine = _serialHasActual ? (sub.MachiningTime_Actual  ?? 0m) : (std?.MachiningTime  ?? 0m);

            var inspect = _serialHasActual ? (sub.InspectionTime_Actual ?? 0m) : (std?.InspectionTime ?? 0m);

            var cycle   = setup + Math.Max(machine, inspect);

            if (cycle <= 0) return null;

            prodMin = (double)(cycle * sl) + sub.ExtraMinutes;

        }

        else

        {

            // Chạy thử: dùng actual khi đã nhập, fallback về std — 1 lần, KHÔNG nhân SL
            // [TRIAL-EST-ACTUAL] Mục 25: khi công nhân đã nhập T.CB hoặc T.Chạy → ô còn lại để trống = 0
            // (VD 08:40 + T.CB 10, T.Chạy trống → Dự kiến 08:50). Chỉ khi CẢ HAI ô đều trống mới lấy chuẩn.
            // Trước: mỗi ô trống tự lấy chuẩn riêng → T.Chạy trống bị cộng T.Chạy chuẩn (20) → 09:10.
            var _trialHasActual = sub.PreparationTime_Actual.HasValue || sub.TrialRunTime_Actual.HasValue;

            var prep  = _trialHasActual ? (sub.PreparationTime_Actual ?? 0m) : (std?.PreparationTime ?? 0m);

            var trial = _trialHasActual ? (sub.TrialRunTime_Actual    ?? 0m) : (std?.TrialRunTime    ?? 0m);

            if (prep + trial <= 0) return null;

            prodMin = (double)(prep + trial) + sub.ExtraMinutes;

        }

        // [FIX-EST-CONV] Dùng AddEffectiveMinutes — đi thẳng qua từng khoảng nghỉ,
        // không dùng vòng lặp hội tụ 3 bước (không đủ khi end gần boundary nghỉ).
        return AddEffectiveMinutes(sub.StartTime, prodMin, SelectedCa);

    }

    private static string SubEstColor(bool isLate)

        => isLate ? "#dc3545" : "#198754"; // red / green Bootstrap

    // ── Tính lại T.Kết thúc theo công thức ──────────────────────────────

    // GC Hàng loạt: (T.Gá + max(T.GC, T.Ktra)) * SL_total

    // GC Chạy thử : (T.Chuẩn bị + T.Chạy thử) * SL_total  [không nhân SL vì chạy thử thường 1 lần]

    // Non-GC      : SL_total * T.chuẩn (từ snapshot)

    private void RecalcEndTime(WtsRow row)

    {

        if (!IsGcGroup)

        {

            // Non-GC: SL * T.chuẩn

            var std = GetStdTimeForWtsCode(row);

            if (std.HasValue && std.Value > 0 && row.QtyDone > 0)

            {

                var totalMin = (int)Math.Ceiling((double)(std.Value * row.QtyDone));

                row.EndTime = row.StartTime.AddMinutes(totalMin);

            }

            return;

        }

        // GC — tính theo mode

        var slTotal = row.QtyDone; // QtyOk + QtyNg

        if (slTotal <= 0) return;

        if (row.ProductionMode == "serial")

        {

            // Hàng loạt: dùng T.Gá + max(T.GC, T.Ktra)

            var setup    = row.SetupTime_Actual      ?? 0m;

            var machine  = row.MachiningTime_Actual  ?? 0m;

            var inspect  = row.InspectionTime_Actual ?? 0m;

            if (setup == 0 && machine == 0 && inspect == 0) return; // chưa nhập gì

            var cycle    = setup + Math.Max(machine, inspect);

            var totalMin = (int)Math.Ceiling((double)(cycle * slTotal));

            row.EndTime  = row.StartTime.AddMinutes(totalMin);

        }

        else // trial

        {

            // Chạy thử: T.Chuẩn bị + T.Chạy thử (không nhân SL — đây là setup 1 lần)

            var prep  = row.PreparationTime_Actual ?? 0m;

            var trial = row.TrialRunTime_Actual    ?? 0m;

            if (prep == 0 && trial == 0) return;

            var totalMin = (int)Math.Ceiling((double)(prep + trial));

            row.EndTime  = row.StartTime.AddMinutes(totalMin);

        }

    }

    // ── Copy giá trị chuẩn vào ô thực tế (chỉ khi UseStdAsDefault=true) ──

    private void TryFillStdValues(WtsRow row)

    {

        if (!row.UseStdAsDefault) return;

        if (!row.KhPlanDetailId.HasValue) return;

        // [STD-ACTUAL-DEFAULT] Mục 29 — Non-GC (HTSP/KCS/Đóng gói): T.Thực tế/pc mặc định = T.Chuẩn/pc (theo snapshot).
        // Công nhân chỉ sửa khi thực tế khác chuẩn. Không đổi giờ kết thúc (Dự kiến tự tính từ T.Thực tế).
        if (!IsGcGroup)
        {
            var stdPc = GetStdTimeForSubRow(row);
            if (stdPc.HasValue) row.ActualTimePerPc = stdPc;
            return;
        }
        var std = GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed);

        if (std == null) return;

        if (row.ProductionMode == "serial")

        {

            row.SetupTime_Actual      = std.SetupTime;

            row.MachiningTime_Actual  = std.MachiningTime;

            row.InspectionTime_Actual = std.InspectionTime;

            // Chạy thử xám → xóa đi

            row.PreparationTime_Actual = null;

            row.TrialRunTime_Actual    = null;

        }

        else

        {

            row.PreparationTime_Actual = std.PreparationTime;

            row.TrialRunTime_Actual    = std.TrialRunTime;

            // Hàng loạt xám → xóa đi

            row.SetupTime_Actual      = null;

            row.MachiningTime_Actual  = null;

            row.InspectionTime_Actual = null;

        }

        RecalcEndTime(row);

    }

    // Gọi khi user thay đổi ProductionMode (toggle Chạy thử / Hàng loạt)

    private void OnProductionModeChanged(WtsRow row, string mode)

    {

        row.ProductionMode = mode;

        // Xóa giá trị actual của mode cũ để tránh nhầm lẫn

        if (mode == "serial")

        {

            row.PreparationTime_Actual = null;

            row.TrialRunTime_Actual    = null;

        }

        else

        {

            row.SetupTime_Actual      = null;

            row.MachiningTime_Actual  = null;

            row.InspectionTime_Actual = null;

        }

        TryFillStdValues(row);

    }

    // Wrapper EventCallback-safe cho toggle — tránh async lambda trong markup

    private async Task OnUseStdToggledHandler(WtsRow row, ChangeEventArgs e)

    {

        var value = e.Value is bool b ? b : false;

        await OnUseStdToggled(row, value);

    }

    // Gọi khi user toggle UseStdAsDefault — lưu preference vào localStorage

    private async Task OnUseStdToggled(WtsRow row, bool value)

    {

        row.UseStdAsDefault = value;

        _useStdAsDefault = value; // cập nhật default cho các dòng tiếp theo

        if (value) TryFillStdValues(row);

        try

        {

            await JS.InvokeVoidAsync("localStorage.setItem",

                $"wts_useStdAsDefault_{_currentUserId}", value ? "true" : "false");

        }

        catch { /* ignore */ }

    }

    // Wrapper các input actual GC — sau khi nhập thì tính lại EndTime

    private void OnSetupTimeInput(WtsRow row, ChangeEventArgs e)

