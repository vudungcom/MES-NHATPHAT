    private bool IsGcStdConfirmed(WtsRow sub, TimingStd? std, string field)
        => std != null && GetSnapConfirm(sub.KhPlanDetailId, std.SrcTable, std.SrcRowId, field)?.IsConfirmed == true;

    private string GcStdStyle(WtsRow sub, TimingStd? std, string field)
        => IsGcStdConfirmed(sub, std, field) ? StdStyleConfirmed : StdStyleUnconfirmed;

    private string GcStdTitle(WtsRow sub, TimingStd? std, string field)
    {
        var label = field switch
        {
            StdTrack.Field.Setup       => "T.Gá lắp",
            StdTrack.Field.Machining   => "T.Gia công",
            StdTrack.Field.Inspection  => "T.Kiểm tra",
            StdTrack.Field.Preparation => "T.Chuẩn bị",
            StdTrack.Field.TrialRun    => "T.Chạy thử",
            _                          => field
        };
        if (std == null) return $"{label}: không tìm thấy thời gian chuẩn trong snapshot phiếu KH";
        decimal? v = field switch
        {
            StdTrack.Field.Setup       => std.SetupTime,
            StdTrack.Field.Machining   => std.MachiningTime,
            StdTrack.Field.Inspection  => std.InspectionTime,
            StdTrack.Field.Preparation => std.PreparationTime,
            StdTrack.Field.TrialRun    => std.TrialRunTime,
            _                          => null
        };
        if (string.IsNullOrEmpty(std.SrcTable))
            return $"{label}: {(v.HasValue ? v.Value.ToString("0.##") : "—")} phút — không lấy từ snapshot phiếu KH, CHƯA xác nhận";
        var where = std.SrcTable == StdTrack.Table.MachiningTiming ? $" (máy đồng dạng {std.SoMay})" : " (NC chính)";
        return StdConfirmTitle(GetSnapConfirm(sub.KhPlanDetailId, std.SrcTable, std.SrcRowId, field), v, label + where);
    }

    // ── Non-GC: dòng snapshot mà GetStdTimeForSubRow lấy số ──
    // Cùng quy tắc: khớp mã WTS trước (Taro: WtsTaskCode ?? NC; còn lại: NC); dòng đó không có số → fallback theo NC.
    private (string Table, long RowId)? GetStdSourceForSubRow(WtsRow sub)
    {
        if (string.IsNullOrEmpty(sub.PO) || !_fullSnapshotCache.TryGetValue(sub.PO, out var snap)) return null;
        if (IsHtspGroup)
            return sub.HtspSubGroup switch
            {
                "Taro"  => PickStdSource(snap.Taro, StdTrack.Table.Taro, sub.WtsCode, sub.NC,
                               s => s.WtsTaskCode ?? s.NC, s => s.NC, s => s.StandardTime, s => s.SnapshotId),
                "Bavia" => PickStdSource(snap.Bavia, StdTrack.Table.Bavia, sub.WtsCode, sub.NC,
                               s => s.NC, s => s.NC, s => s.StandardTime, s => s.SnapshotId),
                "Rua"   => PickStdSource(snap.Washing, StdTrack.Table.Washing, sub.WtsCode, sub.NC,
                               s => s.NC, s => s.NC, s => s.StandardTime, s => s.SnapshotId),
                _       => null
            };
        if (HandoverGroupCode == "KCS")
            return PickStdSource(snap.Inspection, StdTrack.Table.Inspection, sub.WtsCode, sub.NC,
                       s => s.NC, s => s.NC, s => s.StandardTime, s => s.SnapshotId);
        return PickStdSource(snap.Packaging, StdTrack.Table.Packaging, sub.WtsCode, sub.NC,
                   s => s.NC, s => s.NC, s => s.StandardTime, s => s.SnapshotId);
    }

    private static (string Table, long RowId)? PickStdSource<T>(IEnumerable<T> list, string table, string? code, string? nc,
        Func<T, string?> codeKey, Func<T, string> ncKey, Func<T, decimal?> value, Func<T, long> rowId)
    {
        T? byCode = default;
        var hasCode = false;
        if (!string.IsNullOrEmpty(code))
            foreach (var s in list)
                if (codeKey(s) == code) { byCode = s; hasCode = true; break; }
        if (hasCode && value(byCode!).HasValue) return (table, rowId(byCode!));
        if (!string.IsNullOrEmpty(nc))
            foreach (var s in list)
                if (ncKey(s) == nc) return (table, rowId(s));
        return hasCode ? (table, rowId(byCode!)) : null;
    }

    private KhPlanRouteSnapshotStdConfirm? GetStdSnapConfirmForSubRow(WtsRow sub)
    {
        var src = GetStdSourceForSubRow(sub);
        if (src == null) return null;
        return GetSnapConfirm(sub.KhPlanDetailId, src.Value.Table, src.Value.RowId, StdTrack.Field.Standard);
    }

    private decimal? GetStdTimeForWtsCode(WtsRow row)

    {

        if (string.IsNullOrEmpty(row.PO) || string.IsNullOrEmpty(row.NC)) return null;

        if (!_fullSnapshotCache.TryGetValue(row.PO, out var snap)) return null;

        var nc = row.NC;

        // HTSP: tìm trong Taro/Bavia/Washing theo HtspSubGroup

        if (IsHtspGroup)

        {

            return row.HtspSubGroup switch

            {

                "Taro"  => snap.Taro   .FirstOrDefault(s => s.NC == nc)?.StandardTime,

                "Bavia" => snap.Bavia  .FirstOrDefault(s => s.NC == nc)?.StandardTime,

                "Rua"   => snap.Washing.FirstOrDefault(s => s.NC == nc)?.StandardTime,

                _       => null

            };

        }

        // KCS

        if (HandoverGroupCode == "KCS")

            return snap.Inspection.FirstOrDefault(s => s.NC == nc)?.StandardTime;

        // PKG

        return snap.Packaging.FirstOrDefault(s => s.NC == nc)?.StandardTime;

    }

    private string? GetActivePO()

    {

        // Ưu tiên: PO đang nhập trong _groups (form mới)

        var fromGroups = _groups

            .SelectMany(g => g.SubRows)

            .FirstOrDefault(s => !string.IsNullOrEmpty(s.PO))?.PO;

        if (fromGroups != null) return fromGroups;

        // Fallback: _rows cũ (saved rows)

        return _rows.FirstOrDefault(r => !r.Saved && !string.IsNullOrEmpty(r.PO))?.PO

            ?? _rows.LastOrDefault(r => r.Saved && !string.IsNullOrEmpty(r.PO))?.PO;

    }

    private static string[] GetAltMachinesFromTimingRows(

        IEnumerable<KhPlanRouteSnapshotMachiningTiming> timingRows)

        => timingRows

            .OrderBy(t => t.DisplayOrder)

            .SelectMany(t => (t.SoMay ?? "").Split(new[] { ',', ';' },

                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))

            .Distinct()

            .ToArray();

    private List<string> GetMachineOptions(WtsRow row)

    {

        var snap = row.AvailableNCs.FirstOrDefault(n => n.NC == row.NC);

        var opts = new List<string>();

        if (snap == null) return opts;

        // Máy đăng ký luôn đứng đầu

        if (!string.IsNullOrEmpty(snap.MachineRegistered))

            opts.Add(snap.MachineRegistered);

        // Máy đồng dạng: mỗi TimingRow có SoMay = "C04, C06" → parse ra từng máy

        foreach (var t in snap.TimingRows.OrderBy(t => t.DisplayOrder))

        {

            foreach (var m in (t.SoMay ?? "").Split(new[] { ',', ';' },

                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))

            {

                if (!opts.Contains(m)) opts.Add(m);

            }

        }

        return opts;

    }

    /// <summary>Item mã công việc cho nhóm non-GC (HTSP/KCS/PKG)</summary>

    public record WtsItem(string NC, string Name);

    public class WtsRow

    {

        public long? WtsLogId      { get; set; }

        public long? ActivityLogId { get; set; }

        public int? KhPlanDetailId { get; set; }

        public DateTime StartTime { get; set; }

        public DateTime EndTime   { get; set; }

        public int Minutes => EndTime > StartTime ? (int)(EndTime - StartTime).TotalMinutes : -1;

