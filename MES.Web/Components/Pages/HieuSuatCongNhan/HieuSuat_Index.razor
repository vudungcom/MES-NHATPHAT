@page "/hieu-suat-cong-nhan"

@attribute [Authorize]

@* [FIX-CA-FIRST-CLICK] Tắt prerender: trước đây trang hiện HTML tĩnh trước khi kết nối SignalR → bấm Ca lần đầu bị mất,
   trang "nháy" (render lại khi kết nối xong) và phải bấm lần 2. Không có code nào phụ thuộc prerender (JS chỉ gọi trong event). *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Security.Claims

@using Microsoft.EntityFrameworkCore

@using MES.Web.Data

@using MES.Web.Data.Entities

@using MES.Web.Services
@* [VULOI] NgCategoryPicker *@
@using MES.Web.Components.Shared

@using MES.Web.Constants

@inject AppDbContext Db
@inject PartStepStdTimeConfirmService StdConfirmSvc

@inject KhPlanService KhSvc

@inject StandardWtsTaskService WtsSvc

@inject UserService UserSvc

@inject HandoverService HandoverSvc
@* [GN-WTS-CAP] Trần nhập WTS lấy từ hàm tính chung của Giao nhận — cùng số với trang Giao nhận *@
@inject HandoverLedgerService LedgerSvc
@* [WTS-SVC 2026-10-29] phần lưu / xoá WTS tách ra service *@
@inject MES.Web.Services.WtsSaveService WtsSaveSvc

@* [VULOI][DS-LOI] danh mục lỗi: NG chọn loại lỗi, lưu tạo / giữ vụ lỗi *@
@inject NgCaseService NgSvc

@inject ThietBiService ThietBiSvc

@inject WtsReportService ReportSvc

@inject AuthenticationStateProvider AuthState

@inject MES.Web.Services.WtsCategoryGroupMappingService MappingSvc

@inject IJSRuntime JS

<style>

    /* Ẩn spinner mũi tên trên input number toàn trang này */

    input[type=number]::-webkit-inner-spin-button,

    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

    input[type=number] { -moz-appearance: textfield; appearance: textfield; }

</style>

<PageTitle>Nhập WTS - MES</PageTitle>

@* ── Modal confirm xóa WTS ── *@

@if (_voidConfirmRow != null)

{

    var vr = _voidConfirmRow;

    <div class="mes-modal-backdrop">

        <div class="mes-modal" @onclick:stopPropagation style="max-width:420px;">

            <div class="mes-modal-header">

                <h5 class="mb-0 text-danger">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa WTS

                </h5>

                <button class="btn-close" @onclick="CloseVoidModal"></button>

            </div>

            <div class="mes-modal-body">

                <div class="alert alert-danger py-2 small">

                    <i class="bi bi-exclamation-triangle me-1"></i>

                    Thao tác này <strong>không thể hoàn tác</strong>.

                </div>

                @* [GN-WTS-CAP][K5] Lời báo khi xoá làm sai số giao nhận *@
                <div class="alert alert-warning py-2 small" style="@VoidBlockStyle">@_voidBlockMsg</div>

                <table class="table table-sm table-bordered small mb-0">

                    <tr><th class="text-muted" style="width:90px">Thời gian</th><td>@vr.StartTime.ToString("HH:mm") — @vr.EndTime.ToString("HH:mm") (@vr.Minutes ph)</td></tr>

                    <tr><th class="text-muted">PO</th><td>@(vr.PO ?? "—")</td></tr>

                    <tr><th class="text-muted">NC / Máy</th><td>@(vr.NC ?? "—") / @(vr.MachineUsed ?? "—")</td></tr>

                    <tr><th class="text-muted">OK / NG</th><td><span class="text-success fw-semibold">@vr.QtyOk</span> / <span class="text-danger fw-semibold">@vr.QtyNg</span></td></tr>

                </table>

            </div>

            <div class="mes-modal-footer d-flex gap-2 justify-content-end">

                <button class="btn btn-sm btn-secondary" @onclick="CloseVoidModal">Hủy</button>

                @* [GN-WTS-CAP] Gọi hàm theo tên (luật Razor: không lambda nhiều lệnh); bị chặn K5 thì modal giữ nguyên *@
                <button class="btn btn-sm btn-danger" @onclick="OnConfirmVoidAsync" disabled="@_voidBusy">

                    <i class="bi bi-trash me-1"></i>Xóa WTS này

                </button>

            </div>

        </div>

    </div>

}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>

        <h1 class="mb-1">Nhập WTS Sản xuất</h1>

        <p class="text-muted small mb-0">Ghi nhận công việc theo timeline ca làm — mỗi dòng = 1 khoảng thời gian</p>

    </div>

    @if (_currentWorker != null)

    {

        <div class="text-end">

            <span class="badge bg-primary fs-6 px-3">@_currentWorker.FullName</span><br />

            <small class="text-muted">@(_currentWorker.Group?.GroupName ?? _currentWorker.Group?.GroupCode)</small>

        </div>

    }

</div>

@* ── Tab switcher ── *@

<ul class="nav nav-tabs mb-3">

    <li class="nav-item">

        <button class="@_TabInputCls" @onclick="SetTabInput">

            <i class="bi bi-pencil-square me-1"></i>Nhập WTS

        </button>

    </li>

    @if (_canViewReport)

    {

        <li class="nav-item">

            <button class="@_TabReportCls" @onclick="SwitchToReport">

                <i class="bi bi-bar-chart-line me-1"></i>WTS Report

            </button>

        </li>

    }

</ul>

@if (!_canSubmit)

{

    <div class="alert alert-warning">

        <i class="bi bi-shield-exclamation"></i>

        Tài khoản chưa được phân nhóm sản xuất. Vui lòng liên hệ Admin.

    </div>

}

else

{

    @if (_activeTab == "input")

    {

    @* ── Header: Chọn ngày + tổng phút ── *@

    <div class="card mb-3">

        <div class="card-body py-2">

            <div class="row g-2 align-items-center">

                <div class="col-auto">

                    <label class="form-label small mb-0 fw-semibold">Ngày làm việc</label>

                    <input type="date" class="form-control form-control-sm" style="width:150px;"

                           @bind="_workDate" @bind:after="OnWorkDateChanged" />

                </div>

                <div class="d-flex align-items-center gap-1 flex-wrap">

                    <span class="small fw-semibold text-muted me-1">Ca làm việc:</span>

                    @foreach (var ca in _caList)

                    {

                        var isActive = _selectedCaId == ca.CaId;

                        <button type="button"

                                class="@CaButtonCls(isActive)"

                                title="@CaButtonTooltip(ca)"

                                @onclick="async () => await OnCaSelected(ca.CaId)">

                            @ca.TenCa

                            <span style="font-size:10px;opacity:0.8;margin-left:3px">@ca.GioBatDau.ToString("HH:mm")</span>

                        </button>

                    }

                    @if (SelectedCa?.NghiGiaiLaos.Any() == true)

                    {

                        <span class="small text-muted ms-1">

                            <i class="bi bi-cup-hot me-1"></i>Nghỉ: @string.Join(", ", SelectedCa.NghiGiaiLaos.Select(n => FormatNghiLabel(n)))

                        </span>

                    }

                </div>

                <div class="col-auto ms-auto d-flex flex-column gap-1">

                    <div class="form-check form-switch">

                        <input class="form-check-input" type="checkbox" id="toggleNoSnap"

                               @bind="_showWithoutSnapshot" />

                        <label class="form-check-label small" for="toggleNoSnap">

                            Hiện phiếu chưa có quy trình

                            <i class="bi bi-info-circle text-muted ms-1"

                               title="Mặc định chỉ hiện phiếu đã có quy trình từ Part Master (snapshot). Bật tùy chọn này để thấy phiếu chưa đủ quy trình — cẩn thận: công nhân sẽ không thấy NC cần làm, dễ nhầm lẫn. Chỉ dùng khi Kỹ thuật chưa cập nhật Part Master kịp."></i>

                        </label>

                    </div>

                    <div class="form-check form-switch">

                        <input class="form-check-input" type="checkbox" id="toggleNoHandover"

                               @bind="_showWithoutHandover" />

                        <label class="form-check-label small" for="toggleNoHandover">

                            Hiện phiếu chưa nhận hàng

                            <i class="bi bi-exclamation-triangle text-warning ms-1"

                               title="Mặc định chỉ hiện phiếu mà kho/nhóm trước đã bàn giao hàng sang nhóm này. Bật để thấy tất cả — cẩn thận: nhóm chưa nhận hàng không nên nhập WTS."></i>

                        </label>

                    </div>

                </div>

                <div class="col">

                    @{

                        var totalMin = _rows.Where(r => r.Saved).Sum(r => r.Minutes);

                        var pct = Math.Min(100, (int)(totalMin / 4.8));

                        var barColor = pct >= 100 ? "success" : (pct >= 60 ? "warning" : "danger");

                    }

                    <div class="d-flex align-items-center gap-3 mt-3">

                        <span class="small fw-semibold">Tổng hôm nay:</span>

                        <span class="fw-bold @(totalMin >= 480 ? "text-success" : "text-warning")">

                            @totalMin / 480 phút

                        </span>

                        <div class="progress flex-grow-1" style="height:12px; max-width:300px;">

                            <div class="progress-bar bg-@barColor" style="width:@pct%"></div>

                        </div>

                        <span class="small text-muted">@pct%</span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    @* ── Guard: bắt buộc chọn ca trước khi nhập WTS ── *@

    @if (SelectedCa == null)

    {

        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">

            <i class="bi bi-hand-index-thumb fs-5"></i>

            <div>

                <strong>Vui lòng chọn ca làm việc</strong> ở trên trước khi nhập WTS.

                <div class="small text-muted mt-1">Chọn đúng ca để hệ thống tính thời gian nghỉ và phân bổ chính xác.</div>

            </div>

        </div>

    }

    else

    {

    @* ── Bảng timeline ── *@

    <div class="card mb-3">

        <div class="card-header py-2 d-flex justify-content-between align-items-center">

            <span class="fw-semibold"><i class="bi bi-clock me-1"></i> Timeline ca làm việc</span>

            <div class="d-flex align-items-center gap-2">

                @if (!IsToday)

                {

                    <span class="badge bg-warning text-dark">

                        <i class="bi bi-lock me-1"></i>Ngày cũ — chỉ xem

                    </span>

                }

                <button class="btn btn-sm btn-outline-primary" @onclick='() => AddGroup(false)' disabled="@(!IsToday)">

                    <i class="bi bi-plus-lg me-1"></i>Thêm nhóm

                </button>

            </div>

        </div>

        <div class="card-body p-2">

            @* ── Dòng đã lưu (saved rows từ DB) ── *@

            @if (_rows.Any(r => r.Saved))

            {

                <div class="table-responsive mb-2">

                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.8rem;">

                        <thead class="table-light">

                            <tr>

                                <th style="width:28px" class="text-center"></th>

                                <th style="width:70px" class="text-center">Ca</th>

                                <th style="width:75px" class="text-center">Bắt đầu</th>

                                <th style="width:75px" class="text-center">Kết thúc</th>

                                <th style="width:45px" class="text-center">Phút</th>

                                <th style="width:110px">Số KH / PO</th>

                                <th style="width:100px">Part No</th>

                                @* [FIX-NONGC-NC] Tiêu đề theo nhóm đăng nhập: GC = "NC", HTSP/KCS/PKG = "Mã CV" *@
                                <th style="width:50px" class="text-center">@NcColumnTitle</th>

                                <th style="width:65px" class="text-center">Máy</th>

                                <th style="width:52px" class="text-success text-center">OK</th>

                                <th style="width:52px" class="text-danger text-center">NG</th>

                                <th style="width:110px">Lý do NG</th>

                                <th style="width:110px">Mã WTS PS</th>

                                <th style="width:50px" class="text-center">T.PS<br/><small style="font-size:9px">(ph)</small></th>

                                <th>Nội dung PS</th>

                                <th style="width:60px" class="text-center">Thao tác</th>

                            </tr>

                        </thead>

                        <tbody>

                        @foreach (var row in _rows.Where(r => r.Saved && !r.IsOvertime).OrderBy(r => r.StartTime))

                        {

                            <tr class="@SavedRowCls(row)">

                                <td class="text-center p-0" style="width:28px">

                                    @if (row.ExtraItems.Any())

                                    {

                                        <button class="btn btn-link btn-sm py-0 px-1"

                                                style="font-size:12px;color:#0d6efd"

                                                @onclick="() => row.ShowTimeDetail = !row.ShowTimeDetail"

                                                title="@(row.ShowTimeDetail ? "Ẩn phát sinh" : "Xem phát sinh")">

                                            <i class="bi @(row.ShowTimeDetail ? "bi-chevron-up" : "bi-chevron-down")"></i>

                                        </button>

                                    }

                                </td>

                                <td class="text-center" style="font-size:10px;color:#0d6efd">

                                    @(row.CaName ?? "—")

                                </td>

                                <td class="text-center">@row.StartTime.ToString("HH:mm")</td>

                                <td class="text-center">@row.EndTime.ToString("HH:mm")</td>

                                <td class="text-center">@row.Minutes</td>

                                <td>

                                    @if (!string.IsNullOrEmpty(row.PO))

                                    {

                                        <small class="text-muted">@row.PO</small>

                                    }

                                    else

                                    {

                                        <span class="text-muted fst-italic small">—</span>

                                    }

                                </td>

                                <td><small>@(row.PartNo ?? "—")</small></td>

                                <td><small>@(row.NC ?? row.WtsCode ?? "—")</small></td>

                                <td><small>@(row.MachineUsed ?? "—")</small></td>

                                <td class="text-center text-success fw-semibold">@row.QtyOk</td>

                                <td class="text-center text-danger fw-semibold">@(row.QtyNg > 0 ? row.QtyNg.ToString() : "—")</td>

                                <td><small class="text-muted">@WtsNgText(row)</small></td>   @* [VULOI] + mã vụ lỗi *@

                                <td style="background:#fff8e6">

                                    <small class="text-muted">

                                        @if (row.ExtraItems.Count == 1)

                                        {

                                            @(row.ExtraItems[0].WtsCode ?? "—")

                                            @if (!string.IsNullOrEmpty(row.ExtraItems[0].WtsName))

                                            {

                                                <div style="font-size:10px;color:#6c757d">@row.ExtraItems[0].WtsName</div>

                                            }

                                        }

                                        else if (row.ExtraItems.Count > 1)

                                        {
                                            @* [FIX-CLICK] Gắn onclick để xổ/đóng dòng phát sinh — trước chỉ có span tĩnh *@
                                            <span style="font-size:10px;color:#0d6efd;cursor:pointer"
                                                  @onclick="() => row.ShowTimeDetail = !row.ShowTimeDetail">

                                                <i class="bi @(row.ShowTimeDetail ? "bi-chevron-up" : "bi-chevron-down")" style="font-size:10px"></i>

                                                @row.ExtraItems.Count mục — click để xem

                                            </span>

                                        }

                                        else { <span>—</span> }

                                    </small>

                                </td>

                                <td class="text-center small" style="background:#fff8e6">

                                    @(row.ExtraMinutes > 0 ? row.ExtraMinutes.ToString() : "—")

                                </td>

                                <td style="background:#fff8e6">

                                    <small class="text-muted">

                                        @if (row.ExtraItems.Count == 1)

                                        {

                                            @(row.ExtraItems[0].Notes ?? "")

                                        }

                                        else if (row.ExtraItems.Count > 1)

                                        {

                                            <span class="text-muted fst-italic" style="font-size:10px">—</span>

                                        }

                                    </small>

                                </td>

                                <td class="text-center">

                                    @if (IsToday)

                                    {

                                        <button class="btn btn-sm btn-outline-warning py-0 px-1"

                                                @onclick="() => EditSavedRow(row)"

                                                title="Sửa lại">

                                            <i class="bi bi-pencil"></i>

                                        </button>

                                        <button class="btn btn-sm btn-outline-danger py-0 px-1 ms-1"

                                                @onclick="() => ConfirmVoidSavedRow(row)"

                                                title="Xóa WTS này">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    }

                                </td>

                            </tr>

                            @* Dòng phát sinh xổ ra — giống Part Master ──*@

                            @if (row.ShowTimeDetail && row.ExtraItems.Any())

                            {

                                foreach (var ei in row.ExtraItems)

                                {

                                    <tr style="background:#fffbf0;font-size:0.75rem;">

                                        <td class="text-center text-muted" style="padding:2px 4px">

                                            <span style="font-size:9px;color:#9a6700;background:#fff3cd;padding:1px 4px;border-radius:3px">PS</span>

                                        </td>

                                        @* [FIX-COLSPAN] Đổi 10→11: cột thứ 12 là Lý do NG phải nằm trong dải dồn *@
                                        <td colspan="11" class="text-muted" style="padding:2px 8px">—</td>

                                        <td style="background:#fffbf0;padding:2px 6px">

                                            <small>

                                                @if (!string.IsNullOrEmpty(ei.WtsCode))

                                                {

                                                    @ei.WtsCode

                                                    @if (!string.IsNullOrEmpty(ei.WtsName))

                                                    {

                                                        <div style="font-size:10px;color:#6c757d">@ei.WtsName</div>

                                                    }

                                                }

                                                else { <span class="text-muted">—</span> }

                                            </small>

                                        </td>

                                        <td class="text-center" style="background:#fffbf0;padding:2px 6px">

                                            <small>@(ei.Minutes > 0 ? ei.Minutes.ToString() : "—")</small>

                                        </td>

                                        <td style="background:#fffbf0;padding:2px 6px">

                                            <small class="text-muted">@(ei.Notes ?? "")</small>

                                        </td>

                                        <td></td>

                                    </tr>

                                }

                            }

                        }

                        </tbody>

                    </table>

                </div>

            }

            @* ── Nhóm đang nhập mới ── *@

            @foreach (var grp in _groups)

            {

                var grpIdx = _groups.IndexOf(grp);

                var isSerial = grp.ProductionMode == "serial";

                @* ── Header nhóm ── *@

                <div class="border rounded mb-1" style="border-color:var(--bs-border-color)!important">

                    <div class="d-flex align-items-center gap-2 px-3 py-2 flex-wrap"

                         style="background:var(--bs-light,#f8f9fa);border-radius:0.375rem 0.375rem 0 0;border-bottom:0.5px solid #dee2e6">

                        @* Loại sản xuất *@

                        <div>

                            <div style="font-size:10px;color:#6c757d;margin-bottom:2px">Loại</div>

                            <div class="d-flex gap-1">

                                <button type="button" class="@GrpBtnSerialCls(isSerial)"

                                        style="font-size:11px;padding:2px 8px"

                                        @onclick="() => SetGroupModeSerial(grp)">

                                    <i class="bi bi-list-ul me-1"></i>Hàng loạt

                                </button>

                                @* [FIX1] Chạy thử chỉ dùng cho GC — disable với non-GC *@
                                <button type="button" class="@GrpBtnTrialCls(isSerial)"

                                        style="font-size:11px;padding:2px 8px"

                                        disabled="@(!IsGcGroup)"

                                        @onclick="() => SetGroupModeTrial(grp)">

                                    <i class="bi bi-play-circle me-1"></i>Chạy thử

                                </button>

                            </div>

                        </div>

                        @* Toggle tham khảo chuẩn *@

                        <div class="form-check form-switch mb-0 ms-1 align-self-end" style="padding-bottom:4px">

                            <input class="form-check-input" type="checkbox" id="@($"grpStd_{grpIdx}")"

                                   checked="@grp.UseStdAsDefault"

                                   @onchange="e => OnGroupUseStdToggled(grp, e.Value is bool b2 ? b2 : false)" />

                            <label class="form-check-label small text-muted" for="@($"grpStd_{grpIdx}")">

                                Tham khảo chuẩn

                            </label>

                        </div>

                        @* Nút xóa nhóm *@

                        <button class="btn btn-sm btn-outline-danger py-0 px-2 ms-auto"

                                style="font-size:11px" @onclick="() => RemoveGroup(grp)">

                            <i class="bi bi-x-lg"></i>

                        </button>

                    </div>

                    @* ── Bảng sub-rows ── *@

                    <div class="table-responsive" style="padding:8px">

                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.78rem;min-width:900px">

                            <thead>

                                <tr>

                                    <th rowspan="2" style="width:130px">Số PO</th>

                                    <th rowspan="2" style="width:90px">Part No</th>

                                    @if (IsGcGroup)

                                    {

                                        <th rowspan="2" style="width:60px">NC</th>

                                        <th rowspan="2" style="width:70px">Máy SD</th>

                                    }

                                    else

                                    {

                                        @if (IsHtspGroup)

                                        {

                                            <th rowspan="2" style="width:80px">Nhóm nhỏ</th>

                                        }

                                        <th rowspan="2" style="width:130px">Mã CV / Công đoạn</th>

                                    }

                                    <th colspan="4" class="text-center" style="background:#f8f9fa;font-size:10px">Số lượng</th>

                                    <th colspan="3" class="text-center" style="background:#f8f9fa;font-size:10px">Thời gian</th>

                                    @if (IsGcGroup)

                                    {

                                        @if (isSerial)

                                        {

                                            <th colspan="3" class="text-center" style="background:#e6f1fb;font-size:10px;color:#185fa5">Hàng loạt — phút/sp</th>

                                            <th colspan="2" class="text-center" style="background:#f8f9fa;font-size:10px;color:#adb5bd">Chạy thử</th>

                                        }

                                        else

                                        {

                                            <th colspan="3" class="text-center" style="background:#f8f9fa;font-size:10px;color:#adb5bd">Hàng loạt</th>

                                            <th colspan="2" class="text-center" style="background:#faeeda;font-size:10px;color:#854f0b">Chạy thử — phút</th>

                                        }

                                    }

                                    @* [FIX2-MOVED] T.Chuẩn và T.Thực tế — chỉ non-GC, trước Mã WTS PS *@

                                    @if (!IsGcGroup)

                                    {

                                        <th rowspan="2" style="width:60px" class="text-center">T.Chuẩn<br/><small style="font-size:9px">(ph/pc)</small></th>

                                        <th rowspan="2" style="width:60px" class="text-center">T.Thực tế<br/><small style="font-size:9px">(ph/pc)</small></th>

