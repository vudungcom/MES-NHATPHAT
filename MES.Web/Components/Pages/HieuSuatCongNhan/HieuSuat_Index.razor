    // ── Filter phiếu theo nhóm công nhân ─────────────────────

    private async Task BuildSnapshotFilterAsync()

    {

        _hasSnapshotForGroup.Clear();

        if (!_allRows.Any()) return;

        var detailIds = _allRows.Select(r => r.KhPlanDetailId).ToList();

        // Query theo nhóm — chỉ lấy phiếu có snapshot phù hợp

        List<int> withSnap;

        var isAdminOrTech = _groupCode is "ADMIN" or "TECHNICAL";

        if (isAdminOrTech)

        {

            // Thấy tất cả phiếu có bất kỳ snapshot nào

            withSnap = await Db.KhPlanRouteSnapshotMachining

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

        }

        else if (_perms.TryGetValue(SystemPermissions.WtsGc, out var wg) && wg.CanView)

        {

            withSnap = await Db.KhPlanRouteSnapshotMachining

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

        }

        else if (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var wh) && wh.CanView)

        {

            var taro  = await Db.KhPlanRouteSnapshotTaro

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

            var bavia = await Db.KhPlanRouteSnapshotBavia

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

            var rua   = await Db.KhPlanRouteSnapshotWashing

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

            withSnap  = taro.Union(bavia).Union(rua).ToList();

        }

        else if (_perms.TryGetValue(SystemPermissions.WtsKcs, out var wk) && wk.CanView)

        {

            withSnap = await Db.KhPlanRouteSnapshotInspection

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

        }

        else if (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var wd) && wd.CanView)

        {

            withSnap = await Db.KhPlanRouteSnapshotPackaging

                .Where(s => detailIds.Contains(s.KhPlanDetailId))

                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();

        }

        else

        {

            withSnap = new List<int>();

        }

        foreach (var id in withSnap)

            _hasSnapshotForGroup.Add(id);

    }

    // ── Build handover gate: phiếu nhóm này đã nhận hàng ────

    private async Task BuildHandoverFilterAsync()

    {

        _hasReceivedForGroup.Clear();

        if (!_allRows.Any()) return;

        var detailIds = _allRows.Select(r => r.KhPlanDetailId).ToList();

        var groupCode = HandoverGroupCode;

        // Admin thấy tất cả — không cần filter

        if (_groupCode == "ADMIN")

        {

            foreach (var id in detailIds) _hasReceivedForGroup.Add(id);

            return;

        }

        var receivedIds = await HandoverSvc.GetDetailIdsWithReceivedAsync(detailIds, groupCode);

        // [GN-WTS-CAP] Chỉ tính hàng vào SẢN XUẤT của nhóm (Nhận Hàng mới + Hàng lỗi đã xử lý + Làm hộ trả về).
        // Trước: nhận bất kỳ phiếu nào (cả hàng gửi sửa hộ / làm hộ / hàng lỗi bị trả về) là PO hiện ra cho nhóm nhập WTS.
        // Lọc thô bằng truy vấn cũ trước cho nhẹ, rồi mới tính sổ cho các PO đó.
        var ledgers = await LedgerSvc.GetLedgerForDetailsAsync(receivedIds);
        _hasReceivedForGroup = ledgers.Values
            .Where(l => l.G(groupCode).NhanSanXuat > 0)
            .Select(l => l.KhPlanDetailId)
            .ToHashSet();

    }

    // ── Load dòng đã lưu trong ngày ─────────────────────────

    private async Task LoadSavedRowsAsync()

    {

        var start = _workDate.Date;

        var end   = start.AddDays(1);

        var workDate = DateOnly.FromDateTime(_workDate);

        // Loại 1: WtsProductionLogs (link PO/NC)

        var prodLogs = await Db.WtsProductionLogs

            .Include(x => x.Worker)

            .Where(x => x.WorkerId == _currentUserId

                     && x.StartTime >= start && x.StartTime < end

                     && !x.IsVoided)

            .OrderBy(x => x.StartTime)

            .AsNoTracking()

            .ToListAsync();

        // Loại 2: WorkerActivityLogs (không link PO)

        var actLogs = await Db.WorkerActivityLogs

            .Where(x => x.WorkerId == _currentUserId

                     && x.WorkDate == workDate

                     && !x.IsVoided)

            .OrderBy(x => x.StartTime)

            .AsNoTracking()

            .ToListAsync();

        // Gộp và sắp theo StartTime

        var rows = new List<WtsRow>();

        foreach (var log in prodLogs)

        {

            var po = _allRows.FirstOrDefault(r => r.KhPlanDetailId == log.KhPlanDetailId)?.PurchaseOrder;

            rows.Add(new WtsRow

            {

                WtsLogId       = log.WtsLogId,

                KhPlanDetailId = log.KhPlanDetailId,

                StartTime      = log.StartTime,

                EndTime        = log.EndTime,

                PO             = po,

                // [FIX-NONGC-NC] Non-GC không có NC → cột NC hiển thị Mã CV (log.WtsCode).
                // Đồng thời giữ đúng mã khi bấm Sửa dòng (SaveRowAsync lưu row.NC vào WtsCode cho non-GC).
                NC             = log.NC ?? log.WtsCode,
                HtspSubGroup   = log.HtspSubGroup,   // [FIX-NONGC-SUBGROUP] giữ nhóm nhỏ khi Sửa dòng

                PartNo         = _allRows.FirstOrDefault(r => r.KhPlanDetailId == log.KhPlanDetailId)?.PartNo,

                WtsCode        = null,

                WtsName        = null,

                QtyDone        = log.QtyDone,
                ActualTimePerPc = log.ActualTimePerPc,   // [ACTUAL-PC] giữ T.Thực tế/pc khi Sửa dòng

                QtyOk          = log.QtyOk ?? log.QtyDone,   // fallback cho bản ghi cũ

                QtyNg          = log.QtyNg ?? 0m,

                NgReason       = log.NgReason,
                NgCaseId       = log.NgCaseId,   // [VULOI]

                Notes          = log.Notes,

                MachineUsed    = log.MachineUsed,
                // [SERIAL-TIME-REQUIRED] Khôi phục chế độ + T.Thực tế khi bấm Sửa dòng.
                // Trước đây không nạp → dòng Chạy thử mở ra thành Hàng loạt, và bản ghi mới (void + new) mất T.Thực tế.
                // Bản ghi cũ chưa có cột ProductionMode → suy ra: có T.CB / T.Chạy = trial, còn lại = serial.
                ProductionMode         = log.ProductionMode
                                         ?? ((log.PreparationTime_Actual.HasValue || log.TrialRunTime_Actual.HasValue) ? "trial" : "serial"),
                SetupTime_Actual       = log.SetupTime_Actual,
                MachiningTime_Actual   = log.MachiningTime_Actual,
                InspectionTime_Actual  = log.InspectionTime_Actual,
                PreparationTime_Actual = log.PreparationTime_Actual,
                TrialRunTime_Actual    = log.TrialRunTime_Actual,

                // ExtraItems load từ WtsExtraItems DB

                // (sẽ được fill sau khi query — xem LoadExtraItemsAsync)

                ExtraItems     = new List<WtsExtraItem>(),

                IsOvertime     = log.IsOvertime,

                CaId           = log.CaId,

                CaName         = log.CaId.HasValue

                    ? _caList.FirstOrDefault(c => c.CaId == log.CaId)?.TenCa

                    : null,

                Saved          = true,

            });

        }

        // [VULOI] loại lỗi của vụ (để Sửa dòng mở ra đúng loại lỗi đã chọn)
        var _caseIds = rows.Where(r => r.NgCaseId != null).Select(r => r.NgCaseId!.Value).Distinct().ToList();
        if (_caseIds.Any())
        {
            var _caseCat = await Db.NgCases.AsNoTracking().Where(x => _caseIds.Contains(x.NgCaseId))
                                 .Select(x => new { x.NgCaseId, x.NgCategoryId }).ToListAsync();
            foreach (var r in rows.Where(r => r.NgCaseId != null))
                r.NgCategoryId = _caseCat.FirstOrDefault(x => x.NgCaseId == r.NgCaseId)?.NgCategoryId;
            // [DS-LOI-LIVE 2026-10-28] cột Lý do NG hiện tên loại lỗi HIỆN TẠI (DS Lỗi đổi tên → dòng cũ đổi theo); cột NgReason trong DB giữ nguyên
            var _caseLbl = await NgCaseService.GetCaseLabelsAsync(Db, _caseIds.Select(x => (long?)x));
            foreach (var r in rows.Where(r => r.NgCaseId != null))
                r.NgReason = NgCaseService.LiveReason(r.NgCaseId, r.NgReason, _caseLbl);
        }
        foreach (var log in actLogs)

        {

            rows.Add(new WtsRow

            {

                ActivityLogId = log.ActivityLogId,

                StartTime     = log.StartTime,

                EndTime       = log.EndTime,

                PO            = null,

                NC            = null,

                WtsCode       = log.WtsCode,

                WtsName       = log.WtsName,

                QtyDone       = 0,

                Notes         = log.Notes,

                Saved         = true,

            });

        }

        _rows = rows.OrderBy(r => r.StartTime).ToList();

        // Load ExtraItems từ DB cho các dòng đã lưu

        await LoadExtraItemsAsync();

    }

    // Load chi tiết phát sinh (WtsExtraItems) cho tất cả _rows đã saved

    private async Task LoadExtraItemsAsync()

    {

        var wtsLogIds  = _rows.Where(r => r.WtsLogId.HasValue)

                              .Select(r => r.WtsLogId!.Value).ToList();

        var actLogIds  = _rows.Where(r => r.ActivityLogId.HasValue)

                              .Select(r => r.ActivityLogId!.Value).ToList();

        if (!wtsLogIds.Any() && !actLogIds.Any()) return;

        var extraLogs = await Db.WtsExtraItems

            .Where(e => (e.WtsLogId.HasValue    && wtsLogIds.Contains(e.WtsLogId.Value)) ||

                        (e.ActivityLogId.HasValue && actLogIds.Contains(e.ActivityLogId.Value)))

            .ToListAsync();

        foreach (var row in _rows)

        {

            IEnumerable<WtsExtraItemLog> mine;

            if (row.WtsLogId.HasValue)

                mine = extraLogs.Where(e => e.WtsLogId == row.WtsLogId);

            else if (row.ActivityLogId.HasValue)

                mine = extraLogs.Where(e => e.ActivityLogId == row.ActivityLogId);

            else

                continue;

            row.ExtraItems = mine.Select(e => new WtsExtraItem

            {

                WtsCode = e.WtsCode,

                WtsName = e.WtsName,

                Minutes = e.Minutes,

                Notes   = e.Notes,

            }).ToList();

        }

    }

