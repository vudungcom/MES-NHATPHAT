    // Kiểm tra thời gian nằm trong khung ca — cảnh báo realtime (không block)

    private void CheckCaTimeWarning(WtsGroup grp, WtsRow sub)

    {

        sub.ErrorMsg = null;

        if (SelectedCa == null) return; // OT removed 2026-09 — chỉ skip khi chưa chọn ca

        var caStart = _workDate.Date.Add(SelectedCa.GioBatDau.ToTimeSpan());

        var caEnd   = _workDate.Date.Add(SelectedCa.GioKetThuc.ToTimeSpan());

        if (SelectedCa.IsOvernight) caEnd = caEnd.AddDays(1);

        if (sub.StartTime != default && (sub.StartTime < caStart || sub.StartTime > caEnd))

        {

            sub.ErrorMsg = $"⚠ T.Bắt đầu ngoài ca {SelectedCa.TenCa} ({SelectedCa.GioBatDau:HH:mm}–{SelectedCa.GioKetThuc:HH:mm})";

            return;

        }

        if (sub.EndTime != default && sub.EndTime > caEnd)

        {

            sub.ErrorMsg = $"⚠ T.Kết thúc ({sub.EndTime:HH:mm}) vượt ca {SelectedCa.TenCa} (hết lúc {SelectedCa.GioKetThuc:HH:mm}).";

        }

    }

    // Parse "HH:mm", "H:mm" hoặc "HHmm" (4 chữ số liền) — trả false nếu không hợp lệ

    private static bool TryParseHHmm(string? s, out int h, out int m)

    {

        h = m = 0;

        if (string.IsNullOrWhiteSpace(s)) return false;

        var trimmed = s.Trim();

        // Hỗ trợ gõ 4 số liền: "0910" → "09:10", "800" → "08:00"

        if (!trimmed.Contains(':'))

        {

            if (trimmed.Length == 4 &&

                int.TryParse(trimmed[..2], out h) &&

                int.TryParse(trimmed[2..], out m))

                return h is >= 0 and <= 23 && m is >= 0 and <= 59;

            if (trimmed.Length == 3 &&

                int.TryParse(trimmed[..1], out h) &&

                int.TryParse(trimmed[1..], out m))

                return h is >= 0 and <= 23 && m is >= 0 and <= 59;

            return false;

        }

        var parts = trimmed.Split(':');

        if (parts.Length < 2) return false;

        if (!int.TryParse(parts[0], out h) || !int.TryParse(parts[1], out m)) return false;

        return h is >= 0 and <= 23 && m is >= 0 and <= 59;

    }

    // ── Tính lại timeline toàn nhóm ──────────────────────────────────────

    // Hàng đầu: StartTime do user nhập

    // Hàng cuối (nếu chỉ 1 hàng): EndTime tự tính từ cycle × SL

    // Hàng cuối (nếu >1 hàng): EndTime do user nhập

    // Các hàng trung gian: Start = End hàng trước, End = Start + (SL_i / SL_tổng) × tổng_thời_gian

    // [NONGC-ALLOC-WEIGHT] Khối lượng 1 dòng non-GC để chia thời gian; null nếu chưa có T.Thực tế
    private double? GetNonGcAllocWeight(WtsRow sub)
    {
        if (!sub.ActualTimePerPc.HasValue || sub.ActualTimePerPc.Value <= 0) return null;
        var mult = IsPrepNoQty(sub) ? 1m : sub.QtyDone;   // mã không có SL → nhân 1
        return (double)(sub.ActualTimePerPc.Value * mult);
    }

    private void RecalcGroupTimeline(WtsGroup grp)

    {

        // Quy tắc:

        // - 1 hàng: không làm gì — user tự nhập Start và End

        // - Nhiều hàng: user nhập Start hàng đầu + End hàng cuối

        //   Phần mềm tự phân bổ Start/End các hàng trung gian theo tỉ lệ SL

        //   KHÔNG bao giờ override StartTime hàng đầu hoặc EndTime hàng cuối

        if (!grp.SubRows.Any()) return;

        if (grp.SubRows.Count <= 1) return;

        var totalSl = grp.SubRows.Sum(s => s.QtyDone);
        // [NONGC-ALLOC-WEIGHT] Mục 23 — HTSP/KCS/Đóng gói: chia thời gian theo KHỐI LƯỢNG từng dòng
        // = SL (OK+NG) × T.Thực tế/pc; mã CV không có SL (1V/1T/1R/1K/1D/1G) → × 1 (= T.Thực tế tổng phút).
        // Lấy từ ô T.Thực tế (Tham khảo chuẩn chỉ điền sẵn). Trước: chia theo tỉ lệ SL → mã nhanh/chậm chia như nhau.
        // An toàn: dòng nào chưa có T.Thực tế → giữ cách chia theo SL như cũ. GC giữ nguyên cách cũ.
        List<double>? allocWeights = null;
        if (!IsGcGroup)
        {
            var ws = grp.SubRows.Select(GetNonGcAllocWeight).ToList();
            if (ws.All(w => w.HasValue) && ws.Sum(w => w!.Value) > 0)
                allocWeights = ws.Select(w => w!.Value).ToList();
        }
        var totalWeight = allocWeights?.Sum() ?? 0d;
        if (allocWeights == null && totalSl <= 0) return;

        var first = grp.SubRows.First();

        var last  = grp.SubRows.Last();

        if (last.EndTime <= first.StartTime) return;

        // Tổng span = end cuối - start đầu

        var totalSpanMin = (last.EndTime - first.StartTime).TotalMinutes;

        // Nghỉ giải lao: trừ 1 lần cho cả nhóm

        var totalBreakMin = CalcBreakMinutes(first.StartTime, last.EndTime, SelectedCa);

        // T.Phát sinh tổng — trừ ra để còn thời gian sản xuất thuần

        var totalExtraMin = (double)grp.SubRows.Sum(s => s.ExtraMinutes);

        // Thời gian sản xuất thuần để phân bổ

        var totalProdMin = Math.Max(0, totalSpanMin - totalBreakMin - totalExtraMin);

        // Phân bổ cursor qua các hàng trung gian (không đụng hàng đầu và hàng cuối)

        var cursor = first.StartTime;

        for (int i = 0; i < grp.SubRows.Count - 1; i++)

        {

            var sub       = grp.SubRows[i];

            // Hàng đầu (i=0): giữ nguyên StartTime user nhập, chỉ tính EndTime

            // Hàng sau: StartTime = EndTime hàng trước

            if (i > 0) sub.StartTime = cursor;

            else cursor = first.StartTime; // cursor bắt đầu từ start hàng đầu

            // [NONGC-ALLOC-WEIGHT] non-GC: tỉ lệ khối lượng; GC / chưa đủ T.Thực tế: tỉ lệ SL như cũ
            var fraction   = allocWeights != null
                ? allocWeights[i] / totalWeight
                : (totalSl > 0 ? (double)sub.QtyDone / (double)totalSl : 0);

            var subPureMin = totalProdMin * fraction;  // phần sản xuất thuần hàng này

            // End hàng này = cursor + sản xuất thuần + T.Phát sinh hàng này + nghỉ trong khoảng

            var subEnd = cursor.AddMinutes(subPureMin + sub.ExtraMinutes);

            for (int j = 0; j < 3; j++) // hội tụ 3 vòng

            {

                var br = CalcBreakMinutes(cursor, subEnd, SelectedCa);

                subEnd = cursor.AddMinutes(subPureMin + sub.ExtraMinutes + br);

            }

            sub.EndTime = subEnd;

            // Đẩy cursor ra khỏi khoảng nghỉ nếu end rơi vào giờ nghỉ

            cursor = SkipBreaks(sub.EndTime, SelectedCa);

        }

        // Hàng cuối: StartTime = end hàng trước; EndTime giữ nguyên user nhập

        grp.SubRows.Last().StartTime = cursor;

        // KHÔNG đổi EndTime hàng cuối

    }

    // ── Lưu toàn bộ nhóm ─────────────────────────────────────────────────
    // [WTS-SVC 2026-10-29] Toàn bộ phần kiểm thiếu thông tin → khoá máy + trùng giờ → khoá PO + trần + K5 → huỷ dòng cũ + ghi dòng mới
    //   + vụ lỗi + số chuẩn (1 giao dịch) dời NGUYÊN VĂN sang Services/WtsSaveService.SaveGroupAsync (chữ báo y cũ).
    //   Trang chỉ còn: (1) gán thuộc tính nhóm xuống dòng + gom ô nhập & số chuẩn đã tra từ snapshot thành WtsSaveGroup (BuildSaveGroup),
    //   (2) gọi service, (3) đổ lời báo / kết quả về form và nạp lại cache như cũ.
    //   Cảnh báo chỉ hiển thị (đọc cache trang) vẫn tính ở đây: ApplyLegacySaveWarnings.
    private async Task SaveGroupAsync(WtsGroup grp)
    {
        grp.ErrorMsg = null;
        grp.IsSaving = true;
        StateHasChanged();
        try
        {
            // Gán thuộc tính nhóm xuống từng dòng (như vòng validate cũ) — cần trước khi tra số chuẩn theo NC / máy
            foreach (var sub in grp.SubRows)
            {
                sub.ErrorMsg = null;
                sub.NC          = IsGcGroup ? grp.NC : sub.WtsCode;   // [FIX-NONGC-NC]
                if (IsHtspGroup) sub.HtspSubGroup = grp.HtspSubGroup;   // [FIX-NONGC-SUBGROUP]
                sub.MachineUsed = grp.MachineUsed;
                sub.ProductionMode = grp.ProductionMode;
            }
            // Trạng thái cảnh báo trước khi bấm Lưu — lưu không qua thì trả về như cũ ([B2B3-WTS-TRX], [29/10])
            var _warnSnap = grp.SubRows.Select(s => (Row: s, s.HasWarning, s.WarningMsg)).ToList();

            var req = BuildSaveGroup(grp);
            var res = await WtsSaveSvc.SaveGroupAsync(req);

            // Lời báo từng dòng (service ghi vào DTO cùng thứ tự với SubRows)
            for (int i = 0; i < grp.SubRows.Count; i++)
                grp.SubRows[i].ErrorMsg = req.Rows[i].ErrorMsg;

            if (!res.Ok)
            {
                grp.ErrorMsg = res.ErrorMsg;
                foreach (var sn in _warnSnap) { sn.Row.HasWarning = sn.HasWarning; sn.Row.WarningMsg = sn.WarningMsg; }
                foreach (var id in res.DetailIds)
                {
                    // trần + số đã làm trên form về lại số trong DB (giao dịch đã rollback)
                    foreach (var kv in await KhSvc.GetWtsQtySummaryAsync(id)) _qtySummaryCache[$"{id}|{kv.Key}"] = kv.Value;
                    await ReloadFlowAsync(id);
                }
                return;
            }

            for (int i = 0; i < grp.SubRows.Count; i++)
            {
                var s = grp.SubRows[i]; var r = req.Rows[i];
                s.WtsLogId = r.WtsLogId; s.ActivityLogId = r.ActivityLogId; s.NgCaseId = r.NgCaseId; s.IsEditing = r.IsEditing;
                s.Saved = r.Saved; s.HasWarning = r.HasWarning; s.WarningMsg = r.WarningMsg;
            }

            // Nạp lại danh sách dòng đã lưu + cache (phần đuôi của SaveRowAsync cũ, chạy 1 lần cho cả nhóm)
            await AfterGroupSavedRefreshAsync();

            // Xóa nhóm sau khi lưu xong

            // if (grp.IsOvertime) _groupsOT.Remove(grp); // OT removed 2026-09

            _groups.Remove(grp);

            // Reload saved rows + thêm nhóm mới trống nếu muốn

            var unsavedGroups = _groups.ToList();

            await LoadSavedRowsAsync();

            _groups.AddRange(unsavedGroups);
        }
        finally
        {
            grp.IsSaving = false;
            StateHasChanged();
        }
    }

    // [WTS-SVC] Gom ô nhập của 1 nhóm thành DTO cho WtsSaveService — kèm số chuẩn tra sẵn từ snapshot
    // (cùng hàm với phần hiển thị: GetStdTiming / GetStdTimeForSubRow / GetStdSourceForSubRow, như SaveWtsLogStdsAsync cũ).
    private WtsSaveService.WtsSaveGroup BuildSaveGroup(WtsGroup grp)
    {
        var g = new WtsSaveService.WtsSaveGroup
        {
            IsGc = IsGcGroup, IsHtsp = IsHtspGroup, HandoverGroupCode = HandoverGroupCode,
            NC = grp.NC, MachineUsed = grp.MachineUsed, ProductionMode = grp.ProductionMode, HtspSubGroup = grp.HtspSubGroup,
            UserId = _currentUserId, CaId = _selectedCaId, WorkDate = _workDate,
        };
        foreach (var sub in grp.SubRows)
        {
            ApplyLegacySaveWarnings(sub);
            var r = new WtsSaveService.WtsSaveRow
            {
                WtsLogId = sub.WtsLogId, ActivityLogId = sub.ActivityLogId, KhPlanDetailId = sub.KhPlanDetailId,
                StartTime = sub.StartTime, EndTime = sub.EndTime, PO = sub.PO, NC = sub.NC, WtsCode = sub.WtsCode, WtsName = sub.WtsName,
                HtspSubGroup = sub.HtspSubGroup, MachineUsed = sub.MachineUsed,
                QtyDone = sub.QtyDone, QtyOk = sub.QtyOk, QtyNg = sub.QtyNg, NgCategoryId = sub.NgCategoryId, NgCaseId = sub.NgCaseId,
                Notes = sub.Notes, IsOvertime = sub.IsOvertime,
                SetupTime_Actual = sub.SetupTime_Actual, MachiningTime_Actual = sub.MachiningTime_Actual, InspectionTime_Actual = sub.InspectionTime_Actual,
                PreparationTime_Actual = sub.PreparationTime_Actual, TrialRunTime_Actual = sub.TrialRunTime_Actual,
                ActualTimePerPc = sub.ActualTimePerPc, ProductionMode = sub.ProductionMode, IsEditing = sub.IsEditing,
                HasWarning = sub.HasWarning, WarningMsg = sub.WarningMsg,
            };
            foreach (var ei in sub.ExtraItems)
                r.ExtraItems.Add(new WtsSaveService.WtsSaveExtra { WtsCode = ei.WtsCode, WtsName = ei.WtsName, Minutes = ei.Minutes, Notes = ei.Notes });
            if (IsGcGroup)
            {
                var std = sub.KhPlanDetailId.HasValue ? GetStdTiming(sub.KhPlanDetailId.Value, sub.NC, sub.MachineUsed) : null;
                if (std != null)
                    r.GcStd = new WtsSaveService.WtsSaveStd
                    {
                        SetupTime = std.SetupTime, MachiningTime = std.MachiningTime, InspectionTime = std.InspectionTime,
                        PreparationTime = std.PreparationTime, TrialRunTime = std.TrialRunTime, SrcTable = std.SrcTable, SrcRowId = std.SrcRowId,
                    };
            }
            else
            {
                r.StdTimePerPc = GetStdTimeForSubRow(sub);
                var src = GetStdSourceForSubRow(sub);
                if (src != null) { r.StdSrcTable = src.Value.Table; r.StdSrcRowId = src.Value.RowId; }
            }
            g.Rows.Add(r);
        }
        return g;
    }

    // [WTS-SVC] Cảnh báo CHỈ HIỂN THỊ của SaveRowAsync cũ (Loại 1: có NC + PO), đọc cache trang (_allRows, _ncFlowCache) nên giữ ở trang.
    // Nguyên văn 3 khối: "Chưa chọn máy" → tổng giờ thực tế vượt ca → CheckQtyWarning → NC máy loại trừ. Không ảnh hưởng dữ liệu ghi DB.
    private void ApplyLegacySaveWarnings(WtsRow row)
    {
        if (string.IsNullOrEmpty(row.NC) || row.KhPlanDetailId == null) return;

        // Khuyến nghị chọn máy — cảnh báo nhưng vẫn cho save

        // [FIX-NONGC-MACHINE] Chỉ GC mới có máy — non-GC không cảnh báo "Chưa chọn máy"
        if (IsGcGroup && string.IsNullOrEmpty(row.MachineUsed))

        {

            row.HasWarning = true;

            row.WarningMsg = (row.WarningMsg ?? "") + " Chưa chọn máy sử dụng.";

        }

        // Cảnh báo tổng thời gian thực tế — dùng đúng công thức: T.Gá + max(T.GC, T.Ktra)

        var _actualSum = (row.SetupTime_Actual ?? 0)

                       + Math.Max(row.MachiningTime_Actual ?? 0, row.InspectionTime_Actual ?? 0);

        if (_actualSum > row.Minutes && row.Minutes > 0)

            row.WarningMsg = (row.WarningMsg ?? "") + $" Tổng thời gian thực tế ({_actualSum} phút) vượt quá thời gian ca ({row.Minutes} phút).";

        CheckQtyWarning(row);

        // Warn thêm nếu NC loại trừ (không block)

        if (GetFlowItem(row.KhPlanDetailId, row.NC)?.IsExcluded == true)

        {

            row.HasWarning = true;

            row.WarningMsg = (row.WarningMsg ?? "") + $" NC {row.NC} dùng máy loại trừ — thường do nhóm HTSP thực hiện.";

        }
    }

