@page "/hieu-suat-cong-nhan"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using MES.Web.Data
@using MES.Web.Data.Entities
@using MES.Web.Services
@using MES.Web.Constants
@inject AppDbContext Db
@inject KhPlanService KhSvc
@inject StandardWtsTaskService WtsSvc
@inject UserService UserSvc
@inject HandoverService HandoverSvc
@inject ThietBiService ThietBiSvc
@inject WtsReportService ReportSvc
@inject AuthenticationStateProvider AuthState

<PageTitle>Nhập WTS - MES</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Nhập WTS Sản xuất</h1>
        <p class="text-muted small mb-0">Ghi nhận công việc theo timeline ca làm — mỗi dòng = 1 khoảng thời gian</p>
    </div>
    @if (_currentWorker != null)
    {
        <div class="text-end">
            <span class="badge bg-primary fs-6 px-3">@_currentWorker.FullName</span><br />
            <small class="text-muted">@(_currentWorker.Group?.GroupName ?? _currentWorker.Group?.GroupCode)</small>
        </div>
    }
</div>

@* ── Tab switcher ── *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="@_TabInputCls" @onclick="SetTabInput">
            <i class="bi bi-pencil-square me-1"></i>Nhập WTS
        </button>
    </li>
    @if (_canViewReport)
    {
        <li class="nav-item">
            <button class="@_TabReportCls" @onclick="SwitchToReport">
                <i class="bi bi-bar-chart-line me-1"></i>WTS Report
            </button>
        </li>
    }
</ul>

@if (!_canSubmit)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-exclamation"></i>
        Tài khoản chưa được phân nhóm sản xuất. Vui lòng liên hệ Admin.
    </div>
}
else
{
    @* ── Header: Chọn ngày + tổng phút ── *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="form-label small mb-0 fw-semibold">Ngày làm việc</label>
                    <input type="date" class="form-control form-control-sm" style="width:150px;"
                           @bind="_workDate" @bind:after="OnWorkDateChanged" />
                </div>
                <div class="col-auto ms-auto d-flex flex-column gap-1">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleNoSnap"
                               @bind="_showWithoutSnapshot" />
                        <label class="form-check-label small" for="toggleNoSnap">
                            Hiện phiếu chưa có quy trình
                            <i class="bi bi-info-circle text-muted ms-1"
                               title="Mặc định chỉ hiện phiếu đã có quy trình từ Part Master (snapshot). Bật tùy chọn này để thấy phiếu chưa đủ quy trình — cẩn thận: công nhân sẽ không thấy NC cần làm, dễ nhầm lẫn. Chỉ dùng khi Kỹ thuật chưa cập nhật Part Master kịp."></i>
                        </label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleNoHandover"
                               @bind="_showWithoutHandover" />
                        <label class="form-check-label small" for="toggleNoHandover">
                            Hiện phiếu chưa nhận hàng
                            <i class="bi bi-exclamation-triangle text-warning ms-1"
                               title="Mặc định chỉ hiện phiếu mà kho/nhóm trước đã bàn giao hàng sang nhóm này. Bật để thấy tất cả — cẩn thận: nhóm chưa nhận hàng không nên nhập WTS."></i>
                        </label>
                    </div>
                </div>
                <div class="col">
                    @{
                        var totalMin = _rows.Where(r => r.Saved).Sum(r => r.Minutes);
                        var pct = Math.Min(100, (int)(totalMin / 4.8));
                        var barColor = pct >= 100 ? "success" : (pct >= 60 ? "warning" : "danger");
                    }
                    <div class="d-flex align-items-center gap-3 mt-3">
                        <span class="small fw-semibold">Tổng hôm nay:</span>
                        <span class="fw-bold @(totalMin >= 480 ? "text-success" : "text-warning")">
                            @totalMin / 480 phút
                        </span>
                        <div class="progress flex-grow-1" style="height:12px; max-width:300px;">
                            <div class="progress-bar bg-@barColor" style="width:@pct%"></div>
                        </div>
                        <span class="small text-muted">@pct%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Bảng timeline ── *@
    <div class="card mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-clock me-1"></i> Timeline ca làm việc</span>
            <div class="d-flex align-items-center gap-2">
                @if (!IsToday)
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-lock me-1"></i>Ngày cũ — chỉ xem
                    </span>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="AddRow" disabled="@(!IsToday)">
                    <i class="bi bi-plus-lg me-1"></i>Thêm dòng
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.82rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width:100px;">T.Bắt đầu</th>
                            <th style="width:100px;">T.Kết thúc</th>
                            <th style="width:60px;" class="text-center">Phút</th>
                            <th style="width:180px;">PO <span class="text-muted fw-normal">(tùy chọn)</span></th>
                            <th style="width:110px;">Part No</th>
                            @if (IsHtspGroup)
                            {
                                <th style="width:100px;">Nhóm</th>
                            }
                            <th style="width:@(IsGcGroup ? "120px" : "160px");">@(IsGcGroup ? "NC / Mục" : "Mã công việc")</th>
                            @if (IsGcGroup)
                            {
                                <th style="width:100px;">Máy SD <span class="text-danger">*</span></th>
                            }
                            <th style="width:180px;">Mã WTS khác <span class="text-muted fw-normal">(nếu không có PO)</span></th>
                            <th style="width:62px;" class="text-end text-success" title="Số lượng làm đúng">OK</th>
                            <th style="width:62px;" class="text-end text-danger" title="Số lượng làm sai phát hiện tại NC">NG</th>
                            @if (!IsGcGroup)
                            {
                                <th class="text-center text-muted" style="width:60px;font-size:0.75rem;" title="Thời gian chuẩn (phút)">T.Chuẩn<br/><span style="font-size:0.65rem;">(phút)</span></th>
                                <th class="text-center" style="width:60px;font-size:0.75rem;color:#0d6efd;" title="Thời gian thực tế = T.Kết thúc - T.Bắt đầu (phút)">T.Thực tế<br/><span style="font-size:0.65rem;">(phút)</span></th>
                            }
                            <th style="width:140px;" class="text-danger" title="Lý do NG (bắt buộc khi có NG)">Lý do NG</th>
                            <th>Ghi chú</th>
                            <th style="width:80px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            var idx = _rows.IndexOf(row);
                            @if (row.Saved)
                            {
                                @* Dòng đã lưu — hiện read-only *@
                                <tr class="@(row.HasWarning ? "table-warning" : "table-success bg-opacity-10")">
                                    <td class="text-center">@row.StartTime.ToString("HH:mm")</td>
                                    <td class="text-center">@row.EndTime.ToString("HH:mm")</td>
                                    <td class="text-center fw-bold">@row.Minutes</td>
                                    <td><code class="small">@(row.PO ?? "—")</code></td>
                                    <td title="@(row.PartNo ?? "")"><code class="small text-danger">@(row.PartNo ?? "—")</code></td>
                                    @if (IsHtspGroup)
                                    {
                                        <td><span class="small text-muted">@(row.HtspSubGroup ?? "—")</span></td>
                                    }
                                    <td title="@(row.NC ?? row.WtsCode ?? "")"><code class="small">@(row.NC ?? row.WtsCode ?? "—")</code></td>
                                    @if (IsGcGroup)
                                    {
                                        <td><code class="small text-primary">@(row.MachineUsed ?? "—")</code></td>
                                    }
                                    <td class="small text-muted">@row.WtsName</td>
                                    <td class="text-end text-success fw-semibold">@(row.QtyOk > 0 ? row.QtyOk.ToString("0.##") : "—")</td>
                                    <td class="text-end @(row.QtyNg > 0 ? "text-danger fw-semibold" : "text-muted")">@(row.QtyNg > 0 ? row.QtyNg.ToString("0.##") : "—")</td>
                                    @if (!IsGcGroup)
                                    {
                                        <td class="text-center text-muted small">—</td>
                                        <td class="text-center small" style="color:#0d6efd;">@(row.Minutes > 0 ? row.Minutes.ToString() : "—")</td>
                                    }
                                    <td class="small @(row.QtyNg > 0 ? "text-danger" : "text-muted")">
                                        @if (row.QtyNg > 0 && !string.IsNullOrEmpty(row.NgReason))
                                        {
                                            <span title="@row.NgReason"><i class="bi bi-exclamation-circle me-1"></i>@row.NgReason</span>
                                        }
                                        else { <span>—</span> }
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(row.Notes) ? "—" : row.Notes)</td>
                                    <td class="text-center text-nowrap">
                                        @if (row.HasWarning)
                                        {
                                            <span class="badge bg-warning text-dark me-1" title="@row.WarningMsg">
                                                <i class="bi bi-exclamation-triangle"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                                        }
                                        @if (IsToday)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                    title="Sửa dòng này (chỉ cho phép trong ngày)"
                                                    @onclick="() => EditRow(row)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="Ngày cũ — cần quyền cao hơn để sửa">
                                                <i class="bi bi-lock"></i>
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @* Dòng đang nhập *@
                                <tr class="@(!string.IsNullOrEmpty(row.ErrorMsg) ? "table-danger bg-opacity-10" : "")">
                                    @* T.Bắt đầu *@
                                    <td>
                                        <input type="time" class="form-control form-control-sm"
                                               value="@row.StartTime.ToString("HH:mm")"
                                               @onchange="e => OnTimeChanged(row, true, e.Value?.ToString())" />
                                    </td>
                                    @* T.Kết thúc *@
                                    <td>
                                        <input type="time" class="form-control form-control-sm"
                                               value="@row.EndTime.ToString("HH:mm")"
                                               @onchange="e => OnTimeChanged(row, false, e.Value?.ToString())" />
                                    </td>
                                    @* Phút tự tính *@
                                    <td class="text-center fw-bold @(row.Minutes < 0 ? "text-danger" : "")">
                                        @(row.Minutes >= 0 ? row.Minutes.ToString() : "!")
                                    </td>
                                    @* PO *@
                                    <td>
                                        <select class="form-select form-select-sm"
                                                @onchange="e => OnPOChanged(row, e.Value?.ToString())">
                                            <option value="">-- Không chọn PO --</option>
                                            @foreach (var r in PriorityRows)
                                            {
                                                var label = $"{(r.Priority == "Gấp" ? "🔴 " : "")}{r.PurchaseOrder} — {r.PartNo} ({r.Quantity.ToString("0.##")} {r.Unit}, STD: {r.STD.ToString("dd/MM")})";
                                                <option value="@r.PurchaseOrder">@label</option>
                                            }
                                        </select>
                                    </td>
                                    @* Part No — tự lấy từ PO đã chọn *@
                                    <td>
                                        <input class="form-control form-control-sm font-monospace text-danger bg-light"
                                               value="@(row.PartNo ?? "—")" readonly />
                                    </td>
                                    @* Nhóm nhỏ — chỉ hiện cho HTSP *@
                                    @if (IsHtspGroup)
                                    {
                                        <td>
                                            @if (string.IsNullOrEmpty(row.PO))
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm"
                                                        value="@row.HtspSubGroup"
                                                        @onchange="e => OnHtspSubGroupChanged(row, e.Value?.ToString())">
                                                    <option value="">-- Chọn nhóm --</option>
                                                    <option value="Taro">Taro</option>
                                                    <option value="Bavia">Bavia</option>
                                                    <option value="Rua">Rửa</option>
                                                </select>
                                            }
                                        </td>
                                    }
                                    @* NC / Mã công việc *@
                                    <td>
                                        @if (string.IsNullOrEmpty(row.PO))
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                        else if (IsGcGroup)
                                        {
                                            @* GC: dropdown NC từ Machining snapshot *@
                                            @if (!row.AvailableNCs.Any())
                                            {
                                                <span class="text-warning small"><i class="bi bi-exclamation-triangle"></i> Chưa có snapshot</span>
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm"
                                                        @onchange="e => OnNCChanged(row, e.Value?.ToString())">
                                                    <option value="">-- Chọn NC --</option>
                                                    @foreach (var nc in row.AvailableNCs.Where(n => !n.IsBackup))
                                                    {
                                                        var flow        = GetFlowItem(row.KhPlanDetailId, nc.NC);
                                                        var wtsDoneAtNc = flow?.WtsDone ?? 0m;
                                                        var det         = _allRows.FirstOrDefault(r => r.KhPlanDetailId == row.KhPlanDetailId);
                                                        var planQty     = det?.Quantity ?? 0m;
                                                        var isDone      = planQty > 0 && wtsDoneAtNc >= planQty;
                                                        var isExcluded  = flow?.IsExcluded == true;
                                                        var regMachine  = nc.MachineRegistered ?? "";
                                                        var altMachines = GetAltMachinesFromTimingRows(nc.TimingRows);
                                                        var regBroken    = !string.IsNullOrEmpty(regMachine) && _brokenMachines.Contains(regMachine);
                                                        var allAltBroken = altMachines.Length > 0 && altMachines.All(m => _brokenMachines.Contains(m));
                                                        var machineBlocked = regBroken && (altMachines.Length == 0 || allAltBroken);
                                                        var isDisabled = isDone || machineBlocked;
                                                        var lbl = BuildNcLabel(isDone, machineBlocked, isExcluded, regBroken, altMachines, nc.NC, regMachine, planQty, det?.Unit, wtsDoneAtNc);
                                                        <option value="@nc.NC" disabled="@isDisabled">@lbl</option>
                                                    }
                                                    @foreach (var nc in row.AvailableNCs.Where(n => n.IsBackup))
                                                    {
                                                        var dpMachine = nc.MachineRegistered ?? "";
                                                        var dpBroken  = !string.IsNullOrEmpty(dpMachine) && _brokenMachines.Contains(dpMachine);
                                                        var dpLbl     = dpBroken ? $"⛔ DP: NC{nc.NC} — {dpMachine} ĐANG HỎNG" : $"↩ DP: NC{nc.NC} — {dpMachine}";
                                                        <option value="@nc.NC" disabled="@dpBroken">@dpLbl</option>
                                                    }
                                                </select>
                                            }
                                        }
                                        else
                                        {
                                            @* HTSP/KCS/PKG: dropdown mã CV từ snapshot tương ứng *@
                                            @if (IsHtspGroup && string.IsNullOrEmpty(row.HtspSubGroup))
                                            {
                                                <span class="text-muted small">← Chọn nhóm trước</span>
                                            }
                                            else if (!row.AvailableWtsItems.Any())
                                            {
                                                <span class="text-warning small"><i class="bi bi-exclamation-triangle"></i> Chưa có dữ liệu</span>
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm"
                                                        title="@GetWtsItemTitle(row)"
                                                        @onchange="e => OnWtsItemChanged(row, e.Value?.ToString())">
                                                    <option value="">-- Chọn mã CV --</option>
                                                    @foreach (var item in row.AvailableWtsItems)
                                                    {
                                                        <option value="@item.NC" selected="@(row.NC == item.NC)" title="@item.NC — @item.Name">@item.NC — @item.Name</option>
                                                    }
                                                </select>
                                            }
                                        }
                                    </td>
                                    @* Máy sử dụng — chỉ hiện cho nhóm GC *@
                                    @if (IsGcGroup)
                                    {
                                    <td>
                                        @if (!string.IsNullOrEmpty(row.NC) && row.AvailableNCs.Any())
                                        {
                                            <select class="form-select form-select-sm @(string.IsNullOrEmpty(row.MachineUsed) ? "border-danger" : "")"
                                                    @bind="row.MachineUsed">
                                                <option value="">-- Chọn máy --</option>
                                                @foreach (var m in GetMachineOptions(row))
                                                {
                                                    var isBroken = _brokenMachines.Contains(m);
                                                    <option value="@m" disabled="@isBroken">
                                                        @(isBroken ? $"⛔ {m} (hỏng)" : m)
                                                    </option>
                                                }
                                            </select>
                                            @if (string.IsNullOrEmpty(row.MachineUsed))
                                            {
                                                <div style="font-size:10px" class="text-danger">Bắt buộc chọn máy</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    }

                                    @* Mã WTS khác — datalist pattern giống Part Master máy đăng ký *@
                                    <td>
                                        @if (string.IsNullOrEmpty(row.PO))
                                        {
                                            var dlId = $"dl-wts-{_rows.IndexOf(row)}";
                                            <input class="form-control form-control-sm"
                                                   list="@dlId"
                                                   value="@row.WtsCode"
                                                   placeholder="Gõ mã hoặc tên..."
                                                   @oninput="e => OnWtsCodeInput(row, e)" />
                                            <datalist id="@dlId">
                                                @foreach (var t in WtsTasksForGroup)
                                                {
                                                    <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option>
                                                }
                                            </datalist>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic ps-1">— (đã chọn PO)</span>
                                        }
                                    </td>
                                    @* OK *@
                                    <td>
                                        <input type="number" step="1" min="0" class="form-control form-control-sm text-end"
                                               style="border-color:#198754"
                                               value="@row.QtyOk"
                                               @oninput="e => OnQtyOkInput(row, e)"
                                               placeholder="0" title="Số lượng OK" />
                                    </td>
                                    @* NG *@
                                    <td>
                                        <input type="number" step="1" min="0" class="form-control form-control-sm text-end"
                                               style="@(row.QtyNg > 0 ? "border-color:#dc3545" : "")"
                                               value="@row.QtyNg"
                                               @oninput="e => OnQtyNgInput(row, e)"
                                               placeholder="0" title="Số lượng NG phát hiện tại NC" />
                                    </td>
                                    @* T.Chuẩn và T.Thực tế — chỉ non-GC *@
                                    @if (!IsGcGroup)
                                    {
                                        var stdTime = GetStdTimeForWtsCode(row);
                                        <td class="text-center text-muted small">
                                            @(stdTime.HasValue ? stdTime.Value.ToString("0.##") : "—")
                                        </td>
                                        <td class="text-center fw-semibold small" style="color:#0d6efd;">
                                            @(row.Minutes > 0 ? row.Minutes.ToString() : "—")
                                        </td>
                                    }
                                    @* Lý do NG *@
                                    <td>
                                        <input class="form-control form-control-sm"
                                               style="@(row.QtyNg > 0 ? "border-color:#dc3545" : "")"
                                               @bind="row.NgReason"
                                               placeholder="@(row.QtyNg > 0 ? "Lý do NG *" : "Lý do NG")"
                                               title="Bắt buộc khi có NG" />
                                    </td>
                                    @* Ghi chú *@
                                    <td>
                                        <input class="form-control form-control-sm"
                                               @bind="row.Notes" placeholder="Ghi chú..." />
                                    </td>
                                    @* Thao tác *@
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-success py-0 px-2 me-1"
                                                @onclick="() => SaveRowAsync(row)"
                                                title="Lưu dòng này">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                @onclick="() => RemoveRow(row)"
                                                title="Xóa dòng">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                @* Bảng thời gian Chuẩn/Thực tế — luôn hiện *@
                                @if (!string.IsNullOrEmpty(row.NC) && IsGcGroup)
                                {
                                    var std = row.KhPlanDetailId.HasValue
                                        ? GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed)
                                        : null;
                                    <tr class="bg-info bg-opacity-10">
                                        <td colspan="13" class="py-2 px-3">
                                            <div class="d-flex align-items-center gap-3 mb-2">
                                                <span class="small fw-semibold text-info">
                                                    <i class="bi bi-clock me-1"></i>Thời gian (phút) —
                                                    Tổng ca: <strong>@row.Minutes</strong> |
                                                    Đã phân bổ: <strong class="@(row.TimeActualSum > row.Minutes ? "text-danger" : "text-success")">@row.TimeActualSum</strong> |
                                                    Còn lại: <strong class="@(row.TimeActualRemaining < 0 ? "text-danger" : "")">@row.TimeActualRemaining</strong>
                                                </span>
                                                @if (!string.IsNullOrEmpty(row.MachineUsed) && std == null)
                                                {
                                                    <span class="small text-muted fst-italic">
                                                        <i class="bi bi-info-circle me-1"></i>Chưa có TG chuẩn cho máy @row.MachineUsed
                                                    </span>
                                                }
                                            </div>
                                            <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem; max-width:700px;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:80px;"></th>
                                                        <th class="text-center">T.Gá lắp</th>
                                                        <th class="text-center">T.Gia công</th>
                                                        <th class="text-center">T.Kiểm tra</th>
                                                        <th class="text-center">T.Chuẩn bị</th>
                                                        <th class="text-center">T.Chạy thử</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* Hàng Chuẩn — read-only, tự điền từ timing row *@
                                                    <tr class="table-primary bg-opacity-25">
                                                        <td class="fw-semibold text-primary small">Chuẩn</td>
                                                        <td class="text-center text-primary">@(std?.SetupTime?.ToString("0.##") ?? "—")</td>
                                                        <td class="text-center text-primary">@(std?.MachiningTime?.ToString("0.##") ?? "—")</td>
                                                        <td class="text-center text-primary">@(std?.InspectionTime?.ToString("0.##") ?? "—")</td>
                                                        <td class="text-center text-primary">@(std?.PreparationTime?.ToString("0.##") ?? "—")</td>
                                                        <td class="text-center text-primary">@(std?.TrialRunTime?.ToString("0.##") ?? "—")</td>
                                                    </tr>
                                                    @* Hàng Thực tế — input *@
                                                    <tr>
                                                        <td class="fw-semibold small">Thực tế</td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm text-end" min="0"
                                                                   @bind="row.SetupTime_Actual" placeholder="0" />
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm text-end" min="0"
                                                                   @bind="row.MachiningTime_Actual" placeholder="0" />
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm text-end" min="0"
                                                                   @bind="row.InspectionTime_Actual" placeholder="0" />
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm text-end" min="0"
                                                                   @bind="row.PreparationTime_Actual" placeholder="0" />
                                                        </td>
                                                        <td>
                                                            <input type="number" class="form-control form-control-sm text-end" min="0"
                                                                   @bind="row.TrialRunTime_Actual" placeholder="0" />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            @if (row.TimeActualSum > row.Minutes)
                                            {
                                                <div class="text-danger small mt-1">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                    Tổng TG thực tế (@row.TimeActualSum phút) vượt quá thời gian ca (@row.Minutes phút).
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(row.ErrorMsg))
                                {
                                    <tr class="table-danger">
                                        <td colspan="13" class="small text-danger py-1 ps-3">
                                            <i class="bi bi-exclamation-triangle me-1"></i>@row.ErrorMsg
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        @if (!_rows.Any())
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted py-3 fst-italic">
                                    Chưa có dòng nào. Bấm "Thêm dòng" để bắt đầu ghi WTS.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Bảng quy trình snapshot — hiện khi có PO đang chọn ── *@
    @if (GetActivePO() != null)
    {
        var activePO = GetActivePO()!;
        var activeFull = _fullSnapshotCache.ContainsKey(activePO)
            ? _fullSnapshotCache[activePO] : null;
        var activeMachining = _snapshotCache.ContainsKey(activePO)
            ? _snapshotCache[activePO]
            : activeFull?.Machining ?? new List<KhPlanRouteSnapshotMachining>();
        var activeDetail = _allRows.FirstOrDefault(r => r.PurchaseOrder == activePO);
        var planQty = activeDetail?.Quantity ?? 0m;
        if (activeMachining.Any() || activeFull != null)
        {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
