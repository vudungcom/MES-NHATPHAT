    // ── Nhập PO cho sub-row — lọc datalist + auto-match ──

    private async Task OnSubPoInput(WtsGroup grp, WtsRow sub, string? text)

    {

        sub.PoFilter = text ?? "";

        sub.PO       = text ?? "";

        // Tìm exact match

        var det = _allRows.FirstOrDefault(r =>

            r.PurchaseOrder.Equals(text ?? "", StringComparison.OrdinalIgnoreCase));

        // [B5-PODUP 2026-10-28] Số PO trùng nhiều dòng KH (dữ liệu cũ) → không tự chọn dòng đầu (ghi nhầm PO).
        //   [29/10] Đếm theo dòng KH khác nhau (danh sách nối Kho có thể lặp 1 dòng KH); nhóm đã có Part No thì lấy đúng dòng cùng Part.
        var _poCands = _allRows.Where(r => r.PurchaseOrder.Equals(text ?? "", StringComparison.OrdinalIgnoreCase))
                               .GroupBy(r => r.KhPlanDetailId).Select(g => g.First()).ToList();
        if (_poCands.Count > 1 && !string.IsNullOrEmpty(grp.PartNo))
            _poCands = _poCands.Where(r => r.PartNo == grp.PartNo).ToList();
        if (_poCands.Count > 1)
        {
            sub.ErrorMsg = $"Số PO {text} có {_poCands.Count} dòng trong Kế hoạch ({string.Join(", ", _poCands.Select(r => r.PartNo + " · " + r.PlanNo))}) — "
                         + "nếu dòng khác trong nhóm đã có PO cùng Part thì phần mềm tự chọn đúng; còn không, báo quản trị xử lý PO trùng số (dữ liệu cũ).";
            det = null;
        }
        else
        {
            det = _poCands.FirstOrDefault() ?? det;
            if (sub.ErrorMsg != null && sub.ErrorMsg.Contains("dòng trong Kế hoạch")) sub.ErrorMsg = null;
        }

        if (det != null)

        {

            await OnSubRowKhChanged(grp, sub, det.KhPlanDetailId.ToString());

        }

        else

        {

            // [FIX-PO-CLEAR] PO là ô gốc của dòng → xoá / sửa PO thì xoá theo mọi ô phụ thuộc PO (chỉ khi dòng đang có KH,
            // để lúc đang gõ dở không reset lặp lại). Giữ: giờ bắt đầu/kết thúc, phát sinh (Mã WTS PS / T.PS / Nội dung PS).
            var hadKh = sub.KhPlanDetailId.HasValue;
            sub.KhPlanDetailId = null;
            sub.PartNo         = null;
            if (hadKh)
            {
                sub.NC = null; sub.MachineUsed = null;
                sub.WtsCode = null; sub.WtsName = null;
                sub.QtyOk = 0; sub.QtyNg = 0; sub.QtyDone = 0; sub.NgReason = null; sub.NgCategoryId = null;   // [VULOI]
                sub.SetupTime_Actual = null; sub.MachiningTime_Actual = null; sub.InspectionTime_Actual = null;
                sub.PreparationTime_Actual = null; sub.TrialRunTime_Actual = null;
                sub.ActualTimePerPc = null;
                sub.AvailableNCs = new();
                sub.ErrorMsg = null;
            }
            // Nhóm không còn dòng nào có KH → xoá luôn các ô cấp nhóm (Part No lọc PO, NC, Máy, nhóm nhỏ, danh sách NC / Mã CV).
            // Trước đây grp.PartNo giữ PartNo của PO cũ → datalist chỉ còn PO cùng Part, phải F5 mới hiện lại đủ.
            if (!grp.SubRows.Any(s => s.KhPlanDetailId.HasValue))
            {
                grp.PartNo = null;
                grp.NC = null;
                grp.MachineUsed = null;
                grp.HtspSubGroup = "";
                grp.AvailableNCs = new();
                grp.WtsItems = new();
            }

        }

        StateHasChanged();

    }

    // ── Chọn KH cho sub-row ──

    private async Task OnSubRowKhChanged(WtsGroup grp, WtsRow sub, string? detailIdStr)

    {

        sub.ErrorMsg = null;

        if (!int.TryParse(detailIdStr, out var detId)) { sub.KhPlanDetailId = null; sub.PO = null; sub.PartNo = null; return; }

        var det = _allRows.FirstOrDefault(r => r.KhPlanDetailId == detId);

        if (det == null) return;

        sub.KhPlanDetailId = detId;

        sub.PO             = det.PurchaseOrder;

        sub.PartNo         = det.PartNo;

        sub.NC             = grp.NC;
        if (IsHtspGroup) sub.HtspSubGroup = grp.HtspSubGroup;   // [FIX-NONGC-SUBGROUP] kế thừa nhóm nhỏ của nhóm

        sub.MachineUsed    = grp.MachineUsed;

        sub.ProductionMode = grp.ProductionMode;

        // Nếu PartNo chưa set ở nhóm → lấy từ hàng đầu

        if (string.IsNullOrEmpty(grp.PartNo)) grp.PartNo = det.PartNo;

        // Load snapshot mới nhất từ DB (luôn reload để bắt thay đổi từ Kế hoạch)

        await EnsureSnapshotAsync(det.PurchaseOrder, det.KhPlanDetailId);

        // Load WTS logs mới nhất cho bảng snapshot

        await ReloadWtsLogsAsync(det.PurchaseOrder, det.KhPlanDetailId);

        // [FIX] Load NC flow để IsNcLockedByWorkflow đọc được WtsDone NC trước — thiếu dòng này

        // khiến _ncFlowCache rỗng → GetFlowItem = null → WtsDone = 0 → NC sau bị lock oan

        await ReloadFlowAsync(det.KhPlanDetailId);

        // Cập nhật AvailableNCs cho nhóm từ snapshot

        if (_snapshotCache.TryGetValue(det.PurchaseOrder, out var snaps))

        {

            grp.AvailableNCs = snaps;

            sub.AvailableNCs = snaps;

        }

        // Load WtsItems cho non-GC từ snapshot

        if (!IsGcGroup && _fullSnapshotCache.TryGetValue(det.PurchaseOrder, out var fullSnap))

        {

            if (HandoverGroupCode == "KCS")

                grp.WtsItems = fullSnap.Inspection

                    .Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();

            else if (HandoverGroupCode == "PKG")

                grp.WtsItems = fullSnap.Packaging

                    .Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();

            // HTSP: load theo subgroup sau khi user chọn (OnGroupHtspSubChanged)

        }

        // [GN-WTS-CAP] Bỏ nạp _receivedOkCache ([BUG4 FIX] cũ) — sổ giao nhận đã nạp trong ReloadFlowAsync ở trên.

        // [FIX-STD-COLOR-GROUP] Populate _poStdConfirmed để markup gcStdColor / stdConfirmed
        // hiển thị đúng màu xanh khi Part Master đã xác nhận OK.
        // OnPOChanged đã làm việc này cho flow cũ; OnSubRowKhChanged (flow nhóm) thì chưa.
        if (!_poStdConfirmed.ContainsKey(det.PurchaseOrder))
        {
            var pmStd = await Db.PartMasters.FirstOrDefaultAsync(p => p.PartNo == det.PartNo);
            if (pmStd != null)
            {
                await EnsureTimingStdAsync(det.KhPlanDetailId, pmStd.PartId);
                _poStdConfirmed[det.PurchaseOrder] = IsGcGroup           ? pmStd.IsMachiningConfirmed
                    : IsHtspGroup                                         ? pmStd.IsHtspConfirmed
                    : HandoverGroupCode == "KCS"                          ? pmStd.IsKcsConfirmed
                    :                                                        pmStd.IsPkgConfirmed;
            }
        }

        // [STD-CONFIRM-ROW] Non-GC: nạp các dòng T.Chuẩn đã tích xác nhận (per-dòng) của Part
        if (!IsGcGroup && !_poStdRowKeys.ContainsKey(det.PurchaseOrder))
        {
            var pmRow = await Db.PartMasters.AsNoTracking().FirstOrDefaultAsync(p => p.PartNo == det.PartNo);
            if (pmRow != null)
                _poStdRowKeys[det.PurchaseOrder] = await StdConfirmSvc.GetConfirmedCodeKeysAsync(pmRow.PartId);
        }

        // [STD-UPDATE] Nạp trạng thái xác nhận T.Chuẩn từ snapshot phiếu KH (flow nhóm)
        await EnsureSnapStdConfirmsAsync(det.KhPlanDetailId);

        if (grp.UseStdAsDefault) TryFillStdValues(sub);

    }

