                                        <th class="text-center" style="width:54px;color:@(!isSerial ? "#854f0b" : "#adb5bd")">T.CB</th>
                                        <th class="text-center" style="width:54px;color:@(!isSerial ? "#854f0b" : "#adb5bd")">T.Chạy</th>
                                    }
