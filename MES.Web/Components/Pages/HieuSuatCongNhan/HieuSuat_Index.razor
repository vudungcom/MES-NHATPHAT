    private void OnGroupNCChanged(WtsGroup grp, string? nc)

    {

        grp.NC = nc;

        // Cập nhật NC cho tất cả sub-rows

        foreach (var sub in grp.SubRows) { sub.NC = nc; sub.AvailableNCs = grp.AvailableNCs; }

        // Reset máy khi đổi NC

        grp.MachineUsed = null;

        foreach (var sub in grp.SubRows) sub.MachineUsed = null;

