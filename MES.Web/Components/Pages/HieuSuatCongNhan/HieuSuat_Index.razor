                                                    <td class="text-center fw-bold small" style="color:#185fa5;font-size:0.7rem;">@log.QtyDone.ToString("0.##")</td>
                                                    <td class="text-center small" style="font-size:0.7rem;">@log.StartTime.ToString("dd/MM HH:mm")</td>
                                                    <td class="text-center small" style="font-size:0.7rem;">@log.EndTime.ToString("dd/MM HH:mm")</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#185fa5;">@FmtTimeWts(log.SetupTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#185fa5;">@FmtTimeWts(log.MachiningTime_Actual)</td>
                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#185fa5;">@FmtTimeWts(log.InspectionTime_Actual)</td>
