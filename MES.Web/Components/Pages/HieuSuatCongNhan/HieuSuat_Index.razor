    // [FLAT-CODE] Mã CV tính theo tổng thời gian thực tế (không nhân SL): 1V / 1T / 1K / 1G
    // [FLAT-QTY-ZERO] Mã CHUẨN BỊ (không có khối lượng): 1V Bavia · 1T Taro · 1R Rửa · 1K KCS · 1D Đóng gói (+ 1G giữ như cũ)
    // → tính thời gian không nhân SL, KHÔNG bắt nhập OK/NG, KHÔNG hiện huy hiệu SL/PO ở bảng quy trình.
    private static readonly string[] _flatTimeCodes = { "1V", "1T", "1R", "1K", "1D", "1G" };

    private static bool IsPrepCode(string? code)
        => !string.IsNullOrEmpty(code) && _flatTimeCodes.Contains(code.Trim(), StringComparer.OrdinalIgnoreCase);

    // Dòng nhập WTS non-GC đang chọn mã chuẩn bị → không có số lượng
    private bool IsPrepNoQty(WtsRow sub) => !IsGcGroup && IsFlatTimeCode(sub);

    // [TRIAL-QTY-OPTIONAL] Không bắt buộc SL > 0 khi: mã chuẩn bị (non-GC) HOẶC GC đang "Chạy thử"
    // (chạy thử có bước chuẩn bị, có thể chưa ra sản phẩm). Vẫn cho nhập SL nếu có.
    private bool IsQtyOptional(WtsRow sub) => IsPrepNoQty(sub) || (IsGcGroup && sub.ProductionMode == "trial");

    // [SERIAL-TIME-REQUIRED] GC "Hàng loạt" có số KH → bắt buộc nhập đủ T.Gá, T.GC, T.Ktra (> 0) để tính hiệu suất.
    // Trả về thông báo lỗi (liệt kê ô thiếu) hoặc null nếu đủ. Chạy thử / non-GC / Mã WTS khác → không kiểm tra.
    // [ACTUAL-REQUIRED-NONGC] Non-GC (HTSP/KCS/Đóng gói) có số KH → bắt buộc nhập T.Thực tế (> 0).
    // Mã chuẩn bị (1V/1T/1R/1K/1D/1G): ô T.Thực tế = tổng phút — BẮT BUỘC nhập (chốt 2026-10-19). Đổi false nếu muốn cho để trống.
    private const bool RequireActualForPrepCodes = true;

    private string? GetMissingSerialTimesMsg(WtsRow r)
    {
        // [ACTUAL-REQUIRED-NONGC]
        if (!IsGcGroup)
        {
            if (!r.KhPlanDetailId.HasValue) return null;
            if (IsPrepNoQty(r) && !RequireActualForPrepCodes) return null;
            return (r.ActualTimePerPc ?? 0) <= 0
                ? (IsPrepNoQty(r) ? "Chưa nhập T.Thực tế (tổng phút chuẩn bị)." : "Chưa nhập T.Thực tế.")
                : null;
        }
        if (!r.KhPlanDetailId.HasValue) return null;
        // [TRIAL-PREP-REQUIRED] Chạy thử: bắt buộc T.CB (thời gian chuẩn bị) > 0; T.Chạy + SL vẫn không bắt buộc (yêu cầu KH 19/10)
        if (r.ProductionMode == "trial")
            return (r.PreparationTime_Actual ?? 0) <= 0 ? "Chạy thử: chưa nhập T.CB (thời gian chuẩn bị)." : null;
        if (r.ProductionMode != "serial") return null;
        var missing = new List<string>();
        if ((r.SetupTime_Actual      ?? 0) <= 0) missing.Add("T.Gá");
        if ((r.MachiningTime_Actual  ?? 0) <= 0) missing.Add("T.GC");
        if ((r.InspectionTime_Actual ?? 0) <= 0) missing.Add("T.Ktra");
        return missing.Count == 0 ? null : $"Hàng loạt: chưa nhập {string.Join(", ", missing)}.";
    }
    private bool IsFlatTimeCode(WtsRow sub)
    {
        var code = !string.IsNullOrEmpty(sub.WtsCode) ? sub.WtsCode : sub.NC;
        return !string.IsNullOrEmpty(code)
            && _flatTimeCodes.Contains(code.Trim(), StringComparer.OrdinalIgnoreCase);
    }

    // [STD-CONFIRM-ROW] Tag bảng Part Master tương ứng nhóm đang nhập (non-GC)
    private string StdTableTagForRow(WtsRow row)
    {
        if (IsHtspGroup)
            return row.HtspSubGroup switch { "Taro" => "Taro", "Bavia" => "Bavia", "Rua" => "Washing", _ => "" };
        if (HandoverGroupCode == "KCS") return "Inspection";
        return "Packaging";
    }

    // T.Chuẩn/pc của dòng: ưu tiên theo Mã CV đã chọn (cùng quy tắc khớp với lúc auto-fill), fallback theo NC
    private decimal? GetStdTimeForSubRow(WtsRow sub)
    {
        if (sub.StandardTimePerPc.HasValue) return sub.StandardTimePerPc;
        if (!string.IsNullOrEmpty(sub.PO) && !string.IsNullOrEmpty(sub.WtsCode)
            && _fullSnapshotCache.TryGetValue(sub.PO, out var snap))
        {
            var code = sub.WtsCode;
            decimal? v;
            if (IsHtspGroup)
                v = sub.HtspSubGroup switch
                {
                    "Taro"  => snap.Taro   .FirstOrDefault(s => (s.WtsTaskCode ?? s.NC) == code)?.StandardTime,
                    "Bavia" => snap.Bavia  .FirstOrDefault(s => s.NC == code)?.StandardTime,
                    "Rua"   => snap.Washing.FirstOrDefault(s => s.NC == code)?.StandardTime,
                    _       => null
                };
            else if (HandoverGroupCode == "KCS")
                v = snap.Inspection.FirstOrDefault(s => s.NC == code)?.StandardTime;
            else
                v = snap.Packaging.FirstOrDefault(s => s.NC == code)?.StandardTime;
            if (v.HasValue) return v;
        }
        return GetStdTimeForWtsCode(sub);
    }

