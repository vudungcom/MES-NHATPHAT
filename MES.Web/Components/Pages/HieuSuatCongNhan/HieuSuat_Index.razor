        finally { _voidBusy = false; }
    }

    private void CloseVoidModal() { _voidConfirmRow = null; _voidBlockMsg = null; }

    // [GN-WTS-CAP] Trả true = đã xoá; false = bị chặn (lời báo ở _voidBlockMsg).
    // [WTS-SVC 2026-10-29] Phần khoá PO + kiểm K5 + 2 câu UPDATE huỷ dòng + [GN-WHY] dời NGUYÊN VĂN sang
    //   Services/WtsSaveService.VoidRowAsync (chữ báo y cũ; khoá nay LockOwner = Transaction, UPDATE trong cùng giao dịch).
    private async Task<bool> VoidSavedRow(WtsRow row)
    {
        var res = await WtsSaveSvc.VoidRowAsync(new WtsSaveService.WtsVoidRequest
        {
            WtsLogId = row.WtsLogId, ActivityLogId = row.ActivityLogId, KhPlanDetailId = row.KhPlanDetailId, UserId = _currentUserId
        });
        if (!res.Ok) { _voidBlockMsg = res.ErrorMsg; return false; }
        await LoadSavedRowsAsync();
        return true;
    }

