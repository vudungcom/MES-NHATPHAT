                                    </td>

                                    @* SL PO *@
                                    <td class="text-center text-muted" style="font-size:11px">
                                        @if (sub.KhPlanDetailId.HasValue)
                                        {
                                            var poQty = _allRows.FirstOrDefault(r => r.KhPlanDetailId == sub.KhPlanDetailId)?.Quantity;
                                            <span title="SL kế hoạch PO này">@(poQty.HasValue ? poQty.Value.ToString("0") : "—")</span>
                                        }
                                        else { <span>—</span> }
                                    </td>

                                    @* Lý do NG *@
                                    <td>
                                        <input class="form-control form-control-sm" style="font-size:11px"
                                               value="@sub.NgReason" placeholder="Lý do NG..."
                                               disabled="@(sub.QtyNg <= 0)"
                                               @oninput="e => sub.NgReason = e.Value?.ToString()" />
                                    </td>

                                    @* Bắt đầu — chỉ hàng đầu nhập tay, còn lại tự tính *@
