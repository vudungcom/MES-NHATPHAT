                                                    <td class="text-end text-muted">—</td>
                                                    <td class="text-end" style="color:#185fa5;">@FmtTimeWts(log.TrialRunTime_Actual)</td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

