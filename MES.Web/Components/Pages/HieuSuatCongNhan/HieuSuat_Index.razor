@if (_activeTab == "report" && _canViewReport)
{
    <div class="card shadow-sm border-0">
        <div class="card-body">
            @* ── Filter bar ── *@
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label small fw-bold mb-1">Công nhân</label>
                    <select class="form-select form-select-sm" style="min-width: 180px;" @bind="_reportWorkerId">
                        <option value="0">-- Tất cả công nhân --</option>
                        @foreach (var w in _reportWorkers)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label small fw-bold mb-1">Từ ngày</label>
                    <input type="date" class="form-control form-control-sm" @bind="_reportDateFrom" />
                </div>
                <div class="col-auto">
                    <label class="form-label small fw-bold mb-1">Đến ngày</label>
                    <input type="date" class="form-control form-control-sm" @bind="_reportDateTo" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" @onclick="LoadReportAsync" disabled="@_reportLoading">
                        @if (_reportLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                        }
                        Xem báo cáo
                    </button>
                </div>
            </div>

            @if (_reportResult != null)
            {
                @* ── Summary cards ── *@
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card border-0 bg-light text-center py-3">
                            <div class="fs-4 fw-bold text-primary">@_reportResult.TotalMinutes</div>
                            <div class="small text-muted">Tổng phút</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 text-center py-3" style="background-color: #f0fdf4;">
                            <div class="fs-4 fw-bold text-success">@_reportResult.ProductiveMin</div>
                            <div class="small text-muted">Phút có ích</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 text-center py-3" style="background-color: #fff7ed;">
                            <div class="fs-4 fw-bold text-warning">@_reportResult.WasteMin</div>
                            <div class="small text-muted">Phút vô ích</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 text-center py-3" style="background-color: #f0f9ff;">
                            <div class="fs-4 fw-bold text-info">@_reportResult.EfficiencyPct%</div>
                            <div class="small text-muted">Hiệu suất (chưa chính thức)</div>
                        </div>
                    </div>
                </div>

                @* ── Bảng chi tiết ── *@
                @if (_reportResult.Rows.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size: 0.82rem;">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th style="width: 90px;">Ngày</th>
                                    <th style="width: 120px;">Công nhân</th>
                                    <th style="width: 80px;" class="text-center">Bắt đầu</th>
                                    <th style="width: 80px;" class="text-center">Kết thúc</th>
                                    <th style="width: 60px;" class="text-center">Phút</th>
                                    <th style="width: 130px;">PO</th>
                                    <th style="width: 110px;">Part No</th>
                                    <th style="width: 80px;" class="text-center">NC</th>
                                    <th style="width: 80px;" class="text-center">Máy</th>
                                    <th style="width: 150px;">Mã WTS / Tên</th>
                                    <th style="width: 60px;" class="text-center">SL</th>
                                    <th style="width: 90px;" class="text-center">Phân loại</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _reportResult.Rows)
                                {
                                    var rowBg = row.IsProductiveTask ? "" : "background-color: #fff7ed;";
                                    var productiveBadge = row.IsProductiveTask ? "badge bg-success" : "badge bg-secondary";
                                    var productiveLabel = row.IsProductiveTask ? "Có ích" : "Vô ích";
                                    <tr style="@rowBg">
                                        <td class="small">@row.WorkDate.ToString("dd/MM/yyyy")</td>
                                        <td class="small fw-bold">@row.WorkerName</td>
                                        <td class="text-center small">@row.StartTime.ToString("HH:mm")</td>
                                        <td class="text-center small">@row.EndTime.ToString("HH:mm")</td>
                                        <td class="text-center fw-bold">@row.Minutes</td>
                                        <td class="small"><code>@(string.IsNullOrEmpty(row.PurchaseOrder) ? "—" : row.PurchaseOrder)</code></td>
                                        <td class="small"><code class="text-danger">@(string.IsNullOrEmpty(row.PartNo) ? "—" : row.PartNo)</code></td>
                                        <td class="text-center small"><code>@(string.IsNullOrEmpty(row.NC) ? "—" : row.NC)</code></td>
                                        <td class="text-center small text-primary">@(string.IsNullOrEmpty(row.MachineUsed) ? "—" : row.MachineUsed)</td>
                                        <td class="small text-muted">
                                            @if (!string.IsNullOrEmpty(row.WtsCode))
                                            {
                                                <code class="text-danger">@row.WtsCode</code>
                                                <span> @row.WtsName</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="text-center small">@(row.QtyDone > 0 ? row.QtyDone.ToString("0.##") : "—")</td>
                                        <td class="text-center">
                                            <span class="@productiveBadge" style="font-size: 0.7rem;">@productiveLabel</span>
                                        </td>
                                        <td class="small text-muted">@row.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-muted small mt-2">
                        Tổng <b>@_reportResult.Rows.Count</b> dòng
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">Không có dữ liệu WTS trong khoảng thời gian này.</div>
                }
            }
            else if (!_reportLoading)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bar-chart-line fs-1 d-block mb-2 opacity-25"></i>
                    Chọn khoảng ngày và nhấn "Xem báo cáo" để tải dữ liệu.
                </div>
            }
        </div>
    </div>
}


@code {
    private bool _canSubmit;
    private User? _currentWorker;
    private int _currentUserId;
    private Dictionary<string, (bool CanView, bool CanEdit)> _perms = new();

    // ── Tab ──────────────────────────────────────────────────────────────
    private string _activeTab = "input"; // "input" | "report"
    private bool _canViewReport = false;
    private string _TabInputCls  => _activeTab == "input"  ? "nav-link active" : "nav-link";
    private string _TabReportCls => _activeTab == "report" ? "nav-link active" : "nav-link";
    private void SetTabInput() { _activeTab = "input"; }

    // ── Report state ─────────────────────────────────────────────────────
    private DateTime _reportDateFrom = DateTime.Today;
    private DateTime _reportDateTo   = DateTime.Today;
    private int _reportWorkerId      = 0; // 0 = tất cả
    private bool _reportLoading      = false;
    private WtsReportResult? _reportResult = null;
    private List<(int Id, string Name)> _reportWorkers = new();

    private DateTime _workDate = DateTime.Today;

    // Data
    private List<KhPlanDetailRow> _allRows = new(); // tất cả phiếu KH
    private List<StandardWtsTask> _wtsTasks = new(); // tất cả WTS active
    private string _groupCode = ""; // GroupCode của công nhân hiện tại

    /// <summary>
    /// Danh sách WTS tasks lọc theo nhóm công nhân.
    /// PRODUCTION → GC + KT_NC
    /// FINISHING → TARO + BAVIA + RUA
    /// QC → KCS
    /// ADMIN/TECHNICAL → tất cả
    /// </summary>
    private IEnumerable<StandardWtsTask> WtsTasksForGroup
    {
        get
        {
            var result = new List<StandardWtsTask>();
            var isAdmin = _groupCode == "ADMIN";

            // Lọc WTS theo quyền được cấp — không hardcode GroupCode
            if (isAdmin || (_perms.TryGetValue(SystemPermissions.WtsGc, out var g) && g.CanView))
                result.AddRange(_wtsTasks.Where(t => t.CategoryCode is "GIA CÔNG" or "KT_NC"));

            if (isAdmin || (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var h) && h.CanView))
                result.AddRange(_wtsTasks.Where(t => t.CategoryCode is "TARO" or "BAVIA" or "RUA"));

            if (isAdmin || (_perms.TryGetValue(SystemPermissions.WtsKcs, out var k) && k.CanView))
                result.AddRange(_wtsTasks.Where(t => t.CategoryCode == "KCS"));

            if (isAdmin || (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var d) && d.CanView))
                result.AddRange(_wtsTasks.Where(t => t.CategoryCode == "DONG_GOI"));

            return result.DistinctBy(t => t.TaskId);
        }
    }

    /// <summary>
    /// Danh sách PO cho công nhân chọn — sort ưu tiên.
    /// Gate 1: Chỉ hiện phiếu đã có snapshot quy trình (bật _showWithoutSnapshot để bypass).
    /// Gate 2: Chỉ hiện phiếu nhóm này đã nhận hàng từ giao nhận (bật _showWithoutHandover để bypass).
    /// </summary>
    private IEnumerable<KhPlanDetailRow> PriorityRows => _allRows
        .Where(r => _showWithoutSnapshot || _hasSnapshotForGroup.Contains(r.KhPlanDetailId))
        .Where(r => _showWithoutHandover  || _hasReceivedForGroup.Contains(r.KhPlanDetailId))
        .OrderBy(r => r.Priority == "Gấp" ? 0 : 1)
        .ThenBy(r => r.STD)
        .ThenBy(r => r.PurchaseOrder);

    // Toggle hiển thị phiếu chưa có snapshot — mặc định OFF
    private bool _showWithoutSnapshot = false;

    // Toggle hiển thị phiếu chưa có hàng giao nhận — mặc định OFF
    private bool _showWithoutHandover = false;

    // Set các KhPlanDetailId mà nhóm này đã nhận hàng (từ HandoverReceives)
    private HashSet<int> _hasReceivedForGroup = new();

    // GroupCode handover tương ứng với quyền WTS của công nhân
    private string HandoverGroupCode
    {
        get
        {
            if (_groupCode == "ADMIN") return "GC"; // admin thấy hết
            if (_perms.TryGetValue(SystemPermissions.WtsGc,      out var g) && g.CanView) return "GC";
            if (_perms.TryGetValue(SystemPermissions.WtsHtsp,    out var h) && h.CanView) return "HTSP";
            if (_perms.TryGetValue(SystemPermissions.WtsKcs,     out var k) && k.CanView) return "KCS";
            if (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var d) && d.CanView) return "PKG";
            return "GC";
        }
    }

    private bool IsToday => _workDate.Date == DateTime.Today;

    /// <summary>True nếu công nhân thuộc nhóm GC (hoặc ADMIN) — hiện cột Máy SD và label NC</summary>
    private bool IsGcGroup => _groupCode == "ADMIN"
        || (_perms.TryGetValue(SystemPermissions.WtsGc, out var g) && g.CanView);

    /// <summary>True nếu công nhân thuộc nhóm HTSP — hiện cột Nhóm nhỏ (Taro/Bavia/Rửa)</summary>
    private bool IsHtspGroup
        => !IsGcGroup && (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var h) && h.CanView);

    // Cache: PO → RouteSnapshotData đầy đủ (dùng cho non-GC)
    private Dictionary<string, RouteSnapshotData> _fullSnapshotCache = new();

    // Cache: KhPlanDetailId → có snapshot phù hợp với nhóm không
    private HashSet<int> _hasSnapshotForGroup = new();

    // Snapshot cache: PO → list NC (Machining — dùng cho GC)
    private Dictionary<string, List<KhPlanRouteSnapshotMachining>> _snapshotCache = new();
    // Máy đang hỏng/bảo trì — HashSet SoMay để lookup O(1)
    private HashSet<string> _brokenMachines = new();
    private Dictionary<string, decimal> _qtySummaryCache = new(); // "detailId|NC" → qty done

    // Cache: KhPlanDetailId → SL đã nhận vào nhóm này (từ HandoverReceives)
    // Dùng để giới hạn SL tối đa trong CheckQtyWarning (giữ lại cho backward-compat)
    private Dictionary<int, decimal> _receivedOkCache = new();

    // v0.8: Flow per NC theo nhóm handover của công nhân — nguồn "sự thật" duy nhất
    // cho: cascade check (NC sau phụ thuộc NC trước), enforce conservation.
    // Key: KhPlanDetailId, Value: list NcFlowItem của HandoverGroupCode
    private Dictionary<int, List<NcFlowItem>> _ncFlowCache = new();

    private async Task ReloadFlowAsync(int khPlanDetailId)
    {
        var flow = await HandoverSvc.GetNcFlowAsync(khPlanDetailId, HandoverGroupCode);
        _ncFlowCache[khPlanDetailId] = flow;
    }

    private NcFlowItem? GetFlowItem(int? detailId, string? nc)
    {
        if (detailId == null || string.IsNullOrEmpty(nc)) return null;
        if (!_ncFlowCache.TryGetValue(detailId.Value, out var list)) return null;
        return list.FirstOrDefault(f => !f.IsBackup && f.NC == nc);
    }

    // ── Timing chuẩn — tra cứu từ PartMachiningTimings theo NC + máy ─────
    private Dictionary<int, List<TimingStd>> _timingStdCache = new();

    private record TimingStd(string NC, string SoMay,
        decimal? SetupTime, decimal? MachiningTime, decimal? InspectionTime,
        decimal? PreparationTime, decimal? TrialRunTime);

    private TimingStd? GetStdTiming(int detailId, string? nc, string? soMay)
    {
        if (string.IsNullOrEmpty(nc) || string.IsNullOrEmpty(soMay)) return null;
        if (!_timingStdCache.TryGetValue(detailId, out var list)) return null;
        // SoMay trong cache có thể là CSV nhóm "C04, C06" → match nếu soMay nằm trong nhóm đó
        return list.FirstOrDefault(t =>
            t.NC.Equals(nc, StringComparison.OrdinalIgnoreCase) &&
            t.SoMay.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Any(m => m.Equals(soMay, StringComparison.OrdinalIgnoreCase)));
    }

    private bool HasStdTiming(WtsRow row)
        => row.KhPlanDetailId.HasValue && GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed) != null;

    private string BuildStdTimingHtml(WtsRow row)
    {
        if (!row.KhPlanDetailId.HasValue) return "";
        var t = GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed);
        if (t == null) return "";
        var parts = new List<string>();
        if (t.SetupTime.HasValue)      parts.Add($"T.Gá lắp <strong>{t.SetupTime}</strong>");
        if (t.MachiningTime.HasValue)  parts.Add($"T.Gia công <strong>{t.MachiningTime}</strong>");
        if (t.InspectionTime.HasValue) parts.Add($"T.Kiểm tra <strong>{t.InspectionTime}</strong>");
        if (t.PreparationTime.HasValue)parts.Add($"T.Chuẩn bị <strong>{t.PreparationTime}</strong>");
        if (t.TrialRunTime.HasValue)   parts.Add($"T.Chạy thử <strong>{t.TrialRunTime}</strong>");
        return string.Join(" &nbsp;|&nbsp; ", parts);
    }

    private async Task EnsureTimingStdAsync(int detailId, int partId)
    {
        if (_timingStdCache.ContainsKey(detailId)) return;
        var rows = await Db.PartMachiningTimings
            .Where(t => t.Step != null && t.Step.PartId == partId && t.IsActive)
            .Select(t => new { t.Step!.NC, t.SoMay, t.SetupTime, t.MachiningTime, t.InspectionTime, t.PreparationTime, t.TrialRunTime })
            .AsNoTracking()
            .ToListAsync();
        _timingStdCache[detailId] = rows
            .Select(r => new TimingStd(r.NC, r.SoMay, r.SetupTime, r.MachiningTime, r.InspectionTime, r.PreparationTime, r.TrialRunTime))
            .ToList();
    }
    // ── End timing chuẩn ─────────────────────────────────────────────────

    // Timeline rows
    private List<WtsRow> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out _currentUserId)) return;

        _currentWorker = await Db.Users
            .Include(u => u.Group)
            .FirstOrDefaultAsync(u => u.UserId == _currentUserId);

        var gc = _currentWorker?.Group?.GroupCode ?? "";
        _groupCode = gc;

        // Load permissions từ bảng phân quyền — không hardcode GroupCode
        _perms = await UserSvc.GetAllUserPermissionsAsync(_currentUserId);
        _canSubmit = _perms.TryGetValue(SystemPermissions.WtsGc,      out var p1) && p1.CanView
                  || _perms.TryGetValue(SystemPermissions.WtsHtsp,    out var p2) && p2.CanView
                  || _perms.TryGetValue(SystemPermissions.WtsKcs,     out var p3) && p3.CanView
                  || _perms.TryGetValue(SystemPermissions.WtsDongGoi, out var p4) && p4.CanView
                  || gc == "ADMIN";

        _canViewReport = (_perms.TryGetValue(SystemPermissions.WtsReport, out var pr) && pr.CanView)
                      || gc == "ADMIN";

        if (_canSubmit)
        {
            _allRows  = await KhSvc.GetDetailRowsAsync();
            _wtsTasks = await WtsSvc.GetAllActiveAsync();

            // Load danh sách máy đang hỏng
            await LoadBrokenMachinesAsync();

            // Build danh sách phiếu có snapshot phù hợp nhóm
            await BuildSnapshotFilterAsync();

            // Build danh sách phiếu nhóm này đã nhận hàng (handover gate)
            await BuildHandoverFilterAsync();

            await LoadSavedRowsAsync();
            AddRow();
        }
    }

    // ── Load máy đang hỏng ───────────────────────────────────
    private async Task LoadBrokenMachinesAsync()
    {
        var allMachines = await ThietBiSvc.GetAllActiveAsync();
        _brokenMachines = allMachines
            .Where(m => m.IsActive && m.TrangThai != "Hoạt động")
            .Select(m => m.SoMay)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    // ── Filter phiếu theo nhóm công nhân ─────────────────────
    private async Task BuildSnapshotFilterAsync()
    {
        _hasSnapshotForGroup.Clear();
        if (!_allRows.Any()) return;

        var detailIds = _allRows.Select(r => r.KhPlanDetailId).ToList();

        // Query theo nhóm — chỉ lấy phiếu có snapshot phù hợp
        List<int> withSnap;

        var isAdminOrTech = _groupCode is "ADMIN" or "TECHNICAL";
        if (isAdminOrTech)
        {
            // Thấy tất cả phiếu có bất kỳ snapshot nào
            withSnap = await Db.KhPlanRouteSnapshotMachining
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
        }
        else if (_perms.TryGetValue(SystemPermissions.WtsGc, out var wg) && wg.CanView)
        {
            withSnap = await Db.KhPlanRouteSnapshotMachining
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
        }
        else if (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var wh) && wh.CanView)
        {
            var taro  = await Db.KhPlanRouteSnapshotTaro
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
            var bavia = await Db.KhPlanRouteSnapshotBavia
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
            var rua   = await Db.KhPlanRouteSnapshotWashing
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
            withSnap  = taro.Union(bavia).Union(rua).ToList();
        }
        else if (_perms.TryGetValue(SystemPermissions.WtsKcs, out var wk) && wk.CanView)
        {
            withSnap = await Db.KhPlanRouteSnapshotInspection
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
        }
        else if (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var wd) && wd.CanView)
        {
            withSnap = await Db.KhPlanRouteSnapshotPackaging
                .Where(s => detailIds.Contains(s.KhPlanDetailId))
                .Select(s => s.KhPlanDetailId).Distinct().ToListAsync();
        }
        else
        {
            withSnap = new List<int>();
        }

        foreach (var id in withSnap)
            _hasSnapshotForGroup.Add(id);
    }

    // ── Build handover gate: phiếu nhóm này đã nhận hàng ────
    private async Task BuildHandoverFilterAsync()
    {
        _hasReceivedForGroup.Clear();
        if (!_allRows.Any()) return;

        var detailIds = _allRows.Select(r => r.KhPlanDetailId).ToList();
        var groupCode = HandoverGroupCode;

        // Admin thấy tất cả — không cần filter
        if (_groupCode == "ADMIN")
        {
            foreach (var id in detailIds) _hasReceivedForGroup.Add(id);
            return;
        }

        var receivedIds = await HandoverSvc.GetDetailIdsWithReceivedAsync(detailIds, groupCode);
        _hasReceivedForGroup = receivedIds;
    }

    // ── Load dòng đã lưu trong ngày ─────────────────────────
    private async Task LoadSavedRowsAsync()
    {
        var start = _workDate.Date;
        var end   = start.AddDays(1);
        var workDate = DateOnly.FromDateTime(_workDate);

        // Loại 1: WtsProductionLogs (link PO/NC)
        var prodLogs = await Db.WtsProductionLogs
            .Include(x => x.Worker)
            .Where(x => x.WorkerId == _currentUserId
                     && x.StartTime >= start && x.StartTime < end
                     && !x.IsVoided)
            .OrderBy(x => x.StartTime)
            .AsNoTracking()
            .ToListAsync();

        // Loại 2: WorkerActivityLogs (không link PO)
        var actLogs = await Db.WorkerActivityLogs
            .Where(x => x.WorkerId == _currentUserId
                     && x.WorkDate == workDate
                     && !x.IsVoided)
            .OrderBy(x => x.StartTime)
            .AsNoTracking()
            .ToListAsync();

        // Gộp và sắp theo StartTime
        var rows = new List<WtsRow>();

        foreach (var log in prodLogs)
        {
            var po = _allRows.FirstOrDefault(r => r.KhPlanDetailId == log.KhPlanDetailId)?.PurchaseOrder;
            rows.Add(new WtsRow
            {
                WtsLogId       = log.WtsLogId,
                KhPlanDetailId = log.KhPlanDetailId,
                StartTime      = log.StartTime,
                EndTime        = log.EndTime,
                PO             = po,
                NC             = log.NC,
                PartNo         = _allRows.FirstOrDefault(r => r.KhPlanDetailId == log.KhPlanDetailId)?.PartNo,
                WtsCode        = null,
                WtsName        = null,
                QtyDone        = log.QtyDone,
                QtyOk          = log.QtyOk ?? log.QtyDone,   // fallback cho bản ghi cũ
                QtyNg          = log.QtyNg ?? 0m,
                NgReason       = log.NgReason,
                Notes          = log.Notes,
                Saved          = true,
            });
        }

        foreach (var log in actLogs)
        {
            rows.Add(new WtsRow
            {
                ActivityLogId = log.ActivityLogId,
                StartTime     = log.StartTime,
                EndTime       = log.EndTime,
                PO            = null,
                NC            = null,
                WtsCode       = log.WtsCode,
                WtsName       = log.WtsName,
                QtyDone       = 0,
                Notes         = log.Notes,
                Saved         = true,
            });
        }

        _rows = rows.OrderBy(r => r.StartTime).ToList();
    }

    private async Task OnWorkDateChanged()
    {
        _rows.Clear();
        await LoadSavedRowsAsync();
        AddRow();
    }

    // ── Thêm dòng mới ────────────────────────────────────────
    private void AddRow()
    {
        if (!IsToday) return; // Không cho thêm dòng ngày cũ
        var lastEnd = _rows.LastOrDefault()?.EndTime
                      ?? _workDate.Date.AddHours(8);
        _rows.Add(new WtsRow
        {
            StartTime = lastEnd,
            EndTime   = lastEnd.AddHours(2),
        });
    }

    // v0.8: RemoveRow bây giờ async — nếu row có logId (đã lưu DB, đang sửa dở,
    // hoặc user xóa hẳn) thì void ở DB + reload flow. Fix bug: xóa xong NC vẫn
    // hiển thị "ĐÃ ĐỦ SL" vì log cũ chưa được void.
    private async Task RemoveRow(WtsRow row)
    {
        if (row.WtsLogId.HasValue)
        {
            await Db.Database.ExecuteSqlRawAsync(
                "UPDATE WtsProductionLogs SET IsVoided=1, VoidReason=N'Xóa dòng', VoidedBy={0}, VoidedAt={1} WHERE WtsLogId={2}",
                _currentUserId, DateTime.Now, row.WtsLogId.Value);
        }
        if (row.ActivityLogId.HasValue)
        {
            await Db.Database.ExecuteSqlRawAsync(
                "UPDATE WorkerActivityLogs SET IsVoided=1, VoidReason=N'Xóa dòng', VoidedBy={0}, VoidedAt={1} WHERE ActivityLogId={2}",
                _currentUserId, DateTime.Now, row.ActivityLogId.Value);
        }

        _rows.Remove(row);

        // Reload flow cho detail này để dropdown NC và cascade cập nhật ngay
        if (row.KhPlanDetailId.HasValue)
        {
            Db.ChangeTracker.Clear();
            await ReloadFlowAsync(row.KhPlanDetailId.Value);
            // Reload qty summary luôn để nhất quán
            var summary = await KhSvc.GetWtsQtySummaryAsync(row.KhPlanDetailId.Value);
            foreach (var kv in summary)
                _qtySummaryCache[$"{row.KhPlanDetailId}|{kv.Key}"] = kv.Value;
        }
    }

    /// <summary>
    /// Void dòng đã lưu trong ngày + mở lại để sửa.
    /// Cơ chế: đánh dấu Saved=false, giữ WtsLogId/ActivityLogId để void khi save lại.
    /// v0.8: Reload flow + snapshot cho detail để dropdown NC hiển thị đúng ngay.
    /// </summary>
    private async Task EditRow(WtsRow row)
    {
        if (!IsToday) return;
        row.Saved     = false;
        row.IsEditing = true; // đánh dấu đang sửa (sẽ void + tạo mới khi save)

        // Đảm bảo snapshot NC + flow đã load cho detail này (row đã lưu → chưa chắc EnsureLoaded chạy)
        if (row.KhPlanDetailId.HasValue && !string.IsNullOrEmpty(row.PO))
        {
            if (!_snapshotCache.ContainsKey(row.PO))
            {
                var snap = await KhSvc.GetRouteSnapshotAsync(row.KhPlanDetailId.Value);
                _snapshotCache[row.PO] = snap.Machining;
            }
            row.AvailableNCs = _snapshotCache[row.PO];
            await ReloadFlowAsync(row.KhPlanDetailId.Value);
        }
    }

    // ── Time input ────────────────────────────────────────────
    private void OnTimeChanged(WtsRow row, bool isStart, string? val)
    {
        if (string.IsNullOrEmpty(val)) return;
        if (!TimeSpan.TryParse(val, out var ts)) return;
        var dt = _workDate.Date.Add(ts);
        if (isStart) row.StartTime = dt;
        else         row.EndTime   = dt;
    }

    // ── PO chọn → load NC từ snapshot ────────────────────────
    private async Task OnPOChanged(WtsRow row, string? po)
    {
        row.PO = po;
        row.NC = null;
        row.PartNo = null;
        row.WtsCode = null;
        row.WtsName = null;
        row.AvailableNCs.Clear();
        row.AvailableWtsItems.Clear();
        row.HtspSubGroup = null;
        row.KhPlanDetailId = null;

        if (string.IsNullOrEmpty(po)) return;

        var detail = _allRows.FirstOrDefault(r => r.PurchaseOrder == po);
        if (detail == null) return;
        row.KhPlanDetailId = detail.KhPlanDetailId;
        row.PartNo = detail.PartNo;

        // Load snapshot
        if (IsGcGroup)
        {
            // GC: load Machining snapshot vào cache riêng cho dropdown NC
            if (!_snapshotCache.ContainsKey(po))
            {
                var snap = await KhSvc.GetRouteSnapshotAsync(detail.KhPlanDetailId);
                _snapshotCache[po] = snap.Machining;
                _fullSnapshotCache[po] = snap; // cũng lưu full để hiện bảng quy trình
            }
            row.AvailableNCs = _snapshotCache[po];
        }
        else
        {
            // HTSP/KCS/PKG: load full snapshot
            if (!_fullSnapshotCache.ContainsKey(po))
            {
                var snap = await KhSvc.GetRouteSnapshotAsync(detail.KhPlanDetailId);
                _fullSnapshotCache[po] = snap;
            }
            var fullSnap = _fullSnapshotCache[po];
            if (!IsHtspGroup)
            {
                // KCS hoặc PKG — load thẳng vào AvailableWtsItems
                row.AvailableWtsItems = HandoverGroupCode == "KCS"
                    ? fullSnap.Inspection.Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList()
                    : fullSnap.Packaging.Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();
            }
            // HTSP: chờ user chọn nhóm nhỏ → OnHtspSubGroupChanged sẽ fill AvailableWtsItems
        }

        // Load qty summary
        var key = detail.KhPlanDetailId.ToString();
        if (!_qtySummaryCache.ContainsKey(key))
        {
            var summary = await KhSvc.GetWtsQtySummaryAsync(detail.KhPlanDetailId);
            foreach (var kv in summary)
                _qtySummaryCache[$"{detail.KhPlanDetailId}|{kv.Key}"] = kv.Value;
        }

        // Load SL đã nhận vào nhóm này từ giao nhận
        if (!_receivedOkCache.ContainsKey(detail.KhPlanDetailId))
        {
            var groupCode = HandoverGroupCode;
            var receivedOk = await HandoverSvc.GetReceivedOkAsync(detail.KhPlanDetailId, groupCode);
            _receivedOkCache[detail.KhPlanDetailId] = receivedOk > 0 ? receivedOk : detail.Quantity;
        }

        // v0.8: Load NC flow
        if (!_ncFlowCache.ContainsKey(detail.KhPlanDetailId))
        {
            await ReloadFlowAsync(detail.KhPlanDetailId);
        }

        // Load WTS logs cho bảng quy trình
        if (!_wtsLogsCache.ContainsKey(po))
            await ReloadWtsLogsAsync(po, detail.KhPlanDetailId);

        // Load timing chuẩn theo part
        var pm = await Db.PartMasters.FirstOrDefaultAsync(p => p.PartNo == detail.PartNo);
        if (pm != null)
            await EnsureTimingStdAsync(detail.KhPlanDetailId, pm.PartId);
    }

    private void OnNCChanged(WtsRow row, string? nc)
    {
        row.NC          = nc;
        row.WtsCode     = null;
        row.WtsName     = null;
        row.MachineUsed = null; // reset máy khi đổi NC
        CheckQtyWarning(row);
    }

    // Chọn nhóm nhỏ HTSP → fill danh sách mã công việc
    private void OnHtspSubGroupChanged(WtsRow row, string? subGroup)
    {
        row.HtspSubGroup = subGroup;
        row.NC = null;
        row.AvailableWtsItems.Clear();
        if (string.IsNullOrEmpty(subGroup) || string.IsNullOrEmpty(row.PO)) return;
        if (!_fullSnapshotCache.TryGetValue(row.PO, out var snap)) return;
        row.AvailableWtsItems = subGroup switch
        {
            // Taro: dùng WtsTaskCode làm mã CV (mới), fallback về NC nếu snapshot cũ chưa có WtsTaskCode
            "Taro"  => snap.Taro.Where(s => !string.IsNullOrEmpty(s.WtsTaskCode) || !string.IsNullOrEmpty(s.NC))
                           .Select(s => {
                               var code = string.IsNullOrEmpty(s.WtsTaskCode) ? s.NC : s.WtsTaskCode;
                               return new WtsItem(code, s.StepName ?? code);
                           }).ToList(),
            "Bavia" => snap.Bavia  .Where(s => !string.IsNullOrEmpty(s.NC)).Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList(),
            "Rua"   => snap.Washing.Where(s => !string.IsNullOrEmpty(s.NC)).Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList(),
            _       => new List<WtsItem>()
        };
    }

    private void OnWtsItemChanged(WtsRow row, string? nc)
    {
        row.NC = nc;
        CheckQtyWarning(row);
    }

    private void OnWtsOtherChanged(WtsRow row, string? code)
    {
        row.WtsCode = code;
        row.WtsName = _wtsTasks.FirstOrDefault(t => t.TaskCode == code)?.TaskName;
    }

    // Datalist input handler — user gõ hoặc chọn từ list
    private void OnWtsCodeInput(WtsRow row, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        row.WtsCode = val;
        // Nếu khớp đúng 1 TaskCode → tự fill WtsName
        var matched = _wtsTasks.FirstOrDefault(t => t.TaskCode == val);
        row.WtsName = matched?.TaskName;
    }

    private string GetWtsItemTitle(WtsRow row)
    {
        var found = row.AvailableWtsItems.FirstOrDefault(i => i.NC == row.NC);
        return found != null ? $"{found.NC} — {found.Name}" : "-- Chọn mã CV --";
    }

    private static string BuildNcLabel(bool isDone, bool machineBlocked, bool isExcluded,
        bool regBroken, string[] altMachines, string? ncCode, string regMachine,
        decimal planQty, string? unit, decimal wtsDone)
    {
        if (isDone)        return $"✅ NC{ncCode} — ĐÃ ĐỦ SL ({planQty.ToString("0.##")} {unit})";
        if (machineBlocked) return $"⛔ NC{ncCode} — {regMachine} ĐANG HỎNG";
        if (isExcluded)    return $"⚙️ NC{ncCode} — {regMachine} (loại trừ)";
        if (regBroken && altMachines.Any())
        {
            var okAlt = altMachines.FirstOrDefault(m => true); // caller đã lọc broken
            return $"⚠️ NC{ncCode} — {regMachine} hỏng, dùng DP: {okAlt}";
        }
        var icon = wtsDone > 0 ? "🟡" : "⬜";
        return $"{icon} NC{ncCode} — {regMachine} (đã làm: {wtsDone.ToString("0.##")})";
    }

    // Gọi khi user đổi QtyOk hoặc QtyNg — sync QtyDone + trigger warn
    private void OnQtyChanged(WtsRow row)
    {
        row.QtyDone = row.QtyOk + row.QtyNg;
        CheckQtyWarning(row);
    }

    // Xử lý input riêng từng cột — tránh lambda phức tạp trong Razor markup
    // (Razor parser hiểu nhầm "out var v" thành HTML tag < var >)
    private void OnQtyOkInput(WtsRow row, ChangeEventArgs e)
    {
        row.QtyOk = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m;
        OnQtyChanged(row);
    }

    private void OnQtyNgInput(WtsRow row, ChangeEventArgs e)
    {
        row.QtyNg = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m;
        OnQtyChanged(row);
    }

    private void CheckQtyWarning(WtsRow row)
    {
        row.HasWarning  = false;
        row.WarningMsg  = null;
        if (row.KhPlanDetailId == null || string.IsNullOrEmpty(row.NC)) return;

        var detail = _allRows.FirstOrDefault(r => r.KhPlanDetailId == row.KhPlanDetailId);
        if (detail == null) return;

        // v0.8b: Không cascade lock — trong cùng nhóm làm NC nào cũng được.
        // Chỉ warn khi QtyDone lần này vượt PlanQty (mỗi NC max = PlanQty).
        var flow = GetFlowItem(row.KhPlanDetailId, row.NC);
        var wtsDoneAtNc = flow?.WtsDone ?? 0m;

        // NC dùng máy loại trừ — warn nhẹ (không block)
        if (flow?.IsExcluded == true)
        {
            // Chỉ warn info, không block save, không màu đỏ
            row.HasWarning = false; // không tô vàng row
            // Cảnh báo riêng hiển thị dưới dropdown
        }

        // Warn khi nhập vượt PlanQty
        if (row.QtyDone > detail.Quantity)
        {
            row.HasWarning = true;
            row.WarningMsg = $"SL nhập ({row.QtyDone}) vượt KH ({detail.Quantity} {detail.Unit}). Kiểm tra lại.";
        }
        // Warn khi tổng đã làm NC này + mới vượt PlanQty
        else if (wtsDoneAtNc + row.QtyDone > detail.Quantity && wtsDoneAtNc > 0)
        {
            row.HasWarning = true;
            row.WarningMsg = $"NC {row.NC} đã làm {wtsDoneAtNc:0.##} + nhập thêm {row.QtyDone} = {wtsDoneAtNc + row.QtyDone} vượt KH ({detail.Quantity} {detail.Unit}).";
        }
    }

    // ── Lưu 1 dòng ───────────────────────────────────────────
    private async Task SaveRowAsync(WtsRow row)
    {
        row.ErrorMsg = null;

        if (!IsToday)
        { row.ErrorMsg = "Chỉ được nhập WTS cho ngày hôm nay. Ngày cũ cần quyền cao hơn."; return; }

        // Validate chung
        if (row.Minutes <= 0)
        { row.ErrorMsg = "T.Kết thúc phải sau T.Bắt đầu"; return; }

        if (string.IsNullOrEmpty(row.NC) && string.IsNullOrEmpty(row.WtsCode))
        { row.ErrorMsg = "Chọn NC (nếu có PO) hoặc Mã WTS khác"; return; }

        // Nếu đang sửa dòng cũ → void record cũ trước
        if (row.IsEditing)
        {
            if (row.WtsLogId.HasValue)
            {
                await Db.Database.ExecuteSqlRawAsync(
                    "UPDATE WtsProductionLogs SET IsVoided=1, VoidReason=N'Sửa lại', VoidedBy={0}, VoidedAt={1} WHERE WtsLogId={2}",
                    _currentUserId, DateTime.Now, row.WtsLogId.Value);
            }
            if (row.ActivityLogId.HasValue)
            {
                await Db.Database.ExecuteSqlRawAsync(
                    "UPDATE WorkerActivityLogs SET IsVoided=1, VoidReason=N'Sửa lại', VoidedBy={0}, VoidedAt={1} WHERE ActivityLogId={2}",
                    _currentUserId, DateTime.Now, row.ActivityLogId.Value);
            }
            row.WtsLogId      = null;
            row.ActivityLogId = null;
            row.IsEditing     = false;
        }

        // ── Loại 1: Có NC → link PO → WtsProductionLog ──────
        if (!string.IsNullOrEmpty(row.NC))
        {
            if (row.KhPlanDetailId == null)
            { row.ErrorMsg = "Chọn PO để link với NC"; return; }

            // Khuyến nghị chọn máy — cảnh báo nhưng vẫn cho save
            if (string.IsNullOrEmpty(row.MachineUsed))
            {
                row.HasWarning = true;
                row.WarningMsg = (row.WarningMsg ?? "") + " Chưa chọn máy sử dụng.";
            }

            // Validate tổng thời gian thực tế không vượt thời gian ca
            if (row.TimeActualSum > row.Minutes && row.Minutes > 0)
            { row.ErrorMsg = $"Tổng thời gian thực tế ({row.TimeActualSum} phút) vượt quá thời gian ca ({row.Minutes} phút)."; return; }

            CheckQtyWarning(row);

            // v0.8b: Không block theo cascade. Chỉ block khi QtyDone > PlanQty.
            if (row.QtyDone <= 0)
            { row.ErrorMsg = "SL (OK + NG) phải lớn hơn 0."; return; }

            if (row.QtyNg > 0 && string.IsNullOrWhiteSpace(row.NgReason))
            { row.ErrorMsg = "Phải nhập lý do NG khi có số lượng NG."; return; }

            var detForSave = _allRows.FirstOrDefault(r => r.KhPlanDetailId == row.KhPlanDetailId);
            if (detForSave != null && row.QtyDone > detForSave.Quantity)
            { row.ErrorMsg = $"Tổng OK+NG ({row.QtyDone}) vượt KH ({detForSave.Quantity} {detForSave.Unit}). Không được phép."; return; }

            // Warn thêm nếu NC loại trừ (không block)
            if (GetFlowItem(row.KhPlanDetailId, row.NC)?.IsExcluded == true)
            {
                row.HasWarning = true;
                row.WarningMsg = (row.WarningMsg ?? "") + $" NC {row.NC} dùng máy loại trừ — thường do nhóm HTSP thực hiện.";
            }

            try
            {
                // Xác định ProcessGroup và NC/WtsCode theo nhóm công nhân
                string processGroup;
                string? ncValue;
                string? wtsCodeValue;
                if (IsGcGroup)
                {
                    processGroup  = "GC";
                    ncValue       = row.NC;
                    wtsCodeValue  = null;
                }
                else if (IsHtspGroup)
                {
                    processGroup = row.HtspSubGroup switch
                    {
                        "Taro"  => "TARO",
                        "Bavia" => "BAVIA",
                        "Rua"   => "WASHING",
                        _       => "TARO"
                    };
                    ncValue      = null;
                    wtsCodeValue = row.NC;  // NC chọn từ WtsItem lưu vào WtsCode
                }
                else if (HandoverGroupCode == "KCS")
                {
                    processGroup  = "KCS";
                    ncValue       = null;
                    wtsCodeValue  = row.NC;
                }
                else // PKG
                {
                    processGroup  = "PKG";
                    ncValue       = null;
                    wtsCodeValue  = row.NC;
                }

                var log = new WtsProductionLog
                {
                    KhPlanDetailId          = row.KhPlanDetailId.Value,
                    ProcessGroup            = processGroup,
                    NC                      = ncValue,
                    WtsCode                 = wtsCodeValue,
                    HtspSubGroup            = IsHtspGroup ? row.HtspSubGroup : null,
                    WorkerId                = _currentUserId,
                    MachineUsed             = row.MachineUsed,
                    QtyDone                 = row.QtyDone,
                    QtyOk                   = row.QtyOk,
                    QtyNg                   = row.QtyNg,
                    NgReason                = row.QtyNg > 0 ? row.NgReason : null,
                    StartTime               = row.StartTime,
                    EndTime                 = row.EndTime,
                    Notes                   = row.Notes,
                    SetupTime_Actual        = row.SetupTime_Actual,
                    MachiningTime_Actual    = row.MachiningTime_Actual,
                    InspectionTime_Actual   = row.InspectionTime_Actual,
                    PreparationTime_Actual  = row.PreparationTime_Actual,
                    TrialRunTime_Actual     = row.TrialRunTime_Actual,
                    CreatedAt               = DateTime.Now,
                    IsVoided                = false,
                };
                Db.WtsProductionLogs.Add(log);
                await Db.SaveChangesAsync();
                row.WtsLogId = log.WtsLogId;
                Db.ChangeTracker.Clear(); // clear EF cache để reload mới nhất

                // Reload qty cache + flow (v0.8)
                var summary = await KhSvc.GetWtsQtySummaryAsync(row.KhPlanDetailId.Value);
                foreach (var kv in summary)
                    _qtySummaryCache[$"{row.KhPlanDetailId}|{kv.Key}"] = kv.Value;
                await ReloadFlowAsync(row.KhPlanDetailId.Value);
            }
            catch (Exception ex)
            {
                var inner = ex.InnerException?.Message ?? ex.Message;
                row.ErrorMsg = "Lỗi khi lưu: " + inner;
                return;
            }
        }
        // ── Loại 2: Mã WTS khác (không link PO) → WorkerActivityLog ──
        else
        {
            try
            {
                var actLog = new WorkerActivityLog
                {
                    WorkerId  = _currentUserId,
                    WorkDate  = DateOnly.FromDateTime(_workDate),
                    StartTime = row.StartTime,
                    EndTime   = row.EndTime,
                    WtsCode   = row.WtsCode,
                    WtsName   = row.WtsName,
                    Notes     = row.Notes,
                    CreatedAt = DateTime.Now,
                    IsVoided  = false,
                };
                Db.WorkerActivityLogs.Add(actLog);
                await Db.SaveChangesAsync();
                row.ActivityLogId = actLog.ActivityLogId;
                Db.ChangeTracker.Clear();
            }
            catch (Exception ex)
            {
                var inner = ex.InnerException?.Message ?? ex.Message;
                row.ErrorMsg = "Lỗi khi lưu: " + inner;
                return;
            }
        }

        row.Saved = true;

        // Reload lại toàn bộ: danh sách dòng đã lưu + qty summary cho tất cả PO
        var unsavedRows = _rows.Where(r => !r.Saved).ToList();
        await LoadSavedRowsAsync();
        // Giữ lại các dòng chưa lưu
        _rows.AddRange(unsavedRows);

        // Reload qty summary + flow cho tất cả PO đang có trong session (v0.8)
        _qtySummaryCache.Clear();
        _ncFlowCache.Clear();
        foreach (var po in _rows.Where(r => r.KhPlanDetailId.HasValue)
                                 .Select(r => r.KhPlanDetailId!.Value)
                                 .Distinct())
        {
            var sum = await KhSvc.GetWtsQtySummaryAsync(po);
            foreach (var kv in sum)
                _qtySummaryCache[$"{po}|{kv.Key}"] = kv.Value;
            await ReloadFlowAsync(po);
        }

        // Reload receivedOk cache cho PO vừa lưu
        if (row.KhPlanDetailId.HasValue)
        {
            var grp = HandoverGroupCode;
            var ro  = await HandoverSvc.GetReceivedOkAsync(row.KhPlanDetailId.Value, grp);
            var det = _allRows.FirstOrDefault(d => d.KhPlanDetailId == row.KhPlanDetailId.Value);
            _receivedOkCache[row.KhPlanDetailId.Value] = ro > 0 ? ro : (det?.Quantity ?? ro);
        }

        // Reload snapshot cache cho các PO đang dùng
        foreach (var r in _rows.Where(r => !string.IsNullOrEmpty(r.PO) && r.KhPlanDetailId.HasValue && !r.Saved))
        {
            if (!_snapshotCache.ContainsKey(r.PO!))
            {
                var snap = await KhSvc.GetRouteSnapshotAsync(r.KhPlanDetailId!.Value);
                _snapshotCache[r.PO!] = snap.Machining;
                r.AvailableNCs = snap.Machining;
            }
        }

        AddRow(); // mở sẵn dòng trống tiếp theo
    }

    // ── Classes ───────────────────────────────────────────────
    // Cache WTS logs theo PO — để hiện bảng quy trình real-time
    private Dictionary<string, List<WtsProductionLog>> _wtsLogsCache = new();

    private List<WtsProductionLog> GetWtsLogsFor(string po, string group, string? wtsCode = null)
    {
        if (!_wtsLogsCache.TryGetValue(po, out var logs)) return new();
        return logs.Where(l => l.ProcessGroup == group
            && !l.IsVoided
            && (wtsCode == null || l.WtsCode == wtsCode || l.NC == wtsCode)).ToList();
    }

    private decimal GetWtsQtyFor(string po, string group, string? wtsCode = null)
        => GetWtsLogsFor(po, group, wtsCode).Sum(l => l.QtyDone);

    private static string FmtTimeWts(decimal? v)
        => v.HasValue && v > 0 ? v.Value.ToString("0.##") : "—";

    private async Task ReloadWtsLogsAsync(string po, int detailId)
    {
        var logs = await Db.WtsProductionLogs
            .Include(l => l.Worker)
            .Where(l => l.KhPlanDetailId == detailId && !l.IsVoided)
            .OrderBy(l => l.StartTime)
            .AsNoTracking()
            .ToListAsync();
        _wtsLogsCache[po] = logs;
    }

    private decimal? GetStdTimeForWtsCode(WtsRow row)
    {
        if (string.IsNullOrEmpty(row.PO) || string.IsNullOrEmpty(row.NC)) return null;
        if (!_fullSnapshotCache.TryGetValue(row.PO, out var snap)) return null;
        var nc = row.NC;
        // HTSP: tìm trong Taro/Bavia/Washing theo HtspSubGroup
        if (IsHtspGroup)
        {
            return row.HtspSubGroup switch
            {
                "Taro"  => snap.Taro   .FirstOrDefault(s => s.NC == nc)?.StandardTime,
                "Bavia" => snap.Bavia  .FirstOrDefault(s => s.NC == nc)?.StandardTime,
                "Rua"   => snap.Washing.FirstOrDefault(s => s.NC == nc)?.StandardTime,
                _       => null
            };
        }
        // KCS
        if (HandoverGroupCode == "KCS")
            return snap.Inspection.FirstOrDefault(s => s.NC == nc)?.StandardTime;
        // PKG
        return snap.Packaging.FirstOrDefault(s => s.NC == nc)?.StandardTime;
    }

    private string? GetActivePO()
        => _rows.FirstOrDefault(r => !r.Saved && !string.IsNullOrEmpty(r.PO))?.PO
        ?? _rows.LastOrDefault(r => r.Saved && !string.IsNullOrEmpty(r.PO))?.PO;

    private static string[] GetAltMachinesFromTimingRows(
        IEnumerable<KhPlanRouteSnapshotMachiningTiming> timingRows)
        => timingRows
            .OrderBy(t => t.DisplayOrder)
            .SelectMany(t => (t.SoMay ?? "").Split(new[] { ',', ';' },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Distinct()
            .ToArray();

    private List<string> GetMachineOptions(WtsRow row)
    {
        var snap = row.AvailableNCs.FirstOrDefault(n => n.NC == row.NC);
        var opts = new List<string>();
        if (snap == null) return opts;

        // Máy đăng ký luôn đứng đầu
        if (!string.IsNullOrEmpty(snap.MachineRegistered))
            opts.Add(snap.MachineRegistered);

        // Máy đồng dạng: mỗi TimingRow có SoMay = "C04, C06" → parse ra từng máy
        foreach (var t in snap.TimingRows.OrderBy(t => t.DisplayOrder))
        {
            foreach (var m in (t.SoMay ?? "").Split(new[] { ',', ';' },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (!opts.Contains(m)) opts.Add(m);
            }
        }

        return opts;
    }

    /// <summary>Item mã công việc cho nhóm non-GC (HTSP/KCS/PKG)</summary>
    public record WtsItem(string NC, string Name);

    public class WtsRow
    {
        public long? WtsLogId      { get; set; }
        public long? ActivityLogId { get; set; }
        public int? KhPlanDetailId { get; set; }

        public DateTime StartTime { get; set; }
        public DateTime EndTime   { get; set; }
        public int Minutes => EndTime > StartTime ? (int)(EndTime - StartTime).TotalMinutes : -1;

        public string? PO      { get; set; }
        public string? PartNo  { get; set; }
        public string? NC      { get; set; }
        public string? WtsCode { get; set; }
        public string? WtsName { get; set; }

        public List<KhPlanRouteSnapshotMachining> AvailableNCs { get; set; } = new();

        /// <summary>Nhóm nhỏ HTSP đang chọn: "Taro" / "Bavia" / "Rua"</summary>
        public string? HtspSubGroup { get; set; }

        /// <summary>Danh sách mã công việc cho nhóm non-GC (load từ snapshot Taro/Bavia/Washing/Inspection/Packaging)</summary>
        public List<WtsItem> AvailableWtsItems { get; set; } = new();

        /// <summary>Máy thực tế sử dụng — bắt buộc khi có NC (nhóm GC)</summary>
        public string? MachineUsed { get; set; }

        public decimal QtyDone { get; set; }  // = QtyOk + QtyNg (tương thích backward)
        public decimal QtyOk   { get; set; }  // SL làm đúng
        public decimal QtyNg   { get; set; }  // SL làm sai phát hiện tại NC
        public string? NgReason { get; set; } // Lý do NG (bắt buộc khi QtyNg > 0)
        public string? Notes   { get; set; }

        // Thời gian thực tế (phút) — chỉ nhóm GC, tổng = EndTime - StartTime
        public decimal? SetupTime_Actual      { get; set; }
        public decimal? MachiningTime_Actual  { get; set; }
        public decimal? InspectionTime_Actual { get; set; }
        public decimal? PreparationTime_Actual{ get; set; }
        public decimal? TrialRunTime_Actual   { get; set; }

        // Tổng thời gian thực tế đã nhập (phút)
        public decimal TimeActualSum =>
            (SetupTime_Actual ?? 0) + (MachiningTime_Actual ?? 0) +
            (InspectionTime_Actual ?? 0) + (PreparationTime_Actual ?? 0) +
            (TrialRunTime_Actual ?? 0);

        // Còn lại chưa phân bổ (phút)
        public decimal TimeActualRemaining => Minutes - TimeActualSum;

        public bool    ShowTimeDetail { get; set; } // toggle expand thời gian thực tế

        public bool    Saved      { get; set; }
        public bool    IsEditing  { get; set; }
        public string? ErrorMsg   { get; set; }
        public bool    HasWarning { get; set; }
        public string? WarningMsg { get; set; }
    }
    // ── Report methods ────────────────────────────────────────────────────

    private async Task SwitchToReport()
    {
        _activeTab = "report";
        // Load danh sách workers có WTS trong 30 ngày gần nhất khi mở tab lần đầu
        if (!_reportWorkers.Any())
        {
            var from = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
            var to   = DateOnly.FromDateTime(DateTime.Today);
            _reportWorkers = await ReportSvc.GetWorkersWithLogsAsync(from, to);
        }
        // Tự load report hôm nay luôn
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _reportLoading = true;
        _reportResult  = null;
        StateHasChanged();

        var from = DateOnly.FromDateTime(_reportDateFrom);
        var to   = DateOnly.FromDateTime(_reportDateTo);
        int? wId = _reportWorkerId == 0 ? null : _reportWorkerId;

        _reportResult = await ReportSvc.GetReportAsync(from, to, wId);

        // Cập nhật danh sách workers cho khoảng ngày mới
        _reportWorkers = await ReportSvc.GetWorkersWithLogsAsync(from, to);

        _reportLoading = false;
    }

