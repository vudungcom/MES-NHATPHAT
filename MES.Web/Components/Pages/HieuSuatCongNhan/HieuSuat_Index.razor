                                                <td class="text-center small" style="font-size:0.7rem;">@log.StartTime.ToString("dd/MM HH:mm")</td>
                                                <td class="text-center small" style="font-size:0.7rem;">@log.EndTime.ToString("dd/MM HH:mm")</td>
