                                        <input class="form-control form-control-sm" style="font-size:11px"
                                               list="@dlId"
                                               value="@sub.PO"
                                               placeholder="Gõ PO..."
                                               autocomplete="off"
                                               @oninput="async e => await OnSubPoInput(grp, sub, e.Value?.ToString())" />
                                        <datalist id="@dlId">
                                            @foreach (var det in _allRows.Where(r =>
                                                (string.IsNullOrEmpty(grp.PartNo) || r.PartNo == grp.PartNo) &&
                                                (string.IsNullOrEmpty(sub.PoFilter)  ||
                                                 r.PurchaseOrder.Contains(sub.PoFilter, StringComparison.OrdinalIgnoreCase) ||
                                                 r.PartNo.Contains(sub.PoFilter, StringComparison.OrdinalIgnoreCase))))
                                            {
                                                <option value="@det.PurchaseOrder">@det.PartNo — @det.PlanNo</option>
                                            }
                                        </datalist>
                                    </td>

