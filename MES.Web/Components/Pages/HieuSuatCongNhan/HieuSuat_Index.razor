    private bool _voidBusy;   // chặn bấm 2 lần trong lúc chờ khoá PO
    private async Task OnConfirmVoidAsync()
    {
        if (_voidConfirmRow == null || _voidBusy) return;
        _voidBusy = true;
        try
        {
            if (await VoidSavedRow(_voidConfirmRow)) { _voidConfirmRow = null; _voidBlockMsg = null; }
