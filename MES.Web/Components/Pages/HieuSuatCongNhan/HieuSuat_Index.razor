    /// <summary>

    /// Tính số phút làm việc thực sự trong khoảng [start, end],

    /// trừ đi thời gian nghỉ giải lao của ca đang chọn.

    /// </summary>

    // Tính tổng phút nghỉ giải lao trong khoảng [start, end] của ca

    private double CalcBreakMinutes(DateTime start, DateTime end, CaLamViec? ca)

    {

        if (ca == null || end <= start) return 0;

        var date = start.Date;

        double total = 0;

        foreach (var nghi in ca.NghiGiaiLaos)

        {

            var nghiStart = date.Add(nghi.NghiBatDau.ToTimeSpan());

            var nghiEnd   = date.Add(nghi.NghiKetThuc.ToTimeSpan());

            if (nghi.NghiKetThuc < nghi.NghiBatDau) nghiEnd = nghiEnd.AddDays(1);

            var overlapStart = nghiStart < start ? start : nghiStart;

            var overlapEnd   = nghiEnd   > end   ? end   : nghiEnd;

            if (overlapEnd > overlapStart)

                total += (overlapEnd - overlapStart).TotalMinutes;

        }

        return total;

    }

    // Nếu thời điểm t rơi vào khoảng nghỉ → đẩy ra đến hết khoảng nghỉ đó

    private DateTime SkipBreaks(DateTime t, CaLamViec? ca)

    {

        if (ca == null) return t;

        var date = t.Date;

        bool changed = true;

        while (changed)

        {

            changed = false;

            foreach (var nghi in ca.NghiGiaiLaos)

            {

                var ns = date.Add(nghi.NghiBatDau.ToTimeSpan());

                var ne = date.Add(nghi.NghiKetThuc.ToTimeSpan());

                if (nghi.NghiKetThuc < nghi.NghiBatDau) ne = ne.AddDays(1);

                if (t >= ns && t < ne) { t = ne; changed = true; }

            }

        }

        return t;

    }

    private double CalcEffectiveMinutes(DateTime start, DateTime end, CaLamViec? ca)

    {

        if (end <= start) return 0;

        var total = (end - start).TotalMinutes;

        if (ca == null) return total;

        return Math.Max(0, total - CalcBreakMinutes(start, end, ca));

    }

    /// <summary>
    /// Tính DateTime kết thúc sau khi đã làm đủ <paramref name="prodMin"/> phút thực sự,
    /// bỏ qua các khoảng nghỉ của ca. Thay thế vòng lặp hội tụ 3 bước — vòng lặp đó
    /// không hội tụ khi end-time rơi gần boundary khoảng nghỉ (ví dụ: leo dần đến nghỉ
    /// trưa nhưng dừng trước khi nhảy qua, khiến kết quả thiếu tới ~14 phút).
    /// </summary>
    private DateTime AddEffectiveMinutes(DateTime start, double prodMin, CaLamViec? ca)
    {
        if (prodMin <= 0) return start;
        if (ca == null)   return start.AddMinutes(prodMin);

        var date   = start.Date;
        var cursor = start;
        var rem    = prodMin;

        // Chuẩn hoá khoảng nghỉ, lọc những khoảng kết thúc trước start
        var breaks = ca.NghiGiaiLaos
            .Select(n =>
            {
                var ns = date.Add(n.NghiBatDau.ToTimeSpan());
                var ne = date.Add(n.NghiKetThuc.ToTimeSpan());
                if (n.NghiKetThuc < n.NghiBatDau) ne = ne.AddDays(1);
                return (S: ns, E: ne);
            })
            .Where(b => b.E > start)
            .OrderBy(b => b.S)
            .ToList();

        foreach (var brk in breaks)
        {
            if (rem <= 0) break;

            // Cursor đang nằm trong khoảng nghỉ → nhảy qua
            if (cursor >= brk.S && cursor < brk.E)
            {
                cursor = brk.E;
                continue;
            }

            var toBreak = (brk.S - cursor).TotalMinutes;
            if (toBreak <= 0) continue; // break đã qua

            if (rem <= toBreak)
                return cursor.AddMinutes(rem); // xong trước khi chạm break

            rem   -= toBreak;
            cursor = brk.E; // nhảy qua break, tiếp tục làm
        }

        return cursor.AddMinutes(rem);
    }

