    private void OnGroupHtspSubChanged(WtsGroup grp, string? subGroup)

    {

        grp.HtspSubGroup = subGroup ?? "";

        grp.WtsItems     = new();

        // Reset WtsCode cũ

        foreach (var s in grp.SubRows) { s.WtsCode = null; s.WtsName = null; }
        // [FIX-NONGC-SUBGROUP] Gán nhóm nhỏ xuống từng dòng — trước đây chỉ gán cho nhóm → khi lưu
        // row.HtspSubGroup = null → ProcessGroup rơi về mặc định "TARO" (sai với Bavia/Rửa).
        foreach (var s in grp.SubRows) s.HtspSubGroup = grp.HtspSubGroup;

        // Lấy PO từ sub-row đầu tiên có PO

        var po = grp.SubRows.FirstOrDefault(s => !string.IsNullOrEmpty(s.PO))?.PO;

        if (string.IsNullOrEmpty(po)) { StateHasChanged(); return; }

        if (!_fullSnapshotCache.TryGetValue(po, out var snap)) { StateHasChanged(); return; }

        grp.WtsItems = subGroup switch

        {

            "Taro"  => snap.Taro   .Select(s => new WtsItem(s.WtsTaskCode ?? s.NC, s.StepName ?? s.NC)).ToList(),

            "Bavia" => snap.Bavia  .Select(s => new WtsItem(s.NC,                  s.StepName ?? s.NC)).ToList(),

            "Rua"   => snap.Washing.Select(s => new WtsItem(s.NC,                  s.StepName ?? s.NC)).ToList(),

            _       => new List<WtsItem>()

        };

        StateHasChanged();

    }

    private void ValidateSubQty(WtsRow sub, WtsGroup? grp = null)

    {

        sub.ErrorMsg = null;

        if (!sub.KhPlanDetailId.HasValue) return;
        if (IsPrepNoQty(sub)) return;   // [FLAT-QTY-ZERO] mã chuẩn bị: không kiểm tra SL / giao nhận

        var poQty = _allRows.FirstOrDefault(r => r.KhPlanDetailId == sub.KhPlanDetailId)?.Quantity ?? 0m;

        // [GN-WTS-CAP] Workflow OFF (N7): chỉ chặn mỗi dòng ≤ SL PO — giữ như cũ.
        if (!IsWorkflowOn(sub.KhPlanDetailId))
        {
            if (poQty > 0 && sub.QtyDone > poQty)
                sub.ErrorMsg = $"SL nhập ({sub.QtyDone}) vượt SL PO ({poQty}). Kiểm tra lại.";
            return;
        }

        // [GN-WTS-CAP] Workflow ON: trần = Còn chờ làm của NC (GC) / mã CV (HTSP/KCS/PKG) theo sổ giao nhận (L3).
        // So OK + NG (trước: chỉ so OK). Cộng các dòng CÙNG PO + CÙNG NC/mã CV đang nhập trong form.
        // Trước: GC trần = min(NC trước, PO) − đã làm; non-GC trần = SL nhận gộp mọi phiếu − OK cả nhóm.
        if (grp == null) return;
        var wf = GetWfNcCeiling(grp, sub.KhPlanDetailId, IsGcGroup ? grp.NC : sub.WtsCode);
        if (wf == null || wf.Unlimited) return;
        var totalQty = SumFormQty(grp, sub.KhPlanDetailId, IsGcGroup ? grp.NC : sub.WtsCode);
        if (totalQty <= 0) return;
        if (wf.Locked)
            sub.ErrorMsg = $"⚠️ {wf.Label}: chưa nhận hàng — chưa nhập số lượng được. ({wf.Detail})";   // [GN-TEXT] trước: "chưa có hàng vào"
        else if (totalQty > wf.Ceiling)
            sub.ErrorMsg = $"⚠️ {wf.Label}: nhập {totalQty:0.##} (OK + NG) vượt Chưa làm {wf.Ceiling:0.##}. ({wf.Detail})";   // [GN-TEXT] trước: "Còn chờ làm"

    }

    // [GN-WTS-CAP] Tổng OK + NG trong form của 1 PO + 1 NC / mã CV (máy đồng dạng / mã dự phòng gộp về mã chính).
    private decimal SumFormQty(WtsGroup grp, int? khPlanDetailId, string? code)
    {
        if (!khPlanDetailId.HasValue || string.IsNullOrEmpty(code)) return 0m;
        var pg = CurrentPg(grp);
        var main = GetWtsCap(khPlanDetailId, pg, code)?.Code ?? code;
        return grp.SubRows
            .Where(s => s.KhPlanDetailId == khPlanDetailId)
            .Where(s => string.Equals(GetWtsCap(khPlanDetailId, pg, IsGcGroup ? grp.NC : s.WtsCode)?.Code ?? (IsGcGroup ? grp.NC : s.WtsCode), main, StringComparison.OrdinalIgnoreCase))
            .Sum(s => s.QtyDone);
    }


    // [MACHINE-OVERLAP-LIVE] Báo trùng máy NGAY LÚC NHẬP (đổi máy / giờ bắt đầu / giờ kết thúc).
    // Chỉ báo đỏ (OverlapMsg), KHÔNG chặn — chặn thật vẫn ở lúc Lưu (CheckMachineOverlapAsync + khoá máy).
    // Chỉ thấy được log ĐÃ LƯU; dữ liệu người khác đang nhập chưa lưu thì không thấy được.
    private async Task CheckMachineOverlapLiveAsync(WtsGroup grp)
    {
        foreach (var s in grp.SubRows) s.OverlapMsg = null;
        if (!IsGcGroup || string.IsNullOrEmpty(grp.MachineUsed)) return;
        var machine = grp.MachineUsed;
        var subs = grp.SubRows.Where(s => s.EndTime > s.StartTime).ToList();
        if (!subs.Any()) return;

        // 1) Trong cùng form
        for (int i = 0; i < subs.Count; i++)
            for (int j = i + 1; j < subs.Count; j++)
            {
                var a = subs[i];
                var b = subs[j];
                if (a.StartTime < b.EndTime && b.StartTime < a.EndTime && b.OverlapMsg == null)
                    b.OverlapMsg = $"Máy {machine}: trùng giờ với dòng {a.StartTime:HH:mm}–{a.EndTime:HH:mm} trong form.";
            }

        // 2) Với log đã lưu (mọi công nhân, chưa void) — bỏ qua log cũ của dòng đang sửa
        try
        {
            var minStart  = subs.Min(s => s.StartTime);
            var maxEnd    = subs.Max(s => s.EndTime);
            var skipIds   = subs.Where(s => s.IsEditing && s.WtsLogId.HasValue)
                                .Select(s => s.WtsLogId!.Value).ToList();
            var savedLogs = await Db.WtsProductionLogs
                .AsNoTracking()
                .Include(l => l.Worker)
                .Where(l => !l.IsVoided
                         && l.MachineUsed == machine
                         && l.StartTime < maxEnd
                         && l.EndTime   > minStart
                         && !skipIds.Contains(l.WtsLogId))
                .ToListAsync();

            foreach (var sub in subs)
            {
                if (sub.OverlapMsg != null) continue;
                var hit = savedLogs
                    .Where(l => l.StartTime < sub.EndTime && sub.StartTime < l.EndTime)
                    .OrderBy(l => l.StartTime)
                    .FirstOrDefault();
                if (hit == null) continue;
                var ovStart = hit.StartTime > sub.StartTime ? hit.StartTime : sub.StartTime;
                var ovEnd   = hit.EndTime   < sub.EndTime   ? hit.EndTime   : sub.EndTime;
                var po      = _allRows.FirstOrDefault(r => r.KhPlanDetailId == hit.KhPlanDetailId)?.PurchaseOrder
                              ?? $"KH#{hit.KhPlanDetailId}";
                var worker  = hit.Worker?.FullName ?? $"#{hit.WorkerId}";
                var fmt     = hit.StartTime.Date == sub.StartTime.Date ? "HH:mm" : "dd/MM HH:mm";
                sub.OverlapMsg = $"Máy {machine} đã có log {hit.StartTime.ToString(fmt)}–{hit.EndTime.ToString(fmt)} "
                               + $"(PO {po}, NC {hit.NC}, {worker}) — trùng {ovStart:HH:mm}–{ovEnd:HH:mm}. Sẽ không lưu được.";
            }
        }
        catch
        {
            // Lỗi tra cứu lúc nhập không được làm hỏng form — lúc Lưu vẫn kiểm tra lại.
        }
    }


    // [WF-CEIL-MIN] → [GN-WTS-CAP] Trần SL của 1 NC (GC) / 1 mã CV (HTSP/KCS/PKG) cho 1 PO khi Workflow ON —
    // dùng chung cho realtime + Lưu + nhãn dropdown NC.
    // Nay lấy từ hàm chung HandoverLedgerService.WtsCap (cùng số với trang Giao nhận):
    //   trần = Còn chờ làm = Hàng vào NC/mã − OK đã làm − NG đã làm (L3, N1, N2, N3, N5).
    // Trước: NC đầu = PO − đã làm (không xét hàng đã nhận); NC sau = min(NC trước OK+NG, PO) − đã làm.
    // Trả null nếu Workflow OFF hoặc chưa có sổ.
    private sealed class WfCeilInfo
    {
        public decimal  Ceiling   { get; set; }
        public bool     Unlimited { get; set; }   // mã chuẩn bị: không chặn số lượng
        public bool     Locked    { get; set; }   // chưa từng có hàng vào NC / mã này
        public string   Label     { get; set; } = "";   // "PO X · NC Y"
        public string   Detail    { get; set; } = "";   // phép tính: "Hàng vào 100 − OK 50 − NG 5 = 45"
    }

    // [GN-WTS-CAP] Phép tính có tên từng số hạng — [WTS-SVC] dời sang WtsSaveService.CapDetail (dùng chung với lúc Lưu)
    private static string CapDetail(HandoverLedgerService.WtsCapInfo cap) => WtsSaveService.CapDetail(cap);

    private WfCeilInfo? GetWfNcCeiling(WtsGroup grp, int? detailId, string? code)
    {
        if (!detailId.HasValue || string.IsNullOrEmpty(code)) return null;
        if (!IsWorkflowOn(detailId)) return null;
        var cap = GetWtsCap(detailId, CurrentPg(grp), code);
        if (cap == null) return null;
        var po = _allRows.FirstOrDefault(r => r.KhPlanDetailId == detailId)?.PurchaseOrder ?? "";
        var detail = CapDetail(cap);
        return new WfCeilInfo
        {
            Ceiling   = cap.Max ?? 0m,
            Unlimited = cap.Max == null,
            Locked    = cap.Locked,
            Label     = $"PO {po} · {(IsGcGroup ? "NC" : "mã")} {cap.Code}",
            Detail    = detail
        };
    }

