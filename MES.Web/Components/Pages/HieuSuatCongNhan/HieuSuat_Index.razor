                                            <td class="text-end text-muted small">@FmtTimeWts(s.MachiningTime)</td>
                                            <td class="text-end"></td>
                                            <td class="text-end text-muted small">@FmtTimeWts(s.InspectionTime)</td>
                                            <td class="text-end"></td>
                                            <td class="text-end text-muted small">@FmtTimeWts(s.PreparationTime)</td>
                                            <td class="text-end"></td>
                                            <td class="text-end text-muted small">@FmtTimeWts(s.TrialRunTime)</td>
