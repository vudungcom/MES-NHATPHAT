                                                <td class="text-end" style="color:#0d6efd;">@FmtTimeWts(log.SetupTime_Actual)</td>
                                                <td class="text-end text-muted">—</td>
                                                <td class="text-end" style="color:#0d6efd;">@FmtTimeWts(log.MachiningTime_Actual)</td>
