    }

    private void OnSubWtsCodeChanged(WtsGroup grp, WtsRow sub, string? code)

    {

        // Mỗi row chọn Mã CV độc lập — không propagate sang row khác
        sub.WtsCode = code;

        var item = grp.WtsItems.FirstOrDefault(i => i.NC == code);

        sub.WtsName = item?.Name;
        // [FLAT-QTY-ZERO] Mã chuẩn bị không có khối lượng → xóa SL đã nhập + lỗi SL cũ
        if (IsPrepNoQty(sub)) { sub.QtyOk = 0; sub.QtyNg = 0; sub.QtyDone = 0; sub.NgReason = null; sub.NgCategoryId = null; sub.ErrorMsg = null; }   // [VULOI] + loại lỗi

        // [FIX2] Auto-fill T.Chuẩn/pc từ snapshot khi chọn Mã CV (non-GC)
        // Dùng PO của chính sub đang chọn, không propagate sang row khác
        if (!IsGcGroup)
        {
            decimal? stdTime = null;
            if (!string.IsNullOrEmpty(sub.PO) && !string.IsNullOrEmpty(code)
                && _fullSnapshotCache.TryGetValue(sub.PO, out var fsnap))
            {
                if (IsHtspGroup)
                    stdTime = grp.HtspSubGroup switch
                    {
                        "Taro"  => fsnap.Taro.FirstOrDefault(s => (s.WtsTaskCode ?? s.NC) == code)?.StandardTime,
                        "Bavia" => fsnap.Bavia.FirstOrDefault(s => s.NC == code)?.StandardTime,
                        "Rua"   => fsnap.Washing.FirstOrDefault(s => s.NC == code)?.StandardTime,
                        _       => null
                    };
                else if (HandoverGroupCode == "KCS")
                    stdTime = fsnap.Inspection.FirstOrDefault(s => s.NC == code)?.StandardTime;
                else // PKG / Đóng gói
                    stdTime = fsnap.Packaging.FirstOrDefault(s => s.NC == code)?.StandardTime;
            }
            sub.StandardTimePerPc = stdTime; // chỉ set cho row này
            // [STD-ACTUAL-DEFAULT] Mục 29: bật "Tham khảo chuẩn" → T.Thực tế/pc = T.Chuẩn/pc của mã vừa chọn
            if (grp.UseStdAsDefault) { sub.UseStdAsDefault = true; TryFillStdValues(sub); }
            RecalcGroupTimeline(grp);   // [NONGC-ALLOC-WEIGHT] Mã CV đổi → khối lượng đổi → chia lại
        }
        StateHasChanged();

    }

