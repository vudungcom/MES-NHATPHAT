                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Kiểm tra</th>
                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Chuẩn bị</th>
                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Chạy thử</th>
                                        <th style="width:65px;" class="text-center" rowspan="2">TT</th>
                                    </tr>
                                    <tr>
                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>
                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>
                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>
                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>
                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>
                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>
                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>
                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>
                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>
                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in activeMachining)
                                    {
                                        var gcLogs = GetWtsLogsFor(activePO, "GC", s.NC);
