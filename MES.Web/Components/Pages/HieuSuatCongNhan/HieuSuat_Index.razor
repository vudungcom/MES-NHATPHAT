                                            <input type="text" class="form-control form-control-sm text-center"
                                                   list="@($"ts-{grpIdx}-{subIdx}")" pattern="[0-9]{2}:[0-9]{2}" placeholder="HH:mm" maxlength="5"
                                                   value="@sub.StartTime.ToString("HH:mm")"
                                                   @onchange="e => OnSubStartTimeChanged(grp, sub, e.Value?.ToString())" />
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control form-control-sm bg-light text-muted text-center"
                                                   value="@sub.StartTime.ToString("HH:mm")" readonly
                                                   title="Tự tính = Kết thúc hàng trước" />
                                        }
                                    </td>

                                    @* Kết thúc — hàng cuối luôn nhập tay, hàng giữa tự tính *@
                                    <td>
                                        @if (isLast)
                                        {
