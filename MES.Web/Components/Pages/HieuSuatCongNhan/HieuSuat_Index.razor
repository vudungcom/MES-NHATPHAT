    private void SetGroupModeSerial(WtsGroup grp) { grp.ProductionMode = "serial"; OnGroupModeChanged(grp); }
    private void SetGroupModeTrial(WtsGroup grp)  { grp.ProductionMode = "trial";  OnGroupModeChanged(grp); }
    private void OnGroupModeChanged(WtsGroup grp)
    {
        foreach (var sub in grp.SubRows)
        {
            sub.ProductionMode = grp.ProductionMode;
            if (grp.ProductionMode == "serial") { sub.PreparationTime_Actual = null; sub.TrialRunTime_Actual = null; }
            else { sub.SetupTime_Actual = null; sub.MachiningTime_Actual = null; sub.InspectionTime_Actual = null; }
            if (grp.UseStdAsDefault) TryFillStdValues(sub);
        }
    }

    // ── AddGroup / RemoveGroup ──
    private void AddGroup(bool isOT = false)
    {
        if (!IsToday) return;
        var lastSaved = _rows.LastOrDefault(r => r.Saved && r.IsOvertime == isOT);
        var startTime = lastSaved?.EndTime ?? _workDate.Date.AddHours(8);
        var grp = new WtsGroup { UseStdAsDefault = _useStdAsDefault, IsOvertime = isOT };
        var sub = new WtsRow
        {
            StartTime       = startTime,
            EndTime         = startTime.AddMinutes(1),
            UseStdAsDefault = _useStdAsDefault,
            ProductionMode  = "serial",
            IsOvertime      = isOT,
        };
        grp.SubRows.Add(sub);
        // if (isOT) _groupsOT.Add(grp); // OT removed 2026-09
        _groups.Add(grp);
    }
    private void RemoveGroup(WtsGroup grp)
    {
        _groups.Remove(grp);
        // _groupsOT.Remove(grp); // OT removed 2026-09
    }

    // ── AddSubRow / RemoveSubRow ──
    private void AddSubRow(WtsGroup grp)
    {
        // StartTime = EndTime của sub-row cuối
        var lastSub = grp.SubRows.LastOrDefault();
        var sub = new WtsRow
        {
            StartTime       = lastSub?.EndTime ?? _workDate.Date.AddHours(8),
            EndTime         = lastSub?.EndTime.AddMinutes(1) ?? _workDate.Date.AddHours(8).AddMinutes(1),
            UseStdAsDefault = grp.UseStdAsDefault,
            ProductionMode  = grp.ProductionMode,
            NC              = grp.NC,
            MachineUsed     = grp.MachineUsed,
        };
        // Copy timing từ sub đầu nếu UseStdAsDefault
        if (grp.UseStdAsDefault && grp.SubRows.Any())
        {
            var first = grp.SubRows.First();
            sub.SetupTime_Actual       = first.SetupTime_Actual;
            sub.MachiningTime_Actual   = first.MachiningTime_Actual;
            sub.InspectionTime_Actual  = first.InspectionTime_Actual;
            sub.PreparationTime_Actual = first.PreparationTime_Actual;
            sub.TrialRunTime_Actual    = first.TrialRunTime_Actual;
        }
        grp.SubRows.Add(sub);
    }
    private void RemoveSubRow(WtsGroup grp, WtsRow sub)
    {
        grp.SubRows.Remove(sub);
        RecalcGroupTimeline(grp);
    }

    // ── Group NC / Machine changed ──
    private void OnGroupNCChanged(WtsGroup grp, string? nc)
    {
        grp.NC = nc;
        // Cập nhật NC cho tất cả sub-rows
        foreach (var sub in grp.SubRows) { sub.NC = nc; sub.AvailableNCs = grp.AvailableNCs; }
        // Reset máy khi đổi NC
        grp.MachineUsed = null;
        foreach (var sub in grp.SubRows) sub.MachineUsed = null;
    }
    private void OnGroupMachineChanged(WtsGroup grp, string? machine)
    {
        grp.MachineUsed = machine;
        foreach (var sub in grp.SubRows) { sub.MachineUsed = machine; }
        // Fill std values cho tất cả sub-rows
        if (grp.UseStdAsDefault)
            foreach (var sub in grp.SubRows) TryFillStdValues(sub);
    }
    private List<string> GetGroupMachineOptions(WtsGroup grp)
    {
        if (string.IsNullOrEmpty(grp.NC)) return new();
        var snap = grp.AvailableNCs.FirstOrDefault(s => s.NC == grp.NC);
        if (snap == null) return new();
        var machines = new List<string>();
        if (!string.IsNullOrEmpty(snap.MachineRegistered)) machines.Add(snap.MachineRegistered);
        foreach (var tr in snap.TimingRows)
        {
            foreach (var m in (tr.SoMay ?? "").Split(',', ';').Select(x => x.Trim()).Where(x => x.Length > 0))
                if (!machines.Contains(m)) machines.Add(m);
        }
        return machines;
    }

    // ── Toggle UseStdAsDefault cho nhóm ──
    private async Task OnGroupUseStdToggled(WtsGroup grp, bool value)
    {
        grp.UseStdAsDefault = value;
        _useStdAsDefault = value;
        if (value)
            foreach (var sub in grp.SubRows) { sub.UseStdAsDefault = true; TryFillStdValues(sub); }
        try { await JS.InvokeVoidAsync("localStorage.setItem", $"wts_useStdAsDefault_{_currentUserId}", value ? "true" : "false"); }
        catch { }
    }

    // ── Nhập PO cho sub-row — lọc datalist + auto-match ──
    private async Task OnSubPoInput(WtsGroup grp, WtsRow sub, string? text)
    {
        sub.PoFilter = text ?? "";
        sub.PO       = text ?? "";
        // Tìm exact match
        var det = _allRows.FirstOrDefault(r =>
            r.PurchaseOrder.Equals(text ?? "", StringComparison.OrdinalIgnoreCase));
        if (det != null)
        {
            await OnSubRowKhChanged(grp, sub, det.KhPlanDetailId.ToString());
        }
        else
        {
            sub.KhPlanDetailId = null;
            sub.PartNo         = null;
        }
        StateHasChanged();
    }

    // ── Chọn KH cho sub-row ──
    private async Task OnSubRowKhChanged(WtsGroup grp, WtsRow sub, string? detailIdStr)
    {
        sub.ErrorMsg = null;
        if (!int.TryParse(detailIdStr, out var detId)) { sub.KhPlanDetailId = null; sub.PO = null; sub.PartNo = null; return; }
        var det = _allRows.FirstOrDefault(r => r.KhPlanDetailId == detId);
        if (det == null) return;

        sub.KhPlanDetailId = detId;
        sub.PO             = det.PurchaseOrder;
        sub.PartNo         = det.PartNo;
        sub.NC             = grp.NC;
        sub.MachineUsed    = grp.MachineUsed;
        sub.ProductionMode = grp.ProductionMode;

        // Nếu PartNo chưa set ở nhóm → lấy từ hàng đầu
        if (string.IsNullOrEmpty(grp.PartNo)) grp.PartNo = det.PartNo;

        // Load snapshot mới nhất từ DB (luôn reload để bắt thay đổi từ Kế hoạch)
        await EnsureSnapshotAsync(det.PurchaseOrder, det.KhPlanDetailId);

        // Load WTS logs mới nhất cho bảng snapshot
        await ReloadWtsLogsAsync(det.PurchaseOrder, det.KhPlanDetailId);

        // Cập nhật AvailableNCs cho nhóm từ snapshot
        if (_snapshotCache.TryGetValue(det.PurchaseOrder, out var snaps))
        {
            grp.AvailableNCs = snaps;
            sub.AvailableNCs = snaps;
        }

        // Load WtsItems cho non-GC từ snapshot
        if (!IsGcGroup && _fullSnapshotCache.TryGetValue(det.PurchaseOrder, out var fullSnap))
        {
            if (HandoverGroupCode == "KCS")
                grp.WtsItems = fullSnap.Inspection
                    .Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();
            else if (HandoverGroupCode == "PKG")
                grp.WtsItems = fullSnap.Packaging
                    .Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();
            // HTSP: load theo subgroup sau khi user chọn (OnGroupHtspSubChanged)
        }

        if (grp.UseStdAsDefault) TryFillStdValues(sub);
    }

