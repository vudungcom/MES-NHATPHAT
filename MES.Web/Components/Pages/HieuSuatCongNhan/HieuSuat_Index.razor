        row.SetupTime_Actual      = null;
        row.MachiningTime_Actual  = null;
        row.InspectionTime_Actual = null;
        row.PreparationTime_Actual= null;
        row.TrialRunTime_Actual   = null;
        CheckQtyWarning(row);
    }

    // Chọn nhóm nhỏ HTSP → fill danh sách mã công việc
    private void OnHtspSubGroupChanged(WtsRow row, string? subGroup)
    {
        row.HtspSubGroup = subGroup;
        row.NC = null;
        row.AvailableWtsItems.Clear();
        if (string.IsNullOrEmpty(subGroup) || string.IsNullOrEmpty(row.PO)) return;
        if (!_fullSnapshotCache.TryGetValue(row.PO, out var snap)) return;
        row.AvailableWtsItems = subGroup switch
        {
            // Taro: dùng WtsTaskCode làm mã CV (mới), fallback về NC nếu snapshot cũ chưa có WtsTaskCode
            "Taro"  => snap.Taro.Where(s => !string.IsNullOrEmpty(s.WtsTaskCode) || !string.IsNullOrEmpty(s.NC))
                           .Select(s => {
                               var code = string.IsNullOrEmpty(s.WtsTaskCode) ? s.NC : s.WtsTaskCode;
                               return new WtsItem(code, s.StepName ?? code);
                           }).ToList(),
            "Bavia" => snap.Bavia  .Where(s => !string.IsNullOrEmpty(s.NC)).Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList(),
            "Rua"   => snap.Washing.Where(s => !string.IsNullOrEmpty(s.NC)).Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList(),
            _       => new List<WtsItem>()
        };
    }

    private void OnWtsItemChanged(WtsRow row, string? nc)
    {
        row.NC = nc;
        CheckQtyWarning(row);
        RecalcEndTime(row); // non-GC: tính lại EndTime = SL * T.chuẩn
    }

    private void OnWtsOtherChanged(WtsRow row, string? code)
    {
        row.WtsCode = code;
        row.WtsName = _wtsTasks.FirstOrDefault(t => t.TaskCode == code)?.TaskName;
    }

    // Datalist input handler — user gõ hoặc chọn từ list
    private void OnWtsCodeInput(WtsRow row, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        row.WtsCode = val;
        // Nếu khớp đúng 1 TaskCode → tự fill WtsName
        var matched = _wtsTasks.FirstOrDefault(t => t.TaskCode == val);
        row.WtsName = matched?.TaskName;
    }

    // [WORKFLOW Phase 3] Tính tổng SL đã làm WTS cho non-GC theo nhóm + WtsCode hiện tại
    private decimal GetNonGcWtsDone(WtsRow row)
    {
        if (!row.KhPlanDetailId.HasValue) return 0m;
        // Key trong _wtsLogsCache là PO string
        var po = row.PO;
        if (string.IsNullOrEmpty(po)) return 0m;
        if (!_wtsLogsCache.TryGetValue(po, out var logs)) return 0m;
        // Lọc theo processGroup + WtsCode/NC hiện tại của row
        var wtsCode = row.WtsCode ?? row.NC;
        return logs
            .Where(l => !l.IsVoided
                     && l.ProcessGroup != "GC"
                     && (l.WtsCode == wtsCode || l.NC == wtsCode))
            .Sum(l => l.QtyOk ?? l.QtyDone);
    }

    private string GetWtsItemTitle(WtsRow row)
    {
        var found = row.AvailableWtsItems.FirstOrDefault(i => i.NC == row.NC);
        return found != null ? $"{found.NC} — {found.Name}" : "-- Chọn mã CV --";
    }

    private static string BuildNcLabel(bool isDone, bool machineBlocked, bool isExcluded,
        bool regBroken, string[] altMachines, string? ncCode, string regMachine,
        decimal planQty, string? unit, decimal wtsDone)
    {
        if (isDone)        return $"✅ NC{ncCode} — ĐÃ ĐỦ SL ({planQty.ToString("0.##")} {unit})";
        if (machineBlocked) return $"⛔ NC{ncCode} — {regMachine} ĐANG HỎNG";
        if (isExcluded)    return $"⚙️ NC{ncCode} — {regMachine} (loại trừ)";
        if (regBroken && altMachines.Any())
        {
            var okAlt = altMachines.FirstOrDefault(m => true); // caller đã lọc broken
            return $"⚠️ NC{ncCode} — {regMachine} hỏng, dùng DP: {okAlt}";
        }
        var icon = wtsDone > 0 ? "🟡" : "⬜";
        return $"{icon} NC{ncCode} — {regMachine} (đã làm: {wtsDone.ToString("0.##")})";
    }

    // Gọi khi user đổi QtyOk hoặc QtyNg — sync QtyDone + trigger warn + tính lại EndTime
    private void OnQtyChanged(WtsRow row)
    {
        row.QtyDone = row.QtyOk + row.QtyNg;
        CheckQtyWarning(row);
        RecalcEndTime(row);
        StateHasChanged();
    }

    // Xử lý input riêng từng cột — tránh lambda phức tạp trong Razor markup
    // (Razor parser hiểu nhầm "out var v" thành HTML tag < var >)
    private void OnQtyOkInput(WtsRow row, ChangeEventArgs e)
    {
        row.QtyOk = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m;
        OnQtyChanged(row);
    }

    private void OnQtyNgInput(WtsRow row, ChangeEventArgs e)
    {
        row.QtyNg = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0m;
        OnQtyChanged(row);
    }

    private void CheckQtyWarning(WtsRow row)
    {
        row.HasWarning  = false;
        row.WarningMsg  = null;
        if (row.KhPlanDetailId == null || string.IsNullOrEmpty(row.NC)) return;

        var detail = _allRows.FirstOrDefault(r => r.KhPlanDetailId == row.KhPlanDetailId);
        if (detail == null) return;

        // v0.8b: Không cascade lock — trong cùng nhóm làm NC nào cũng được.
        // Chỉ warn khi QtyDone lần này vượt PlanQty (mỗi NC max = PlanQty).
        var flow = GetFlowItem(row.KhPlanDetailId, row.NC);
        var wtsDoneAtNc = flow?.WtsDone ?? 0m;

        // NC dùng máy loại trừ — warn nhẹ (không block)
        if (flow?.IsExcluded == true)
        {
            // Chỉ warn info, không block save, không màu đỏ
            row.HasWarning = false; // không tô vàng row
            // Cảnh báo riêng hiển thị dưới dropdown
        }

        // Warn khi nhập vượt PlanQty
        if (row.QtyDone > detail.Quantity)
        {
            row.HasWarning = true;
            row.WarningMsg = $"SL nhập ({row.QtyDone}) vượt KH ({detail.Quantity} {detail.Unit}). Kiểm tra lại.";
        }
        // Warn khi tổng đã làm NC này + mới vượt PlanQty
        else if (wtsDoneAtNc + row.QtyDone > detail.Quantity && wtsDoneAtNc > 0)
        {
            row.HasWarning = true;
            row.WarningMsg = $"NC {row.NC} đã làm {wtsDoneAtNc:0.##} + nhập thêm {row.QtyDone} = {wtsDoneAtNc + row.QtyDone} vượt KH ({detail.Quantity} {detail.Unit}).";
        }
    }

    // ── Lưu 1 dòng ───────────────────────────────────────────
    private async Task SaveRowAsync(WtsRow row)
    {
        row.ErrorMsg = null;

        if (!IsToday)
        { row.ErrorMsg = "Chỉ được nhập WTS cho ngày hôm nay. Ngày cũ cần quyền cao hơn."; return; }

        // Validate chung
        if (row.Minutes <= 0)
        { row.ErrorMsg = "T.Kết thúc phải sau T.Bắt đầu"; return; }

        if (string.IsNullOrEmpty(row.NC) && string.IsNullOrEmpty(row.WtsCode))
        { row.ErrorMsg = "Chọn NC (nếu có PO) hoặc Mã WTS khác"; return; }

        // Nếu đang sửa dòng cũ → void record cũ trước
        if (row.IsEditing)
        {
            if (row.WtsLogId.HasValue)
            {
                await Db.Database.ExecuteSqlRawAsync(
                    "UPDATE WtsProductionLogs SET IsVoided=1, VoidReason=N'Sửa lại', VoidedBy={0}, VoidedAt={1} WHERE WtsLogId={2}",
                    _currentUserId, DateTime.Now, row.WtsLogId.Value);
            }
            if (row.ActivityLogId.HasValue)
            {
                await Db.Database.ExecuteSqlRawAsync(
                    "UPDATE WorkerActivityLogs SET IsVoided=1, VoidReason=N'Sửa lại', VoidedBy={0}, VoidedAt={1} WHERE ActivityLogId={2}",
                    _currentUserId, DateTime.Now, row.ActivityLogId.Value);
            }
            row.WtsLogId      = null;
            row.ActivityLogId = null;
            row.IsEditing     = false;
        }

        // ── Loại 1: Có NC → link PO → WtsProductionLog ──────
        if (!string.IsNullOrEmpty(row.NC))
        {
            if (row.KhPlanDetailId == null)
            { row.ErrorMsg = "Chọn PO để link với NC"; return; }

            // Khuyến nghị chọn máy — cảnh báo nhưng vẫn cho save
            if (string.IsNullOrEmpty(row.MachineUsed))
            {
                row.HasWarning = true;
                row.WarningMsg = (row.WarningMsg ?? "") + " Chưa chọn máy sử dụng.";
            }

            // Cảnh báo tổng thời gian thực tế — dùng đúng công thức: T.Gá + max(T.GC, T.Ktra)
            var _actualSum = (row.SetupTime_Actual ?? 0)
                           + Math.Max(row.MachiningTime_Actual ?? 0, row.InspectionTime_Actual ?? 0);
            if (_actualSum > row.Minutes && row.Minutes > 0)
                row.WarningMsg = (row.WarningMsg ?? "") + $" Tổng thời gian thực tế ({_actualSum} phút) vượt quá thời gian ca ({row.Minutes} phút).";

            CheckQtyWarning(row);

            // v0.8b: Không block theo cascade. Chỉ block khi QtyDone > PlanQty.
            if (row.QtyDone <= 0)
            { row.ErrorMsg = "SL (OK + NG) phải lớn hơn 0."; return; }

            if (row.QtyNg > 0 && string.IsNullOrWhiteSpace(row.NgReason))
            { row.ErrorMsg = "Phải nhập lý do NG khi có số lượng NG."; return; }

            var detForSave = _allRows.FirstOrDefault(r => r.KhPlanDetailId == row.KhPlanDetailId);
            if (detForSave != null && row.QtyDone > detForSave.Quantity)
            { row.ErrorMsg = $"Tổng OK+NG ({row.QtyDone}) vượt KH ({detForSave.Quantity} {detForSave.Unit}). Không được phép."; return; }

            // [WORKFLOW Phase 3] Non-GC: tổng WTS + lần này ≤ ReceivedOk
            if (!IsGcGroup && detForSave?.ApplyWorkflow == true && row.KhPlanDetailId.HasValue)
            {
                var receivedOk = _receivedOkCache.TryGetValue(row.KhPlanDetailId.Value, out var rv) ? rv : 0m;
                var wtsDoneNonGc = GetNonGcWtsDone(row);
                if (receivedOk > 0 && wtsDoneNonGc + row.QtyOk > receivedOk)
                {
                    row.ErrorMsg = $"Workflow: Tổng đã làm ({wtsDoneNonGc:0.##}) + lần này ({row.QtyOk:0.##}) = {wtsDoneNonGc + row.QtyOk:0.##} vượt SL đã nhận ({receivedOk:0.##}). Chưa có đủ hàng.";
                    return;
                }
            }

            // Warn thêm nếu NC loại trừ (không block)
            if (GetFlowItem(row.KhPlanDetailId, row.NC)?.IsExcluded == true)
            {
                row.HasWarning = true;
                row.WarningMsg = (row.WarningMsg ?? "") + $" NC {row.NC} dùng máy loại trừ — thường do nhóm HTSP thực hiện.";
            }

            try
            {
                // Xác định ProcessGroup và NC/WtsCode theo nhóm công nhân
                string processGroup;
                string? ncValue;
                string? wtsCodeValue;
                if (IsGcGroup)
                {
                    processGroup  = "GC";
                    ncValue       = row.NC;
                    wtsCodeValue  = null;
                }
                else if (IsHtspGroup)
                {
                    processGroup = row.HtspSubGroup switch
                    {
                        "Taro"  => "TARO",
                        "Bavia" => "BAVIA",
                        "Rua"   => "WASHING",
                        _       => "TARO"
                    };
                    ncValue      = null;
                    wtsCodeValue = row.NC;  // NC chọn từ WtsItem lưu vào WtsCode
                }
                else if (HandoverGroupCode == "KCS")
                {
                    processGroup  = "KCS";
                    ncValue       = null;
                    wtsCodeValue  = row.NC;
                }
                else // PKG
                {
                    processGroup  = "PKG";
                    ncValue       = null;
                    wtsCodeValue  = row.NC;
                }

                var log = new WtsProductionLog
                {
                    KhPlanDetailId          = row.KhPlanDetailId.Value,
                    ProcessGroup            = processGroup,
                    NC                      = ncValue,
                    WtsCode                 = wtsCodeValue,
                    HtspSubGroup            = IsHtspGroup ? row.HtspSubGroup : null,
                    WorkerId                = _currentUserId,
                    MachineUsed             = row.MachineUsed,
                    QtyDone                 = row.QtyDone,
                    QtyOk                   = row.QtyOk,
                    QtyNg                   = row.QtyNg,
                    NgReason                = row.QtyNg > 0 ? row.NgReason : null,
                    StartTime               = row.StartTime,
                    EndTime                 = row.EndTime,
                    Notes                   = row.Notes,
                    ExtraMinutes            = row.ExtraMinutes > 0 ? row.ExtraMinutes : (int?)null,
                    CaId                    = _selectedCaId,  // Ca làm việc — dùng cho báo cáo
                    IsOvertime              = row.IsOvertime,  // Tăng ca flag
                    SetupTime_Actual        = row.SetupTime_Actual,
                    MachiningTime_Actual    = row.MachiningTime_Actual,
                    InspectionTime_Actual   = row.InspectionTime_Actual,
                    PreparationTime_Actual  = row.PreparationTime_Actual,
                    TrialRunTime_Actual     = row.TrialRunTime_Actual,
                    CreatedAt               = DateTime.Now,
                    IsVoided                = false,
                };
                Db.WtsProductionLogs.Add(log);
                await Db.SaveChangesAsync();
                row.WtsLogId = log.WtsLogId;

                // Lưu từng dòng phát sinh chi tiết vào WtsExtraItems
                if (row.ExtraItems.Any())
                {
                    foreach (var ei in row.ExtraItems.Where(e => e.Minutes > 0))
                    {
                        Db.WtsExtraItems.Add(new WtsExtraItemLog
                        {
                            WtsLogId   = log.WtsLogId,
                            WtsCode    = ei.WtsCode,
                            WtsName    = ei.WtsName,
                            Minutes    = ei.Minutes,
                            Notes      = ei.Notes,
                            CreatedAt  = DateTime.Now,
                        });
                    }
                    await Db.SaveChangesAsync();
                }
                Db.ChangeTracker.Clear(); // clear EF cache để reload mới nhất

                // Reload qty cache + flow (v0.8)
                var summary = await KhSvc.GetWtsQtySummaryAsync(row.KhPlanDetailId.Value);
                foreach (var kv in summary)
                    _qtySummaryCache[$"{row.KhPlanDetailId}|{kv.Key}"] = kv.Value;
                await ReloadFlowAsync(row.KhPlanDetailId.Value);
            }
            catch (Exception ex)
            {
                var inner = ex.InnerException?.Message ?? ex.Message;
                row.ErrorMsg = "Lỗi khi lưu: " + inner;
                return;
            }
        }
        // ── Loại 2: Mã WTS khác (không link PO) → WorkerActivityLog ──
        else
        {
            try
            {
                var actLog = new WorkerActivityLog
                {
                    WorkerId  = _currentUserId,
                    WorkDate  = DateOnly.FromDateTime(_workDate),
                    StartTime = row.StartTime,
                    EndTime   = row.EndTime,
                    WtsCode   = row.WtsCode,
                    WtsName   = row.WtsName,
                    Notes     = row.Notes,
                    CreatedAt = DateTime.Now,
                    IsVoided  = false,
                };
                Db.WorkerActivityLogs.Add(actLog);
                await Db.SaveChangesAsync();
                row.ActivityLogId = actLog.ActivityLogId;

                // Lưu từng dòng phát sinh chi tiết
                if (row.ExtraItems.Any())
                {
                    foreach (var ei in row.ExtraItems.Where(e => e.Minutes > 0))
                    {
                        Db.WtsExtraItems.Add(new WtsExtraItemLog
                        {
                            ActivityLogId = actLog.ActivityLogId,
                            WtsCode       = ei.WtsCode,
                            WtsName       = ei.WtsName,
                            Minutes       = ei.Minutes,
                            Notes         = ei.Notes,
                            CreatedAt     = DateTime.Now,
                        });
                    }
                    await Db.SaveChangesAsync();
                }
                Db.ChangeTracker.Clear();
            }
            catch (Exception ex)
            {
                var inner = ex.InnerException?.Message ?? ex.Message;
                row.ErrorMsg = "Lỗi khi lưu: " + inner;
                return;
            }
        }

        row.Saved = true;

        // Reload lại toàn bộ: danh sách dòng đã lưu + qty summary cho tất cả PO
        var unsavedRows = _rows.Where(r => !r.Saved).ToList();
        await LoadSavedRowsAsync();
        // Giữ lại các dòng chưa lưu
        _rows.AddRange(unsavedRows);

        // Reload qty summary + flow cho tất cả PO đang có trong session (v0.8)
        _qtySummaryCache.Clear();
        _ncFlowCache.Clear();
        foreach (var po in _rows.Where(r => r.KhPlanDetailId.HasValue)
                                 .Select(r => r.KhPlanDetailId!.Value)
                                 .Distinct())
        {
            var sum = await KhSvc.GetWtsQtySummaryAsync(po);
            foreach (var kv in sum)
                _qtySummaryCache[$"{po}|{kv.Key}"] = kv.Value;
            await ReloadFlowAsync(po);
        }

        // Reload receivedOk cache cho PO vừa lưu
        if (row.KhPlanDetailId.HasValue)
        {
            var grp = HandoverGroupCode;
            var ro  = await HandoverSvc.GetReceivedOkAsync(row.KhPlanDetailId.Value, grp);
            var det = _allRows.FirstOrDefault(d => d.KhPlanDetailId == row.KhPlanDetailId.Value);
            _receivedOkCache[row.KhPlanDetailId.Value] = ro > 0 ? ro : (det?.Quantity ?? ro);
        }

        // Reload snapshot cache cho các PO đang dùng
        foreach (var r in _rows.Where(r => !string.IsNullOrEmpty(r.PO) && r.KhPlanDetailId.HasValue && !r.Saved))
        {
            if (!_snapshotCache.ContainsKey(r.PO!))
            {
                var snap = await KhSvc.GetRouteSnapshotAsync(r.KhPlanDetailId!.Value);
                _snapshotCache[r.PO!] = snap.Machining;
                r.AvailableNCs = snap.Machining;
            }
        }

    }

    // ── Classes ───────────────────────────────────────────────
    // Cache WTS logs theo PO — để hiện bảng quy trình real-time
    private Dictionary<string, List<WtsProductionLog>> _wtsLogsCache = new();

    private List<WtsProductionLog> GetWtsLogsFor(string po, string group, string? wtsCode = null)
    {
        if (!_wtsLogsCache.TryGetValue(po, out var logs)) return new();
        return logs.Where(l => l.ProcessGroup == group
            && !l.IsVoided
            && (wtsCode == null || l.WtsCode == wtsCode || l.NC == wtsCode)).ToList();
    }

    private decimal GetWtsQtyFor(string po, string group, string? wtsCode = null)
        => GetWtsLogsFor(po, group, wtsCode).Sum(l => l.QtyDone);

    private static string FmtTimeWts(decimal? v)
        => v.HasValue && v > 0 ? v.Value.ToString("0.##") : "—";

    private async Task ReloadWtsLogsAsync(string po, int detailId)
    {
        var logs = await Db.WtsProductionLogs
            .Include(l => l.Worker)
            .Where(l => l.KhPlanDetailId == detailId && !l.IsVoided)
            .OrderBy(l => l.StartTime)
            .AsNoTracking()
            .ToListAsync();
        _wtsLogsCache[po] = logs;
    }

    private decimal? GetStdTimeForWtsCode(WtsRow row)
    {
        if (string.IsNullOrEmpty(row.PO) || string.IsNullOrEmpty(row.NC)) return null;
        if (!_fullSnapshotCache.TryGetValue(row.PO, out var snap)) return null;
        var nc = row.NC;
        // HTSP: tìm trong Taro/Bavia/Washing theo HtspSubGroup
        if (IsHtspGroup)
        {
            return row.HtspSubGroup switch
            {
                "Taro"  => snap.Taro   .FirstOrDefault(s => s.NC == nc)?.StandardTime,
                "Bavia" => snap.Bavia  .FirstOrDefault(s => s.NC == nc)?.StandardTime,
                "Rua"   => snap.Washing.FirstOrDefault(s => s.NC == nc)?.StandardTime,
                _       => null
            };
        }
        // KCS
        if (HandoverGroupCode == "KCS")
            return snap.Inspection.FirstOrDefault(s => s.NC == nc)?.StandardTime;
        // PKG
        return snap.Packaging.FirstOrDefault(s => s.NC == nc)?.StandardTime;
    }

    private string? GetActivePO()
    {
        // Ưu tiên: PO đang nhập trong _groups (form mới)
        var fromGroups = _groups
            .SelectMany(g => g.SubRows)
            .FirstOrDefault(s => !string.IsNullOrEmpty(s.PO))?.PO;
        if (fromGroups != null) return fromGroups;
        // Fallback: _rows cũ (saved rows)
        return _rows.FirstOrDefault(r => !r.Saved && !string.IsNullOrEmpty(r.PO))?.PO
            ?? _rows.LastOrDefault(r => r.Saved && !string.IsNullOrEmpty(r.PO))?.PO;
    }

    private static string[] GetAltMachinesFromTimingRows(
        IEnumerable<KhPlanRouteSnapshotMachiningTiming> timingRows)
        => timingRows
            .OrderBy(t => t.DisplayOrder)
            .SelectMany(t => (t.SoMay ?? "").Split(new[] { ',', ';' },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Distinct()
            .ToArray();

    private List<string> GetMachineOptions(WtsRow row)
    {
        var snap = row.AvailableNCs.FirstOrDefault(n => n.NC == row.NC);
        var opts = new List<string>();
        if (snap == null) return opts;

        // Máy đăng ký luôn đứng đầu
        if (!string.IsNullOrEmpty(snap.MachineRegistered))
            opts.Add(snap.MachineRegistered);

        // Máy đồng dạng: mỗi TimingRow có SoMay = "C04, C06" → parse ra từng máy
        foreach (var t in snap.TimingRows.OrderBy(t => t.DisplayOrder))
        {
            foreach (var m in (t.SoMay ?? "").Split(new[] { ',', ';' },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (!opts.Contains(m)) opts.Add(m);
            }
        }

        return opts;
    }

