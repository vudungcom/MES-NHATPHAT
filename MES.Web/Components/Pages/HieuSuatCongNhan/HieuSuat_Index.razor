    // ── Thêm dòng mới ────────────────────────────────────────

    private void AddRow()

    {

        if (!IsToday) return; // Không cho thêm dòng ngày cũ

        // StartTime = EndTime của dòng đã lưu cuối cùng (continuous timeline)

        // EndTime placeholder = +1 phút, công thức tính lại khi nhập timing

        var lastSaved = _rows.LastOrDefault(r => r.Saved);

        var lastEnd = lastSaved?.EndTime ?? _workDate.Date.AddHours(8);

        _rows.Add(new WtsRow

        {

            StartTime      = lastEnd,

            EndTime        = lastEnd.AddMinutes(1),

            UseStdAsDefault = _useStdAsDefault,

        });

    }

    // [W2-REMOVEROW 2026-10-28] Đã bỏ hàm RemoveRow (code chết từ 17/10, không nút nào gọi): huỷ dòng WTS KHÔNG khoá PO, KHÔNG kiểm K5.
    //   Xoá dòng đã lưu chỉ đi qua VoidSavedRow (khoá PO + K5 + báo gốc rễ).

    /// <summary>

    /// Void dòng đã lưu trong ngày + mở lại để sửa.

    /// Cơ chế: đánh dấu Saved=false, giữ WtsLogId/ActivityLogId để void khi save lại.

    /// v0.8: Reload flow + snapshot cho detail để dropdown NC hiển thị đúng ngay.

    /// </summary>

    private async Task EditRow(WtsRow row)

    {

        if (!IsToday) return;

        row.Saved     = false;

        row.IsEditing = true; // đánh dấu đang sửa (sẽ void + tạo mới khi save)

        // Đảm bảo snapshot NC + flow đã load cho detail này (row đã lưu → chưa chắc EnsureLoaded chạy)

        if (row.KhPlanDetailId.HasValue && !string.IsNullOrEmpty(row.PO))

        {

            if (!_snapshotCache.ContainsKey(row.PO))

            {

                var snap = await KhSvc.GetRouteSnapshotAsync(row.KhPlanDetailId.Value);

                _snapshotCache[row.PO] = snap.Machining;

            }

            row.AvailableNCs = _snapshotCache[row.PO];

            // [STD-UPDATE] Nạp trạng thái xác nhận T.Chuẩn từ snapshot phiếu KH
            await EnsureSnapStdConfirmsAsync(row.KhPlanDetailId.Value);

            await ReloadFlowAsync(row.KhPlanDetailId.Value);

        }

    }

    // ── Time input ────────────────────────────────────────────

    private void OnTimeChanged(WtsRow row, bool isStart, string? val)

    {

        if (string.IsNullOrEmpty(val)) return;

        if (!TimeSpan.TryParse(val, out var ts)) return;

        var dt = _workDate.Date.Add(ts);

        if (isStart) row.StartTime = dt;

        else         row.EndTime   = dt;

    }

    // ── PO chọn → load NC từ snapshot ────────────────────────

    private async Task OnPOChanged(WtsRow row, string? po)

    {

        row.PO = po;

        row.NC = null;

        row.PartNo = null;

        row.WtsCode = null;

        row.WtsName = null;

        row.AvailableNCs.Clear();

        row.AvailableWtsItems.Clear();

        row.HtspSubGroup = null;

        row.KhPlanDetailId = null;

        if (string.IsNullOrEmpty(po)) return;

        var detail = _allRows.Where(r => r.PurchaseOrder == po).Select(r => r.KhPlanDetailId).Distinct().Count() > 1 ? null : _allRows.FirstOrDefault(r => r.PurchaseOrder == po);   // [B5-PODUP] PO trùng số (khác dòng KH): không tự chọn dòng đầu

        if (detail == null) return;

        row.KhPlanDetailId = detail.KhPlanDetailId;

        row.PartNo = detail.PartNo;

        // Load snapshot

        if (IsGcGroup)

        {

            // GC: load Machining snapshot vào cache riêng cho dropdown NC

            if (!_snapshotCache.ContainsKey(po))

            {

                var snap = await KhSvc.GetRouteSnapshotAsync(detail.KhPlanDetailId);

                _snapshotCache[po] = snap.Machining;

                _fullSnapshotCache[po] = snap; // cũng lưu full để hiện bảng quy trình

            }

            row.AvailableNCs = _snapshotCache[po];

        }

        else

        {

            // HTSP/KCS/PKG: load full snapshot

            if (!_fullSnapshotCache.ContainsKey(po))

            {

                var snap = await KhSvc.GetRouteSnapshotAsync(detail.KhPlanDetailId);

                _fullSnapshotCache[po] = snap;

            }

            var fullSnap = _fullSnapshotCache[po];

            if (!IsHtspGroup)

            {

                // KCS hoặc PKG — load thẳng vào AvailableWtsItems

                row.AvailableWtsItems = HandoverGroupCode == "KCS"

                    ? fullSnap.Inspection.Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList()

                    : fullSnap.Packaging.Select(s => new WtsItem(s.NC, s.StepName ?? s.NC)).ToList();

            }

            // HTSP: chờ user chọn nhóm nhỏ → OnHtspSubGroupChanged sẽ fill AvailableWtsItems

        }

        // Load qty summary

        var key = detail.KhPlanDetailId.ToString();

        if (!_qtySummaryCache.ContainsKey(key))

        {

            var summary = await KhSvc.GetWtsQtySummaryAsync(detail.KhPlanDetailId);

            foreach (var kv in summary)

                _qtySummaryCache[$"{detail.KhPlanDetailId}|{kv.Key}"] = kv.Value;

        }

        // [GN-WTS-CAP] Bỏ nạp "SL đã nhận vào nhóm" (_receivedOkCache) — trần nhập WTS lấy từ sổ giao nhận,
        // nạp cùng ReloadFlowAsync bên dưới.

        // v0.8: Load NC flow

        if (!_ncFlowCache.ContainsKey(detail.KhPlanDetailId))

        {

            await ReloadFlowAsync(detail.KhPlanDetailId);

        }

        // Load WTS logs cho bảng quy trình

        if (!_wtsLogsCache.ContainsKey(po))

            await ReloadWtsLogsAsync(po, detail.KhPlanDetailId);

        // [STD-UPDATE] Nạp trạng thái xác nhận T.Chuẩn từ snapshot phiếu KH
        await EnsureSnapStdConfirmsAsync(detail.KhPlanDetailId);

        // Load timing chuẩn theo part

        var pm = await Db.PartMasters.FirstOrDefaultAsync(p => p.PartNo == detail.PartNo);

        if (pm != null)
        {
            await EnsureTimingStdAsync(detail.KhPlanDetailId, pm.PartId);

            // [FIX-STD-COLOR] Lưu trạng thái xác nhận — GC dùng IsMachiningConfirmed, non-GC dùng section tương ứng
            if (!_poStdConfirmed.ContainsKey(po))
            {
                _poStdConfirmed[po] = IsGcGroup           ? pm.IsMachiningConfirmed
                    : IsHtspGroup                          ? pm.IsHtspConfirmed
                    : HandoverGroupCode == "KCS"           ? pm.IsKcsConfirmed
                    :                                        pm.IsPkgConfirmed;
            }
            // [STD-CONFIRM-ROW] Non-GC: nạp các dòng T.Chuẩn đã tích xác nhận (per-dòng) của Part
            if (!IsGcGroup && !_poStdRowKeys.ContainsKey(po))
                _poStdRowKeys[po] = await StdConfirmSvc.GetConfirmedCodeKeysAsync(pm.PartId);
        }

    }

    // ── Edit / Void saved row (dùng bởi bảng saved rows) ──

    // [EDIT-NONGC] async: non-GC cần nạp lại snapshot / Mã CV / nhóm nhỏ khi Sửa dòng
    private async Task EditSavedRow(WtsRow row)

    {

        // Tạo nhóm mới từ row đã lưu để sửa lại

        var grp = new WtsGroup

        {

            PartNo        = row.PartNo,

            NC            = row.NC,

            MachineUsed   = row.MachineUsed,

            ProductionMode= row.ProductionMode,

            UseStdAsDefault = _useStdAsDefault,
            HtspSubGroup  = IsHtspGroup ? (row.HtspSubGroup ?? "") : "",   // [EDIT-NONGC] giữ nhóm nhỏ — trước đây bắt chọn lại

        };

        row.IsEditing = true;

        grp.SubRows.Add(row);

        _groups.Add(grp);

        // [GN-WTS-CAP] GC: nạp lại sổ giao nhận, bỏ dòng đang sửa khỏi phép tính trần (để không bị tính 2 lần).
        // Non-GC: OnSubRowKhChanged bên dưới đã gọi ReloadFlowAsync → nạp sổ.
        if (IsGcGroup && row.KhPlanDetailId.HasValue) await ReloadFlowAsync(row.KhPlanDetailId.Value);


        // [EDIT-NONGC] Non-GC: nạp lại snapshot + cache + danh sách Mã CV, GIỮ NGUYÊN giá trị đã lưu.
        // Trước đây: grp thiếu nhóm nhỏ, WtsItems rỗng, row.WtsCode = null → bắt chọn lại nhóm nhỏ / Mã CV.
        if (!IsGcGroup && row.KhPlanDetailId.HasValue)
        {
            var keepCode   = row.NC;                 // log non-GC: Mã CV được nạp vào row.NC
            var keepActual = row.ActualTimePerPc;
            grp.UseStdAsDefault = false;             // không để TryFillStdValues ghi đè T.Thực tế đã lưu
            await OnSubRowKhChanged(grp, row, row.KhPlanDetailId.Value.ToString());
            grp.UseStdAsDefault = _useStdAsDefault;

            // HTSP: nạp Mã CV theo nhóm nhỏ (hàm này reset WtsCode → khôi phục ngay sau)
            if (IsHtspGroup && !string.IsNullOrEmpty(grp.HtspSubGroup))
                OnGroupHtspSubChanged(grp, grp.HtspSubGroup);

            row.WtsCode         = keepCode;
            row.WtsName         = grp.WtsItems.FirstOrDefault(i => i.NC == keepCode)?.Name;
            row.ActualTimePerPc = keepActual;
            StateHasChanged();
        }
    }

