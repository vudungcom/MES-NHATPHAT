@code {

    private bool _canSubmit;

    private User? _currentWorker;

    private int _currentUserId;

    // Preference per-user — lưu vào localStorage, default true

    private bool _useStdAsDefault = true;

    // ── Danh sách nhóm đang nhập (chưa lưu) ──

    private List<WtsGroup> _groups = new();

    // ── Danh sách nhóm tăng ca (OT) ──

    // private List<WtsGroup> _groupsOT = new();        // OT removed 2026-09

    // private bool _showOtSection = false;              // OT removed 2026-09

    // ── Ca làm việc ──

    private List<CaLamViec> _caList = new();

    private int? _selectedCaId;          // Ca đang chọn cho ngày làm việc này

    private CaLamViec? SelectedCa => _caList.FirstOrDefault(c => c.CaId == _selectedCaId);

    // ── Confirm xóa WTS row ──

    private WtsRow? _voidConfirmRow; // != null → hiện modal confirm

    private Dictionary<string, (bool CanView, bool CanEdit)> _perms = new();

    // ── Tab ──────────────────────────────────────────────────────────────

    private string _activeTab = "input"; // "input" | "report"

    private bool _canViewReport = false;

    private string _TabInputCls  => _activeTab == "input"  ? "nav-link active" : "nav-link";

    private string _TabReportCls => _activeTab == "report" ? "nav-link active" : "nav-link";

    private void SetTabInput() { _activeTab = "input"; }

    // ── Report state ─────────────────────────────────────────────────────

    private DateTime _reportDateFrom = DateTime.Today;

    private DateTime _reportDateTo   = DateTime.Today;

    private int _reportWorkerId      = 0; // 0 = tất cả

    private bool _reportLoading      = false;

    private WtsReportResult? _reportResult = null;

    private List<(int Id, string Name)> _reportWorkers = new();

    private DateTime _workDate = DateTime.Today;

    // Data

    private List<KhPlanDetailRow> _allRows = new(); // tất cả phiếu KH

    private List<StandardWtsTask> _wtsTasks = new(); // tất cả WTS active

    private Dictionary<string, List<string>> _categoryMapping = new(); // ProcessGroup → List<CategoryCode> từ DB

    private string _groupCode = ""; // GroupCode của công nhân hiện tại

    /// <summary>

    /// Danh sách WTS tasks lọc theo nhóm công nhân.

    /// Dùng _categoryMapping từ DB (WtsCategoryGroupMappings) thay hardcode CategoryCode.

    /// Admin thấy tất cả.

    /// </summary>

    private IEnumerable<StandardWtsTask> WtsTasksForGroup

    {

        get

        {

            var isAdmin = _groupCode == "ADMIN";

            if (isAdmin) return _wtsTasks;

            var result = new List<StandardWtsTask>();

            // Lọc theo ProcessGroup mà user có quyền WTS vào

            if (_perms.TryGetValue(SystemPermissions.WtsGc, out var g) && g.CanView)

            {

                var codes = _categoryMapping.GetValueOrDefault("GC") ?? new();

                result.AddRange(_wtsTasks.Where(t => codes.Contains(t.CategoryCode)));

            }

            if (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var h) && h.CanView)

            {

                var codes = _categoryMapping.GetValueOrDefault("HTSP") ?? new();

                result.AddRange(_wtsTasks.Where(t => codes.Contains(t.CategoryCode)));

            }

            if (_perms.TryGetValue(SystemPermissions.WtsKcs, out var k) && k.CanView)

            {

                var codes = _categoryMapping.GetValueOrDefault("KCS") ?? new();

                result.AddRange(_wtsTasks.Where(t => codes.Contains(t.CategoryCode)));

            }

            if (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var d) && d.CanView)

            {

                var codes = _categoryMapping.GetValueOrDefault("PKG") ?? new();

                result.AddRange(_wtsTasks.Where(t => codes.Contains(t.CategoryCode)));

            }

            return result.DistinctBy(t => t.TaskId);

        }

    }

    /// <summary>

    /// Danh sách PO cho công nhân chọn — sort ưu tiên.

    /// Gate 1: Chỉ hiện phiếu đã có snapshot quy trình (bật _showWithoutSnapshot để bypass).

    /// Gate 2: Chỉ hiện phiếu nhóm này đã nhận hàng từ giao nhận (bật _showWithoutHandover để bypass).

    /// </summary>

    private IEnumerable<KhPlanDetailRow> PriorityRows => _allRows

        .Where(r => _showWithoutSnapshot || _hasSnapshotForGroup.Contains(r.KhPlanDetailId))

        // [WORKFLOW] Phiếu ApplyWorkflow=false: bỏ qua handover gate

        .Where(r => !r.ApplyWorkflow || _showWithoutHandover || _hasReceivedForGroup.Contains(r.KhPlanDetailId))

        .OrderBy(r => r.Priority == "Gấp" ? 0 : 1)

        .ThenBy(r => r.STD)

        .ThenBy(r => r.PurchaseOrder);

    // Toggle hiển thị phiếu chưa có snapshot — mặc định OFF

    private bool _showWithoutSnapshot = false;

    // Toggle hiển thị phiếu chưa có hàng giao nhận — mặc định OFF

    private bool _showWithoutHandover = false;

    // Set các KhPlanDetailId mà nhóm này đã nhận hàng (từ HandoverReceives)

    private HashSet<int> _hasReceivedForGroup = new();

    // ── [VULOI][DS-LOI 2026-10-28] Loại lỗi (DS Lỗi) cho ô NG ──
    private List<NgCategory> _ngCats = new();
    private void OnSubNgCatChanged(WtsRow sub, int? catId)
    {
        sub.NgCategoryId = catId;
        sub.NgReason = _ngCats.FirstOrDefault(x => x.NgCategoryId == catId)?.Label;
        sub.ErrorMsg = null;
    }
    private static string WtsNgText(WtsRow row)
        => (row.NgReason ?? "") + (row.NgCaseId != null && row.QtyNg > 0 ? " · " + NgCaseNo.Format(row.NgCaseId.Value) : "");

    // GroupCode handover tương ứng với quyền WTS của công nhân

    private string HandoverGroupCode

    {

        get

        {

            if (_groupCode == "ADMIN") return "GC"; // admin thấy hết

            if (_perms.TryGetValue(SystemPermissions.WtsGc,      out var g) && g.CanView) return "GC";

            if (_perms.TryGetValue(SystemPermissions.WtsHtsp,    out var h) && h.CanView) return "HTSP";

            if (_perms.TryGetValue(SystemPermissions.WtsKcs,     out var k) && k.CanView) return "KCS";

            if (_perms.TryGetValue(SystemPermissions.WtsDongGoi, out var d) && d.CanView) return "PKG";

            return "GC";

        }

    }

    private bool IsToday => _workDate.Date == DateTime.Today;

    /// <summary>True nếu công nhân thuộc nhóm GC (hoặc ADMIN) — hiện cột Máy SD và label NC</summary>

    private bool IsGcGroup => _groupCode == "ADMIN"

        || (_perms.TryGetValue(SystemPermissions.WtsGc, out var g) && g.CanView);

    /// <summary>True nếu công nhân thuộc nhóm HTSP — hiện cột Nhóm nhỏ (Taro/Bavia/Rửa)</summary>

    private bool IsHtspGroup

        => !IsGcGroup && (_perms.TryGetValue(SystemPermissions.WtsHtsp, out var h) && h.CanView);

    // Cache: PO → RouteSnapshotData đầy đủ (dùng cho non-GC)

    private Dictionary<string, RouteSnapshotData> _fullSnapshotCache = new();

    // [FIX-NONGC-NC] Tiêu đề cột NC của bảng dòng đã lưu — non-GC không có NC, cột này hiện Mã CV
    private string NcColumnTitle => IsGcGroup ? "NC" : "Mã CV";

    // Cache: KhPlanDetailId → có snapshot phù hợp với nhóm không

    private HashSet<int> _hasSnapshotForGroup = new();

    // Snapshot cache: PO → list NC (Machining — dùng cho GC)

    private Dictionary<string, List<KhPlanRouteSnapshotMachining>> _snapshotCache = new();

    // [FIX-STD-COLOR] PO → true nếu phần PartMaster tương ứng nhóm này đã xác nhận OK
    private Dictionary<string, bool> _poStdConfirmed = new();
    // [STD-CONFIRM-ROW] Non-GC: PO → tập "Bảng|Mã" của các dòng T.Chuẩn ĐÃ được tích xác nhận bên Part Master
    private Dictionary<string, HashSet<string>> _poStdRowKeys = new();
    // [STD-UPDATE] KhPlanDetailId → trạng thái xác nhận từng ô của SNAPSHOT phiếu KH.
    // Đây là nguồn DUY NHẤT cho màu xanh/xám + tooltip T.Chuẩn (GC và non-GC).
    // _poStdConfirmed / _poStdRowKeys ở trên không còn dùng để tô màu nữa.
    private Dictionary<int, Dictionary<(string Table, long RowId, string Field), KhPlanRouteSnapshotStdConfirm>> _snapStdConfirmCache = new();

    // Máy đang hỏng/bảo trì — HashSet SoMay để lookup O(1)

    private HashSet<string> _brokenMachines = new();

    private Dictionary<string, decimal> _qtySummaryCache = new(); // "detailId|NC" → qty done

    // [GN-WTS-CAP] Đã bỏ _receivedOkCache (SL nhận gộp mọi loại phiếu) — thay bằng _ledgerCache (sổ giao nhận).

    // v0.8: Flow per NC theo nhóm handover của công nhân — nguồn "sự thật" duy nhất

    // cho: cascade check (NC sau phụ thuộc NC trước), enforce conservation.

    // Key: KhPlanDetailId, Value: list NcFlowItem của HandoverGroupCode

    private Dictionary<int, List<NcFlowItem>> _ncFlowCache = new();

    private async Task ReloadFlowAsync(int khPlanDetailId)

    {

        var flow = await HandoverSvc.GetNcFlowAsync(khPlanDetailId, HandoverGroupCode);

        _ncFlowCache[khPlanDetailId] = flow;

        // [GN-WTS-CAP] Nạp lại sổ giao nhận cùng lúc với flow — mọi chỗ đang reload flow đều có số trần mới
        await ReloadLedgerAsync(khPlanDetailId);

    }

    // ── [GN-WTS-CAP] Trần nhập WTS từ hàm chung (HandoverLedgerService) ──────────
    // Nguồn DUY NHẤT cho: kiểm realtime, nhãn dropdown NC, khoá NC, kiểm lúc Lưu.
    // Thay cho: _receivedOkCache (số nhận gộp mọi loại phiếu), GetNonGcGroupWtsDone (cộng OK cả Taro+Bavia+Rửa),
    // công thức cũ min(NC trước, PO) − đã làm. Luật: L3, N1, N2, N3, N5 — Sổ luật Giao nhận MES.
    private Dictionary<int, LedgerRow> _ledgerCache = new();

    private async Task ReloadLedgerAsync(int khPlanDetailId)
    {
        var row = await LedgerSvc.GetLedgerForDetailAsync(khPlanDetailId, EditingLogIds(khPlanDetailId));
        if (row != null) _ledgerCache[khPlanDetailId] = row;
        else _ledgerCache.Remove(khPlanDetailId);
    }

    // Dòng WTS đang mở sửa (sẽ void khi lưu) → bỏ khỏi phép tính trần, để không bị tính 2 lần.
    private List<long> EditingLogIds(int khPlanDetailId)
        => _groups.SelectMany(g => g.SubRows).Concat(_rows)
                  .Where(s => s.IsEditing && s.WtsLogId.HasValue && s.KhPlanDetailId == khPlanDetailId)
                  .Select(s => s.WtsLogId!.Value).Distinct().ToList();

    // ProcessGroup ghi trên WTS theo nhóm công nhân (khớp SaveRowAsync)
    private string CurrentPg(WtsGroup? grp)
    {
        if (IsGcGroup) return "GC";
        if (IsHtspGroup)
            return (grp?.HtspSubGroup) switch { "Taro" => "TARO", "Bavia" => "BAVIA", "Rua" => "WASHING", _ => "" };
        return HandoverGroupCode == "KCS" ? "KCS" : "PKG";
    }

    private bool IsWorkflowOn(int? khPlanDetailId)
        => khPlanDetailId.HasValue && _allRows.FirstOrDefault(r => r.KhPlanDetailId == khPlanDetailId)?.ApplyWorkflow == true;

    private HandoverLedgerService.WtsCapInfo? GetWtsCap(int? khPlanDetailId, string pg, string? code)
    {
        if (!khPlanDetailId.HasValue || string.IsNullOrEmpty(pg) || string.IsNullOrEmpty(code)) return null;
        if (!_ledgerCache.TryGetValue(khPlanDetailId.Value, out var lr)) return null;
        return HandoverLedgerService.WtsCap(lr, pg, code);
    }

    private NcFlowItem? GetFlowItem(int? detailId, string? nc)

    {

        if (detailId == null || string.IsNullOrEmpty(nc)) return null;

        if (!_ncFlowCache.TryGetValue(detailId.Value, out var list)) return null;

        return list.FirstOrDefault(f => !f.IsBackup && f.NC == nc);

    }

    // ── Timing chuẩn — tra cứu từ PartMachiningTimings theo NC + máy ─────

    private Dictionary<int, List<TimingStd>> _timingStdCache = new();

    // [STD-UPDATE] Thêm SrcTable/SrcRowId = dòng snapshot đã lấy số (để tra trạng thái xác nhận).
    // NULL = không lấy từ snapshot (fallback Part Master live) → coi như CHƯA xác nhận.
    private record TimingStd(string NC, string SoMay,

        decimal? SetupTime, decimal? MachiningTime, decimal? InspectionTime,

        decimal? PreparationTime, decimal? TrialRunTime,

        string? SrcTable = null, long? SrcRowId = null);

    /// <summary>

    /// Lấy timing chuẩn từ snapshot đã load trong row.AvailableNCs.

    /// Ưu tiên: 1) TimingRows (máy đồng dạng, match SoMay CSV)

    ///           2) Timing gốc trên KhPlanRouteSnapshotMachining (máy đăng ký chính)

    /// Không cần detailId nữa — snapshot đã có sẵn trong row.

    /// </summary>

    private TimingStd? GetStdTiming(int detailId, string? nc, string? soMay)

    {

        if (string.IsNullOrEmpty(nc) || string.IsNullOrEmpty(soMay)) return null;

        // Tìm NC trong snapshot đang giữ trong memory

        // _snapshotCache key = PO string, value = List<KhPlanRouteSnapshotMachining>

        var snapList = _snapshotCache.Values

            .SelectMany(list => list)

            .Where(s => s.NC.Equals(nc, StringComparison.OrdinalIgnoreCase)

                     && s.KhPlanDetailId == detailId)

            .FirstOrDefault();

        if (snapList == null) return null;

        // 1. Thử match TimingRow (máy đồng dạng)

        foreach (var tr in snapList.TimingRows)

        {

            var machines = (tr.SoMay ?? "").Split(new[] { ',', ';' },

                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (machines.Any(m => m.Equals(soMay, StringComparison.OrdinalIgnoreCase)))

                return new TimingStd(nc, tr.SoMay ?? soMay,

                    tr.SetupTime, tr.MachiningTime, tr.InspectionTime,

                    tr.PreparationTime, tr.TrialRunTime,

                    StdTrack.Table.MachiningTiming, tr.TimingSnapshotId); // [STD-UPDATE]

        }

        // 2. Fallback: máy đăng ký chính — timing lưu trực tiếp trên snap

        if (soMay.Equals(snapList.MachineRegistered ?? "", StringComparison.OrdinalIgnoreCase)

            || string.IsNullOrEmpty(snapList.MachineRegistered))

        {

            if (snapList.SetupTime.HasValue || snapList.MachiningTime.HasValue ||

                snapList.InspectionTime.HasValue || snapList.PreparationTime.HasValue ||

                snapList.TrialRunTime.HasValue)

            {

                return new TimingStd(nc, soMay,

                    snapList.SetupTime, snapList.MachiningTime, snapList.InspectionTime,

                    snapList.PreparationTime, snapList.TrialRunTime,

                    StdTrack.Table.Machining, snapList.SnapshotId); // [STD-UPDATE]

            }

        }

        // 3. Fallback: lấy timing bất kỳ TimingRow nào thuộc NC này (bỏ qua máy)

        if (snapList.TimingRows.Any())

        {

            var firstTr = snapList.TimingRows.First();

            return new TimingStd(nc, firstTr.SoMay ?? soMay,

                firstTr.SetupTime, firstTr.MachiningTime, firstTr.InspectionTime,

                firstTr.PreparationTime, firstTr.TrialRunTime,

                StdTrack.Table.MachiningTiming, firstTr.TimingSnapshotId); // [STD-UPDATE]

        }

        // 4. Fallback cuối: timing trực tiếp trên snap (bỏ qua match máy)

        if (snapList.SetupTime.HasValue || snapList.MachiningTime.HasValue ||

            snapList.InspectionTime.HasValue)

        {

            return new TimingStd(nc, soMay,

                snapList.SetupTime, snapList.MachiningTime, snapList.InspectionTime,

                snapList.PreparationTime, snapList.TrialRunTime,

                StdTrack.Table.Machining, snapList.SnapshotId); // [STD-UPDATE]

        }

        // 5. Cuối cùng fallback về _timingStdCache (Part Master live — cũ)

        if (!_timingStdCache.TryGetValue(detailId, out var list)) return null;

        return list.FirstOrDefault(t =>

            t.NC.Equals(nc, StringComparison.OrdinalIgnoreCase) &&

            t.SoMay.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)

                .Any(m => m.Equals(soMay, StringComparison.OrdinalIgnoreCase)))

            ?? list.FirstOrDefault(t => t.NC.Equals(nc, StringComparison.OrdinalIgnoreCase));

    }

    private bool HasStdTiming(WtsRow row)

        => row.KhPlanDetailId.HasValue && GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed) != null;

    private string BuildStdTimingHtml(WtsRow row)

    {

        if (!row.KhPlanDetailId.HasValue) return "";

        var t = GetStdTiming(row.KhPlanDetailId.Value, row.NC, row.MachineUsed);

        if (t == null) return "";

        var parts = new List<string>();

        if (t.SetupTime.HasValue)      parts.Add($"T.Gá lắp <strong>{t.SetupTime}</strong>");

        if (t.MachiningTime.HasValue)  parts.Add($"T.Gia công <strong>{t.MachiningTime}</strong>");

        if (t.InspectionTime.HasValue) parts.Add($"T.Kiểm tra <strong>{t.InspectionTime}</strong>");

        if (t.PreparationTime.HasValue)parts.Add($"T.Chuẩn bị <strong>{t.PreparationTime}</strong>");

        if (t.TrialRunTime.HasValue)   parts.Add($"T.Chạy thử <strong>{t.TrialRunTime}</strong>");

        return string.Join(" &nbsp;|&nbsp; ", parts);

    }

    // Wrapper load snapshot cho 1 PO — luôn load mới từ DB để bắt thay đổi từ Kế hoạch

    private async Task EnsureSnapshotAsync(string purchaseOrder, int detailId)

    {

        var snap = await KhSvc.GetRouteSnapshotAsync(detailId);

        if (snap != null)

        {

            _snapshotCache[purchaseOrder]     = snap.Machining;  // B. GC

            _fullSnapshotCache[purchaseOrder] = snap;             // B+C+D+E

        }

    }

    private async Task EnsureTimingStdAsync(int detailId, int partId)

    {

        if (_timingStdCache.ContainsKey(detailId)) return;

        var rows = await Db.PartMachiningTimings

            .Where(t => t.Step != null && t.Step.PartId == partId && t.IsActive)

            .Select(t => new { t.Step!.NC, t.SoMay, t.SetupTime, t.MachiningTime, t.InspectionTime, t.PreparationTime, t.TrialRunTime })

            .AsNoTracking()

            .ToListAsync();

        _timingStdCache[detailId] = rows

            .Select(r => new TimingStd(r.NC, r.SoMay, r.SetupTime, r.MachiningTime, r.InspectionTime, r.PreparationTime, r.TrialRunTime))

            .ToList();

    }

