                                    {
                                        @* [STD-UPDATE] Bỏ tô màu theo cờ cả section (IsMachiningConfirmed).
                                           Mỗi ô tự tra xác nhận trong SNAPSHOT: xanh = đã xác nhận, xám = chưa. Tooltip = người + thời điểm. *@

                                        @* T.Gá *@

                                        <td style="background:@(!isSerial ? "#f8f9fa" : "transparent")">

                                            @if (isFirst) { <div style="@GcStdStyle(sub, subStd, StdTrack.Field.Setup)" title="@GcStdTitle(sub, subStd, StdTrack.Field.Setup)">@(subStd?.SetupTime?.ToString("0.#") ?? "—")</div> }

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   disabled="@(!isSerial)"

                                                   value="@(sub.SetupTime_Actual > 0 ? sub.SetupTime_Actual.ToString() : "")"

                                                   @oninput="e => OnSubSetupInput(grp, sub, e)" />

                                        </td>

                                        @* T.GC *@

                                        <td style="background:@(!isSerial ? "#f8f9fa" : "transparent")">

                                            @if (isFirst) { <div style="@GcStdStyle(sub, subStd, StdTrack.Field.Machining)" title="@GcStdTitle(sub, subStd, StdTrack.Field.Machining)">@(subStd?.MachiningTime?.ToString("0.#") ?? "—")</div> }

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   disabled="@(!isSerial)"

                                                   value="@(sub.MachiningTime_Actual > 0 ? sub.MachiningTime_Actual.ToString() : "")"

                                                   @oninput="e => OnSubMachiningInput(grp, sub, e)" />

                                        </td>

                                        @* T.Ktra *@

                                        <td style="background:@(!isSerial ? "#f8f9fa" : "transparent")">

                                            @if (isFirst) { <div style="@GcStdStyle(sub, subStd, StdTrack.Field.Inspection)" title="@GcStdTitle(sub, subStd, StdTrack.Field.Inspection)">@(subStd?.InspectionTime?.ToString("0.#") ?? "—")</div> }

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   disabled="@(!isSerial)"

                                                   value="@(sub.InspectionTime_Actual > 0 ? sub.InspectionTime_Actual.ToString() : "")"

                                                   @oninput="e => OnSubInspectionInput(grp, sub, e)" />

                                        </td>

                                        @* T.CB *@

                                        <td style="background:@(isSerial ? "#f8f9fa" : "transparent")">

                                            @if (isFirst) { <div style="@GcStdStyle(sub, subStd, StdTrack.Field.Preparation)" title="@GcStdTitle(sub, subStd, StdTrack.Field.Preparation)">@(subStd?.PreparationTime?.ToString("0.#") ?? "—")</div> }

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   disabled="@(isSerial)"

                                                   value="@(sub.PreparationTime_Actual > 0 ? sub.PreparationTime_Actual.ToString() : "")"

                                                   @oninput="e => OnSubPrepInput(grp, sub, e)" />

                                        </td>

                                        @* T.Chạy *@

                                        <td style="background:@(isSerial ? "#f8f9fa" : "transparent")">

                                            @if (isFirst) { <div style="@GcStdStyle(sub, subStd, StdTrack.Field.TrialRun)" title="@GcStdTitle(sub, subStd, StdTrack.Field.TrialRun)">@(subStd?.TrialRunTime?.ToString("0.#") ?? "—")</div> }

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   disabled="@(isSerial)"

                                                   value="@(sub.TrialRunTime_Actual > 0 ? sub.TrialRunTime_Actual.ToString() : "")"

                                                   @oninput="e => OnSubTrialInput(grp, sub, e)" />

                                        </td>

                                    }

                                    @* [FIX2-MOVED] T.Chuẩn và T.Thực tế — chỉ non-GC, trước Mã WTS PS *@

                                    @if (!IsGcGroup)

                                    {
                                        @* [FIX-STD-COLOR] Xanh nếu PartMaster section đã xác nhận OK *@
                                        var stdConfirmed = IsStdRowConfirmed(sub);

                                        <td class="text-center">

                                            @* [FIX-STD-COLOR-V2] Confirmed → bold + green border + green text (giống cột OK); chưa confirmed → xám nhạt *@
                                            <input class="form-control form-control-sm text-center @(stdConfirmed ? "" : "bg-light")"

                                                   style="@NonGcStdInputStyle(stdConfirmed)"

                                                   value="@StdTimeText(sub)"

                                                   readonly title="@StdTimeTitle(sub)" />

                                        </td>

                                        <td>

                                            <input type="number" class="form-control form-control-sm text-center"

                                                   style="font-size:11px"

                                                   min="0" step="0.1"

                                                   value="@(sub.ActualTimePerPc.HasValue ? sub.ActualTimePerPc.Value.ToString("0.##") : "")"

                                                   placeholder="0"

                                                   @oninput="e => OnSubActualTimePerPcInput(grp, sub, e)" />

                                        </td>

                                    }

                                    @* Mã WTS PS — input trực tiếp cho ExtraItem[0] *@

                                    <td style="background:#fff8e6">

                                        <input list="@($"dl-wtsps-{grpIdx}-{subIdx}")"

                                               class="form-control form-control-sm" style="font-size:11px"

                                               value="@(sub.ExtraItems.Count > 0 ? sub.ExtraItems[0].WtsCode : "")"

                                               placeholder="Mã WTS..."

                                               autocomplete="off"

                                               @onchange="e => OnSubPsWtsCode(sub, e.Value?.ToString())" />

                                        <datalist id="@($"dl-wtsps-{grpIdx}-{subIdx}")">

                                            @foreach (var t in WtsTasksForGroup)

                                            {

                                                <option value="@t.TaskCode">@t.TaskCode — @t.TaskName</option>

                                            }

                                        </datalist>

                                        @if (sub.ExtraItems.Count > 0 && !string.IsNullOrEmpty(sub.ExtraItems[0].WtsName))

                                        {

                                            <div style="font-size:10px;color:#6c757d;margin-top:1px">@sub.ExtraItems[0].WtsName</div>

                                        }

                                    </td>

                                    @* T.PS — input cho ExtraItem[0] *@

                                    <td style="background:#fff8e6">

                                        <input type="number" class="form-control form-control-sm text-center" min="0"

                                               value="@(sub.ExtraItems.Count > 0 && sub.ExtraItems[0].Minutes > 0 ? sub.ExtraItems[0].Minutes.ToString() : "")"

                                               placeholder="0"

                                               @oninput="e => OnSubPsMinutes(grp, sub, e)" />

                                    </td>

                                    @* Nội dung PS — input cho ExtraItem[0] *@

                                    <td style="background:#fff8e6">

                                        <input class="form-control form-control-sm" style="font-size:11px"

                                               value="@(sub.ExtraItems.Count > 0 ? sub.ExtraItems[0].Notes : "")"

                                               placeholder="Nội dung PS..."

                                               @oninput="e => OnSubPsNotes(sub, e)" />

                                    </td>

                                    @* Nút + thêm PS, × xóa sub-row *@

                                    <td class="text-center" style="white-space:nowrap">

                                        <button class="btn btn-sm btn-outline-warning py-0 px-1 me-1"

                                                title="Thêm dòng phát sinh"

                                                @onclick="() => AddExtraItem(sub)">

                                            <i class="bi bi-plus"></i>

                                        </button>

                                        @if (grp.SubRows.Count > 1)

                                        {

                                            <button class="btn btn-sm btn-outline-danger py-0 px-1"

                                                    @onclick="() => RemoveSubRow(grp, sub)">

                                                <i class="bi bi-x"></i>

                                            </button>

                                        }

                                    </td>

                                </tr>

                                @* ── Dòng phát sinh phụ (ExtraItem[1+]) ── *@

                                @foreach (var ei in sub.ExtraItems.Skip(1))

                                {

                                    var eiIdx  = sub.ExtraItems.IndexOf(ei);

                                    var eiDlId = $"dl-ei-{grpIdx}-{subIdx}-{eiIdx}";

                                    @* Dồn sang phải: colspan hết các cột trước Mã WTS PS *@

                                    <tr @key="ei" style="background:#fffbf0">

                                        @* Cột trái: Số PO + Part No + NC/Máy + OK/NG/SL/LýdoNG/BĐ/KT/DK + timing — empty, dồn hết *@

                                        <td colspan="@(IsGcGroup ? 16 : (IsHtspGroup ? 11 : 10))" style="background:#fffbf0"

                                            class="text-end pe-1">

                                            <span style="color:#adb5bd;font-size:11px">└</span>

                                            <span style="font-size:10px;font-weight:600;color:#9a6700;background:#fff3cd;padding:1px 5px;border-radius:3px">PS</span>

                                        </td>

                                        @* Mã WTS PS — gióng thẳng cột header *@

                                        <td style="background:#fffbf0">

                                            <input list="@eiDlId"

                                                   class="form-control form-control-sm" style="font-size:11px"

                                                   value="@ei.WtsCode"

                                                   placeholder="Mã WTS..."

                                                   autocomplete="off"

                                                   @onchange="e => OnExtraItemWtsCode(sub, ei, e.Value?.ToString())" />

                                            <datalist id="@eiDlId">

                                                @foreach (var t in WtsTasksForGroup)

                                                {

                                                    <option value="@t.TaskCode">@t.TaskCode — @t.TaskName</option>

                                                }

                                            </datalist>

                                            @if (!string.IsNullOrEmpty(ei.WtsName))

                                            {

                                                <div style="font-size:10px;color:#6c757d;margin-top:1px">@ei.WtsName</div>

                                            }

                                        </td>

                                        @* T.PS — gióng thẳng cột header *@

                                        <td style="background:#fff8e6">

                                            <input type="number" class="form-control form-control-sm text-center" min="0"

                                                   value="@(ei.Minutes > 0 ? ei.Minutes.ToString() : "")"

                                                   placeholder="0"

                                                   @oninput="e => OnExtraItemMinutes(grp, sub, ei, e)" />

                                        </td>

                                        @* Nội dung PS — gióng thẳng cột header *@

                                        <td style="background:#fffbf0">

                                            <input class="form-control form-control-sm" style="font-size:11px"

                                                   value="@ei.Notes"

                                                   placeholder="Nội dung PS..."

                                                   @oninput="e => OnExtraItemNotes(ei, e)" />

                                        </td>

                                        @* Nút − xóa — gióng thẳng cột action *@

                                        <td class="text-center" style="background:#fffbf0">

                                            <button class="btn btn-sm btn-outline-danger py-0 px-1"

                                                    @onclick="() => RemoveExtraItem(grp, sub, ei)">

                                                <i class="bi bi-dash"></i>

                                            </button>

                                        </td>

                                    </tr>

                                }

                                @* Error sub-row *@

                                @if (!string.IsNullOrEmpty(sub.ErrorMsg))

                                {

                                    <tr class="table-danger">

                                        <td colspan="12" class="small text-danger py-1 ps-2">

                                            <i class="bi bi-exclamation-triangle me-1"></i>@sub.ErrorMsg

                                        </td>

                                    </tr>

                                }

                                @* [MACHINE-OVERLAP-LIVE] Cảnh báo máy trùng giờ ngay lúc nhập *@
                                @if (!string.IsNullOrEmpty(sub.OverlapMsg))
                                {
                                    <tr class="table-danger">
                                        <td colspan="12" class="small text-danger py-1 ps-2">
                                            <i class="bi bi-exclamation-octagon me-1"></i>@sub.OverlapMsg
                                        </td>
                                    </tr>
                                }

                            }

                            @* Hàng tổng *@

                            @{

                                var totalOk    = grp.SubRows.Sum(s => s.QtyOk);

                                var totalNg    = grp.SubRows.Sum(s => s.QtyNg);

                                var totalSl    = totalOk + totalNg;

                                var tStart     = grp.SubRows.FirstOrDefault()?.StartTime;

                                var tEnd       = grp.SubRows.LastOrDefault()?.EndTime;

                                var grpTotalMin = (tStart.HasValue && tEnd.HasValue && tEnd > tStart)

                                    ? (int)(tEnd.Value - tStart.Value).TotalMinutes : 0;

                            }

                            <tr class="table-light" style="font-size:11px;font-weight:500">

                                <td class="text-muted ps-2" colspan="@(IsGcGroup ? 4 : (IsHtspGroup ? 4 : 3))">Tổng</td>

                                <td class="text-center text-success">@totalOk</td>

                                <td class="text-center text-danger">@(totalNg > 0 ? totalNg.ToString() : "—")</td>

                                <td></td>@* SL PO *@

                                <td></td>@* Lý do NG — fix lệch cột *@

                                <td class="text-center text-muted">@(tStart.HasValue ? tStart.Value.ToString("HH:mm") : "—")</td>

                                <td class="text-center text-muted">@(tEnd.HasValue ? tEnd.Value.ToString("HH:mm") : "—")</td>

                                <td class="text-center">

                                    @if (tStart.HasValue && tEnd.HasValue && tEnd > tStart)

                                    {

                                        var effMin = (int)CalcEffectiveMinutes(tStart.Value, tEnd.Value, SelectedCa);

                                        var rawMin = (int)(tEnd.Value - tStart.Value).TotalMinutes;

                                        <span class="small fw-semibold">@effMin ph</span>

                                        @if (SelectedCa != null && effMin != rawMin)

                                        {

                                            <div style="font-size:9px;color:#6c757d">(@rawMin ph - @(rawMin-effMin) ph nghỉ)</div>

                                        }

                                    }

                                </td>

                                @if (IsGcGroup)

                                {

                                    <td colspan="5" class="text-muted">

                                        @if (tStart.HasValue && tEnd.HasValue && tEnd > tStart && totalSl > 0)

                                        {

                                            var effMinCycle = (int)CalcEffectiveMinutes(tStart.Value, tEnd.Value, SelectedCa);

                                            var totalExtraGrp = (int)grp.SubRows.Sum(s => s.ExtraMinutes);

                                            var prodMinCycle  = effMinCycle - totalExtraGrp;

                                            <text>@effMinCycle ph · @totalSl sp · ~@((prodMinCycle > 0 ? prodMinCycle / (double)totalSl : effMinCycle / (double)totalSl).ToString("0.0")) ph/sp (cycle thuần)</text>

                                        }

                                    </td>

                                }

                                <td></td>

                                <td class="text-center" style="background:#fff8e6;font-size:11px;font-weight:500">

                                    @{

                                        var totalExtra = grp.SubRows.Sum(s => s.ExtraMinutes);

                                    }

                                    @(totalExtra > 0 ? totalExtra.ToString() + " ph" : "—")

                                </td>

                                <td></td>

                                <td></td>

                            </tr>

                            </tbody>

                        </table>

                    </div>

                    @* Footer nhóm: thêm KH + lưu nhóm *@

                    <div class="d-flex align-items-center gap-2 px-3 pb-2 flex-wrap">

                        <button class="btn btn-sm btn-outline-secondary py-0"

                                style="font-size:11px" @onclick="() => AddSubRow(grp)">

                            <i class="bi bi-plus me-1"></i>Thêm số KH

                        </button>

                        <div class="ms-auto d-flex align-items-center gap-1">

                            @if (!string.IsNullOrEmpty(grp.ErrorMsg))

                            {

                                <span class="text-danger small me-2">

                                    <i class="bi bi-exclamation-triangle me-1"></i>@FirstPart(grp.ErrorMsg)   @* [GN-WHY] dòng đầu; gợi ý đầy đủ ở khung bên dưới *@

                                </span>

                            }

                            <button class="btn btn-sm btn-success py-0 px-3"

                                    style="font-size:12px"

                                    @onclick="async () => await SaveGroupAsync(grp)"

                                    disabled="@(grp.IsSaving)">

                                @if (grp.IsSaving)

                                {

                                    <span class="spinner-border spinner-border-sm me-1"></span>

                                }

                                <i class="bi bi-check-lg me-1"></i>Lưu

                            </button>

                        </div>

                    </div>

                    @* Error nhóm *@

                    @if (!string.IsNullOrEmpty(grp.ErrorMsg))

                    {

                        <div class="px-3 pb-2">

                            <div class="alert alert-danger py-1 small mb-0" style="white-space:pre-line">   @* [GN-WHY] xuống dòng các bước gợi ý *@

                                <i class="bi bi-exclamation-triangle me-1"></i>@grp.ErrorMsg

                            </div>

                        </div>

                    }

                </div>

            }

            @if (!_groups.Any() && !_rows.Any(r => r.Saved))

            {

                <div class="text-center text-muted py-3 fst-italic small">

                    Chưa có dữ liệu. Bấm "Thêm nhóm" để bắt đầu ghi WTS.

                </div>

            }

        </div>

    </div>

    @* ── Vùng Tăng ca (OT) ── ĐÃ XÓA 2026-09: CN tự do nhập thời gian, không cần phân vùng OT riêng ── *@

    @* ── Bảng quy trình snapshot — hiện khi có PO đang chọn ── *@

    @if (GetActivePO() != null)

    {

        var activePO = GetActivePO()!;

        var activeFull = _fullSnapshotCache.ContainsKey(activePO)

            ? _fullSnapshotCache[activePO] : null;

        var activeMachining = _snapshotCache.ContainsKey(activePO)

            ? _snapshotCache[activePO]

            : activeFull?.Machining ?? new List<KhPlanRouteSnapshotMachining>();

        var activeDetail = _allRows.FirstOrDefault(r => r.PurchaseOrder == activePO);

        var planQty = activeDetail?.Quantity ?? 0m;

        if (activeMachining.Any() || activeFull != null)

        {

        <div class="card shadow-sm border-0 mb-3">

            <div class="card-header py-2 d-flex align-items-center gap-2">

                <i class="bi bi-diagram-3 me-1"></i>

                <span class="fw-semibold">Quy trình sản xuất — PO: <code>@activePO</code></span>

                <span class="badge bg-secondary ms-1">Snapshot</span>

                <span class="text-muted small ms-2">Đọc từ kế hoạch, không tự thay đổi theo Part Master.</span>

                <button class="btn btn-sm btn-outline-secondary ms-auto py-0"

                        @onclick="async () => { _wtsLogsCache.Remove(activePO); await ReloadWtsLogsAsync(activePO, activeDetail!.KhPlanDetailId); }">

                    <i class="bi bi-arrow-clockwise me-1"></i>Làm mới

                </button>

            </div>

            <div class="card-body p-2">

                @* B. Machining *@

                @if (activeMachining.Any())

                {

                    <div class="mb-3">

                        <div class="fw-semibold small py-1 px-2 rounded mb-1" style="background:#1a73e8;color:white;">

                            B. Quy trình gia công (@activeMachining.Count bước)

                        </div>

                        <div class="table-responsive">

                            <table class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">

                                <thead class="table-light">

                                    <tr>

                                        <th class="text-center" style="width:35px;" rowspan="2">#</th>

                                        <th style="width:55px;" rowspan="2">NC</th>

                                        <th rowspan="2">Máy đăng ký</th>

                                        <th rowspan="2">Máy đồng dạng</th>

                                        <th style="width:70px;" class="text-center" rowspan="2">Worker</th>

                                        <th style="width:45px;" class="text-center" rowspan="2">SL</th>

                                        <th style="width:85px;" class="text-center" rowspan="2">T.Bắt đầu</th>

                                        <th style="width:85px;" class="text-center" rowspan="2">T.Hoàn thành</th>

                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Gá lắp</th>

                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Gia công</th>

                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Kiểm tra</th>

                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Chuẩn bị</th>

                                        <th colspan="2" class="text-center" style="font-size:0.7rem;">T.Chạy thử</th>

                                        <th style="width:65px;" class="text-center" rowspan="2">TT</th>

                                    </tr>

                                    <tr>

                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>

                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>

                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>

                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>

                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>

                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>

                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>

                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>

                                        <th class="text-end text-muted fw-normal" style="width:35px;font-size:0.68rem;">Chuẩn</th>

                                        <th class="text-end fw-normal" style="width:35px;font-size:0.68rem;color:#0d6efd;">TT</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var s in activeMachining)

                                    {

                                        var gcLogs = GetWtsLogsFor(activePO, "GC", s.NC);

                                        var regLogs = gcLogs.Where(l => l.MachineUsed == s.MachineRegistered || string.IsNullOrEmpty(l.MachineUsed) || !s.TimingRows.Any(t => (t.SoMay ?? "").Split(',').Select(x => x.Trim()).Contains(l.MachineUsed ?? ""))).ToList();

                                        var qtyDone = gcLogs.Sum(l => l.QtyDone);

                                        var badgeColor = qtyDone == 0 ? "danger" : (qtyDone >= planQty ? "success" : "warning");

                                        var timingTotal = s.TimingRows.Sum(t => { var tl = gcLogs.Where(l => (t.SoMay ?? "").Split(',').Select(x => x.Trim()).Contains(l.MachineUsed ?? "")).ToList(); return 1 + (tl.Count == 0 ? 1 : tl.Count); });

                                        var totalRowspan = 1 + (regLogs.Count == 0 ? 1 : regLogs.Count) + timingTotal;

                                        <tr class="@(s.IsBackup ? "table-warning" : "")">

                                            <td class="text-center">@s.StepOrder</td>

                                            <td><code>@s.NC</code></td>

                                            <td>@(s.MachineRegistered ?? "—")</td>

                                            <td class="text-muted small">—</td>

                                            <td class="text-muted fst-italic small text-center" colspan="4" style="font-size:0.7rem;">← WTS CN</td>

                                            <td class="text-end text-muted small">@FmtTimeWts(s.SetupTime)</td>

                                            <td class="text-end"></td>

                                            <td class="text-end text-muted small">@FmtTimeWts(s.MachiningTime)</td>

                                            <td class="text-end"></td>

                                            <td class="text-end text-muted small">@FmtTimeWts(s.InspectionTime)</td>

                                            <td class="text-end"></td>

                                            <td class="text-end text-muted small">@FmtTimeWts(s.PreparationTime)</td>

                                            <td class="text-end"></td>

                                            <td class="text-end text-muted small">@FmtTimeWts(s.TrialRunTime)</td>

                                            <td class="text-end"></td>

                                            <td class="text-center" rowspan="@totalRowspan">

                                                <span class="badge bg-@badgeColor" style="font-size:0.62rem;">@qtyDone.ToString("0.##")/@planQty.ToString("0.##")</span>

                                            </td>

                                        </tr>

                                        @if (regLogs.Count == 0)

                                        {

                                            <tr class="bg-light" style="border-left:3px solid #0d6efd;">

                                                <td colspan="18" class="text-muted fst-italic small ps-2" style="font-size:0.7rem;">Chưa có dữ liệu</td>

                                            </tr>

                                        }

                                        @foreach (var log in regLogs)

                                        {

