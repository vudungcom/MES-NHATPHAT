                    <span style="width:56px;@LowStyle(b.Pro, b.Base)" class="small fw-bold text-end">@Pct(b.Pro, b.Base)</span>
                </button>
            }
            <div class="small text-muted mt-1">Thanh dài = giờ chuẩn của ngày (ngày làm thông nghỉ / làm ngoài ca dài hơn; ngày không rõ ca = phút khai báo). % = có ích ÷ @BaseWord; đỏ = dưới @LowPct%.</div>
        </div>
    };

    RenderFragment Timeline() => __builder =>
    {
        var day = From;
        var dd = (_result?.Days ?? new()).FirstOrDefault(x => x.WorkerId == _workerId && x.Day == day);
        var rs = _rows.Where(r => r.WorkDate == day).ToList();
        var s0 = dd?.PlanStart ?? (rs.Count > 0 ? rs.Min(r => r.StartTime) : day.ToDateTime(new TimeOnly(8, 0)));
        var e0 = dd?.PlanEnd ?? (rs.Count > 0 ? rs.Max(r => r.EndTime) : s0.AddHours(9));
        if (rs.Count > 0) { var mn = rs.Min(r => r.StartTime); var mx = rs.Max(r => r.EndTime); if (mn < s0) s0 = mn; if (mx > e0) e0 = mx; }
        s0 = s0.Date.AddHours(s0.Hour); if (e0.Minute > 0 || e0.Second > 0) e0 = e0.Date.AddHours(e0.Hour + 1);
        var span = Math.Max(1, (e0 - s0).TotalMinutes);
        var ticks = Enumerable.Range(0, (int)Math.Floor(span / 60) + 1).Select(h => s0.AddHours(h)).ToList();
        // dòng chồng giờ (đứng 2 máy, việc chồng dòng sản xuất) → xếp nhiều làn để không che nhau
        var lanes = new List<(WtsReportRow R, int Lane)>(); var laneEnd = new List<DateTime>();
        foreach (var r in rs.OrderBy(x => x.StartTime).ThenByDescending(x => x.EndTime))
        {
            var ln = laneEnd.FindIndex(e => e <= r.StartTime);
            if (ln < 0) { laneEnd.Add(r.EndTime); ln = laneEnd.Count - 1; } else laneEnd[ln] = r.EndTime;
            lanes.Add((r, ln));
        }
        var nLane = Math.Max(1, laneEnd.Count);
        <div class="border rounded p-3 h-100 bg-white">
            <div class="fw-semibold mb-2">Dòng thời gian trong ngày <span class="small text-muted fw-normal">— làm gì, lúc nào (@(dd?.CaName == null ? "không có ca" : $"{dd.CaName} {dd.CaLabel}"))</span></div>
            <div class="position-relative rounded border" style="height:@(Math.Max(44, 8 + 30 * nLane))px;background:#fff;overflow:hidden">
                @if (dd?.PlanStart != null)
                {
                    <div class="position-absolute" style="@PlanStyle(dd, s0, span)"></div>
                }
                @foreach (var b in dd?.Breaks ?? new())
                {
                    <div class="position-absolute" title="@BrkTitle(b)" style="@BrkStyle(b, s0, span)"></div>
                }
                @foreach (var x in lanes)
                {
                    <div class="position-absolute d-flex align-items-center justify-content-center overflow-hidden text-nowrap" title="@TlTitle(x.R)" style="@TlStyle(x.R, s0, span, x.Lane, nLane)">@ShortLbl(x.R)</div>
                }
            </div>
            <div class="position-relative" style="height:18px;font-size:11px;color:#6c757d">
                @foreach (var t in ticks)
                {
                    <span class="position-absolute" style="left:@W((t - s0).TotalMinutes, span);transform:translateX(-50%)">@t.ToString("HH:mm")</span>
                }
            </div>
            <div class="d-flex flex-wrap gap-3 small text-muted mt-2">
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CG"></span>có ích</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CO"></span>vô ích</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CN"></span>chưa có mã</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@Hatch"></span>nghỉ ca</span>
                <span>khoảng trắng trong khung nét đứt = chưa khai báo</span>
                <span class="ms-auto">Rê chuột vào khối để xem giờ, việc, PO</span>
            </div>
        </div>
    };
    static string BrkTitle((DateTime S, DateTime E) b) => $"Nghỉ ca {b.S:HH:mm}–{b.E:HH:mm}";
    static string BrkStyle((DateTime S, DateTime E) b, DateTime s0, double span) => $"top:0;bottom:0;left:{W((b.S - s0).TotalMinutes, span)};width:{W((b.E - b.S).TotalMinutes, span)};background:{Hatch}";
    static string PlanStyle(WtsReportDay dd, DateTime s0, double span) => $"top:0;bottom:0;left:{W((dd.PlanStart!.Value - s0).TotalMinutes, span)};width:{W((dd.PlanEnd!.Value - dd.PlanStart.Value).TotalMinutes, span)};border-left:1px dashed #adb5bd;border-right:1px dashed #adb5bd";
    static string TlTitle(WtsReportRow r) => $"{r.StartTime:HH:mm}–{r.EndTime:HH:mm} · {TaskText(r)} ({KindWord(r.Kind)}) {r.PurchaseOrder} {r.NC} {r.MachineUsed}".Trim()
        + (r.ExtraParts.Count > 0 ? " · phát sinh: " + string.Join(", ", r.ExtraParts.Select(x => $"{PartText(r, x)} {x.ReqMin} ph ({KindWord(x.Kind)})")) : "");
    static string TlStyle(WtsReportRow r, DateTime s0, double span, int lane, int nLane)
        => $"top:{4 + 30 * lane}px;height:28px;left:{W((r.StartTime - s0).TotalMinutes, span)};width:{W((r.EndTime - r.StartTime).TotalMinutes, span)};background:{KindColor(r.Kind)};color:{(r.Kind == WtsTaskKind.VoIch ? "#1f1300" : "#fff")};font-size:11px;border-right:1px solid #fff";
    static string ShortLbl(WtsReportRow r) => r.RowType == WtsRowType.Production && (r.ProcessGroup ?? "").ToUpperInvariant() == "GC"
        ? string.Join(" · ", new[] { r.NC, r.MachineUsed }.Where(x => !string.IsNullOrWhiteSpace(x)))
        : (string.IsNullOrWhiteSpace(r.TaskCode) ? r.TaskLabel : r.TaskCode);

    RenderFragment TaskTable() => __builder =>
    {
        // [WTS-1NGUON] gom theo PHẦN (phần dòng + phát sinh theo mã); OK / NG chỉ đếm ở phần dòng sản xuất
        var groups = _rows.SelectMany(r => r.Parts.Select(x => (R: r, P: x))).Where(x => x.P.Min > 0 || !x.P.IsExtra).GroupBy(x => (x.P.Kind, x.P.TaskKey)).Select(g => (
            Ok: g.Key.Kind, Lbl: PartText(g.First().R, g.First().P), Grp: string.Join(" · ", g.Select(x => x.P.GroupLabel).Distinct()), Lines: g.Select(x => x.R).Distinct().Count(), Min: g.Sum(x => x.P.Min),
            QOk: g.Where(x => !x.P.IsExtra && x.R.RowType == WtsRowType.Production).Sum(x => x.R.QtyOk ?? 0), QNg: g.Where(x => !x.P.IsExtra && x.R.RowType == WtsRowType.Production).Sum(x => x.R.QtyNg ?? 0),
            Prod: g.Any(x => !x.P.IsExtra && x.R.RowType == WtsRowType.Production)))
            .OrderBy(x => x.Ok).ThenByDescending(x => x.Min).ToList();
        var tot = BaseMin;
        var un = Unacc ?? 0;
        <div class="border rounded p-3 h-100 bg-white">
            <div class="fw-semibold mb-2">Theo việc / mã công việc</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" style="font-size:.85rem">
                    <thead class="table-light"><tr><th>Loại</th><th>Việc / mã</th><th>Nhóm</th><th class="text-end">Số dòng</th><th class="text-end">Phút</th><th class="text-end">% @BaseWord</th><th class="text-end">OK</th><th class="text-end">NG</th></tr></thead>
                    <tbody>
                        @foreach (var x in groups)
                        {
                            <tr style="@RowBg(x.Ok)">
                                <td><span class="@TagCls(x.Ok)" style="@TagStyle(x.Ok)">@TagText(x.Ok)</span></td>
                                <td class="fw-semibold">@x.Lbl</td>
                                <td class="text-muted small">@x.Grp</td>
                                <td class="text-end">@x.Lines</td>
                                <td class="text-end fw-bold">@N(x.Min)</td>
                                <td class="text-end">@Pct(x.Min, tot)</td>
                                <td class="text-end">@(x.Prod ? N(x.QOk) : "—")</td>
                                <td class="text-end text-danger">@(x.Prod && x.QNg > 0 ? N(x.QNg) : "—")</td>
                            </tr>
                        }
                        @if (un > 0)
                        {
                            <tr><td><span class="badge text-dark" style="font-size:.7rem;background:@Hatch">Chưa KB</span></td><td class="fst-italic text-muted">Giờ ca không có dòng WTS</td><td></td><td class="text-end">—</td><td class="text-end fw-bold">@N(un)</td><td class="text-end">@Pct(un, tot)</td><td class="text-end">—</td><td class="text-end">—</td></tr>
                        }
                        <tr class="fw-bold"><td></td><td>@(Searching ? "Tổng" : "Tổng = giờ chuẩn")</td><td></td><td class="text-end">@_rows.Count</td><td class="text-end">@N(tot)</td><td class="text-end">@(tot > 0 ? "100%" : "—")</td><td class="text-end">@N(OkSum)</td><td class="text-end text-danger">@N(NgSum)</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="small text-muted mt-1">Gia công gom theo Hàng loạt / Chạy thử (NC từng PO xem ở chi tiết). Loại Gia công theo "Mã dùng cho Gia công". Phút = phút làm; phút phát sinh tách theo mã phát sinh; giờ trùng: có ích tính trước, rồi vô ích, rồi chưa có mã; cùng loại (đứng 2 máy) chia đều.</div>
        </div>
    };

    RenderFragment DetailByDay() => __builder =>
    {
        var isDay = _period == "day";
        <div class="border rounded p-3 bg-white mb-3">
            <div class="fw-semibold mb-2">Chi tiết dòng WTS <span class="small text-muted fw-normal">— gom theo ngày; dòng vô ích tô cam, chưa có mã tô xám</span></div>
            @foreach (var g in _rows.GroupBy(r => r.WorkDate).OrderBy(g => g.Key))
            {
                var d = g.Key;
                var pro = SumKind(g, WtsTaskKind.CoIch); var waste = SumKind(g, WtsTaskKind.VoIch); var nc = SumKind(g, WtsTaskKind.ChuaMa);   // [WTS-1NGUON]
                var dd = Searching ? null : _dayOf.GetValueOrDefault(d);
                var dun = dd?.UnaccountedMin;
                var dbase = pro + waste + nc + (dun ?? 0);
                var open = isDay || _openDays.Contains(d);
                <div class="d-flex align-items-center gap-3 px-2 py-2 mt-2 rounded border small" style="background:#f8fafc" @key="d">
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => ToggleDay(d)" aria-label="Mở / đóng ngày">@(open ? "▾" : "▸")</button>
                    <b style="width:90px">@DayLabel(d)</b>
                    @if (!Searching)
                    {
                        <span>chuẩn @N(dbase)</span>
                    }
                    <span>khai báo @N(pro + waste + nc)</span>
                    <span style="color:@CG">có ích @N(pro)</span>
                    <span style="color:@COT">vô ích @N(waste)</span>
                    <span style="color:@CN;@NcVis(nc)">chưa có mã @N(nc)</span>
                    @if (dun != null)
                    {
                        <span class="text-muted">chưa KB @N(dun.Value)</span>
                    }
                    else if (dd?.IsTail == true)
                    {
                        <span class="badge text-dark" style="background:#e7f1ff" title="Dòng sau 0h của ca qua đêm hôm trước — giờ ca đã tính ở hôm trước">đuôi ca đêm</span>
                    }
                    else if (!Searching)
                    {
                        <span class="badge text-dark" style="background:#fff3cd">không rõ ca</span>
                    }
                    @if ((dd?.BreakWorkedMin ?? 0) > 0)
                    {
                        <span class="text-primary">làm thông nghỉ @(dd!.BreakWorkedMin)</span>
                    }
                    <span class="ms-auto fw-bold" style="@LowStyle(pro, dbase)">@Pct(pro, dbase)</span>
                    @if (!isDay)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => OpenDay(d)" disabled="@_loading">Xem ngày</button>
                    }
                </div>
                @if (open)
                {
                    @DetailTable(g.ToList(), false)
                }
            }
        </div>
    };

    RenderFragment DetailTable(List<WtsReportRow> rs, bool withWorker) => __builder =>
    {
        <div class="table-responsive" style="max-height:520px">
            <table class="table table-sm table-bordered align-middle mb-0" style="font-size:.8rem">
                <thead class="table-light" style="position:sticky;top:0;z-index:1">
                    <tr>
                        @if (withWorker)
                        {
                            <th>Ngày</th><th>Công nhân</th>
                        }
                        <th>Giờ</th><th class="text-center" title="Phút làm = giờ thô − nghỉ bị trừ (đã cộng làm thông nghỉ)">Phút</th><th class="text-center">Thô</th><th class="text-center">Thông nghỉ</th>
                        <th>Loại</th><th>Việc / mã</th><th>PO</th><th>Part No</th><th>NC · Máy</th><th class="text-center">OK</th><th class="text-center">NG</th><th>Lý do NG</th><th class="text-center">T.PS</th><th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rs)
                    {
                        <tr style="@RowBg(r.Kind)">
                            @if (withWorker)
                            {
                                <td>@r.WorkDate.ToString("dd/MM")</td><td class="fw-semibold">@r.WorkerName</td>
                            }
                            <td class="text-nowrap">@r.StartTime.ToString("HH:mm")–@r.EndTime.ToString("HH:mm")</td>
                            <td class="text-center fw-bold" title="@RowTip(r)">@r.Minutes@(r.AllocMin != r.Minutes ? $" ({r.AllocMin})" : "")</td>
                            <td class="text-center text-muted">@r.RawMinutes</td>
                            <td class="text-center text-warning">@(r.BreakWorkedMin > 0 ? r.BreakWorkedMin.ToString() : "—")</td>
                            <td><span class="@TagCls(r.Kind)" style="@TagStyle(r.Kind)">@TagText(r.Kind)</span>@if (r.IsOvertime) {<span class="badge bg-warning text-dark ms-1" style="font-size:.65rem">OT</span>}</td>
                            <td>@TaskText(r)</td>
                            <td><code>@(string.IsNullOrEmpty(r.PurchaseOrder) ? "—" : r.PurchaseOrder)</code></td>
                            <td>@(string.IsNullOrEmpty(r.PartNo) ? "—" : r.PartNo)</td>
                            <td>@NcMay(r)</td>
                            <td class="text-center text-success">@(r.QtyOk > 0 ? r.QtyOk.Value.ToString("0.##") : "—")</td>
                            <td class="text-center text-danger">@(r.QtyNg > 0 ? r.QtyNg.Value.ToString("0.##") : "—")</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(r.NgReason) ? "—" : r.NgReason)</td>
                            <td class="text-center" title="@PsTip(r)">@PsText(r)</td>
                            <td class="text-muted">@r.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!withWorker && rs.Count > 0)
        {
            <div class="small text-muted mt-1">Số trong ngoặc ở cột Phút = phút tính vào báo cáo khi trùng giờ với dòng khác: việc có ích được tính trước việc vô ích, các dòng cùng loại (vd đứng 2 máy) chia đều.</div>
        }
    };
    // [WTS-1NGUON] cột T.PS: phút + mã phát sinh (loại theo mã)
    static string PsText(WtsReportRow r) => r.ExtraParts.Count > 0
        ? string.Join(", ", r.ExtraParts.Select(x => $"{x.ReqMin} {(x.TaskCode.Length > 0 ? x.TaskCode : "(không mã)")}"))
        : (r.ExtraMinutes is int em && em > 0 ? em.ToString() : "—");   // [WTS-1NGUON] em: tránh cảnh báo CS8603 (int?.ToString)
    static string PsTip(WtsReportRow r) => r.ExtraParts.Count == 0 ? "" : string.Join("; ", r.ExtraParts.Select(x => $"{PartText(r, x)}: khai {x.ReqMin} ph, tính {x.Min} ph — {KindWord(x.Kind)}"));
    static string NcVis(int nc) => nc > 0 ? "" : "display:none";
    static string NcMay(WtsReportRow r)
    {
        var s = string.Join(" · ", new[] { r.NC, r.MachineUsed }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return s.Length == 0 ? "—" : s;
    }

    // ── bảng phụ cũ (giữ) ──────────────────────────────────────────────────────────────────────────────────
    RenderFragment ExtraTables() => __builder =>
    {
        var inG = GroupWorkers();   // [G31-LOC-NHOM] bảng phụ cũng theo ô Nhóm (rà độc lập 22/11 Trung 4)
        var src = new WtsReportResult { Rows = (_result?.Rows ?? new()).Where(r => (_workerId == 0 || r.WorkerId == _workerId) && (inG == null || inG.Contains(r.WorkerId))).ToList() };
        var rep = src.RepairByPo;
        var brk = src.BreakWorkRows;
        if (rep.Count == 0 && brk.Count == 0) return;
        <div class="mt-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleExtra">
                <i class="@_extraIcon"></i>Bảng phụ: giờ sửa hàng theo PO (@rep.Count) · làm thông nghỉ (@brk.Count)
            </button>
        </div>
        if (!_showExtra) return;
        if (rep.Count > 0)
        {
            <div class="card border-0 bg-light mt-2">
                <div class="card-body py-2">
                    <div class="small fw-semibold mb-1"><i class="bi bi-tools me-1"></i>Giờ sửa hàng theo PO (việc không ra sản phẩm có ghi PO) — phút làm từng dòng, chưa chia giờ trùng</div>
                    <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;max-width:640px">
                        <thead class="table-light"><tr><th>PO</th><th>Part No</th><th class="text-center">Phút</th><th class="text-center">Số dòng</th><th class="text-center">Số @NgCaseNo.Term</th></tr></thead>
                        <tbody>
                            @foreach (var x in rep)
                            {
                                <tr><td>@x.Po</td><td>@x.Part</td><td class="text-center fw-semibold">@x.Minutes</td><td class="text-center">@x.Lines</td><td class="text-center">@x.Cases</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        if (brk.Count > 0)
        {
            <div class="card border-0 bg-light mt-2">
                <div class="card-body py-2">
                    <div class="small fw-semibold mb-1"><i class="bi bi-cup-hot me-1"></i>Làm thông nghỉ (phút) — theo ngày · công nhân · khoảng nghỉ · PO</div>
                    <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;max-width:760px">
                        <thead><tr><th>Ngày</th><th>Công nhân</th><th>Khoảng nghỉ</th><th>PO</th><th>NC / Mã CV</th><th class="text-center">Phút</th></tr></thead>
                        <tbody>
                            @foreach (var x in brk)
                            {
                                <tr><td>@x.Day.ToString("dd/MM/yyyy")</td><td>@x.Worker</td><td>@x.Break</td><td>@(string.IsNullOrEmpty(x.Po) ? "—" : x.Po)</td><td>@x.Code</td><td class="text-center fw-semibold">@x.Minutes</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    };
}
