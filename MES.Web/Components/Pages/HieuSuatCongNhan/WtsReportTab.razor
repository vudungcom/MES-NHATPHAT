    RenderFragment Breadcrumb() => __builder =>
    {
        <div class="small text-muted mb-2">
            @if (_workerId == 0)
            {
                <b class="text-dark">Tất cả công nhân</b>
                <span> · @_rows.Select(r => r.WorkerId).Distinct().Count() người có WTS</span>
            }
            else
            {
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="BackToTeam">Tất cả công nhân</button>
                <span> › </span><b class="text-dark">@_workerText</b>
                <span> · @CaText</span>
            }
            @if (_search.Trim().Length > 0)
            {
                <span class="ms-2 badge bg-info text-dark">Đang lọc: "@_search.Trim()" — @_rows.Count dòng khớp</span>
            }
            @if (_groupKey.Length > 0)
            {
                <span class="ms-2 badge bg-secondary">Nhóm: @GroupName</span>
            }
        </div>
    };
    string CaText
    {
        get
        {
            var cas = (_result?.Days ?? new()).Where(d => d.WorkerId == _workerId && d.CaName != null).Select(d => $"{d.CaName} ({d.CaLabel})").Distinct().ToList();
            return cas.Count == 0 ? "không có ca trên dòng WTS" : string.Join(", ", cas);
        }
    }

    RenderFragment Kpi(string label, string val, string sub, string color, string bg) => __builder =>
    {
        <div class="col">
            <div class="h-100 rounded border px-3 py-2" style="background:@bg">
                <div class="small text-muted">@label</div>
                <div class="fs-4 fw-bold" style="color:@color">@val</div>
                <div class="text-muted" style="font-size:.75rem">@sub</div>
            </div>
        </div>
    };
    RenderFragment KpiRow() => __builder =>
    {
        var un = Unacc;
        var ng = NgSum; var ok = OkSum;
        var bs = BaseMin;
        <div class="row row-cols-2 row-cols-md-6 g-2 mb-3">
            @(Kpi(Searching ? "Phút dòng khớp tìm nhanh" : "Giờ chuẩn (theo ca)", N(bs), BaseSub, "#212529", "#fff"))
            @(Kpi("Có ích", N(ProMin), $"{Pct(ProMin, bs)} {BaseWord}", CG, "#f0fdf4"))
            @(Kpi("Vô ích đã khai báo", N(WasteMin), $"{Pct(WasteMin, bs)} · lớn nhất: {TopWasteName(_rows)}", COT, "#fff7ed"))
            @(Kpi("Chưa có mã", N(NoCodeMin), $"{Pct(NoCodeMin, bs)} · dòng / phát sinh chưa có mã WTS tiêu chuẩn", CN, "#f1f5f9"))
            @(Kpi("Chưa khai báo", un == null ? "—" : N(un.Value), un == null ? (Searching ? "không tính khi đang tìm nhanh" : "không rõ ca trên dòng WTS") : $"{Pct(un.Value, bs)} · giờ ca không có dòng WTS", "#5c636a", "#f8f9fa"))
            @(Kpi("Sản lượng OK / NG", $"{N(ok)} / {N(ng)}", ok + ng > 0 ? $"tỉ lệ NG {Pct((double)ng, (double)(ok + ng))}" : "không có dòng sản xuất", "#212529", "#fff"))
        </div>
    };

    /// <summary>[G30-RPT-MAUSO] Dòng phụ ô Giờ chuẩn: số ngày có WTS · khai báo · làm thông nghỉ · ngày không rõ ca.</summary>
    string BaseSub
    {
        get
        {
            if (Searching) return "đang tìm nhanh: % chỉ trên phút của dòng khớp (không có giờ ca)";
            var ds = ScopeDays;
            var nDays = _workerId == 0 ? ds.Count : ds.Select(d => d.Day).Distinct().Count();
            var parts = new List<string> { $"{nDays} {(_workerId == 0 ? "người-ngày" : "ngày")} có WTS", $"khai báo {N(TotMin)}" };
            var th = ds.Sum(d => d.BreakWorkedMin);
            if (th > 0) parts.Add($"làm thông nghỉ {N(th)}");
            var noCa = ds.Count(NoCa);
            var tl = ds.Count(d => d.IsTail);
            if (tl > 0) parts.Add($"{tl} {(_workerId == 0 ? "người-ngày" : "ngày")} đuôi ca đêm (giờ ca tính ở hôm trước)");
            if (noCa > 0) parts.Add($"{noCa} {(_workerId == 0 ? "người-ngày" : "ngày")} không rõ ca (tính trên phút khai báo)");
            return string.Join(" · ", parts);
        }
    }

    // ── TẤT CẢ CÔNG NHÂN ───────────────────────────────────────────────────────────────────────────────────
    sealed record TeamRow(int Id, string Name, string Main, int Tot, int Pro, int Waste, int NoCode, int? Unacc, string TopWaste, int Days, bool HasNoCa)
    {
        public int Base => Tot + (Unacc ?? 0);   // [G30-RPT-MAUSO] giờ chuẩn của người (tìm nhanh: Unacc null → phút dòng khớp)
    }
    List<TeamRow> TeamRows()
    {
        var days = _result?.Days ?? new();
        var noSearch = _search.Trim().Length == 0;
        return _rows.GroupBy(r => r.WorkerId).Select(g =>
        {
            var pro = SumKind(g, WtsTaskKind.CoIch); var waste = SumKind(g, WtsTaskKind.VoIch); var nc = SumKind(g, WtsTaskKind.ChuaMa);   // [WTS-1NGUON]
            var main = g.Where(r => r.RowType == WtsRowType.Production).GroupBy(r => r.GroupLabel).OrderByDescending(x => x.Sum(r => r.AllocMin)).Select(x => x.Key).FirstOrDefault() ?? "Việc không ra SP";
            var ud = days.Where(d => d.WorkerId == g.Key && d.UnaccountedMin != null).ToList();
            return new TeamRow(g.Key, g.First().WorkerName, main, pro + waste + nc, pro, waste, nc, noSearch && ud.Count > 0 ? ud.Sum(d => d.UnaccountedMin!.Value) : null, TopWasteName(g), g.Select(r => r.WorkDate).Distinct().Count(), days.Any(d => d.WorkerId == g.Key && NoCa(d)));
        }).OrderBy(t => t.Base == 0 ? 101 : PctVal(t.Pro, t.Base)).ThenBy(t => t.Name).ToList();
    }
    RenderFragment TeamView() => __builder =>
    {
        var team = TeamRows();
        var maxTot = team.Count == 0 ? 1 : Math.Max(1, team.Max(t => t.Base));
        var noSearch = !Searching;
        <div class="row g-3 mb-3">
            <div class="col-lg-8">
                <div class="border rounded p-3 h-100 bg-white">
                    <div class="fw-semibold mb-2">Từng công nhân <span class="small text-muted fw-normal">— xếp % có ích thấp → cao; bấm tên để xem riêng; % = có ích ÷ @BaseWord; chỉ tính ngày có WTS</span></div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" style="font-size:.85rem">
                            <thead class="table-light"><tr><th>Công nhân</th><th>Làm chủ yếu</th><th class="text-end">Ngày có WTS</th><th class="text-end">@(Searching ? "Phút khớp" : "Giờ chuẩn (ph)")</th><th style="width:220px">Có ích / vô ích / chưa có mã / chưa KB</th><th class="text-end">% có ích</th><th>Vô ích lớn nhất</th><th class="text-end">Chưa khai báo</th></tr></thead>
                            <tbody>
                                @foreach (var t in team)
                                {
                                    var id = t.Id;
                                    <tr @key="t.Id">
                                        <td><button type="button" class="btn btn-link btn-sm p-0 fw-bold" @onclick="() => PickWorker(id)">@t.Name</button></td>
                                        <td>@t.Main</td>
                                        <td class="text-end">@t.Days</td>
                                        <td class="text-end">@N(t.Base)</td>
                                        <td><div class="d-flex rounded overflow-hidden" style="height:14px;background:#f1f3f5;width:@W(t.Base, maxTot)"><div style="width:@W(t.Pro, t.Base);background:@CG"></div><div style="width:@W(t.Waste, t.Base);background:@CO"></div><div style="width:@W(t.NoCode, t.Base);background:@CN"></div><div style="width:@W(t.Unacc ?? 0, t.Base);background:@Hatch"></div></div></td>
                                        <td class="text-end fw-bold" style="@LowStyle(t.Pro, t.Base)">@Pct(t.Pro, t.Base)</td>
                                        <td class="small">@t.TopWaste</td>
                                        <td class="text-end text-muted">
                                            @if (t.Unacc != null)
                                            {
                                                <span>@N(t.Unacc.Value)</span>
                                                @if (noSearch && t.HasNoCa)
                                                {
                                                    <span class="ms-1 text-warning" title="Có ngày dòng WTS không cho biết ca — ngày đó chỉ tính trên phút khai báo">*</span>
                                                }
                                            }
                                            else if (noSearch && t.HasNoCa)
                                            {
                                                <span class="badge text-dark" style="background:#fff3cd;font-size:.7rem" title="Dòng WTS không cho biết ca — % chỉ tính trên phút khai báo">Không rõ ca</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 d-flex flex-column gap-3">
                <div class="border rounded p-3 bg-white">
                    <div class="fw-semibold mb-2">Cả đội <span class="small text-muted fw-normal">trên @BaseWord</span></div>
                    <div class="d-flex align-items-center gap-3">@Donut(ProMin, WasteMin, NoCodeMin, Unacc ?? 0, "có ích")@Legend3(ProMin, WasteMin, NoCodeMin, Unacc)</div>
                </div>
                @Pareto()
            </div>
        </div>
        @if (_search.Trim().Length > 0)
        {
            <div class="border rounded p-3 bg-white mb-3">
                <div class="fw-semibold mb-2">Dòng khớp tìm nhanh <span class="small text-muted fw-normal">(tối đa 500 dòng)</span></div>
                @DetailTable(_rows.Take(500).ToList(), true)
            </div>
        }
    };
    static string LowStyle(double pro, double tot) => tot > 0 && PctVal(pro, tot) < LowPct ? "color:#b02a37" : "";

    RenderFragment Pareto() => __builder =>
    {
        var waste = _rows.SelectMany(r => r.Parts.Select(x => (R: r, P: x))).Where(x => x.P.Kind == WtsTaskKind.VoIch).GroupBy(x => x.P.TaskKey)   // [WTS-1NGUON] cả phát sinh
            .Select(g => (Lbl: PartText(g.First().R, g.First().P), Min: g.Sum(x => x.P.Min), Lines: g.Count())).Where(x => x.Min > 0).OrderByDescending(x => x.Min).ToList();
        var tot = waste.Sum(x => x.Min);
        var max = waste.Count == 0 ? 1 : waste[0].Min;
        <div class="border rounded p-3 bg-white">
            <div class="fw-semibold mb-2">Vô ích do đâu <span class="small text-muted fw-normal">— @N(tot) ph, lớn → nhỏ</span></div>
            @if (waste.Count == 0)
            {
                <div class="small text-muted">Không có phút vô ích.</div>
            }
            @foreach (var x in waste.Take(10))
            {
                <div class="d-flex align-items-center gap-2 py-1 small">
                    <span style="width:150px" class="text-truncate" title="@x.Lbl">@x.Lbl</span>
                    <div class="flex-grow-1 rounded" style="height:14px;background:#f1f3f5"><div class="rounded" style="height:14px;width:@W(x.Min, max);background:@CO"></div></div>
                    <span style="width:120px;white-space:nowrap" class="text-end"><b>@N(x.Min)</b> ph · @Pct(x.Min, tot)</span>
                </div>
            }
            @if (waste.Count > 10)
            {
                <div class="small text-muted">+ @(waste.Count - 10) việc khác: @N(waste.Skip(10).Sum(x => x.Min)) ph</div>
            }
            @if ((Unacc ?? 0) > 0 || NoCodeMin > 0)
            {
                <div class="small text-muted mt-1">Chưa có mã (@N(NoCodeMin) ph) và chưa khai báo (@N(Unacc ?? 0) ph) không nằm trong bảng này.</div>
            }
        </div>
    };

    // ── 1 CÔNG NHÂN ────────────────────────────────────────────────────────────────────────────────────────
    sealed record DayBar(DateOnly Day, int Pro, int Waste, int NoCode, int? Unacc, int? Plan, int Thong)
    {
        public int Base => Pro + Waste + NoCode + (Unacc ?? 0);   // [G30-RPT-MAUSO] giờ chuẩn ngày · [WTS-1NGUON] + chưa có mã
    }
    List<DayBar> DayBars()
    {
        var noSearch = _search.Trim().Length == 0;
        var days = _dayOf;
        return _rows.GroupBy(r => r.WorkDate).OrderBy(g => g.Key).Select(g =>
        {
            days.TryGetValue(g.Key, out var d);
            return new DayBar(g.Key, SumKind(g, WtsTaskKind.CoIch), SumKind(g, WtsTaskKind.VoIch), SumKind(g, WtsTaskKind.ChuaMa), noSearch ? d?.UnaccountedMin : null, d?.PlanMin, noSearch ? d?.BreakWorkedMin ?? 0 : 0);
        }).ToList();
    }
    RenderFragment WorkerView() => __builder =>
    {
        var isDay = _period == "day";
        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100 bg-white">
                    <div class="fw-semibold mb-2">Tỉ lệ có ích / vô ích <span class="small text-muted fw-normal">trên @BaseWord</span></div>
                    <div class="d-flex align-items-center gap-3">@Donut(ProMin, WasteMin, NoCodeMin, Unacc ?? 0, "có ích")@Legend3(ProMin, WasteMin, NoCodeMin, Unacc)</div>
                    <div class="small text-muted mt-2">Giờ chuẩn = giờ ca − giờ nghỉ + làm thông nghỉ + làm ngoài giờ ca; chỉ tính ngày có dòng WTS. Có ích / vô ích theo cột Phân loại của mã ở WTS tiêu chuẩn (Gia công theo "Mã dùng cho Gia công"; phút phát sinh theo mã phát sinh). Chưa có mã = dòng / phát sinh không mã hoặc mã không có trong danh mục.</div>
                </div>
            </div>
            <div class="col-lg-8">
                @if (isDay)
                {
                    @Timeline()
                }
                else
                {
                    @DayBarsUi()
                }
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-lg-4">@Pareto()</div>
            <div class="col-lg-8">@TaskTable()</div>
        </div>
        @DetailByDay()
    };

    RenderFragment DayBarsUi() => __builder =>
    {
        var bars = DayBars();
        var scale = Math.Max(1, bars.Count == 0 ? 1 : bars.Max(b => b.Base));
        <div class="border rounded p-3 h-100 bg-white">
            <div class="fw-semibold mb-1">Từng ngày <span class="small text-muted fw-normal">— bấm 1 ngày để xem dòng thời gian ngày đó</span></div>
            <div class="d-flex flex-wrap gap-3 small text-muted mb-2">
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CG"></span>có ích</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CO"></span>vô ích đã khai báo</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@CN"></span>chưa có mã</span>
                <span><span class="d-inline-block me-1" style="width:10px;height:10px;background:@Hatch"></span>chưa khai báo</span>
                <span class="ms-auto">phút: có ích · vô ích · chưa có mã · chưa KB / chuẩn — % có ích</span>
            </div>
            @foreach (var b in bars)
            {
                var d = b.Day;
                <button type="button" class="btn btn-light w-100 d-flex align-items-center gap-2 py-1 px-1 mb-1 border-0 text-start" @onclick="() => OpenDay(d)" disabled="@_loading">
                    <span style="width:70px" class="small">@DayLabel(b.Day)</span>
                    <span class="flex-grow-1 d-flex align-items-center gap-1">
                        <span class="d-flex rounded overflow-hidden" style="height:20px;width:@W(b.Base, scale)">
                            <span style="width:@W(b.Pro, b.Base);background:@CG"></span><span style="width:@W(b.Waste, b.Base);background:@CO"></span><span style="width:@W(b.NoCode, b.Base);background:@CN"></span><span style="width:@W(b.Unacc ?? 0, b.Base);background:@Hatch"></span>
                        </span>
                        @if (b.Thong > 0)
                        {
                            <span class="text-primary" style="font-size:.7rem;white-space:nowrap">+@b.Thong thông nghỉ</span>
                        }
