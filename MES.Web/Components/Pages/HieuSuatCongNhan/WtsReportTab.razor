            }
            <div class="d-flex align-items-center gap-2 border-top pt-1"><span class="flex-grow-1 text-muted">@(Searching ? "Phút dòng khớp" : "Giờ chuẩn")</span><b>@N(tot) ph</b><span style="width:48px"></span></div>
        </div>
