@* [G29-RPT 2026-11-21] Tab "WTS Report" làm lại theo mockup https://claude.ai/artifact/HH5sobEdA8pFNjGCaDGJKR (Hùng 21/11 09:46 "ok làm"):
   tất cả công nhân → 1 công nhân (tuần / tháng: từng ngày, theo việc, vô ích do đâu, chi tiết gom ngày) → 1 ngày (dòng thời gian trong ca).
   Số lấy từ WtsReportService.GetReportAsync (chỉ đọc; máy chủ kiểm quyền Xem WTS Report [RPT-4]). Phút mỗi dòng = AllocMin (khoảng nhiều dòng
   phủ chia đều, ưu tiên dòng có ích) nên mọi bảng cộng đúng bằng ô tổng. Ô "Tìm nhanh" [G29-TIMNHANH] lọc dòng theo chữ (người, PO, Part, NC,
   máy, mã / tên việc, lý do NG, ghi chú) — ô số, biểu đồ, bảng tính lại theo dòng khớp. Thay khối report cũ trong HieuSuat_Index.razor
   (bảng phẳng 1 khoảng ngày + 4 ô số); giữ 2 bảng phụ cũ: giờ sửa hàng theo PO [ML16-ACT] + làm thông nghỉ [ML17-XN].
   Nguồn: KHÁCH chưa xem; HÙNG 21/11 08:01 (ý tưởng) + 09:46 (OK mockup + câu B theo đề xuất, thêm tìm nhanh).
   [G30-RPT-MAUSO 2026-11-21] Mọi % có ích / vô ích / chưa khai báo chia cho GIỜ CHUẨN theo ca (Σ WtsReportDay.BaseMin của người-ngày trong phạm vi
   = phút làm + giờ ca chưa khai báo; làm thông nghỉ + làm ngoài ca đã nằm trong phút làm), không còn chia cho phút khai báo; biểu đồ tròn 3 phần;
   chỉ ngày có dòng WTS. Đang tìm nhanh: không còn giờ ca → % trên phút của dòng khớp. Thêm nút Năm.
   Nguồn: HÙNG 21/11 16:03 + 16:10 + 16:19 "ok làm đi" (mockup HH5sobEdA8pFNjGCaDGJKR bản G30).
   [G31-LOC-NHOM 2026-11-22] Ô "Nhóm" (nhóm của công nhân ở Cài đặt phân quyền): lọc theo NGƯỜI nên giữ giờ chuẩn (khác Tìm nhanh lọc theo dòng).
   Nguồn: HÙNG 22/11 08:29 + 11:58 "code luôn"; CLAUDE đề xuất ô Nhóm 22/11.
   [WTS-1NGUON 2026-11-26] Phút chia theo PHẦN (WtsReportRow.Parts: phần việc của dòng + từng mục phát sinh theo mã) và 3 loại theo cờ mã WTS
   tiêu chuẩn: Có ích / Vô ích / Chưa có mã (+ Chưa khai báo) = giờ chuẩn. Gia công theo "Mã dùng cho Gia công".
   Nguồn: HÙNG 26/11 22:09 + 23:00 "chốt lại làm theo bạn" + 23:08 "Ok làm đi". *@
@using System.Globalization
@using MES.Web.Services
@inject WtsReportService ReportSvc
@inject ILogger<WtsReportTab> Logger

<div class="card shadow-sm border-0">
    <div class="card-body">
        @FilterBar()
        @if (_error != null)
        {
            <div class="alert alert-warning my-2">@_error</div>
        }
        @if (_loading)
        {
            <div class="text-muted small my-2"><span class="spinner-border spinner-border-sm me-1"></span>Đang tải báo cáo…</div>
        }
        @if (_result != null && !_loading)
        {
            @Breadcrumb()
            @KpiRow()
            @if (_rows.Count == 0)
            {
                <div class="text-center py-5 text-muted">Không có dòng WTS nào @(_search.Length > 0 ? "khớp ô Tìm nhanh" : "trong kỳ này").</div>
            }
            else if (_workerId == 0)
            {
                @TeamView()
            }
            else
            {
                @WorkerView()
            }
            @ExtraTables()
        }
    </div>
</div>

@code {
    [Parameter] public int ViewerUserId { get; set; }

    static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");
    const string CG = "#198754";    // có ích
    const string CO = "#e8890c";    // vô ích
    const string COT = "#9a4a00";   // chữ vô ích (đủ tương phản)
    const string CN = "#64748b";    // [WTS-1NGUON] chưa có mã
    const string Hatch = "repeating-linear-gradient(45deg,#dee2e6 0 4px,#f8f9fa 4px 8px)";
    const int LowPct = 85;          // mức tô đỏ (câu B4 — cố định, chưa làm cài đặt)

    string _period = "week";        // day | week | month | year | custom
    DateTime _anchor = DateTime.Today;
    DateTime _customFrom = DateTime.Today.AddDays(-6);
    DateTime _customTo = DateTime.Today;
    string _workerText = "";
    bool _workerNotFound;
    int _workerId;
    string _groupKey = "";          // [G31-LOC-NHOM] "" = tất cả nhóm; "g<GroupId>" / "none" = chưa có nhóm
    string _search = "";
    bool _loading;
    string? _error;
    WtsReportResult? _result;
    List<(int Id, string Name)> _workers = new();
    List<WtsReportRow> _rows = new();          // dòng sau lọc người + tìm nhanh
    HashSet<DateOnly> _openDays = new();
    bool _showExtra;

    DateOnly From => _period switch
    {
        "day" => DateOnly.FromDateTime(_anchor),
        "week" => DateOnly.FromDateTime(_anchor.AddDays(-(((int)_anchor.DayOfWeek + 6) % 7))),
        "month" => new DateOnly(_anchor.Year, _anchor.Month, 1),
        "year" => new DateOnly(_anchor.Year, 1, 1),   // [G30-RPT-MAUSO] nút Năm (Hùng 16:10 "theo năm")
        _ => DateOnly.FromDateTime(_customFrom),
    };
    DateOnly To => _period switch
    {
        "day" => DateOnly.FromDateTime(_anchor),
        "week" => From.AddDays(6),
        "month" => new DateOnly(_anchor.Year, _anchor.Month, 1).AddMonths(1).AddDays(-1),
        "year" => new DateOnly(_anchor.Year, 12, 31),
        _ => DateOnly.FromDateTime(_customTo),
    };

    protected override async Task OnInitializedAsync()
    {
        try { _workers = await ReportSvc.GetAllActiveWorkersAsync(ViewerUserId); }
        catch (Exception ex) { _error = UiSafe.Text(ex, Logger, "tải danh sách công nhân"); }
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (_loading) return;   // không tải chồng (1 DbContext / phiên)
        _loading = true; _error = null; _result = null;
        StateHasChanged();
        try
        {
            var f = From; var t = To;
            if (t < f) { _error = "Ngày \"Từ\" phải trước hoặc bằng ngày \"Đến\"."; return; }
            // không trần số ngày (rà độc lập 16/11 T2 đã chốt cho báo cáo WTS — giữ; rà độc lập 21/11 L10)
            _result = await ReportSvc.GetReportAsync(f, t, null, ViewerUserId);   // [RPT-4] máy chủ kiểm quyền; lọc người ở trang (đã có đủ người-ngày)
            _openDays.Clear();
            Recompute();
        }
        catch (Exception ex) { _error = UiSafe.Text(ex, Logger, "tải báo cáo WTS"); }   // chỉ đọc
        finally { _loading = false; }
    }

    // ── lọc người + tìm nhanh ───────────────────────────────────────────────────────────────────────────────
    void Recompute()
    {
        var all = _result?.Rows ?? new List<WtsReportRow>();
        IEnumerable<WtsReportRow> q = all;
        if (_workerId != 0) q = q.Where(r => r.WorkerId == _workerId);
        if (_groupKey.Length > 0 && !GroupOptions().Any(g => g.Key == _groupKey)) _groupKey = "";   // kỳ mới không có nhóm đã chọn → bỏ lọc (rà độc lập 22/11 L5)
        var inGroup = GroupWorkers();
        if (inGroup != null) q = q.Where(r => inGroup.Contains(r.WorkerId));   // [G31-LOC-NHOM]
        var s = (_search ?? "").Trim();
        if (s.Length > 0)
        {
            var parts = s.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            q = q.Where(r => { var h = Hay(r); return parts.All(p => h.Contains(p)); });
        }
        _rows = q.OrderBy(r => r.WorkDate).ThenBy(r => r.WorkerName).ThenBy(r => r.StartTime).ToList();
        // [G30-RPT-MAUSO] rà độc lập 21/11 (Thấp 5): tính 1 lần mỗi lần lọc (xem Năm: hàng chục nghìn người-ngày; trước quét lại mỗi lần vẽ)
        _scopeDays = (_result?.Days ?? new()).Where(d => (_workerId == 0 || d.WorkerId == _workerId) && (inGroup == null || inGroup.Contains(d.WorkerId))).ToList();
        _dayOf = _workerId == 0 ? new() : _scopeDays.GroupBy(d => d.Day).ToDictionary(g => g.Key, g => g.First());
        var ud = _scopeDays.Where(d => d.UnaccountedMin != null).ToList();
        _unacc = s.Length > 0 || _result == null || ud.Count == 0 ? null : ud.Sum(d => d.UnaccountedMin!.Value);
    }
    List<WtsReportDay> _scopeDays = new();
    // [G31-LOC-NHOM] nhóm → tập công nhân (theo dòng đã tải); null = không lọc nhóm
    static string GroupKeyOf(WtsReportRow r) => r.WorkerGroupId == null ? "none" : "g" + r.WorkerGroupId.Value;
    HashSet<int>? GroupWorkers() => _groupKey.Length == 0 ? null
        : (_result?.Rows ?? new()).Where(r => GroupKeyOf(r) == _groupKey).Select(r => r.WorkerId).ToHashSet();
    List<(string Key, string Name)> GroupOptions() => (_result?.Rows ?? new()).GroupBy(GroupKeyOf)
        .Select(g => (g.Key, g.First().WorkerGroupName)).OrderBy(x => x.Item2).ToList();
    string GroupName => GroupOptions().FirstOrDefault(x => x.Key == _groupKey).Name ?? "";
    void OnGroupChange(ChangeEventArgs e)
    {
        _groupKey = e.Value?.ToString() ?? ""; _openDays.Clear();
        var inG = GroupWorkers();   // người đang xem không thuộc nhóm mới → về tất cả công nhân của nhóm (rà độc lập 22/11 L6)
        if (_workerId != 0 && inG != null && !inG.Contains(_workerId)) { _workerId = 0; _workerText = ""; _workerNotFound = false; }
        Recompute();
    }
    Dictionary<DateOnly, WtsReportDay> _dayOf = new();
    int? _unacc;
    static bool NoCa(WtsReportDay d) => d.UnaccountedMin == null && !d.IsTail;   // không rõ ca (đuôi ca đêm hôm trước thì đã biết ca)

    static string Hay(WtsReportRow r) => string.Join(" ", r.WorkerName, r.PurchaseOrder, r.PartNo, r.NC, r.MachineUsed, r.WtsCode, r.WtsName,
        r.TaskLabel, r.GroupLabel, r.NgReason ?? "", r.Notes, KindWord(r.Kind), string.Join(" ", r.ExtraParts.Select(x => x.TaskCode + " " + x.TaskLabel))).ToLowerInvariant();

    void OnSearch(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; Recompute(); }
    void ClearSearch() { _search = ""; Recompute(); }

    async Task SetPeriod(string p)
    {
        if (_loading) return;   // rà độc lập 21/11 Trung 4: không tải chồng trên cùng DbContext
        if (p == "custom" && _period != "custom") { _customFrom = From.ToDateTime(TimeOnly.MinValue); _customTo = To.ToDateTime(TimeOnly.MinValue); }
        _period = p;
        if (p != "custom") await LoadAsync();
    }
    async Task Shift(int dir)
    {
        if (_loading) return;
        _anchor = _period switch { "day" => _anchor.AddDays(dir), "week" => _anchor.AddDays(7 * dir), "month" => _anchor.AddMonths(dir), "year" => _anchor.AddYears(dir), _ => _anchor };
        await LoadAsync();
    }
    async Task Prev() => await Shift(-1);
    async Task Next() => await Shift(1);
    async Task ApplyCustom() => await LoadAsync();

    void OnWorkerChange(ChangeEventArgs e)
    {
        _workerText = (e.Value?.ToString() ?? "").Trim();
        _workerId = WorkerIdOf(_workerText);
        _workerNotFound = _workerId == 0 && _workerText.Length > 0;   // giữ chữ đã gõ + báo (rà độc lập 21/11 L11 — trước: ô vẫn hiện chữ sai mà đang xem tất cả)
        Recompute();
    }
    int WorkerIdOf(string text)
    {
        if (text.Length == 0) return 0;
        foreach (var w in WorkerOptions()) if (string.Equals(w.Label, text, StringComparison.OrdinalIgnoreCase)) return w.Id;
        return 0;
    }
    List<(int Id, string Label)> WorkerOptions()
    {
        var inGroup = GroupWorkers();   // [G31-LOC-NHOM] đang chọn nhóm → chỉ người của nhóm đó (có dòng trong kỳ)
        var src = _workers.Concat((_result?.Rows ?? new()).Select(r => (r.WorkerId, r.WorkerName))).DistinctBy(x => x.Item1).Where(x => inGroup == null || inGroup.Contains(x.Item1)).ToList();
        var dup = src.GroupBy(x => x.Item2, StringComparer.OrdinalIgnoreCase).Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return src.Select(x => (x.Item1, dup.Contains(x.Item2) ? $"{x.Item2} (#{x.Item1})" : x.Item2)).OrderBy(x => x.Item2).ToList();
    }
    void PickWorker(int id)
    {
        _workerId = id; _workerNotFound = false;
        _workerText = WorkerOptions().FirstOrDefault(x => x.Id == id).Label ?? "";
        _openDays.Clear();
        Recompute();
    }
    void BackToTeam() { _workerId = 0; _workerText = ""; _workerNotFound = false; Recompute(); }
    async Task OpenDay(DateOnly d) { if (_loading) return; _period = "day"; _anchor = d.ToDateTime(TimeOnly.MinValue); await LoadAsync(); }
    void ToggleDay(DateOnly d) { if (!_openDays.Remove(d)) _openDays.Add(d); }
    void ToggleExtra() => _showExtra = !_showExtra;
    string _extraIcon => _showExtra ? "bi bi-chevron-up me-1" : "bi bi-chevron-down me-1";

    // ── chữ / số ────────────────────────────────────────────────────────────────────────────────────────────
    static string N(int v) => v.ToString("N0", Vi);
    static string N(double v) => Math.Round(v).ToString("N0", Vi);
    static string N(decimal v) => v.ToString("#,0.##", Vi);
    static string Pct(double a, double b) => b <= 0 ? "—" : (a * 100.0 / b).ToString("0.0", Vi) + "%";
    static double PctVal(double a, double b) => b <= 0 ? 0 : a * 100.0 / b;
    static string W(double part, double whole) => (whole <= 0 ? 0 : Math.Clamp(part * 100.0 / whole, 0, 100)).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    static readonly string[] Thu = { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    static string DayLabel(DateOnly d) => $"{Thu[(int)d.DayOfWeek]} {d:dd/MM}";
    string PeriodLabel => _period switch
    {
        "day" => $"{(From.DayOfWeek == DayOfWeek.Sunday ? "Chủ nhật" : "Thứ " + ((int)From.DayOfWeek + 1))} · {From:dd/MM/yyyy}",
        "week" => $"Tuần {ISOWeek.GetWeekOfYear(From.ToDateTime(TimeOnly.MinValue))} · {From:dd/MM} – {To:dd/MM/yyyy}",
        "month" => $"Tháng {From:MM/yyyy}",
        "year" => $"Năm {From:yyyy}",
        _ => $"{From:dd/MM} – {To:dd/MM/yyyy}",
    };
    string SegCls(string p) => _period == p ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-secondary";
    string _clsDay => SegCls("day");
    string _clsWeek => SegCls("week");
    string _clsMonth => SegCls("month");
    string _clsYear => SegCls("year");
    string _clsCustom => SegCls("custom");
    async Task SetDay() => await SetPeriod("day");
    async Task SetWeek() => await SetPeriod("week");
    async Task SetMonth() => await SetPeriod("month");
    async Task SetYear() => await SetPeriod("year");
    async Task SetCustom() => await SetPeriod("custom");

    int SumAlloc(IEnumerable<WtsReportRow> rs) => rs.Sum(r => r.AllocMin);
    // [WTS-1NGUON] cộng theo PHẦN (phần dòng + phát sinh), 3 loại
    static int SumKind(IEnumerable<WtsReportRow> rs, WtsTaskKind k) => rs.SelectMany(r => r.Parts).Where(x => x.Kind == k).Sum(x => x.Min);
    int ProMin => SumKind(_rows, WtsTaskKind.CoIch);
    int WasteMin => SumKind(_rows, WtsTaskKind.VoIch);
    int NoCodeMin => SumKind(_rows, WtsTaskKind.ChuaMa);
    int TotMin => ProMin + WasteMin + NoCodeMin;
    /// <summary>Chưa khai báo: chỉ khi không tìm nhanh (tìm theo chữ thì không còn nghĩa giờ ca). null = không có ca nào.</summary>
    int? Unacc => _unacc;
    /// <summary>[G30-RPT-MAUSO] Mẫu số của mọi %: giờ chuẩn theo ca = phút khai báo + chưa khai báo (đang tìm nhanh: chỉ phút dòng khớp).</summary>
    int BaseMin => TotMin + (Unacc ?? 0);
    bool Searching => _search.Trim().Length > 0;
    string BaseWord => Searching ? "phút dòng khớp" : "giờ chuẩn";
    /// <summary>Người-ngày trong phạm vi (người đang xem / tất cả) — chỉ ngày có dòng WTS (Days chỉ sinh từ dòng).</summary>
    List<WtsReportDay> ScopeDays => _scopeDays;
    decimal OkSum => _rows.Where(r => r.RowType == WtsRowType.Production).Sum(r => r.QtyOk ?? 0);
    decimal NgSum => _rows.Where(r => r.RowType == WtsRowType.Production).Sum(r => r.QtyNg ?? 0);
    string TopWasteName(IEnumerable<WtsReportRow> rs)
    {
        var t = rs.SelectMany(r => r.Parts.Select(x => (R: r, P: x))).Where(x => x.P.Kind == WtsTaskKind.VoIch).GroupBy(x => x.P.TaskKey)
            .Select(g => (Lbl: PartText(g.First().R, g.First().P), Min: g.Sum(x => x.P.Min))).OrderByDescending(x => x.Min).FirstOrDefault();
        return t.Min <= 0 ? "—" : $"{t.Lbl} {t.Min}";
    }
    /// <summary>[WTS-1NGUON] Chữ của 1 phần: phần dòng = TaskText; phát sinh = mã + tên.</summary>
    static string PartText(WtsReportRow r, WtsReportPart p) => !p.IsExtra ? TaskText(r)
        : string.Join(" ", new[] { p.TaskCode, p.TaskLabel }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim();
    static string TaskText(WtsReportRow r) => r.RowType == WtsRowType.Production && (r.ProcessGroup ?? "").ToUpperInvariant() == "GC"
        ? r.TaskLabel
        : string.Join(" ", new[] { r.TaskCode, r.TaskLabel }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim() is var s && s.Length > 0 ? s : "(không mã)";
    static string RowTip(WtsReportRow r)
        => (r.Breaks.Count == 0 ? $"{r.Minutes} phút làm" : $"Thô {r.RawMinutes} − nghỉ {r.BreakDeductMin} = {r.Minutes} phút làm" + (r.BreakWorkedMin > 0 ? $" (làm thông nghỉ {r.BreakWorkedMin})" : ""))
           + (r.AllocMin != r.Minutes ? $" · tính {r.AllocMin} phút vào báo cáo: giờ trùng với dòng khác — có ích tính trước, rồi vô ích, rồi chưa có mã; cùng loại chia đều" : "")
           + (r.Parts.Any(x => x.IsExtra) ? " · phát sinh tách riêng: " + string.Join(", ", r.Parts.Where(x => x.IsExtra).Select(x => $"{PartText(r, x)} {x.Min} ph ({KindWord(x.Kind)})")) : "");
    // [WTS-1NGUON] 3 loại
    static string KindWord(WtsTaskKind k) => k == WtsTaskKind.CoIch ? "có ích" : k == WtsTaskKind.VoIch ? "vô ích" : "chưa có mã";
    static string KindColor(WtsTaskKind k) => k == WtsTaskKind.CoIch ? CG : k == WtsTaskKind.VoIch ? CO : CN;
    static string TagCls(WtsTaskKind k) => k == WtsTaskKind.CoIch ? "badge bg-success" : k == WtsTaskKind.VoIch ? "badge text-dark" : "badge text-white";
    static string TagStyle(WtsTaskKind k) => k == WtsTaskKind.CoIch ? "font-size:.7rem" : k == WtsTaskKind.VoIch ? "font-size:.7rem;background:#f6b26b" : "font-size:.7rem;background:" + CN;
    static string TagText(WtsTaskKind k) => k == WtsTaskKind.CoIch ? "Có ích" : k == WtsTaskKind.VoIch ? "Vô ích" : "Chưa có mã";
    static string RowBg(WtsTaskKind k) => k == WtsTaskKind.CoIch ? "" : k == WtsTaskKind.VoIch ? "background:#fff7ed" : "background:#f1f5f9";

    // ── donut ───────────────────────────────────────────────────────────────────────────────────────────────
    const double R = 62;
    static readonly double Circ = 2 * Math.PI * R;
    static string Dash(double part, double whole) => (whole <= 0 ? 0 : Circ * part / whole).ToString("0.##", CultureInfo.InvariantCulture) + " " + Circ.ToString("0.##", CultureInfo.InvariantCulture);
    static string DonutAria(int pro, int waste, int nc, int un) => $"Có ích {Pct(pro, pro + waste + nc + un)}, vô ích đã khai báo {Pct(waste, pro + waste + nc + un)}, chưa có mã {Pct(nc, pro + waste + nc + un)}, chưa khai báo {Pct(un, pro + waste + nc + un)}";
    /// <summary>[G30-RPT-MAUSO] phần trên giờ chuẩn: có ích (xanh) · vô ích đã khai báo (cam) · [WTS-1NGUON] chưa có mã (xám đậm) · chưa khai báo (xám sọc = nền).</summary>
    RenderFragment Donut(int pro, int waste, int nc, int un, string sub) => __builder =>
    {
        var tot = pro + waste + nc + un;
        <svg width="150" height="150" viewBox="0 0 160 160" role="img" aria-label="@DonutAria(pro, waste, nc, un)">
            <defs><pattern id="rptHatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="#f1f3f5"></rect><rect width="3" height="6" fill="#adb5bd"></rect></pattern></defs>
            <circle cx="80" cy="80" r="62" fill="none" stroke="@RingStroke(un)" stroke-width="22"></circle>
            <circle cx="80" cy="80" r="62" fill="none" stroke="@CN" stroke-width="22" stroke-dasharray="@Dash(pro + waste + nc, tot)" transform="rotate(-90 80 80)"></circle>
            <circle cx="80" cy="80" r="62" fill="none" stroke="@CO" stroke-width="22" stroke-dasharray="@Dash(pro + waste, tot)" transform="rotate(-90 80 80)"></circle>
            <circle cx="80" cy="80" r="62" fill="none" stroke="@CG" stroke-width="22" stroke-dasharray="@Dash(pro, tot)" transform="rotate(-90 80 80)"></circle>
            <text x="80" y="80" text-anchor="middle" font-size="22" font-weight="700" fill="#212529">@Pct(pro, tot)</text>
            <text x="80" y="99" text-anchor="middle" font-size="11" fill="#5c636a">@sub</text>
        </svg>
    };
    static string RingStroke(int un) => un > 0 ? "url(#rptHatch)" : "#e9ecef";
    RenderFragment Legend3(int pro, int waste, int nc, int? un) => __builder =>
