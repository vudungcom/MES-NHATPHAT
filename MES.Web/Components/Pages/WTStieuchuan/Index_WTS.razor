@page "/wts-tieu-chuan"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using System.Security.Claims
@inject AuthenticationStateProvider AuthState
@inject MES.Web.Services.StandardWtsTaskService WtsSvc
@inject MES.Web.Services.WtsCategoryGroupMappingService MappingSvc
@inject MES.Web.Services.UserService UserSvc
@using MES.Web.Constants
@inject IJSRuntime JS

<PageTitle>Danh mục Công việc WTS Tiêu Chuẩn - MES</PageTitle>

<div class="container-fluid pt-3 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 style="font-weight: bold; color: #1e293b;">Danh mục Công việc WTS Tiêu Chuẩn</h2>
            <p class="text-muted mb-0">
                Master Data định hình nguyên công cho <b>Part Master</b> và danh mục bắt buộc cho <b>chấm công WTS của công nhân</b>.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" @onclick="XuatExcelAsync" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang xuất...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    <span>Xuất Excel</span>
                }
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="MoPopupThem">
                <i class="bi bi-plus-lg"></i> Thêm công việc mới
            </button>
        </div>
    </div>

@* ── Tab chính: Danh mục | Cấu hình nhóm ── *@
<ul class="nav nav-tabs mb-0 mt-3">
    <li class="nav-item">
        <button class="@_MainTabListCls" @onclick="SetMainTabList">
            <i class="bi bi-list-check me-1"></i>Danh mục công việc
        </button>
    </li>
    @if (_canEditMapping)
    {
        <li class="nav-item">
            <button class="@_MainTabMapCls" @onclick="SetMainTabMapping">
                <i class="bi bi-diagram-2 me-1"></i>Cấu hình nhóm WTS
            </button>
        </li>
    }
</ul>
<div style="border: 1px solid #dee2e6; border-top: none; padding: 1rem; border-radius: 0 0 .375rem .375rem;">
    @* ═══ TAB 1: DANH MỤC CÔNG VIỆC ═══ *@
    @if (_mainTab == "list")
    {
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text"
                       class="form-control"
                       placeholder="Tìm kiếm theo Mã công việc / Tên công việc..."
                       autocomplete="off"
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="ClearSearch" style="@_ClearSearchVisibility">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select form-select-sm" @bind="filterCategory">
                <option value="">-- Tất cả Nhóm công việc (@DanhSachNhom.Count nhóm) --</option>
                @foreach (var cat in DanhSachNhom)
                {
                    <option value="@cat.Code">@cat.Name (@cat.Code)</option>
                }
            </select>
        </div>
        <div class="col-md-3 text-end align-self-center text-muted small">
            Hiển thị <b>@DanhSachHienThi.Count</b> / @DanhSachGoc.Count công việc
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBaoLoi))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle"></i> @thongBaoLoi
            <button type="button" class="btn-close float-end" @onclick="ClearThongBaoLoi"></button>
        </div>
    }

    <div class="alert alert-warning py-2 mb-3 d-flex align-items-center justify-content-between"
         style="@_PendingBarStyle">
        <span class="small">
            <i class="bi bi-pencil-square me-1"></i>
            Có <b>@SoLuongThayDoi</b> mã công việc vừa được đổi phân loại — chưa lưu vào hệ thống.
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="HuyThayDoi">
                <i class="bi bi-x-circle me-1"></i>Hủy
            </button>
            <button class="btn btn-sm btn-warning fw-bold" @onclick="MoPopupLuuTong">
                <i class="bi bi-floppy me-1"></i>Lưu phân loại (@SoLuongThayDoi)
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @* [TBL-FREEZE 2026-10-28] Khung cuộn vừa màn hình + cố định tiêu đề *@
            <div class="mes-scroll">
                <table class="table table-hover table-bordered mb-0 align-middle mes-table">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th style="width: 220px;">Nhóm công đoạn</th>
                            <th style="width: 120px;" class="text-center text-danger">Mã công việc</th>
                            <th>Tên công việc tiêu chuẩn</th>
                            <th style="width: 100px;" class="text-center">ĐVT</th>
                            <th style="width: 110px;" class="text-center">Phân loại</th>
                            <th style="width: 80px;" class="text-center">Thứ tự</th>
                            <th>Ghi chú</th>
                            <th style="width: 130px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">Đang nạp danh mục công việc tiêu chuẩn...</td>
                            </tr>
                        }
                        else if (DanhSachHienThi.Any())
                        {
                            var stt = 0;
                            foreach (var item in DanhSachHienThi)
                            {
                                stt++;
                                var localValue = GetLocalValue(item.TaskId, item.IsProductiveTask);
                                var isDirty = localValue != item.IsProductiveTask;
                                var rowStyle = isDirty ? "background-color: #fffbeb;" : "";
                                var badgeCls = localValue ? "badge bg-success px-2 py-1" : "badge bg-secondary px-2 py-1";
                                var badgeTitle = localValue ? "Có ích — Click để đổi" : "Vô ích — Click để đổi";
                                var catBadgeCls = "badge " + GetBadgeClass(item.CategoryCode) + " px-2 py-1";
                                var itemRef = item;
                                <tr style="@rowStyle">
                                    <td class="text-center text-muted small">@stt</td>
                                    <td>
                                        <span class="@catBadgeCls">@item.CategoryName</span>
                                    </td>
                                    <td class="text-center font-monospace fw-bold text-danger fs-6">@item.TaskCode</td>
                                    <td class="fw-bold">@item.TaskName</td>
                                    <td class="text-center small text-muted">@item.DefaultUnit</td>
                                    <td class="text-center">
                                        <span class="@badgeCls"
                                              style="cursor: pointer; user-select: none;"
                                              title="@badgeTitle"
                                              @onclick="() => ToggleLocal(itemRef.TaskId, itemRef.IsProductiveTask)">
                                            @if (localValue)
                                            {
                                                <i class="bi bi-check-circle me-1"></i><span>Có ích</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle me-1"></i><span>Vô ích</span>
                                            }
                                        </span>
                                        @if (isDirty)
                                        {
                                            <span class="ms-1 text-warning" title="Chưa lưu" style="font-size: 0.75rem;">●</span>
                                        }
                                    </td>
                                    <td class="text-center small text-muted">@item.DisplayOrder</td>
                                    <td class="small text-muted">@item.GhiChu</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Sửa"
                                                @onclick="() => MoPopupSua(itemRef)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Lịch sử"
                                                @onclick="() => MoPopupLichSu(itemRef)">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa"
                                                @onclick="() => MoPopupXoa(itemRef)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">Không tìm thấy công việc tiêu chuẩn phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    }
    @* ═══ TAB 2: CẤU HÌNH NHÓM WTS ═══ *@
    @if (_mainTab == "mapping")
    {
        <div class="pt-2">
            <p class="text-muted mb-3 small">
                Gán <b>Nhóm công việc tiêu chuẩn</b> vào từng <b>Nhóm sản xuất</b> (GC / HTSP / KCS / PKG).
                Khi công nhân chấm công WTS, hệ thống tự lọc đúng nhóm công việc theo nhóm của họ.
            </p>

            <ul class="nav nav-tabs mb-0">
                @foreach (var pg in _mProcessGroups)
                {
                    var pgLocal = pg;
                    var isActive = _mActiveTab == pgLocal.Code;
                    var tabCls = "nav-link" + (isActive ? " active fw-bold" : "");
                    var mappedCount = _mAllMappings.Count(m => m.ProcessGroup == pgLocal.Code);
                    <li class="nav-item">
                        <button class="@tabCls" @onclick="() => MSwitchTab(pgLocal.Code)">
                            @pgLocal.Name
                            <span class="badge ms-1 @(isActive ? "bg-primary" : "bg-secondary") rounded-pill"
                                  style="font-size:0.7rem;">@mappedCount</span>
                        </button>
                    </li>
                }
            </ul>

            <div class="card shadow-sm border-0 border-top-0 rounded-0 rounded-bottom">
                <div class="card-body p-3">
                    @if (_mIsLoading)
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="spinner-border spinner-border-sm me-2"></span>Đang tải...
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="small text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Tick chọn các <b>Nhóm công việc</b> hiển thị cho công nhân nhóm
                                <b>@_mActiveTabName</b> khi chấm công WTS.
                                1 nhóm có thể chọn ở nhiều tab.
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="MXacNhanLuuAsync"
                                    disabled="@(!_mIsDirty || _mIsProcessing)">
                                <i class="bi bi-floppy me-1"></i>
                                @(_mIsProcessing ? "Đang lưu..." : $"Lưu cấu hình ({_mPendingCount} thay đổi)")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(_mThongBaoLoi))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>@_mThongBaoLoi
                                <button type="button" class="btn-close float-end btn-sm"
                                        @onclick="ClearMLoi"></button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_mThongBaoOk))
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-circle me-1"></i>@_mThongBaoOk
                                <button type="button" class="btn-close float-end btn-sm"
                                        @onclick="ClearMOk"></button>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-hover table-bordered mb-0 align-middle">
                                <thead style="background-color: #f8fafc;">
                                    <tr>
                                        <th style="width:56px;" class="text-center">
                                            <input type="checkbox" class="form-check-input"
                                                   title="Chọn/bỏ tất cả"
                                                   checked="@_mIsAllSelected"
                                                   @onchange="MToggleAll" />
                                        </th>
                                        <th style="width:220px;">Nhóm công việc</th>
                                        <th style="width:120px;" class="text-center">Mã nhóm</th>
                                        <th class="text-center">Số CV trong nhóm</th>
                                        <th>Nhóm sản xuất khác đã gán</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!_mAllCategories.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                Chưa có nhóm công việc nào trong WTS Tiêu Chuẩn.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var cat in _mAllCategories)
                                        {
                                            var catLocal = cat;
                                            var isChecked = _mLocalSelection.Contains(catLocal.Code);
                                            var taskCount = _mTaskCountByCategory.GetValueOrDefault(catLocal.Code, 0);
                                            var otherPgs  = MGetOtherProcessGroups(catLocal.Code);
                                            var rowStyle  = isChecked ? "background-color: #f0f9ff;" : "";
                                            <tr style="@rowStyle" @key="catLocal.Code">
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@isChecked"
                                                           @onchange="() => MToggleCategory(catLocal.Code)" />
                                                </td>
                                                <td>
                                                    <span class="badge @GetBadgeClass(catLocal.Code) px-2 py-1">
                                                        @catLocal.Name
                                                    </span>
                                                </td>
                                                <td class="text-center font-monospace fw-bold text-secondary">
                                                    @catLocal.Code
                                                </td>
                                                <td class="text-center small text-muted">
                                                    @taskCount công việc
                                                </td>
                                                <td class="small">
                                                    @if (otherPgs.Any())
                                                    {
                                                        foreach (var pg in otherPgs)
                                                        {
                                                            <span class="badge bg-light text-dark border me-1">@pg</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

</div>

@* ═══════════════════════════════════════════════════════════════
   MODAL 1: THÊM MỚI / SỬA CÔNG VIỆC
   ═══════════════════════════════════════════════════════════════ *@
@if (isHienThiPopupSua && itemDangSua != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>@_TieuDePopupSua
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupSua"></button>
                </div>
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(loiPopup))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>@loiPopup
                        </div>
                    }

                    @* ── Nhóm công đoạn ── *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nhóm công đoạn <span class="text-danger">*</span></label>
                        @if (!isTaoNhomMoi)
                        {
                            <select class="form-select form-select-sm" @onchange="OnChonNhomCoSan">
                                @foreach (var nhom in DanhSachNhom)
                                {
                                    <option value="@nhom.Code" selected="@(itemDangSua.CategoryCode == nhom.Code)">
                                        [@nhom.Code] @nhom.Name
                                    </option>
                                }
                            </select>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="chkTaoNhomMoi"
                                       checked="@isTaoNhomMoi" @onchange="OnToggleTaoNhomMoi" />
                                <label class="form-check-label small text-muted" for="chkTaoNhomMoi">
                                    Tạo nhóm công đoạn mới
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-4">
                                    <input type="text" class="form-control form-control-sm font-monospace text-uppercase"
                                           placeholder="Mã nhóm (VD: TARO)"
                                           @bind="itemDangSua.CategoryCode" />
                                </div>
                                <div class="col-8">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Tên nhóm (VD: Công việc nhóm Taro)"
                                           @bind="itemDangSua.CategoryName" />
                                </div>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="chkTaoNhomMoi2"
                                       checked="@isTaoNhomMoi" @onchange="OnToggleTaoNhomMoi" />
                                <label class="form-check-label small text-muted" for="chkTaoNhomMoi2">
                                    Tạo nhóm công đoạn mới
                                </label>
                            </div>
                        }
                    </div>

                    @* ── Mã & Tên công việc ── *@
                    <div class="row g-2 mb-3">
                        <div class="col-3">
                            <label class="form-label fw-semibold">Mã công việc <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm font-monospace text-uppercase text-danger fw-bold"
                                   placeholder="VD: 1V"
                                   @bind="itemDangSua.TaskCode" />
                        </div>
                        <div class="col-9">
                            <label class="form-label fw-semibold">Tên công việc <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="VD: Chuẩn bị"
                                   @bind="itemDangSua.TaskName" />
                        </div>
                    </div>

                    @* ── ĐVT, Thứ tự, Thời gian ── *@
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label fw-semibold">Đơn vị tính</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Chi tiết"
                                   @bind="itemDangSua.DefaultUnit" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Thứ tự hiển thị</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="itemDangSua.DisplayOrder" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Thời gian chuẩn (giây)</label>
                            <input type="number" class="form-control form-control-sm"
                                   placeholder="Tùy chọn"
                                   @bind="itemDangSua.StandardTimeSec" />
                        </div>
                    </div>

                    @* ── Phân loại Có ích / Vô ích ── *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phân loại</label>
                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="@(itemDangSua.IsProductiveTask ? "btn btn-success btn-sm" : "btn btn-outline-success btn-sm")"
                                    @onclick="SetProductiveTrue">
                                <i class="bi bi-check-circle me-1"></i>Có ích
                            </button>
                            <button type="button"
                                    class="@(!itemDangSua.IsProductiveTask ? "btn btn-secondary btn-sm" : "btn btn-outline-secondary btn-sm")"
                                    @onclick="SetProductiveFalse">
                                <i class="bi bi-dash-circle me-1"></i>Vô ích
                            </button>
                        </div>
                        <div class="form-text">Công việc "Vô ích" không tính vào hiệu suất công nhân.</div>
                    </div>

                    @* ── Ghi chú ── *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú</label>
                        <textarea class="form-control form-control-sm" rows="2"
                                  placeholder="Ghi chú thêm (tùy chọn)"
                                  @bind="itemDangSua.GhiChu"></textarea>
                    </div>

                    @* ── Lý do sửa (chỉ hiện khi sửa, không phải thêm mới) ── *@
                    @if (!isThemMoi)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lý do thay đổi</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Mô tả ngắn lý do chỉnh sửa (tùy chọn)"
                                   @bind="lyDoSua" />
                        </div>
                    }

                    @* ── PIN xác nhận ── *@
                    <div class="mb-1">
                        <label class="form-label fw-semibold">PIN xác nhận <span class="text-danger">*</span></label>
                        <input type="password" class="form-control form-control-sm" style="max-width: 200px;"
                               placeholder="Nhập mã PIN của bạn"
                               autocomplete="off"
                               @bind="pinXacNhan" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DongPopupSua"
                            disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="LuuThongTinAsync"
                            disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-floppy me-1"></i>
                            <span>@_LuuCongViecLabel</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   MODAL 2: XÓA CÔNG VIỆC
   ═══════════════════════════════════════════════════════════════ *@
@if (isHienThiPopupXoa && itemCanXoa != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-danger">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-trash me-2"></i>Xác nhận xóa công việc
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupXoa"></button>
                </div>
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(loiPopup))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>@loiPopup
                        </div>
                    }

                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Bạn sắp xóa công việc tiêu chuẩn khỏi danh mục. Thao tác này không thể hoàn tác.
                    </div>

                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="small text-muted mb-1">Công việc sẽ bị xóa:</div>
                        <div class="fw-bold text-danger font-monospace">[@itemCanXoa.TaskCode]</div>
                        <div class="fw-bold">@itemCanXoa.TaskName</div>
                        <div class="small text-muted mt-1">Nhóm: @itemCanXoa.CategoryName</div>
                    </div>

                    <div>
                        <label class="form-label fw-semibold">PIN xác nhận <span class="text-danger">*</span></label>
                        <input type="password" class="form-control form-control-sm" style="max-width: 200px;"
                               placeholder="Nhập mã PIN của bạn"
                               autocomplete="off"
                               @bind="pinXacNhan" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DongPopupXoa"
                            disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="XacNhanXoaAsync"
                            disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash me-1"></i>
                            <span>@_XacNhanXoaLabel</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   MODAL 3: LỊCH SỬ THAY ĐỔI
   ═══════════════════════════════════════════════════════════════ *@
@if (isHienThiPopupLichSu && itemDangXem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-clock-history me-2 text-secondary"></i>
                        Lịch sử thay đổi — [@itemDangXem.TaskCode] @itemDangXem.TaskName
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupLichSu"></button>
                </div>
                <div class="modal-body" style="max-height: 500px; overflow-y: auto;">
                    @if (isLoadingLogs)
                    {
                        <div class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm me-2"></span>Đang tải lịch sử...
                        </div>
                    }
                    else if (!danhSachChangeLog.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox me-2"></i>Chưa có lịch sử thay đổi.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead style="background-color: #f8fafc; position: sticky; top: 0;">
                                <tr>
                                    <th style="width: 140px;">Thời gian</th>
                                    <th style="width: 80px;">Người sửa</th>
                                    <th style="width: 140px;">Trường thay đổi</th>
                                    <th>Giá trị cũ</th>
                                    <th>Giá trị mới</th>
                                    <th>Lý do</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in danhSachChangeLog)
                                {
                                    <tr>
                                        <td class="small text-muted">@log.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small fw-semibold">@(log.ChangedByUser?.Username ?? "?")</td>
                                        <td class="small fw-semibold text-primary">@log.FieldName</td>
                                        <td class="small text-muted">@(log.OldValue ?? "—")</td>
                                        <td class="small fw-bold">@(log.NewValue ?? "—")</td>
                                        <td class="small text-muted fst-italic">@(log.Reason ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DongPopupLichSu">
                        <i class="bi bi-x-circle me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════
   MODAL 4: LƯU TỔNG PHÂN LOẠI (BULK SAVE)
   ═══════════════════════════════════════════════════════════════ *@
@if (isHienThiPopupLuuTong)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-floppy me-2 text-warning"></i>Xác nhận lưu phân loại
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupLuuTong"></button>
                </div>
                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(loiLuuTong))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>@loiLuuTong
                        </div>
                    }

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Bạn sắp lưu thay đổi phân loại cho <b>@SoLuongThayDoi</b> công việc vào hệ thống.
                    </div>

                    <div>
                        <label class="form-label fw-semibold">PIN xác nhận <span class="text-danger">*</span></label>
                        <input type="password" class="form-control form-control-sm" style="max-width: 200px;"
                               placeholder="Nhập mã PIN của bạn"
                               autocomplete="off"
                               @bind="pinLuuTong" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DongPopupLuuTong"
                            disabled="@isProcessing">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-warning btn-sm fw-bold" @onclick="XacNhanLuuTongAsync"
                            disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-floppy me-1"></i>
                            <span>@_LuuTongLabel</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool isExporting = false;
    private bool isLoadingLogs = false;
    private int currentUserId;

    private string searchText = "";
    private string filterCategory = "";
    private string thongBaoLoi = "";
    private string loiPopup = "";

    private List<StandardWtsTask> DanhSachGoc = new();
    private List<(string Code, string Name)> DanhSachNhom = new();
    private List<StandardWtsTaskChangeLog> danhSachChangeLog = new();

    private bool isHienThiPopupSua = false;
    private bool isHienThiPopupLichSu = false;
    private bool isHienThiPopupXoa = false;
    private bool isHienThiPopupLuuTong = false;
    private bool isThemMoi = false;
    private bool isTaoNhomMoi = false;

    private StandardWtsTask? itemDangSua = null;
    private StandardWtsTask? itemDangXem = null;
    private StandardWtsTask? itemCanXoa = null;

    private string lyDoSua = "";
    private string pinXacNhan = "";
    private string pinLuuTong = "";
    private string loiLuuTong = "";

    private Dictionary<int, bool> _localChanges = new();

    private bool CoThayDoiChuaLuu => _localChanges.Any();
    private int SoLuongThayDoi => _localChanges.Count;

    // Precomputed strings — tránh mọi expression phức tạp trong attribute
    private string _PendingBarStyle => CoThayDoiChuaLuu ? "visibility: visible;" : "visibility: hidden;";
    private string _ClearSearchVisibility => string.IsNullOrEmpty(searchText) ? "visibility: hidden;" : "visibility: visible;";
    private string _LuuTongLabel
    {
        get
        {
            if (isProcessing) return "Đang lưu...";
            return "Xác nhận lưu (" + SoLuongThayDoi + ")";
        }
    }
    private string _TieuDePopupSua
    {
        get
        {
            if (isThemMoi) return "Thêm mới công việc WTS tiêu chuẩn";
            if (itemDangSua == null) return "";
            return "Sửa công việc: [" + itemDangSua.TaskCode + "]";
        }
    }
    private string _LuuCongViecLabel => isProcessing ? "Đang lưu..." : "Lưu công việc";
    private string _XacNhanXoaLabel => isProcessing ? "Đang kiểm tra..." : "Xác nhận xóa";

    private bool GetLocalValue(int taskId, bool dbValue)
    {
        if (_localChanges.TryGetValue(taskId, out var local)) return local;
        return dbValue;
    }

    private void ToggleLocal(int taskId, bool dbValue)
    {
        var current = GetLocalValue(taskId, dbValue);
        var newValue = !current;
        if (newValue == dbValue)
        {
            _localChanges.Remove(taskId);
        }
        else
        {
            _localChanges[taskId] = newValue;
        }
    }

    private void HuyThayDoi()
    {
        _localChanges.Clear();
    }

    private void ClearSearch()
    {
        searchText = "";
    }

    private void ClearThongBaoLoi()
    {
        thongBaoLoi = "";
    }

    private void SetProductiveTrue()
    {
        if (itemDangSua != null) itemDangSua.IsProductiveTask = true;
    }

    private void SetProductiveFalse()
    {
        if (itemDangSua != null) itemDangSua.IsProductiveTask = false;
    }

    private void MoPopupLuuTong()
    {
        pinLuuTong = "";
        loiLuuTong = "";
        isHienThiPopupLuuTong = true;
    }

    private void DongPopupLuuTong()
    {
        isHienThiPopupLuuTong = false;
        pinLuuTong = "";
        loiLuuTong = "";
    }

    private async Task XacNhanLuuTongAsync()
    {
        if (!_localChanges.Any()) return;
        isProcessing = true;
        loiLuuTong = "";

        var changes = _localChanges.Select(kv => (kv.Key, kv.Value)).ToList();
        var result = await WtsSvc.BulkUpdateProductiveAsync(changes, currentUserId, pinLuuTong);

        if (result.Success)
        {
            _localChanges.Clear();
            DongPopupLuuTong();
            await LoadDataAsync();
        }
        else
        {
            loiLuuTong = result.Error ?? "Lỗi lưu phân loại.";
        }
        isProcessing = false;
    }

    private List<StandardWtsTask> DanhSachHienThi
    {
        get
        {
            return DanhSachGoc
                .Where(x =>
                    (string.IsNullOrWhiteSpace(searchText) ||
                     x.TaskCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                     x.TaskName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrWhiteSpace(filterCategory) || x.CategoryCode == filterCategory)
                ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
        await LoadDataAsync();
        await LoadMappingPermAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        DanhSachGoc = await WtsSvc.GetAllActiveAsync();
        DanhSachNhom = await WtsSvc.GetDistinctCategoriesAsync();
        isLoading = false;
    }

    private string GetBadgeClass(string catCode)
    {
        switch (catCode)
        {
            case "TARO":     return "bg-primary text-white";
            case "BAVIA":    return "bg-info text-dark";
            case "RUA":      return "bg-success text-white";
            case "KCS":      return "bg-danger text-white";
            case "DONG_GOI": return "bg-warning text-dark";
            case "KT_NC":    return "bg-dark text-white";
            case "GIA_CONG": return "bg-purple text-white";
            default:         return "bg-secondary text-white";
        }
    }

    private void OnChonNhomCoSan(ChangeEventArgs e)
    {
        var selectedCode = e.Value?.ToString() ?? "";
        if (itemDangSua != null)
        {
            itemDangSua.CategoryCode = selectedCode;
            var found = DanhSachNhom.FirstOrDefault(x => x.Code == selectedCode);
            itemDangSua.CategoryName = found.Name ?? selectedCode;
        }
    }

    // Toggle checkbox tạo nhóm mới / chọn nhóm có sẵn
    private void OnToggleTaoNhomMoi(ChangeEventArgs e)
    {
        isTaoNhomMoi = (bool)(e.Value ?? false);
        if (!isTaoNhomMoi && itemDangSua != null)
        {
            // Reset về nhóm đầu tiên trong danh sách
            var defaultCat = DanhSachNhom.FirstOrDefault();
            if (defaultCat != default)
            {
                itemDangSua.CategoryCode = defaultCat.Code;
                itemDangSua.CategoryName = defaultCat.Name;
            }
        }
        else if (isTaoNhomMoi && itemDangSua != null)
        {
            itemDangSua.CategoryCode = "";
            itemDangSua.CategoryName = "";
        }
    }

    private void MoPopupThem()
    {
        var defaultCat = DanhSachNhom.FirstOrDefault();
        itemDangSua = new StandardWtsTask
        {
            CategoryCode = defaultCat.Code ?? "TARO",
            CategoryName = defaultCat.Name ?? "Công việc nhóm Taro",
            DefaultUnit = "Chi tiết",
            DisplayOrder = DanhSachGoc.Count + 1,
            IsProductiveTask = true
        };
        isTaoNhomMoi = false;
        isThemMoi = true;
        pinXacNhan = "";
        lyDoSua = "";
        loiPopup = "";
        isHienThiPopupSua = true;
    }

    private void MoPopupSua(StandardWtsTask item)
    {
        itemDangSua = new StandardWtsTask
        {
            TaskId           = item.TaskId,
            CategoryCode     = item.CategoryCode,
            CategoryName     = item.CategoryName,
            TaskCode         = item.TaskCode,
            TaskName         = item.TaskName,
            DefaultUnit      = item.DefaultUnit,
            StandardTimeSec  = item.StandardTimeSec,
            DisplayOrder     = item.DisplayOrder,
            GhiChu           = item.GhiChu,
            IsProductiveTask = item.IsProductiveTask
        };
        isTaoNhomMoi = false;
        isThemMoi = false;
        pinXacNhan = "";
        lyDoSua = "";
        loiPopup = "";
        isHienThiPopupSua = true;
    }

    private void DongPopupSua()
    {
        isHienThiPopupSua = false;
        itemDangSua = null;
    }

    private async Task LuuThongTinAsync()
    {
        if (itemDangSua == null) return;
        isProcessing = true;
        loiPopup = "";

        if (isThemMoi)
        {
            var result = await WtsSvc.CreateAsync(itemDangSua, currentUserId, pinXacNhan);
            if (result.Success)
            {
                DongPopupSua();
                await LoadDataAsync();
            }
            else
            {
                loiPopup = result.Error ?? "Lỗi thêm công việc.";
            }
        }
        else
        {
            var result = await WtsSvc.UpdateAsync(itemDangSua, lyDoSua, currentUserId, pinXacNhan);
            if (result.Success)
            {
                DongPopupSua();
                await LoadDataAsync();
            }
            else
            {
                loiPopup = result.Error ?? "Lỗi cập nhật.";
            }
        }
        isProcessing = false;
    }

    private void MoPopupXoa(StandardWtsTask item)
    {
        itemCanXoa = item;
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupXoa = true;
    }

    private void DongPopupXoa()
    {
        isHienThiPopupXoa = false;
        itemCanXoa = null;
    }

    private async Task XacNhanXoaAsync()
    {
        if (itemCanXoa == null) return;
        isProcessing = true;
        loiPopup = "";

        var result = await WtsSvc.SoftDeleteAsync(itemCanXoa.TaskId, currentUserId, pinXacNhan);
        if (result.Success)
        {
            DongPopupXoa();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi xóa công việc.";
        }
        isProcessing = false;
    }

    private async Task MoPopupLichSu(StandardWtsTask item)
    {
        itemDangXem = item;
        isHienThiPopupLichSu = true;
        isLoadingLogs = true;
        danhSachChangeLog = await WtsSvc.GetChangeLogsAsync(item.TaskId);
        isLoadingLogs = false;
    }

    private void DongPopupLichSu()
    {
        isHienThiPopupLichSu = false;
    }

    private async Task XuatExcelAsync()
    {
        try
        {
            isExporting = true;
            var fileBytes = await WtsSvc.ExportExcelAsync(DanhSachHienThi);
            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = "DS_WTS_TieuChuan_" + DateTime.Now.ToString("yyyyMMdd_HHmm") + ".xlsx";
            var js = "(function(){const a=document.createElement('a');a.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64," + base64 + "';a.download='" + fileName + "';document.body.appendChild(a);a.click();document.body.removeChild(a);})();";
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi khi xuất file Excel: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }

    // ═══════════════════════════════════════════════════
    // TAB 2 — CẤU HÌNH NHÓM WTS
    // ═══════════════════════════════════════════════════
    private string _mainTab = "list"; // "list" | "mapping"

    private string _MainTabListCls => "nav-link" + (_mainTab == "list"    ? " active fw-bold" : "");
    private string _MainTabMapCls  => "nav-link" + (_mainTab == "mapping" ? " active fw-bold" : "");

    private void SetMainTabList() { _mainTab = "list"; }
    private async Task SetMainTabMapping()
    {
        _mainTab = "mapping";
        if (!_mDataLoaded) await MLoadDataAsync();
    }

    private async Task LoadMappingPermAsync()
    {
        var perms = await UserSvc.GetAllUserPermissionsAsync(currentUserId);
        _canEditMapping = perms.TryGetValue(SystemPermissions.WtsMapping, out var p) && p.CanView;
    }

    private bool   _mIsLoading    = false;
    private bool   _mIsProcessing = false;
    private bool   _mDataLoaded     = false;
    private bool   _canEditMapping  = false;
    private string _mActiveTab    = "GC";
    private string _mThongBaoLoi  = "";
    private string _mThongBaoOk   = "";

    private List<WtsCategoryGroupMapping>    _mAllMappings         = new();
    private List<(string Code, string Name)> _mAllCategories       = new();
    private Dictionary<string, int>          _mTaskCountByCategory = new();
    private HashSet<string> _mLocalSelection = new();
    private HashSet<string> _mDbSelection    = new();

    private static readonly List<(string Code, string Name)> _mProcessGroups =
        MES.Web.Services.WtsCategoryGroupMappingService.ProcessGroups;

    private string _mActiveTabName => _mProcessGroups.FirstOrDefault(p => p.Code == _mActiveTab).Name ?? _mActiveTab;
    private bool   _mIsDirty       => !_mLocalSelection.SetEquals(_mDbSelection);
    private int    _mPendingCount  => _mLocalSelection.Count(c => !_mDbSelection.Contains(c))
                                    + _mDbSelection.Count(c => !_mLocalSelection.Contains(c));
    private bool   _mIsAllSelected => _mAllCategories.Any()
                                    && _mAllCategories.All(c => _mLocalSelection.Contains(c.Code));

    private async Task MLoadDataAsync()
    {
        _mIsLoading = true;
        _mAllMappings   = await MappingSvc.GetAllAsync();
        var cats        = await WtsSvc.GetDistinctCategoriesAsync();
        _mAllCategories = cats.OrderBy(c => c.Code).ToList();
        var allTasks    = await WtsSvc.GetAllActiveAsync();
        _mTaskCountByCategory = allTasks
            .GroupBy(t => t.CategoryCode)
            .ToDictionary(g => g.Key, g => g.Count());
        MRefreshSelection();
        _mIsLoading  = false;
        _mDataLoaded = true;
    }

    private void MRefreshSelection()
    {
        var mapped = _mAllMappings
            .Where(m => m.ProcessGroup == _mActiveTab)
            .Select(m => m.CategoryCode)
            .ToHashSet();
        _mDbSelection    = new HashSet<string>(mapped);
        _mLocalSelection = new HashSet<string>(mapped);
    }

    private void MSwitchTab(string code)
    {
        _mActiveTab   = code;
        _mThongBaoLoi = "";
        _mThongBaoOk  = "";
        MRefreshSelection();
    }

    private void MToggleCategory(string code)
    {
        if (_mLocalSelection.Contains(code)) _mLocalSelection.Remove(code);
        else _mLocalSelection.Add(code);
    }

    private void MToggleAll(ChangeEventArgs e)
    {
        var check = (bool)(e.Value ?? false);
        if (check) foreach (var cat in _mAllCategories) _mLocalSelection.Add(cat.Code);
        else _mLocalSelection.Clear();
    }

    private void ClearMOk()  { _mThongBaoOk  = ""; }
    private void ClearMLoi() { _mThongBaoLoi = ""; }

    private async Task MXacNhanLuuAsync()
    {
        _mIsProcessing = true;
        _mThongBaoLoi  = "";
        var selected = _mAllCategories.Where(c => _mLocalSelection.Contains(c.Code)).ToList();
        var result   = await MappingSvc.SaveGroupMappingAsync(_mActiveTab, selected, currentUserId);
        if (result.Success)
        {
            _mThongBaoOk = $"Đã lưu cấu hình cho nhóm {_mActiveTabName} thành công.";
            await MLoadDataAsync();
        }
        else
        {
            _mThongBaoLoi = result.Error ?? "Lỗi lưu cấu hình.";
        }
        _mIsProcessing = false;
    }

    private List<string> MGetOtherProcessGroups(string categoryCode)
    {
        return _mAllMappings
            .Where(m => m.CategoryCode == categoryCode && m.ProcessGroup != _mActiveTab)
            .Select(m => m.ProcessGroup)
            .Distinct().OrderBy(x => x).ToList();
    }

}
