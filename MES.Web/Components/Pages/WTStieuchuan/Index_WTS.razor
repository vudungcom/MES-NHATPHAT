@page "/wts-tieu-chuan"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using System.Security.Claims
@inject AuthenticationStateProvider AuthState
@inject MES.Web.Services.StandardWtsTaskService WtsSvc
@inject MES.Web.Services.WtsCategoryGroupMappingService MappingSvc
@inject IJSRuntime JS

<PageTitle>Danh mục Công việc WTS Tiêu Chuẩn - MES</PageTitle>

<div class="container-fluid pt-3 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 style="font-weight: bold; color: #1e293b;">Danh mục Công việc WTS Tiêu Chuẩn</h2>
            <p class="text-muted mb-0">
                Master Data định hình nguyên công cho <b>Part Master</b> và danh mục bắt buộc cho <b>chấm công WTS của công nhân</b>.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" @onclick="XuatExcelAsync" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang xuất...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    <span>Xuất Excel</span>
                }
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="MoPopupThem">
                <i class="bi bi-plus-lg"></i> Thêm công việc mới
            </button>
        </div>
    </div>

@* ── Tab chính: Danh mục | Cấu hình nhóm ── *@
<ul class="nav nav-tabs mb-0 mt-3">
    <li class="nav-item">
        <button class="@_MainTabListCls" @onclick="SetMainTabList">
            <i class="bi bi-list-check me-1"></i>Danh mục công việc
        </button>
    </li>
    <li class="nav-item">
        <button class="@_MainTabMapCls" @onclick="SetMainTabMapping">
            <i class="bi bi-diagram-2 me-1"></i>Cấu hình nhóm WTS
        </button>
    </li>
</ul>
<div style="border: 1px solid #dee2e6; border-top: none; padding: 1rem; border-radius: 0 0 .375rem .375rem;">
    @* ═══ TAB 1: DANH MỤC CÔNG VIỆC ═══ *@
    @if (_mainTab == "list")
    {
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text"
                       class="form-control"
                       placeholder="Tìm kiếm theo Mã công việc / Tên công việc..."
                       autocomplete="off"
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="ClearSearch" style="@_ClearSearchVisibility">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select form-select-sm" @bind="filterCategory">
                <option value="">-- Tất cả Nhóm công việc (@DanhSachNhom.Count nhóm) --</option>
                @foreach (var cat in DanhSachNhom)
                {
                    <option value="@cat.Code">@cat.Name (@cat.Code)</option>
                }
            </select>
        </div>
        <div class="col-md-3 text-end align-self-center text-muted small">
            Hiển thị <b>@DanhSachHienThi.Count</b> / @DanhSachGoc.Count công việc
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBaoLoi))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle"></i> @thongBaoLoi
            <button type="button" class="btn-close float-end" @onclick="ClearThongBaoLoi"></button>
        </div>
    }

    <div class="alert alert-warning py-2 mb-3 d-flex align-items-center justify-content-between"
         style="@_PendingBarStyle">
        <span class="small">
            <i class="bi bi-pencil-square me-1"></i>
            Có <b>@SoLuongThayDoi</b> mã công việc vừa được đổi phân loại — chưa lưu vào hệ thống.
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="HuyThayDoi">
                <i class="bi bi-x-circle me-1"></i>Hủy
            </button>
            <button class="btn btn-sm btn-warning fw-bold" @onclick="MoPopupLuuTong">
                <i class="bi bi-floppy me-1"></i>Lưu phân loại (@SoLuongThayDoi)
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th style="width: 220px;">Nhóm công đoạn</th>
                            <th style="width: 120px;" class="text-center text-danger">Mã công việc</th>
                            <th>Tên công việc tiêu chuẩn</th>
                            <th style="width: 100px;" class="text-center">ĐVT</th>
                            <th style="width: 110px;" class="text-center">Phân loại</th>
                            <th style="width: 80px;" class="text-center">Thứ tự</th>
                            <th>Ghi chú</th>
                            <th style="width: 130px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">Đang nạp danh mục công việc tiêu chuẩn...</td>
                            </tr>
                        }
                        else if (DanhSachHienThi.Any())
                        {
                            var stt = 0;
                            foreach (var item in DanhSachHienThi)
                            {
                                stt++;
                                var localValue = GetLocalValue(item.TaskId, item.IsProductiveTask);
                                var isDirty = localValue != item.IsProductiveTask;
                                var rowStyle = isDirty ? "background-color: #fffbeb;" : "";
                                var badgeCls = localValue ? "badge bg-success px-2 py-1" : "badge bg-secondary px-2 py-1";
                                var badgeTitle = localValue ? "Có ích — Click để đổi" : "Vô ích — Click để đổi";
                                var catBadgeCls = "badge " + GetBadgeClass(item.CategoryCode) + " px-2 py-1";
                                var itemRef = item;
                                <tr style="@rowStyle">
                                    <td class="text-center text-muted small">@stt</td>
                                    <td>
                                        <span class="@catBadgeCls">@item.CategoryName</span>
                                    </td>
                                    <td class="text-center font-monospace fw-bold text-danger fs-6">@item.TaskCode</td>
                                    <td class="fw-bold">@item.TaskName</td>
                                    <td class="text-center small text-muted">@item.DefaultUnit</td>
                                    <td class="text-center">
                                        <span class="@badgeCls"
                                              style="cursor: pointer; user-select: none;"
                                              title="@badgeTitle"
                                              @onclick="() => ToggleLocal(itemRef.TaskId, itemRef.IsProductiveTask)">
                                            @if (localValue)
                                            {
                                                <i class="bi bi-check-circle me-1"></i><span>Có ích</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle me-1"></i><span>Vô ích</span>
                                            }
                                        </span>
                                        @if (isDirty)
                                        {
                                            <span class="ms-1 text-warning" title="Chưa lưu" style="font-size: 0.75rem;">●</span>
                                        }
                                    </td>
                                    <td class="text-center small text-muted">@item.DisplayOrder</td>
                                    <td class="small text-muted">@item.GhiChu</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Sửa"
                                                @onclick="() => MoPopupSua(itemRef)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Lịch sử"
                                                @onclick="() => MoPopupLichSu(itemRef)">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa"
                                                @onclick="() => MoPopupXoa(itemRef)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">Không tìm thấy công việc tiêu chuẩn phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    }
    @* ═══ TAB 2: CẤU HÌNH NHÓM WTS ═══ *@
    @if (_mainTab == "mapping")
    {
        <div class="pt-2">
            <p class="text-muted mb-3 small">
                Gán <b>Nhóm công việc tiêu chuẩn</b> vào từng <b>Nhóm sản xuất</b> (GC / HTSP / KCS / PKG).
                Khi công nhân chấm công WTS, hệ thống tự lọc đúng nhóm công việc theo nhóm của họ.
            </p>

            <ul class="nav nav-tabs mb-0">
                @foreach (var pg in _mProcessGroups)
                {
                    var pgLocal = pg;
                    var isActive = _mActiveTab == pgLocal.Code;
                    var tabCls = "nav-link" + (isActive ? " active fw-bold" : "");
                    var mappedCount = _mAllMappings.Count(m => m.ProcessGroup == pgLocal.Code);
                    <li class="nav-item">
                        <button class="@tabCls" @onclick="() => MSwitchTab(pgLocal.Code)">
                            @pgLocal.Name
                            <span class="badge ms-1 @(isActive ? "bg-primary" : "bg-secondary") rounded-pill"
                                  style="font-size:0.7rem;">@mappedCount</span>
                        </button>
                    </li>
                }
            </ul>

            <div class="card shadow-sm border-0 border-top-0 rounded-0 rounded-bottom">
                <div class="card-body p-3">
                    @if (_mIsLoading)
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="spinner-border spinner-border-sm me-2"></span>Đang tải...
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="small text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Tick chọn các <b>Nhóm công việc</b> hiển thị cho công nhân nhóm
                                <b>@_mActiveTabName</b> khi chấm công WTS.
                                1 nhóm có thể chọn ở nhiều tab.
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="MMoPopupLuu"
                                    disabled="@(!_mIsDirty)">
                                <i class="bi bi-floppy me-1"></i>
                                Lưu cấu hình (@_mPendingCount thay đổi)
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(_mThongBaoLoi))
                        {
                            <div class="alert alert-danger py-2 small mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>@_mThongBaoLoi
                                <button type="button" class="btn-close float-end btn-sm"
                                        @onclick="ClearMLoi"></button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_mThongBaoOk))
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-circle me-1"></i>@_mThongBaoOk
                                <button type="button" class="btn-close float-end btn-sm"
                                        @onclick="ClearMOk"></button>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-hover table-bordered mb-0 align-middle">
                                <thead style="background-color: #f8fafc;">
                                    <tr>
                                        <th style="width:56px;" class="text-center">
                                            <input type="checkbox" class="form-check-input"
                                                   title="Chọn/bỏ tất cả"
                                                   checked="@_mIsAllSelected"
                                                   @onchange="MToggleAll" />
                                        </th>
                                        <th style="width:220px;">Nhóm công việc</th>
                                        <th style="width:120px;" class="text-center">Mã nhóm</th>
                                        <th class="text-center">Số CV trong nhóm</th>
                                        <th>Nhóm sản xuất khác đã gán</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!_mAllCategories.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                Chưa có nhóm công việc nào trong WTS Tiêu Chuẩn.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var cat in _mAllCategories)
                                        {
                                            var catLocal = cat;
                                            var isChecked = _mLocalSelection.Contains(catLocal.Code);
                                            var taskCount = _mTaskCountByCategory.GetValueOrDefault(catLocal.Code, 0);
                                            var otherPgs  = MGetOtherProcessGroups(catLocal.Code);
                                            var rowStyle  = isChecked ? "background-color: #f0f9ff;" : "";
                                            <tr style="@rowStyle" @key="catLocal.Code">
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@isChecked"
                                                           @onchange="() => MToggleCategory(catLocal.Code)" />
                                                </td>
                                                <td>
                                                    <span class="badge @GetBadgeClass(catLocal.Code) px-2 py-1">
                                                        @catLocal.Name
                                                    </span>
                                                </td>
                                                <td class="text-center font-monospace fw-bold text-secondary">
                                                    @catLocal.Code
                                                </td>
                                                <td class="text-center small text-muted">
                                                    @taskCount công việc
                                                </td>
                                                <td class="small">
                                                    @if (otherPgs.Any())
                                                    {
                                                        foreach (var pg in otherPgs)
                                                        {
                                                            <span class="badge bg-light text-dark border me-1">@pg</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

</div>

@* ── Modal PIN cấu hình nhóm ── *@
@if (_mIsHienThiPopupLuu)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content shadow">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-floppy me-1"></i> Lưu cấu hình nhóm @_mActiveTabName
                    </h6>
                    <button type="button" class="btn-close" @onclick="MDongPopupLuu"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3 p-2 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="small fw-bold text-muted mb-2">
                            Nhóm CV sẽ gán cho <b>@_mActiveTabName</b> (@_mLocalSelection.Count nhóm):
                        </div>
                        @if (_mLocalSelection.Any())
                        {
                            foreach (var code in _mLocalSelection.OrderBy(x => x))
                            {
                                var codeLocal = code;
                                var cat = _mAllCategories.FirstOrDefault(c => c.Code == codeLocal);
                                var catName = cat.Code == codeLocal ? cat.Name : codeLocal;
                                <div class="small mb-1">
                                    <i class="bi bi-check2 text-success me-1"></i>
                                    <span class="font-monospace text-secondary fw-bold">[@codeLocal]</span>
                                    @catName
                                </div>
                            }
                        }
                        else
                        {
                            <div class="small text-muted fst-italic">(Không chọn nhóm nào — xoá toàn bộ mapping)</div>
                        }
                    </div>
                    <div>
                        <label class="form-label text-danger fw-bold small mb-1">
                            <i class="bi bi-shield-lock"></i> Nhập PIN xác nhận *
                        </label>
                        <input type="password" class="form-control form-control-sm"
                               autocomplete="new-password"
                               @bind="_mPinInput"
                               placeholder="Nhập PIN của bạn..." />
                    </div>
                    @if (!string.IsNullOrEmpty(_mLoiPopup))
                    {
                        <div class="text-danger mt-2 fw-bold small">@_mLoiPopup</div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary"
                            @onclick="MDongPopupLuu" disabled="@_mIsProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold"
                            @onclick="MXacNhanLuuAsync" disabled="@_mIsProcessing">
                        @(_mIsProcessing ? "Đang lưu..." : "Xác nhận lưu")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool isExporting = false;
    private bool isLoadingLogs = false;
    private int currentUserId;

    private string searchText = "";
    private string filterCategory = "";
    private string thongBaoLoi = "";
    private string loiPopup = "";

    private List<StandardWtsTask> DanhSachGoc = new();
    private List<(string Code, string Name)> DanhSachNhom = new();
    private List<StandardWtsTaskChangeLog> danhSachChangeLog = new();

    private bool isHienThiPopupSua = false;
    private bool isHienThiPopupLichSu = false;
    private bool isHienThiPopupXoa = false;
    private bool isHienThiPopupLuuTong = false;
    private bool isThemMoi = false;
    private bool isTaoNhomMoi = false;

    private StandardWtsTask? itemDangSua = null;
    private StandardWtsTask? itemDangXem = null;
    private StandardWtsTask? itemCanXoa = null;

    private string lyDoSua = "";
    private string pinXacNhan = "";
    private string pinLuuTong = "";
    private string loiLuuTong = "";

    private Dictionary<int, bool> _localChanges = new();

    private bool CoThayDoiChuaLuu => _localChanges.Any();
    private int SoLuongThayDoi => _localChanges.Count;

    // Precomputed strings — tránh mọi expression phức tạp trong attribute
    private string _PendingBarStyle => CoThayDoiChuaLuu ? "visibility: visible;" : "visibility: hidden;";
    private string _ClearSearchVisibility => string.IsNullOrEmpty(searchText) ? "visibility: hidden;" : "visibility: visible;";
    private string _LuuTongLabel
    {
        get
        {
            if (isProcessing) return "Đang lưu...";
            return "Xác nhận lưu (" + SoLuongThayDoi + ")";
        }
    }
    private string _TieuDePopupSua
    {
        get
        {
            if (isThemMoi) return "Thêm mới công việc WTS tiêu chuẩn";
            if (itemDangSua == null) return "";
            return "Sửa công việc: [" + itemDangSua.TaskCode + "]";
        }
    }
    private string _LuuCongViecLabel => isProcessing ? "Đang lưu..." : "Lưu công việc";
    private string _XacNhanXoaLabel => isProcessing ? "Đang kiểm tra..." : "Xác nhận xóa";

    private bool GetLocalValue(int taskId, bool dbValue)
    {
        if (_localChanges.TryGetValue(taskId, out var local)) return local;
        return dbValue;
    }

    private void ToggleLocal(int taskId, bool dbValue)
    {
        var current = GetLocalValue(taskId, dbValue);
        var newValue = !current;
        if (newValue == dbValue)
        {
            _localChanges.Remove(taskId);
        }
        else
        {
            _localChanges[taskId] = newValue;
        }
    }

    private void HuyThayDoi()
    {
        _localChanges.Clear();
    }

    private void ClearSearch()
    {
        searchText = "";
    }

    private void ClearThongBaoLoi()
    {
        thongBaoLoi = "";
    }

    private void SetProductiveTrue()
    {
        if (itemDangSua != null) itemDangSua.IsProductiveTask = true;
    }

    private void SetProductiveFalse()
    {
        if (itemDangSua != null) itemDangSua.IsProductiveTask = false;
    }

    private void MoPopupLuuTong()
    {
        pinLuuTong = "";
        loiLuuTong = "";
        isHienThiPopupLuuTong = true;
    }

    private void DongPopupLuuTong()
    {
        isHienThiPopupLuuTong = false;
        pinLuuTong = "";
        loiLuuTong = "";
    }

    private async Task XacNhanLuuTongAsync()
    {
        if (!_localChanges.Any()) return;
        isProcessing = true;
        loiLuuTong = "";

        var changes = _localChanges.Select(kv => (kv.Key, kv.Value)).ToList();
        var result = await WtsSvc.BulkUpdateProductiveAsync(changes, currentUserId, pinLuuTong);

        if (result.Success)
        {
            _localChanges.Clear();
            DongPopupLuuTong();
            await LoadDataAsync();
        }
        else
        {
            loiLuuTong = result.Error ?? "Lỗi lưu phân loại.";
        }
        isProcessing = false;
    }

    private List<StandardWtsTask> DanhSachHienThi
    {
        get
        {
            return DanhSachGoc
                .Where(x =>
                    (string.IsNullOrWhiteSpace(searchText) ||
                     x.TaskCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                     x.TaskName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrWhiteSpace(filterCategory) || x.CategoryCode == filterCategory)
                ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        DanhSachGoc = await WtsSvc.GetAllActiveAsync();
        DanhSachNhom = await WtsSvc.GetDistinctCategoriesAsync();
        isLoading = false;
    }

    private string GetBadgeClass(string catCode)
    {
        switch (catCode)
        {
            case "TARO":     return "bg-primary text-white";
            case "BAVIA":    return "bg-info text-dark";
            case "RUA":      return "bg-success text-white";
            case "KCS":      return "bg-danger text-white";
            case "DONG_GOI": return "bg-warning text-dark";
            case "KT_NC":    return "bg-dark text-white";
            case "GIA_CONG": return "bg-purple text-white";
            default:         return "bg-secondary text-white";
        }
    }

    private void OnChonNhomCoSan(ChangeEventArgs e)
    {
        var selectedCode = e.Value?.ToString() ?? "";
        if (itemDangSua != null)
        {
            itemDangSua.CategoryCode = selectedCode;
            var found = DanhSachNhom.FirstOrDefault(x => x.Code == selectedCode);
            itemDangSua.CategoryName = found.Name ?? selectedCode;
        }
    }

    private void MoPopupThem()
    {
