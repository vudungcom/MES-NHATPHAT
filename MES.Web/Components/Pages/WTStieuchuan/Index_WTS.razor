    private async Task XuatExcelAsync()
    {
        try
        {
            isExporting = true;
            var fileBytes = await WtsSvc.ExportExcelAsync(DanhSachHienThi);
            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = "DS_WTS_TieuChuan_" + DateTime.Now.ToString("yyyyMMdd_HHmm") + ".xlsx";
            var js = "(function(){const a=document.createElement('a');a.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64," + base64 + "';a.download='" + fileName + "';document.body.appendChild(a);a.click();document.body.removeChild(a);})();";
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi khi xuất file Excel: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }

    // ═══════════════════════════════════════════════════
    // TAB 2 — CẤU HÌNH NHÓM WTS
    // ═══════════════════════════════════════════════════
    private string _mainTab = "list"; // "list" | "mapping"

    private string _MainTabListCls => "nav-link" + (_mainTab == "list"    ? " active fw-bold" : "");
    private string _MainTabMapCls  => "nav-link" + (_mainTab == "mapping" ? " active fw-bold" : "");

    private void SetMainTabList() { _mainTab = "list"; }
    private async Task SetMainTabMapping()
    {
        _mainTab = "mapping";
        if (!_mDataLoaded) await MLoadDataAsync();
    }

    private bool   _mIsLoading    = false;
    private bool   _mIsProcessing = false;
    private bool   _mDataLoaded   = false;
    private string _mActiveTab    = "GC";
    private string _mThongBaoLoi  = "";
    private string _mThongBaoOk   = "";
    private string _mPinInput     = "";
    private string _mLoiPopup     = "";
    private bool   _mIsHienThiPopupLuu = false;

    private List<WtsCategoryGroupMapping>    _mAllMappings         = new();
    private List<(string Code, string Name)> _mAllCategories       = new();
    private Dictionary<string, int>          _mTaskCountByCategory = new();
    private HashSet<string> _mLocalSelection = new();
    private HashSet<string> _mDbSelection    = new();

    private static readonly List<(string Code, string Name)> _mProcessGroups =
        MES.Web.Services.WtsCategoryGroupMappingService.ProcessGroups;

    private string _mActiveTabName => _mProcessGroups.FirstOrDefault(p => p.Code == _mActiveTab).Name ?? _mActiveTab;
    private bool   _mIsDirty       => !_mLocalSelection.SetEquals(_mDbSelection);
    private int    _mPendingCount  => _mLocalSelection.Count(c => !_mDbSelection.Contains(c))
                                    + _mDbSelection.Count(c => !_mLocalSelection.Contains(c));
    private bool   _mIsAllSelected => _mAllCategories.Any()
                                    && _mAllCategories.All(c => _mLocalSelection.Contains(c.Code));

    private async Task MLoadDataAsync()
    {
        _mIsLoading = true;
        _mAllMappings   = await MappingSvc.GetAllAsync();
        var cats        = await WtsSvc.GetDistinctCategoriesAsync();
        _mAllCategories = cats.OrderBy(c => c.Code).ToList();
        var allTasks    = await WtsSvc.GetAllActiveAsync();
        _mTaskCountByCategory = allTasks
            .GroupBy(t => t.CategoryCode)
            .ToDictionary(g => g.Key, g => g.Count());
        MRefreshSelection();
        _mIsLoading  = false;
        _mDataLoaded = true;
    }

    private void MRefreshSelection()
    {
        var mapped = _mAllMappings
            .Where(m => m.ProcessGroup == _mActiveTab)
            .Select(m => m.CategoryCode)
            .ToHashSet();
        _mDbSelection    = new HashSet<string>(mapped);
        _mLocalSelection = new HashSet<string>(mapped);
    }

    private void MSwitchTab(string code)
    {
        _mActiveTab   = code;
        _mThongBaoLoi = "";
        _mThongBaoOk  = "";
        MRefreshSelection();
    }

    private void MToggleCategory(string code)
    {
        if (_mLocalSelection.Contains(code)) _mLocalSelection.Remove(code);
        else _mLocalSelection.Add(code);
    }

    private void MToggleAll(ChangeEventArgs e)
    {
        var check = (bool)(e.Value ?? false);
        if (check) foreach (var cat in _mAllCategories) _mLocalSelection.Add(cat.Code);
        else _mLocalSelection.Clear();
    }

    private void ClearMOk()  { _mThongBaoOk  = ""; }
    private void ClearMLoi() { _mThongBaoLoi = ""; }
    private void MMoPopupLuu()   { _mPinInput = ""; _mLoiPopup = ""; _mIsHienThiPopupLuu = true; }
    private void MDongPopupLuu() { _mIsHienThiPopupLuu = false; _mPinInput = ""; _mLoiPopup = ""; }

    private async Task MXacNhanLuuAsync()
    {
        _mIsProcessing = true;
        _mLoiPopup     = "";
        var selected = _mAllCategories.Where(c => _mLocalSelection.Contains(c.Code)).ToList();
        var result   = await MappingSvc.SaveGroupMappingAsync(_mActiveTab, selected, currentUserId, _mPinInput);
        if (result.Success)
        {
            MDongPopupLuu();
            _mThongBaoOk = $"Đã lưu cấu hình cho nhóm {_mActiveTabName} thành công.";
            await MLoadDataAsync();
        }
        else
        {
            _mLoiPopup = result.Error ?? "Lỗi lưu cấu hình.";
        }
        _mIsProcessing = false;
    }

    private List<string> MGetOtherProcessGroups(string categoryCode)
    {
        return _mAllMappings
            .Where(m => m.CategoryCode == categoryCode && m.ProcessGroup != _mActiveTab)
            .Select(m => m.ProcessGroup)
            .Distinct().OrderBy(x => x).ToList();
    }

}
