@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Đăng nhập - MES</PageTitle>

<div class="mes-login-card">
    <div class="mes-login-brand text-center mb-3">
        <img src="/images/Logo.jpg" alt="Logo Nhật Phát" style="max-width: 180px; max-height: 80px; object-fit: contain; margin-bottom: 12px;" />
        <h1 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 2px;">MES</h1>
        <p class="text-muted small mb-0">Manufacturing Execution System</p>
    </div>

    @if (HasError)
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle"></i> Sai username hoặc password
        </div>
    }
    @if (ErrorParam == "3")
    {
        @* [RS-C3 2026-10-30] *@
        <div class="alert alert-warning py-2 small mb-3">
            <i class="bi bi-lock"></i> Tài khoản chưa có nhóm hoặc nhóm đang bị khoá — nhờ Admin kiểm tra phân quyền.
        </div>
    }
    @if (IsLocked)
    {
        @* [RS-C4 2026-10-30] đăng nhập sai quá nhiều lần *@
        <div class="alert alert-warning py-2 small mb-3">
            <i class="bi bi-lock"></i> Đăng nhập sai quá nhiều lần — thử lại sau @WaitText phút, hoặc nhờ Admin kiểm tra tài khoản.
        </div>
    }

    <form method="post" action="/login-submit" id="loginForm">
        @if (!string.IsNullOrEmpty(ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        }
        <div class="mb-3">
            <label class="form-label small">Tên đăng nhập</label>
            <input type="text" name="username" id="username" class="form-control" required autofocus
                   autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label small">Mật khẩu</label>
            <input type="password" name="password" id="password" class="form-control" required
                   autocomplete="current-password" />
        </div>

        <div class="mb-3 d-flex align-items-center gap-2">
            <input type="checkbox" id="rememberMe" class="form-check-input mt-0" />
            <label for="rememberMe" class="form-check-label small text-muted" style="cursor:pointer">
                Nhớ tên đăng nhập
            </label>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
        </button>
    </form>

    @* [RS-C4 2026-10-30] Bỏ dòng gợi ý tài khoản / mật khẩu mặc định trên trang đăng nhập *@
</div>

<script>
// [RS-C5 2026-10-30] "Nhớ" CHỈ tên đăng nhập — trước: lưu cả mật khẩu chữ thường trong trình duyệt (máy dùng chung là lộ).
//   Xoá luôn mật khẩu đã lưu từ bản cũ.
(function () {
    var KEY_USER = 'mes_saved_username';
    var KEY_PASS = 'mes_saved_password';
    var KEY_REM  = 'mes_remember_me';
    try { localStorage.removeItem(KEY_PASS); } catch (e) { }

    var uEl  = document.getElementById('username');
    var pEl  = document.getElementById('password');
    var cbEl = document.getElementById('rememberMe');
    var form = document.getElementById('loginForm');

    try {
        if (localStorage.getItem(KEY_REM) === '1') {
            uEl.value    = localStorage.getItem(KEY_USER) || '';
            cbEl.checked = true;
            if (uEl.value) pEl.focus();
        }
    } catch (e) { }

    form.addEventListener('submit', function () {
        try {
            if (cbEl.checked) {
                localStorage.setItem(KEY_USER, uEl.value);
                localStorage.setItem(KEY_REM,  '1');
            } else {
                localStorage.removeItem(KEY_USER);
                localStorage.removeItem(KEY_REM);
            }
        } catch (e) { }
    });
})();
</script>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorParam { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "wait")]
    public string? WaitParam { get; set; }

    private bool HasError => ErrorParam == "1";
    private bool IsLocked => ErrorParam == "2";   // [RS-C4]
    private string WaitText => int.TryParse(WaitParam, out var w) && w > 0 ? w.ToString() : "15";
}
