@page "/do-ga"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using System.Security.Claims
@inject AuthenticationStateProvider AuthState
@inject MES.Web.Services.DoGaService DoGaSvc
@inject IJSRuntime JS

<PageTitle>Quản lý Đồ gá & Phụ kiện - MES</PageTitle>

<div class="container-fluid pt-3 pb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 style="font-weight: bold; color: #1e293b;">Bảng theo dõi Đồ gá & Phụ kiện kèm theo</h2>
            <p class="text-muted mb-0">
                Mỗi dòng = 1 Bộ đồ gá. <b>Double-click</b> để xem chi tiết. Cột <b>Tên Đồ Gá</b> là khóa tham chiếu chuẩn.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" @onclick="XuatExcelAsync" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang xuất...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    <span>Xuất Excel</span>
                }
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="MoPopupThem">
                <i class="bi bi-plus-lg"></i> Thêm đồ gá mới
            </button>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" 
                       class="form-control" 
                       placeholder="Tìm theo Tên Đồ gá / Sản phẩm / Phụ kiện / Người mượn..." 
                       autocomplete="off"
                       @bind-value="searchText" 
                       @bind-value:event="oninput" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <button class="btn btn-outline-secondary" @onclick="() => searchText = string.Empty">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="filterTrangThai">
                <option value="">-- Tất cả Trạng thái --</option>
                <option value="Sẵn sàng">🟢 Sẵn sàng (Trong kho)</option>
                <option value="Đang mượn">🟡 Đang mượn</option>
                <option value="Bảo trì">🔴 Đang bảo trì / Hỏng</option>
            </select>
        </div>
        <div class="col-md-4 text-end align-self-center text-muted small">
            Hiển thị <b>@DanhSachHienThi.Count</b> / @DanhSachGoc.Count Đồ gá
            @if (DanhSachGoc.Any(x => x.TrangThai == "Đang mượn"))
            {
                <span class="badge bg-warning text-dark ms-2">
                    <i class="bi bi-person-fill"></i> @DanhSachGoc.Count(x => x.TrangThai == "Đang mượn") Đang mượn
                </span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBaoLoi))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle"></i> @thongBaoLoi
            <button type="button" class="btn-close float-end" @onclick="() => thongBaoLoi = string.Empty"></button>
        </div>
    }

    <!-- Bảng danh sách đồ gá chuẩn định dạng 2 tầng Header -->
    <div class="table-responsive shadow-sm bg-white rounded border" style="max-height: 720px; overflow-y: auto;">
        <table class="table table-hover table-bordered mb-0 align-middle table-sm">
            <thead style="background-color: #f1f5f9; position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th rowspan="2" class="text-center" style="width: 40px;">#</th>
                    <th rowspan="2" class="text-center" style="width: 110px; color: #d81b60;">Tên Đồ Gá</th>
                    <th rowspan="2" class="text-center" style="width: 55px;">SL</th>
                    <th colspan="6" class="text-center bg-primary text-white py-1">Phụ Kiện Đi Kèm</th>
                    <th rowspan="2" style="min-width: 140px;">Sản phẩm sử dụng</th>
                    <th rowspan="2" style="min-width: 140px;">Ghi chú</th>
                    <th rowspan="2" class="text-center" style="width: 95px;">Trạng thái</th>
                    <th rowspan="2" style="min-width: 130px; color: #c2410c;">Người mượn</th>
                    <th rowspan="2" class="text-center" style="width: 105px; color: #c2410c;">Ngày mượn</th>
                    <th rowspan="2" class="text-center" style="width: 105px; color: #c2410c;">Hạn trả</th>
                    <th rowspan="2" class="text-center" style="width: 140px;">Thao tác</th>
                </tr>
                <tr style="background-color: #e2e8f0; font-size: 0.8rem;">
                    <th style="min-width: 90px;">Bu lông</th>
                    <th style="min-width: 90px;">BL định vị</th>
                    <th style="min-width: 90px;">Chốt</th>
                    <th style="min-width: 80px;">Đệm</th>
                    <th style="min-width: 90px;">Kẹp</th>
                    <th style="min-width: 85px;">Long đen</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="16" class="text-center py-5 text-muted">Đang nạp dữ liệu đồ gá...</td></tr>
                }
                else if (DanhSachHienThi.Any())
                {
                    int stt = 1;
                    foreach (var item in DanhSachHienThi)
                    {
                        var isMuon = item.TrangThai == "Đang mượn";
                        <tr class="@(isMuon ? "table-warning bg-opacity-25" : "")" 
                            @ondblclick="() => MoPopupView(item)" 
                            style="cursor: pointer;" 
                            title="Double-click để xem chi tiết đầy đủ">
                            
                            <td class="text-center text-muted small">@stt</td>
                            <td class="fw-bold text-nowrap" style="color: #d81b60; font-size: 0.88rem;">@item.TenDoGa</td>
                            <td class="text-center font-monospace small">@item.SoLuong</td>

                            <!-- Phụ kiện -->
                            <td class="small">@item.BuLong</td>
                            <td class="small">@item.BuLongDinhVi</td>
                            <td class="small">@item.Chot</td>
                            <td class="small">@item.Dem</td>
                            <td class="small">@item.Kep</td>
                            <td class="small">@item.LongDen</td>

                            <td class="small fw-semibold text-primary">@item.SanPhamSuDung</td>
                            <td class="small text-muted text-truncate" style="max-width: 160px;" title="@item.GhiChu">@item.GhiChu</td>

                            <!-- Trạng thái -->
                            <td class="text-center text-nowrap">
                                @if (isMuon)
                                {
                                    <span class="badge bg-warning text-dark">Đang mượn</span>
                                }
                                else if (item.TrangThai == "Bảo trì")
                                {
                                    <span class="badge bg-danger">Bảo trì</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Sẵn sàng</span>
                                }
                            </td>

                            <!-- Người mượn, ngày mượn, hạn trả -->
                            <td class="small text-nowrap">
                                @if (isMuon && !string.IsNullOrEmpty(item.NguoiMuonHienTai))
                                {
                                    <span class="fw-bold text-danger"><i class="bi bi-person me-1"></i>@item.NguoiMuonHienTai</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center small text-nowrap">
                                @if (isMuon && item.NgayMuonHienTai.HasValue)
                                {
                                    <span class="text-danger fw-semibold">@item.NgayMuonHienTai.Value.ToString("dd/MM/yy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center small text-nowrap">
                                @if (isMuon && item.NgayTraDuKien.HasValue)
                                {
                                    <span class="text-danger fw-semibold">@item.NgayTraDuKien.Value.ToString("dd/MM/yy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <!-- Thao tác -->
                            <td class="text-center text-nowrap" @onclick:stopPropagation="true">
                                @if (isMuon)
                                {
                                    <button class="btn btn-sm btn-success py-0 px-2 me-1" title="Xác nhận trả đồ gá về kho" @onclick="() => MoPopupTra(item)">
                                        <i class="bi bi-box-arrow-in-down"></i> Trả
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-warning text-dark py-0 px-2 me-1" title="Mượn đồ gá này" @onclick="() => MoPopupMuon(item)">
                                        <i class="bi bi-hand-index-thumb"></i> Mượn
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-primary py-0 px-1 me-1" title="Sửa thông tin" @onclick="() => MoPopupSua(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-1 me-1" title="Lịch sử mượn trả & sửa đổi" @onclick="() => MoPopupLichSu(item)">
                                    <i class="bi bi-clock-history"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Xóa" @onclick="() => MoPopupXoa(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr><td colspan="16" class="text-center py-5 text-muted">Không tìm thấy dữ liệu đồ gá phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Mượn Đồ Gá -->
@if (isHienThiPopupMuon && itemDangMuonTra != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning bg-opacity-25">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-hand-index-thumb text-warning-emphasis"></i> Mượn đồ gá: @itemDangMuonTra.TenDoGa</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupMuon"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Người mượn (Mã NV & Họ tên) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="nguoiMuonInput" placeholder="VD: 016 Đỗ Văn Phúc..." />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Thời gian mượn</label>
                            <input type="datetime-local" class="form-control form-control-sm" @bind="ngayMuonInput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Hạn ngày trả</label>
                            <input type="datetime-local" class="form-control form-control-sm" @bind="ngayTraDuKienInput" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-1">Lý do mượn / Gia công Part nào</label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="lyDoMuonInput" placeholder="VD: Gia công Part 4B-PT1405210 ca ngày..." />
                    </div>

                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px;">
                        <label class="form-label text-danger fw-bold small mb-1"><i class="bi bi-shield-lock"></i> Nhập PIN xác nhận *</label>
                        <input type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN của bạn..." />
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupMuon" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" @onclick="XacNhanMuonAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang ghi..." : "Xác nhận mượn")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Trả Đồ Gá -->
@if (isHienThiPopupTra && itemDangMuonTra != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-box-arrow-in-down"></i> Trả đồ gá về kho: @itemDangMuonTra.TenDoGa</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="DongPopupTra"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <div>Đang mượn bởi: <b>@itemDangMuonTra.NguoiMuonHienTai</b></div>
                        <div>Mượn từ lúc: <b>@(itemDangMuonTra.NgayMuonHienTai.HasValue ? itemDangMuonTra.NgayMuonHienTai.Value.ToString("dd/MM/yyyy HH:mm") : "-")</b></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-1">Ghi chú tình trạng khi trả</label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="ghiChuTraInput" placeholder="VD: Đồ gá nguyên vẹn, đủ bulong..." />
                    </div>

                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px;">
                        <label class="form-label text-danger fw-bold small mb-1"><i class="bi bi-shield-lock"></i> Nhập PIN xác nhận trả *</label>
                        <input type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN của bạn..." />
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupTra" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-success fw-bold" @onclick="XacNhanTraAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang xử lý..." : "Xác nhận đã trả về kho")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Thêm / Sửa Đồ Gá -->
@if (isHienThiPopupSua && itemDangSua != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-pencil-square"></i> @(isThemMoi ? "Thêm mới đồ gá" : $"Sửa thông tin đồ gá: {itemDangSua.TenDoGa}")
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupSua"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-8">
                            <label class="form-label small fw-bold mb-1">Tên Đồ Gá (Cột B) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm fw-bold text-danger" autocomplete="off" @bind="itemDangSua.TenDoGa" placeholder="VD: VJ63, A288, A295+A296..." />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold mb-1">Số lượng</label>
                            <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.SoLuong" placeholder="VD: 1, 2..." />
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded border mb-2">
                        <div class="fw-bold text-primary small mb-2"><i class="bi bi-nut"></i> Phụ kiện đi kèm theo đồ gá</div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small mb-1">Bu lông</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.BuLong" placeholder="VD: M8*30(1)..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Bu lông định vị</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.BuLongDinhVi" placeholder="VD: 7..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Chốt</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.Chot" placeholder="VD: 2 chốt F6..." />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label small mb-1">Đệm</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.Dem" placeholder="VD: 14, 2 đệm..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Kẹp</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.Kep" placeholder="VD: KTC 25*60(1)..." />
                            </div>
                            <div class="col-4">
                                <label class="form-label small mb-1">Long đen</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.LongDen" placeholder="VD: 4, Long đen F17..." />
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Sản phẩm sử dụng (Part No)</label>
                            <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.SanPhamSuDung" placeholder="VD: 4B-PT1405210..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold mb-1">Ghi chú</label>
                            <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="itemDangSua.GhiChu" placeholder="VD: Kẹp và đệm đã bắt vào nhau..." />
                        </div>
                    </div>

                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px;">
                        @if (!isThemMoi)
                        {
                            <div class="mb-2">
                                <label class="form-label small fw-bold mb-1">Lý do thay đổi thông tin</label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="lyDoSua" placeholder="VD: Cập nhật thêm bu lông kẹp..." />
                            </div>
                        }
                        <div>
                            <label class="form-label text-danger fw-bold small mb-1"><i class="bi bi-shield-lock"></i> Nhập PIN xác nhận *</label>
                            <input type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN của bạn..." />
                        </div>
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupSua" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="LuuThongTinDoGaAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang lưu..." : "Lưu dữ liệu")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Lịch Sử (2 Tabs) -->
@if (isHienThiPopupLichSu && itemDangXem != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-secondary">
                        <i class="bi bi-clock-history"></i> Lịch sử đồ gá: <span class="text-danger">@itemDangXem.TenDoGa</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupLichSu"></button>
                </div>
                <div class="modal-body p-0">
                    <ul class="nav nav-tabs px-3 pt-2 bg-light">
                        <li class="nav-item">
                            <button class="nav-link @(tabLichSuActive == 1 ? "active fw-bold text-primary" : "")" @onclick="() => tabLichSuActive = 1">
                                <i class="bi bi-arrow-left-right me-1"></i> Lịch sử Mượn / Trả
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(tabLichSuActive == 2 ? "active fw-bold text-primary" : "")" @onclick="() => tabLichSuActive = 2">
                                <i class="bi bi-journal-text me-1"></i> Nhật ký sửa đổi thông tin
                            </button>
                        </li>
                    </ul>

                    <div class="p-3">
                        @if (isLoadingLogs)
                        {
                            <div class="text-center py-4">Đang tải lịch sử...</div>
                        }
                        else if (tabLichSuActive == 1)
                        {
                            @if (danhSachMuonTraLog.Any())
                            {
                                <table class="table table-sm table-bordered table-hover mb-0 align-middle">
                                    <thead style="background-color: #f8fafc;">
                                        <tr>
                                            <th>Người mượn</th>
                                            <th>Ngày mượn</th>
                                            <th>Hẹn trả</th>
                                            <th>Ngày trả thực tế</th>
                                            <th>Lý do mượn</th>
                                            <th>Ghi chú khi trả</th>
                                            <th class="text-center">Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in danhSachMuonTraLog)
                                        {
                                            <tr>
                                                <td class="fw-bold text-danger">@log.NguoiMuon</td>
                                                <td class="small">@log.NgayMuon.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="small">@(log.NgayTraDuKien.HasValue ? log.NgayTraDuKien.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                                <td class="small">@(log.NgayTraThucTe.HasValue ? log.NgayTraThucTe.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                                <td class="small">@log.LyDoMuon</td>
                                                <td class="small text-muted">@log.GhiChuTra</td>
                                                <td class="text-center">
                                                    @if (log.TrangThai == "Đang mượn")
                                                    {
                                                        <span class="badge bg-warning text-dark">Đang mượn</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Đã trả</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">Chưa có lịch sử mượn trả nào cho đồ gá này.</div>
                            }
                        }
                        else
                        {
                            @if (danhSachChangeLog.Any())
                            {
                                <table class="table table-sm table-bordered table-hover mb-0 align-middle">
                                    <thead style="background-color: #f8fafc;">
                                        <tr>
                                            <th style="width: 140px;">Thời gian</th>
                                            <th style="width: 110px;">Người sửa</th>
                                            <th>Thông tin thay đổi</th>
                                            <th>Giá trị cũ</th>
                                            <th>Giá trị mới</th>
                                            <th>Lý do</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in danhSachChangeLog)
                                        {
                                            <tr>
                                                <td class="small">@log.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                <td class="small fw-bold">@(log.ChangedByUser?.Username ?? "System")</td>
                                                <td class="small"><span class="badge bg-light text-dark border">@log.FieldName</span></td>
                                                <td class="small text-muted">@log.OldValue</td>
                                                <td class="small text-primary fw-bold">@log.NewValue</td>
                                                <td class="small text-secondary">@log.Reason</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">Chưa có nhật ký sửa đổi nào cho đồ gá này.</div>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupLichSu">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Xem Chi Tiết -->
@if (isHienThiPopupView && itemDangXem != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-info-circle"></i> Chi tiết đồ gá: @itemDangXem.TenDoGa</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupView"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered mb-0">
                        <tbody>
                            <tr><th style="width: 140px; background-color: #f8fafc;">Tên Đồ Gá</th><td class="fw-bold text-danger">@itemDangXem.TenDoGa</td></tr>
                            <tr><th style="background-color: #f8fafc;">Số lượng</th><td>@itemDangXem.SoLuong</td></tr>
                            <tr><th style="background-color: #f8fafc;">Bu lông</th><td>@itemDangXem.BuLong</td></tr>
                            <tr><th style="background-color: #f8fafc;">BL định vị</th><td>@itemDangXem.BuLongDinhVi</td></tr>
                            <tr><th style="background-color: #f8fafc;">Chốt</th><td>@itemDangXem.Chot</td></tr>
                            <tr><th style="background-color: #f8fafc;">Đệm</th><td>@itemDangXem.Dem</td></tr>
                            <tr><th style="background-color: #f8fafc;">Kẹp</th><td>@itemDangXem.Kep</td></tr>
                            <tr><th style="background-color: #f8fafc;">Long đen</th><td>@itemDangXem.LongDen</td></tr>
                            <tr><th style="background-color: #f8fafc;">Sản phẩm sử dụng</th><td class="fw-bold text-primary">@itemDangXem.SanPhamSuDung</td></tr>
                            <tr><th style="background-color: #f8fafc;">Ghi chú</th><td>@itemDangXem.GhiChu</td></tr>
                            <tr>
                                <th style="background-color: #f8fafc;">Trạng thái</th>
                                <td>
                                    @if (itemDangXem.TrangThai == "Đang mượn") { <span class="badge bg-warning text-dark">Đang mượn bởi: @itemDangXem.NguoiMuonHienTai</span> }
                                    else { <span class="badge bg-success">Sẵn sàng trong kho</span> }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-auto" @onclick="() => { DongPopupView(); MoPopupLichSu(itemDangXem); }">
                        <i class="bi bi-clock-history"></i> Lịch sử
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => { DongPopupView(); MoPopupSua(itemDangXem); }">
                        <i class="bi bi-pencil"></i> Sửa
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupView">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Xác Nhận Xóa -->
@if (isHienThiPopupXoa && itemCanXoa != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash3"></i> Xác nhận xóa đồ gá</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupXoa"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3 small">
                        <i class="bi bi-info-circle"></i> Bạn có chắc chắn muốn xóa đồ gá <b>@itemCanXoa.TenDoGa</b> khỏi hệ thống?
                    </div>
                    <div style="border: 1px solid #dc3545; border-radius: 6px; padding: 15px;">
                        <label class="form-label text-danger fw-bold small mb-2"><i class="bi bi-shield-lock"></i> Nhập PIN của bạn *</label>
                        <input type="password" class="form-control" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN để xác nhận xóa..." disabled="@isProcessing" />
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="DongPopupXoa" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-danger" @onclick="XacNhanXoaAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang kiểm tra..." : "Xác nhận xóa")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool isExporting = false;
    private bool isLoadingLogs = false;
    private int currentUserId;

    private string searchText = "";
    private string filterTrangThai = "";
    private string thongBaoLoi = "";
    private string loiPopup = "";

    private List<DoGa> DanhSachGoc = new List<DoGa>();
    private List<DoGaMuonTraLog> danhSachMuonTraLog = new List<DoGaMuonTraLog>();
    private List<DoGaChangeLog> danhSachChangeLog = new List<DoGaChangeLog>();

    private bool isHienThiPopupView = false;
    private bool isHienThiPopupMuon = false;
    private bool isHienThiPopupTra = false;
    private bool isHienThiPopupSua = false;
    private bool isHienThiPopupLichSu = false;
    private bool isHienThiPopupXoa = false;
    private bool isThemMoi = false;
    private int tabLichSuActive = 1;

    private DoGa? itemDangXem = null;
    private DoGa? itemDangMuonTra = null;
    private DoGa? itemDangSua = null;
    private DoGa? itemCanXoa = null;

    private string nguoiMuonInput = "";
    private DateTime ngayMuonInput = DateTime.Now;
    private DateTime? ngayTraDuKienInput = null;
    private string lyDoMuonInput = "";
    private string ghiChuTraInput = "";
    private string lyDoSua = "";
    private string pinXacNhan = "";

    private List<DoGa> DanhSachHienThi => DanhSachGoc
        .Where(x => 
            (string.IsNullOrWhiteSpace(searchText) ||
             x.TenDoGa.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             (x.SanPhamSuDung != null && x.SanPhamSuDung.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
             (x.BuLong != null && x.BuLong.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
             (x.Kep != null && x.Kep.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
             (x.NguoiMuonHienTai != null && x.NguoiMuonHienTai.Contains(searchText, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(filterTrangThai) || x.TrangThai == filterTrangThai)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        DanhSachGoc = await DoGaSvc.GetAllActiveAsync();
        isLoading = false;
    }

    private void MoPopupView(DoGa item)
    {
        itemDangXem = item;
        isHienThiPopupView = true;
    }
    private void DongPopupView() { isHienThiPopupView = false; }

    private void MoPopupMuon(DoGa item)
    {
        itemDangMuonTra = item;
        nguoiMuonInput = "";
        ngayMuonInput = DateTime.Now;
        ngayTraDuKienInput = DateTime.Now.AddDays(1);
        lyDoMuonInput = "";
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupMuon = true;
    }
    private void DongPopupMuon() { isHienThiPopupMuon = false; }

    private async Task XacNhanMuonAsync()
    {
        if (itemDangMuonTra == null) return;
        isProcessing = true;
        loiPopup = "";

        var result = await DoGaSvc.MuonDoGaAsync(
            itemDangMuonTra.DoGaId, 
            nguoiMuonInput, 
            ngayMuonInput, 
            ngayTraDuKienInput, 
            lyDoMuonInput, 
            currentUserId, 
            pinXacNhan);

        if (result.Success)
        {
            DongPopupMuon();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi ghi nhận mượn đồ gá.";
        }
        isProcessing = false;
    }

    private void MoPopupTra(DoGa item)
    {
        itemDangMuonTra = item;
        ghiChuTraInput = "";
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupTra = true;
    }
    private void DongPopupTra() { isHienThiPopupTra = false; }

    private async Task XacNhanTraAsync()
    {
        if (itemDangMuonTra == null) return;
        isProcessing = true;
        loiPopup = "";

        var result = await DoGaSvc.TraDoGaAsync(itemDangMuonTra.DoGaId, ghiChuTraInput, currentUserId, pinXacNhan);
        if (result.Success)
        {
            DongPopupTra();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi xác nhận trả đồ gá.";
        }
        isProcessing = false;
    }

    private void MoPopupThem()
    {
        itemDangSua = new DoGa { SoLuong = "1", TrangThai = "Sẵn sàng" };
        isThemMoi = true;
        pinXacNhan = "";
        lyDoSua = "";
        loiPopup = "";
        isHienThiPopupSua = true;
    }

    private void MoPopupSua(DoGa item)
    {
        itemDangSua = new DoGa
        {
            DoGaId = item.DoGaId,
            TenDoGa = item.TenDoGa,
            SoLuong = item.SoLuong,
            BuLong = item.BuLong,
            BuLongDinhVi = item.BuLongDinhVi,
            Chot = item.Chot,
            Dem = item.Dem,
            Kep = item.Kep,
            LongDen = item.LongDen,
            SanPhamSuDung = item.SanPhamSuDung,
            GhiChu = item.GhiChu,
            TrangThai = item.TrangThai
        };
        isThemMoi = false;
        pinXacNhan = "";
        lyDoSua = "";
        loiPopup = "";
        isHienThiPopupSua = true;
    }
    private void DongPopupSua() { isHienThiPopupSua = false; itemDangSua = null; }

    private async Task LuuThongTinDoGaAsync()
    {
        if (itemDangSua == null) return;
        isProcessing = true;
        loiPopup = "";

        if (isThemMoi)
        {
            var result = await DoGaSvc.CreateAsync(itemDangSua, currentUserId, pinXacNhan);
            if (result.Success)
            {
                DongPopupSua();
                await LoadDataAsync();
            }
            else
            {
                loiPopup = result.Error ?? "Lỗi thêm đồ gá mới.";
            }
        }
        else
        {
            var result = await DoGaSvc.UpdateAsync(itemDangSua, lyDoSua, currentUserId, pinXacNhan);
            if (result.Success)
            {
                DongPopupSua();
                await LoadDataAsync();
            }
            else
            {
                loiPopup = result.Error ?? "Lỗi cập nhật đồ gá.";
            }
        }
        isProcessing = false;
    }

    private void MoPopupXoa(DoGa item)
    {
        itemCanXoa = item;
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupXoa = true;
    }
    private void DongPopupXoa() { isHienThiPopupXoa = false; itemCanXoa = null; }

    private async Task XacNhanXoaAsync()
    {
        if (itemCanXoa == null) return;
        isProcessing = true;
        loiPopup = "";

        var result = await DoGaSvc.SoftDeleteAsync(itemCanXoa.DoGaId, currentUserId, pinXacNhan);
        if (result.Success)
        {
            DongPopupXoa();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi xóa đồ gá.";
        }
        isProcessing = false;
    }

    private async Task MoPopupLichSu(DoGa item)
    {
        itemDangXem = item;
        tabLichSuActive = 1;
        isHienThiPopupLichSu = true;
        isLoadingLogs = true;
        danhSachMuonTraLog = await DoGaSvc.GetMuonTraLogsAsync(item.DoGaId);
        danhSachChangeLog = await DoGaSvc.GetChangeLogsAsync(item.DoGaId);
        isLoadingLogs = false;
    }
    private void DongPopupLichSu() { isHienThiPopupLichSu = false; }

    private async Task XuatExcelAsync()
    {
        try
        {
            isExporting = true;
            var fileBytes = await DoGaSvc.ExportExcelAsync(DanhSachHienThi);
            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = $"TheoDoiDoGa_NhatPhat_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const a = document.createElement('a');
                    a.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi khi xuất file Excel: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }
}