@page "/dao"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject DaoService DaoSvc
@inject AuthenticationStateProvider AuthState

<PageTitle>Quản lý Dao cụ - MES</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Danh mục Dao cụ</h1>
        <p class="text-muted small mb-0">Mỗi dòng = 1 Dao cụ. Cột Ký hiệu dao là khóa tham chiếu chuẩn Master Data.</p>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg"></i> Thêm dao mới
        </button>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Tìm theo Ký hiệu dao / Loại dao / Thông số quy cách..."
                   @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button class="btn btn-outline-secondary" @onclick="() => _search = string.Empty">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="_selectedLoaiDao">
            <option value="">-- Tất cả Loại dao --</option>
            @foreach (var l in _loaiDaoList)
            {
                <option value="@l">@l</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
        <div class="form-check form-switch small mb-0">
            <input class="form-check-input" type="checkbox" id="chkShowAll" @bind="_showInactive" @bind:after="async () => await LoadDataAsync()" />
            <label class="form-check-label text-muted" for="chkShowAll">Hiện cả dao đã xóa</label>
        </div>
        <small class="text-muted">Hiển thị <strong>@Filtered.Count()</strong> / @_daos.Count Dao</small>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span> Đang tải danh sách dao...</div>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded border">
        <table class="table table-bordered table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light">
                <tr class="text-center">
                    <th style="width: 45px;">#</th>
                    <th style="width: 130px;">Phân loại</th>
                    <th style="width: 240px;">Ký hiệu dao (Cột B) *</th>
                    <th class="text-start">Thông số / Quy cách (Cột C)</th>
                    <th style="width: 120px;">Hãng SX</th>
                    <th style="width: 100px;">Vị trí tủ</th>
                    <th style="width: 70px;">SL tồn</th>
                    <th style="width: 110px;">Trạng thái</th>
                    <th style="width: 110px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Filtered.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <em>Không tìm thấy dao cụ nào phù hợp.</em>
                        </td>
                    </tr>
                }
                @foreach (var (item, idx) in Filtered.Select((d, i) => (d, i)))
                {
                    <tr class="@(!item.IsActive ? "table-secondary text-muted text-decoration-line-through" : "")">
                        <td class="text-center text-muted">@(idx + 1)</td>
                        <td class="text-center">@(string.IsNullOrEmpty(item.LoaiDao) ? "—" : item.LoaiDao)</td>
                        <td class="text-start font-monospace"><strong class="text-danger">@item.TenDao</strong></td>
                        <td class="text-start">@(string.IsNullOrEmpty(item.QuyCach) ? "—" : item.QuyCach)</td>
                        <td class="text-center">@(string.IsNullOrEmpty(item.HangSX) ? "—" : item.HangSX)</td>
                        <td class="text-center font-monospace">@(string.IsNullOrEmpty(item.ViTriKho) ? "—" : item.ViTriKho)</td>
                        <td class="text-center fw-bold">@(item.SoLuongTon?.ToString() ?? "0")</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng dùng</span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Chỉnh sửa"
                                    @onclick="() => OpenEditModal(item)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Lịch sử thay đổi"
                                    @onclick="async () => await OpenHistoryModal(item)">
                                <i class="bi bi-clock-history"></i>
                            </button>
                            @if (item.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Ngừng dùng / Xóa"
                                        @onclick="async () => await ToggleDelete(item, false)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success py-0 px-2" title="Khôi phục hoạt động"
                                        @onclick="async () => await ToggleDelete(item, true)">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ==================== MODAL THÊM / SỬA DAO ==================== *@
@if (_showEditModal && _editingModel != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow border-0">
                <div class="modal-header @(_editingModel.DaoId == 0 ? "bg-primary" : "bg-dark") text-white py-2">
                    <h6 class="modal-title mb-0">
                        <i class="bi bi-tools"></i>
                        @(_editingModel.DaoId == 0 ? "Thêm dao cụ mới" : $"Chỉnh sửa: {_editingModel.TenDao}")
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showEditModal = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Phân loại dao <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" list="loai-dao-list" @bind="_editingModel.LoaiDao" placeholder="Chọn hoặc nhập loại dao..." />
                            <datalist id="loai-dao-list">
                                <option value="Khoan" />
                                <option value="Center" />
                                <option value="Chíp Phay" />
                                <option value="Chíp Tiện" />
                                <option value="Mũi Tap" />
                                <option value="Dao Phay" />
                                <option value="Dao bo tròn" />
                                <option value="Doa" />
                                <option value="CHAMFER" />
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ký hiệu dao (Cột B - Dùng cho Part Master) <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm font-monospace fw-bold" @bind="_editingModel.TenDao" placeholder="VD: DRI-CB-D4.2Lc30, END-CB-SU-4F..." />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Thông số / Quy cách chi tiết (Cột C)</label>
                            <input class="form-control form-control-sm" @bind="_editingModel.QuyCach" placeholder="VD: DRILL 4.2 HỢP KIM PAC, DAO PHAY D6*4F*d6*50L..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Hãng sản xuất</label>
                            <input class="form-control form-control-sm" @bind="_editingModel.HangSX" placeholder="VD: NACHI, OSG, YAMAWA, JAWA..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Vị trí tủ dao / Ngăn</label>
                            <input class="form-control form-control-sm" @bind="_editingModel.ViTriKho" placeholder="VD: Tủ A1-01, Kệ B2..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Số lượng tồn kho</label>
                            <input type="number" min="0" class="form-control form-control-sm text-end" @bind="_editingModel.SoLuongTon" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Ghi chú</label>
                            <input class="form-control form-control-sm" @bind="_editingModel.GhiChu" placeholder="Ghi chú điều kiện cắt, vật liệu gia công..." />
                        </div>

                        @if (_editingModel.DaoId > 0)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-bold text-danger">Lý do thay đổi <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm border-danger" @bind="_editReason" placeholder="Nhập tóm tắt lý do chỉnh sửa Master Data..." />
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-0 mt-3">
                            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showEditModal = false">Hủy</button>
                    <button type="button" class="btn btn-sm btn-primary px-3 fw-bold" @onclick="async () => await SaveDaoAsync()" disabled="@_saving">
                        <i class="bi bi-check-lg"></i> @(_saving ? "Đang lưu..." : "Lưu thông tin dao")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==================== MODAL LỊCH SỬ AUDIT TRAIL ==================== *@
@if (_showHistoryModal && _selectedDao != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-light py-2 border-bottom">
                    <h6 class="modal-title mb-0 text-dark fw-bold">
                        <i class="bi bi-clock-history text-secondary me-1"></i>
                        Lịch sử sửa — <span class="text-primary">@_selectedDao.TenDao</span>
                    </h6>
                    <button type="button" class="btn-close" @onclick="() => _showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_historyLoading)
                    {
                        <div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm"></span> Đang tải lịch sử...</div>
                    }
                    else if (!_historyLogs.Any())
                    {
                        <div class="text-center py-4 text-muted"><em>Chưa có nhật ký thay đổi nào cho dao này.</em></div>
                    }
                    else
                    {
                        <div class="table-responsive mb-0">
                            <table class="table table-sm table-hover table-bordered align-middle mb-0" style="font-size: 0.8rem;">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 130px;">Thời gian</th>
                                        <th style="width: 130px;">Trường (Field)</th>
                                        <th>Giá trị cũ</th>
                                        <th>Giá trị mới</th>
                                        <th style="width: 140px;">Người sửa</th>
                                        <th>Lý do</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in _historyLogs)
                                    {
                                        <tr>
                                            <td>@log.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><code class="text-secondary">@log.FieldName</code></td>
                                            <td class="text-danger">@log.OldValue</td>
                                            <td class="text-success fw-bold">@log.NewValue</td>
                                            <td><i class="bi bi-person-circle text-muted me-1"></i>@log.ChangedByName</td>
                                            <td class="text-muted fst-italic">@log.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showHistoryModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving = false;
    private int _currentUserId;
    private List<Dao> _daos = new();
    private List<string> _loaiDaoList = new();
    private string _search = string.Empty;
    private string _selectedLoaiDao = string.Empty;
    private bool _showInactive = false;

    private bool _showEditModal = false;
    private Dao? _editingModel;
    private string _editReason = string.Empty;
    private string? _errorMessage;

    private bool _showHistoryModal = false;
    private bool _historyLoading = false;
    private Dao? _selectedDao;
    private List<DaoChangeLogItem> _historyLogs = new();

    private IEnumerable<Dao> Filtered
    {
        get
        {
            var query = _daos.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_selectedLoaiDao))
            {
                query = query.Where(d => d.LoaiDao == _selectedLoaiDao);
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(d =>
                    d.TenDao.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (d.LoaiDao?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.QuyCach?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.HangSX?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.ViTriKho?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uidStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(uidStr, out _currentUserId);

        await LoadDataAsync();
        _loading = false;
    }

    private async Task LoadDataAsync()
    {
        _daos = await DaoSvc.GetAllAsync(_showInactive);
        _loaiDaoList = await DaoSvc.GetDistinctLoaiDaoAsync();
    }

    private void OpenCreateModal()
    {
        _editingModel = new Dao { IsActive = true, SoLuongTon = 0 };
        _editReason = string.Empty;
        _errorMessage = null;
        _showEditModal = true;
    }

    private void OpenEditModal(Dao item)
    {
        _editingModel = new Dao
        {
            DaoId = item.DaoId,
            MaDao = item.MaDao,
            TenDao = item.TenDao,
            LoaiDao = item.LoaiDao,
            QuyCach = item.QuyCach,
            HangSX = item.HangSX,
            VatLieuDao = item.VatLieuDao,
            ViTriKho = item.ViTriKho,
            SoLuongTon = item.SoLuongTon,
            GhiChu = item.GhiChu,
            IsActive = item.IsActive
        };
        _editReason = string.Empty;
        _errorMessage = null;
        _showEditModal = true;
    }

    private async Task SaveDaoAsync()
    {
        _errorMessage = null;
        if (_editingModel == null) return;

        if (string.IsNullOrWhiteSpace(_editingModel.TenDao))
        {
            _errorMessage = "Ký hiệu dao là bắt buộc.";
            return;
        }

        if (_editingModel.DaoId > 0 && (string.IsNullOrWhiteSpace(_editReason) || _editReason.Trim().Length < 3))
        {
            _errorMessage = "Vui lòng nhập lý do chỉnh sửa (tối thiểu 3 ký tự).";
            return;
        }

        _editingModel.MaDao = _editingModel.TenDao.Trim();

        _saving = true;
        try
        {
            if (_editingModel.DaoId == 0)
            {
                var (ok, err, _) = await DaoSvc.CreateAsync(_editingModel, _currentUserId);
                if (!ok) { _errorMessage = err; return; }
            }
            else
            {
                var (ok, err) = await DaoSvc.UpdateAsync(_editingModel, _editReason, _currentUserId);
                if (!ok) { _errorMessage = err; return; }
            }

            _showEditModal = false;
            await LoadDataAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleDelete(Dao item, bool activate)
    {
        await DaoSvc.ToggleActiveAsync(item.DaoId, activate, activate ? "Khôi phục sử dụng" : "Ngừng sử dụng dao", _currentUserId);
        await LoadDataAsync();
    }

    private async Task OpenHistoryModal(Dao item)
    {
        _selectedDao = item;
        _showHistoryModal = true;
        _historyLoading = true;
        _historyLogs = await DaoSvc.GetChangeLogsAsync(item.DaoId);
        _historyLoading = false;
    }
}