@page "/so-do-to-chuc"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Data.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticationStateProvider AuthState
@inject MES.Web.Services.DepartmentService DeptSvc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>Sơ đồ tổ chức - MES</PageTitle>

<div class="container-fluid pt-3 pb-5" @onclick="DongContextMenu">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 style="font-weight: bold; color: #1e293b;">Sơ đồ tổ chức</h2>
            <p class="text-muted mb-0">
                Cơ cấu phòng ban & tổ nhóm. <b>Click ảnh</b> để phóng to, <b>Click khối</b> để sửa, <b>Chuột phải</b> để thêm nhánh.
            </p>
        </div>
        <div class="d-flex gap-2">
            <!-- NÚT XUẤT EXCEL -->
            <button type="button" class="btn btn-outline-success btn-sm" @onclick="XuatExcelAsync" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Đang xuất...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    <span>Xuất Excel</span>
                }
            </button>

            <!-- Nút Thêm vị trí mới -->
            <button type="button" class="btn btn-success btn-sm" @onclick="() => MoPopupThemTuDo()">
                <i class="bi bi-plus-lg"></i> Thêm vị trí mới
            </button>

            <!-- Nhóm nút chuyển chế độ xem -->
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm @(isVisualView ? "btn-primary" : "btn-outline-primary")" @onclick="() => isVisualView = true">
                    <i class="bi bi-diagram-3"></i> Sơ đồ khối
                </button>
                <button type="button" class="btn btn-sm @(!isVisualView ? "btn-primary" : "btn-outline-primary")" @onclick="() => isVisualView = false">
                    <i class="bi bi-list-ul"></i> Dạng danh sách
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(thongBaoLoi))
    {
        <div class="alert alert-danger py-2 small">
            <i class="bi bi-exclamation-triangle"></i> @thongBaoLoi
            <button type="button" class="btn-close float-end" @onclick="() => thongBaoLoi = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Đang tải sơ đồ tổ chức...</div>
        </div>
    }
    else if (isVisualView)
    {
        <!-- SƠ ĐỒ KHỐI TRỰC QUAN -->
        <div class="org-chart-scroll-wrapper shadow-sm bg-white rounded border p-4">
            <div class="org-chart-canvas">
                
                <!-- TẦNG 1: BAN GIÁM ĐỐC -->
                @{ var rootNodes = DanhSachDept.Where(d => d.ParentId == null || d.Level == 1).ToList(); }
                <div class="d-flex justify-content-center gap-3">
                    @foreach (var r in rootNodes)
                    {
                        @RenderOrgNode(r, "org-node-gd")
                    }
                </div>

                <div class="tree-line-v"></div>

                <!-- TẦNG 2: KHỐI PHÒNG BAN CHỨC NĂNG -->
                @{ var level2Nodes = DanhSachDept.Where(d => d.Level == 2).ToList(); }
                <div class="d-flex justify-content-center align-items-start gap-4 mb-2">
                    @foreach (var l2 in level2Nodes)
                    {
                        <div>
                            @RenderOrgNode(l2, l2.DepartmentCode == "PHONG_SX" ? "org-node-sx" : "")
                        </div>
                    }
                </div>

                <div class="tree-line-v"></div>

                <!-- TẦNG 3, 4, 5: CƠ CẤU PHÒNG SẢN XUẤT -->
                @{ var level3Branches = DanhSachDept.Where(d => d.ParentId == 3).ToList(); }
                <div class="d-flex justify-content-center align-items-start gap-3">
                    @foreach (var pp in level3Branches)
                    {
                        <div class="branch-box p-3 rounded border">
                            <div class="d-flex justify-content-center mb-3">
                                @RenderOrgNode(pp, "org-node-pp")
                            </div>

                            @{ var bpList = GetChildren(pp.DepartmentId); }
                            <div class="d-flex align-items-start gap-2">
                                @foreach (var bp in bpList)
                                {
                                    <div class="col-stack">
                                        @RenderOrgNode(bp)

                                        @{ var nhomList = GetChildren(bp.DepartmentId); }
                                        @if (nhomList.Any())
                                        {
                                            <div class="sub-stack mt-2">
                                                @foreach (var nhom in nhomList)
                                                {
                                                    <div class="mb-2">
                                                        @RenderOrgNode(nhom, "org-node-group")
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <button class="btn btn-sm btn-outline-dashed mt-1" 
                                                title="Thêm nhóm/nhân viên trực thuộc @bp.DepartmentName"
                                                @onclick="() => MoPopupThemNhanh(bp, isChild: true)">
                                            <i class="bi bi-plus"></i> Thêm dưới
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    }
    else
    {
        <!-- CHẾ ĐỘ BẢNG DANH SÁCH -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0 align-middle">
                        <thead style="background-color: #f8fafc;">
                            <tr>
                                <th style="width: 50px;" class="text-center">ID</th>
                                <th style="width: 60px;" class="text-center">Ảnh</th>
                                <th style="width: 130px;">Mã</th>
                                <th>Tên Phòng ban / Bộ phận / Nhóm</th>
                                <th>Chức vụ</th>
                                <th style="color: #dc2626;">Người phụ trách</th>
                                <th>Cấp trên trực tiếp</th>
                                <th class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in DanhSachDept)
                            {
                                var parent = DanhSachDept.FirstOrDefault(p => p.DepartmentId == d.ParentId);
                                <tr>
                                    <td class="text-center">@d.DepartmentId</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(d.AvatarUrl))
                                        {
                                            <img src="@d.AvatarUrl" class="table-avatar" alt="Avatar" @onclick="() => MoXemAnhLon(d)" title="Click để phóng to ảnh" />
                                        }
                                        else
                                        {
                                            <div class="table-avatar-placeholder"><i class="bi bi-person"></i></div>
                                        }
                                    </td>
                                    <td class="font-monospace small">@d.DepartmentCode</td>
                                    <td>
                                        <span style="margin-left: @((d.Level - 1) * 20)px;">
                                            @if (d.Level > 1) { <i class="bi bi-arrow-return-right text-muted me-1"></i> }
                                            <b>@d.DepartmentName</b>
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@d.RoleTitle</span></td>
                                    <td class="fw-bold text-danger">@(string.IsNullOrEmpty(d.ManagerName) ? "(Chưa phân công)" : d.ManagerName)</td>
                                    <td class="small text-muted">@(parent != null ? parent.DepartmentName : "(Gốc)")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Sửa" @onclick="() => MoPopupSua(d)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Lịch sử" @onclick="() => MoPopupLichSu(d)">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa" @onclick="() => MoPopupXoa(d)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Render 1 Node Khối Sơ Đồ -->
@code {
    RenderFragment RenderOrgNode(Department dept, string customClass = "") => __builder =>
    {
        <div class="org-node @customClass" 
             @onclick="() => MoPopupSua(dept)" 
             @oncontextmenu="(e) => MoContextMenu(e, dept)" 
             @oncontextmenu:preventDefault="true"
             title="Click vào khối để sửa | Click vào ảnh để phóng to | Click phải để thêm nhánh">
            <div class="org-node-header">
                <div class="org-title">@dept.DepartmentName</div>
                @if (!string.IsNullOrEmpty(dept.RoleTitle))
                {
                    <div class="org-role">@dept.RoleTitle</div>
                }
            </div>
            <div class="org-node-body">
                @if (!string.IsNullOrEmpty(dept.ManagerName))
                {
                    <div class="org-manager">@dept.ManagerName</div>
                    <div class="org-avatar-container" 
                         @onclick:stopPropagation="true" 
                         @onclick="() => MoXemAnhLon(dept)">
                        @if (!string.IsNullOrEmpty(dept.AvatarUrl))
                        {
                            <img src="@dept.AvatarUrl" alt="Avatar" class="org-avatar-img" title="Click để xem ảnh lớn" />
                        }
                        else
                        {
                            <div class="org-avatar-placeholder" title="Chưa có ảnh (Click khối để thêm ảnh)">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="org-manager text-muted fst-italic" style="font-size: 0.72rem;">(Chưa phân công)</div>
                    <div class="org-avatar-container">
                        <div class="org-avatar-placeholder opacity-50">
                            <i class="bi bi-person-dash"></i>
                        </div>
                    </div>
                }
            </div>
        </div>
    };
}

<!-- MODAL PHÓNG TO ẢNH (LIGHTBOX PREVIEW) -->
@if (isHienThiXemAnhLon && deptXemAnh != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px);" tabindex="-1" @onclick="DongXemAnhLon">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-person-bounding-box me-1"></i> Thông tin nhân sự: @deptXemAnh.ManagerName
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="DongXemAnhLon"></button>
                </div>
                <div class="modal-body text-center p-4 bg-white">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(deptXemAnh.AvatarUrl))
                        {
                            <img src="@deptXemAnh.AvatarUrl" alt="Ảnh lớn" class="lightbox-big-img" />
                        }
                        else
                        {
                            <div class="lightbox-no-img">
                                <i class="bi bi-person-fill" style="font-size: 5rem; color: #94a3b8;"></i>
                                <div class="text-muted small mt-2">Vị trí này chưa có ảnh đại diện</div>
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-danger mb-1">@deptXemAnh.ManagerName</h5>
                    <div class="text-primary fw-bold small mb-1">@deptXemAnh.RoleTitle</div>
                    <div class="text-muted small">Đơn vị: <b>@deptXemAnh.DepartmentName</b> (@deptXemAnh.DepartmentCode)</div>
                </div>
                <div class="modal-footer bg-light py-2 justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => { DongXemAnhLon(); MoPopupSua(deptXemAnh); }">
                        <i class="bi bi-pencil-square"></i> Đổi ảnh / Cập nhật
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongXemAnhLon">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CONTEXT MENU (CHUỘT PHẢI) -->
@if (isContextMenuOpen && contextDept != null)
{
    <div class="custom-context-menu shadow" style="top: @(contextMenuY)px; left: @(contextMenuX)px;" @onclick:stopPropagation="true">
        <div class="context-header px-3 py-2 bg-light border-bottom">
            <div class="fw-bold small text-primary text-truncate">@contextDept.DepartmentName</div>
            <div class="text-muted" style="font-size: 0.75rem;">@contextDept.RoleTitle: @contextDept.ManagerName</div>
        </div>
        @if (!string.IsNullOrEmpty(contextDept.AvatarUrl))
        {
            <button class="context-item text-dark" @onclick="() => { DongContextMenu(); MoXemAnhLon(contextDept); }">
                <i class="bi bi-arrows-fullscreen me-2 text-info"></i> <b>Xem ảnh phóng to</b>
            </button>
            <hr class="my-1" />
        }
        <button class="context-item text-success" @onclick="() => { DongContextMenu(); MoPopupThemNhanh(contextDept, isChild: true); }">
            <i class="bi bi-arrow-down-square-fill me-2"></i> <b>Tạo nhánh dưới mới</b>
        </button>
        <button class="context-item text-primary" @onclick="() => { DongContextMenu(); MoPopupThemNhanh(contextDept, isChild: false); }">
            <i class="bi bi-arrow-right-square-fill me-2"></i> <b>Tạo nhánh ngang mới</b>
        </button>
        <hr class="my-1" />
        <button class="context-item" @onclick="() => { DongContextMenu(); MoPopupSua(contextDept); }">
            <i class="bi bi-pencil-square me-2 text-primary"></i> Sửa thông tin / Đổi ảnh & nhân sự
        </button>
        <button class="context-item" @onclick="() => { DongContextMenu(); MoPopupLichSu(contextDept); }">
            <i class="bi bi-clock-history me-2 text-secondary"></i> Xem lịch sử điều động
        </button>
        <button class="context-item text-danger" @onclick="() => { DongContextMenu(); MoPopupXoa(contextDept); }">
            <i class="bi bi-trash me-2"></i> Xóa vị trí này
        </button>
    </div>
}

<!-- Modal 1: Thêm vị trí mới -->
@if (isHienThiPopupThem)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-plus-circle"></i> Thêm vị trí / bộ phận mới</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupThem"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Thuộc cấp trên</label>
                        <select class="form-select form-select-sm" @bind="deptMoi.ParentId">
                            <option value="">-- Không có (Cấp cao nhất) --</option>
                            @foreach (var d in DanhSachDept)
                            {
                                <option value="@d.DepartmentId">@d.DepartmentName (@d.DepartmentCode)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-5">
                            <label class="form-label small fw-bold mb-1">Mã vị trí <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm text-uppercase" autocomplete="off" @bind="deptMoi.DepartmentCode" placeholder="VD: NHOM_PHAY_5..." />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold mb-1">Tên vị trí / nhóm <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="deptMoi.DepartmentName" placeholder="VD: NHÓM PHAY 5..." />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Chức danh</label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="deptMoi.RoleTitle" placeholder="VD: Trưởng nhóm, Nhân viên..." />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Người phụ trách (Mã NV & Họ tên) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="deptMoi.ManagerName" placeholder="VD: 199 Nguyễn Văn A..." />
                    </div>

                    <div class="mb-3 p-2 bg-light rounded border">
                        <label class="form-label small fw-bold mb-1 d-block"><i class="bi bi-camera"></i> Ảnh đại diện nhân viên</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(deptMoi.AvatarUrl))
                            {
                                <img src="@deptMoi.AvatarUrl" class="upload-preview-img" alt="Preview" />
                            }
                            else
                            {
                                <div class="upload-preview-placeholder"><i class="bi bi-image"></i></div>
                            }
                            <div class="flex-grow-1">
                                <InputFile OnChange="@(e => XuLyTaiAnh(e, isEdit: false))" accept="image/*" class="form-control form-control-sm" />
                                <div class="text-muted" style="font-size: 0.72rem;">Định dạng: JPG, PNG (tối đa 5MB)</div>
                            </div>
                        </div>
                    </div>

                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px;">
                        <label class="form-label text-danger fw-bold small mb-1"><i class="bi bi-shield-lock"></i> Nhập PIN xác nhận *</label>
                        <input type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN của bạn..." />
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupThem" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-success" @onclick="LuuThemDeptAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang lưu..." : "Lưu vị trí mới")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Sửa vị trí -->
@if (isHienThiPopupSua && deptDangSua != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-pencil-square"></i> Điều chỉnh vị trí: @deptDangSua.DepartmentName
                    </h5>
                    <button type="button" class="btn-close" @onclick="DongPopupSua"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Thuộc cấp trên</label>
                        <select class="form-select form-select-sm" @bind="deptDangSua.ParentId">
                            <option value="">-- Không có (Cấp cao nhất) --</option>
                            @foreach (var d in DanhSachDept.Where(x => x.DepartmentId != deptDangSua.DepartmentId))
                            {
                                <option value="@d.DepartmentId">@d.DepartmentName (@d.DepartmentCode)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-5">
                            <label class="form-label small fw-bold mb-1">Mã đơn vị</label>
                            <input type="text" class="form-control form-control-sm text-uppercase" @bind="deptDangSua.DepartmentCode" />
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-bold mb-1">Tên đơn vị / nhóm</label>
                            <input type="text" class="form-control form-control-sm" @bind="deptDangSua.DepartmentName" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Chức danh</label>
                        <input type="text" class="form-control form-control-sm" @bind="deptDangSua.RoleTitle" placeholder="VD: Trưởng phòng, Trưởng nhóm..." />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">
                            Người phụ trách (Mã NV & Họ tên)
                            @if (deptDangSua.ManagerName?.Trim() != tenGocLucMoPopup)
                            {
                                <span class="badge bg-warning text-dark ms-1">Đã đổi người $\rightarrow$ Bắt buộc tải ảnh mới</span>
                            }
                        </label>
                        <input type="text" class="form-control form-control-sm" @bind="deptDangSua.ManagerName" placeholder="VD: 016 Đỗ Văn Phúc..." />
                    </div>

                    <div class="mb-3 p-2 bg-light rounded border">
                        <label class="form-label small fw-bold mb-1 d-block"><i class="bi bi-camera"></i> Ảnh đại diện nhân viên</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(deptDangSua.AvatarUrl))
                            {
                                <img src="@deptDangSua.AvatarUrl" class="upload-preview-img" alt="Preview" />
                            }
                            else
                            {
                                <div class="upload-preview-placeholder"><i class="bi bi-image"></i></div>
                            }
                            <div class="flex-grow-1">
                                <InputFile OnChange="@(e => XuLyTaiAnh(e, isEdit: true))" accept="image/*" class="form-control form-control-sm" />
                                <div class="text-muted" style="font-size: 0.72rem;">Tải ảnh chân dung mới để cập nhật</div>
                            </div>
                        </div>
                    </div>
                    
                    <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px;">
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">Lý do điều động / thay đổi</label>
                            <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="lyDoSua" placeholder="VD: Bổ nhiệm mới / Thay ảnh nhân sự..." />
                        </div>
                        <div>
                            <label class="form-label text-danger fw-bold small mb-1"><i class="bi bi-shield-lock"></i> Nhập PIN xác nhận *</label>
                            <input type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="pinXacNhan" placeholder="Nhập PIN của bạn..." />
                        </div>
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-danger me-auto" @onclick="() => { DongPopupSua(); MoPopupXoa(deptDangSua); }">
                        <i class="bi bi-trash"></i> Xóa vị trí
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => { DongPopupSua(); MoPopupLichSu(deptDangSua); }">
                        <i class="bi bi-clock-history"></i> Lịch sử
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupSua" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="LuuSuaDeptAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang lưu..." : "Lưu thay đổi")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 3: Xác nhận xóa -->
@if (isHienThiPopupXoa && deptCanXoa != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash3"></i> Xác nhận xóa vị trí</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupXoa"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3 small">
                        <i class="bi bi-info-circle"></i> Bạn có chắc chắn muốn xóa vị trí <b>@deptCanXoa.DepartmentName</b> khỏi sơ đồ tổ chức?
                    </div>
                    <div style="border: 1px solid #dc3545; border-radius: 6px; padding: 15px;">
                        <label class="form-label text-danger fw-bold small mb-2">
                            <i class="bi bi-shield-lock"></i> Nhập PIN của bạn *
                        </label>
                        <input type="password" 
                               class="form-control" 
                               autocomplete="new-password"
                               @bind="pinXacNhan" 
                               placeholder="Nhập PIN để xác nhận xóa..." 
                               disabled="@isProcessing" />
                        @if (!string.IsNullOrEmpty(loiPopup))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.85rem;">@loiPopup</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="DongPopupXoa" disabled="@isProcessing">Hủy</button>
                    <button type="button" class="btn btn-danger" @onclick="XacNhanXoaDeptAsync" disabled="@isProcessing">
                        @(isProcessing ? "Đang kiểm tra..." : "Xác nhận xóa")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 4: Lịch sử -->
@if (isHienThiPopupLichSu && deptDangXem != null)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 850px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-clock-history text-secondary"></i> Lịch sử điều động: @deptDangXem.DepartmentName</h5>
                    <button type="button" class="btn-close" @onclick="DongPopupLichSu"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingLogs)
                    {
                        <div class="text-center py-4">Đang tải lịch sử...</div>
                    }
                    else if (danhSachLog.Any())
                    {
                        <table class="table table-sm table-bordered table-hover mb-0">
                            <thead style="background-color: #f1f5f9;">
                                <tr>
                                    <th style="width: 140px;">Thời gian</th>
                                    <th style="width: 100px;">Người thực hiện</th>
                                    <th>Thông tin thay đổi</th>
                                    <th>Nhân sự cũ</th>
                                    <th>Nhân sự mới</th>
                                    <th>Lý do</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in danhSachLog)
                                {
                                    <tr>
                                        <td class="small align-middle">@log.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td class="small align-middle fw-bold">@(log.ChangedByUser?.Username ?? "System")</td>
                                        <td class="small align-middle"><span class="badge bg-light text-dark border">@log.FieldName</span></td>
                                        <td class="small align-middle text-muted">@log.OldValue</td>
                                        <td class="small align-middle text-primary fw-bold">@log.NewValue</td>
                                        <td class="small align-middle text-secondary">@log.Reason</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">Chưa có lịch sử thay đổi nào cho vị trí này.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="DongPopupLichSu">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

