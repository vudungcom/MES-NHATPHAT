@code {
    private bool isLoading = true;
    private bool isVisualView = true;
    private bool isProcessing = false;
    private bool isExporting = false;
    private bool isLoadingLogs = false;
    private int currentUserId;

    private List<Department> DanhSachDept = new List<Department>();
    private List<DepartmentChangeLog> danhSachLog = new List<DepartmentChangeLog>();

    // Context Menu
    private bool isContextMenuOpen = false;
    private double contextMenuX = 0;
    private double contextMenuY = 0;
    private Department? contextDept = null;

    // Popups
    private Department? deptDangSua = null;
    private Department? deptDangXem = null;
    private Department? deptCanXoa = null;
    private Department deptMoi = new Department();

    private bool isHienThiPopupThem = false;
    private bool isHienThiPopupSua = false;
    private bool isHienThiPopupLichSu = false;
    private bool isHienThiPopupXoa = false;

    // Xem ảnh lớn (Lightbox)
    private bool isHienThiXemAnhLon = false;
    private Department? deptXemAnh = null;

    private string pinXacNhan = "";
    private string lyDoSua = "";
    private string loiPopup = "";
    private string thongBaoLoi = "";

    private string tenGocLucMoPopup = "";
    private bool isNewAvatarUploaded = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        DanhSachDept = await DeptSvc.GetAllActiveAsync();
        isLoading = false;
    }

    private List<Department> GetChildren(int parentId) => 
        DanhSachDept.Where(d => d.ParentId == parentId).OrderBy(d => d.DisplayOrder).ToList();

    // Xuất Excel
    private async Task XuatExcelAsync()
    {
        try
        {
            isExporting = true;
            var fileBytes = await DeptSvc.ExportExcelAsync();
            var base64 = Convert.ToBase64String(fileBytes);
            var fileName = $"SoDoToChuc_NhatPhat_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const a = document.createElement('a');
                    a.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi khi xuất file Excel: " + ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }

    // Mở Lightbox xem ảnh lớn
    private void MoXemAnhLon(Department dept)
    {
        deptXemAnh = dept;
        isHienThiXemAnhLon = true;
    }
    private void DongXemAnhLon() { isHienThiXemAnhLon = false; deptXemAnh = null; }

    // Context Menu
    private void MoContextMenu(MouseEventArgs e, Department dept)
    {
        contextDept = dept;
        contextMenuX = e.ClientX;
        contextMenuY = e.ClientY;
        isContextMenuOpen = true;
    }
    private void DongContextMenu() { isContextMenuOpen = false; }

    // Upload Avatar
    private async Task XuLyTaiAnh(InputFileChangeEventArgs e, bool isEdit)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            loiPopup = "Kích thước ảnh vượt quá 5MB!";
            return;
        }

        try
        {
            var folderPath = Path.Combine(Env.WebRootPath ?? "wwwroot", "uploads", "avatars");
            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }

            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext)) ext = ".jpg";

            var randomCode = Guid.NewGuid().ToString("N").Substring(0, 8);
            var fileName = $"nv_{DateTime.Now:yyyyMMddHHmmss}_{randomCode}{ext}";
            var fullPath = Path.Combine(folderPath, fileName);

            using (var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024))
            using (var fileStream = new FileStream(fullPath, FileMode.Create))
            {
                await stream.CopyToAsync(fileStream);
            }

            var relativeUrl = $"/uploads/avatars/{fileName}";
            if (isEdit && deptDangSua != null)
            {
                deptDangSua.AvatarUrl = relativeUrl;
                isNewAvatarUploaded = true;
            }
            else if (!isEdit)
            {
                deptMoi.AvatarUrl = relativeUrl;
            }
            loiPopup = "";
        }
        catch (Exception ex)
        {
            loiPopup = "Lỗi lưu file ảnh: " + ex.Message;
        }
    }

    // Thêm
    private void MoPopupThemTuDo()
    {
        deptMoi = new Department { DisplayOrder = 1 };
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupThem = true;
    }

    private void MoPopupThemNhanh(Department targetDept, bool isChild)
    {
        deptMoi = new Department();
        if (isChild)
        {
            deptMoi.ParentId = targetDept.DepartmentId;
            deptMoi.DepartmentCode = $"{targetDept.DepartmentCode}_SUB";
            deptMoi.RoleTitle = targetDept.Level >= 4 ? "Nhân viên" : "Trưởng nhóm";
        }
        else
        {
            deptMoi.ParentId = targetDept.ParentId;
            deptMoi.DepartmentCode = $"{targetDept.DepartmentCode}_NEW";
            deptMoi.RoleTitle = targetDept.RoleTitle;
        }

        deptMoi.DisplayOrder = 1;
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupThem = true;
    }

    private void DongPopupThem() { isHienThiPopupThem = false; }

    private async Task LuuThemDeptAsync()
    {
        if (string.IsNullOrWhiteSpace(pinXacNhan))
        {
            loiPopup = "Vui lòng nhập mã PIN xác nhận!";
            return;
        }

        loiPopup = "";
        isProcessing = true;

        var result = await DeptSvc.CreateAsync(deptMoi, currentUserId, pinXacNhan);
        if (result.Success)
        {
            DongPopupThem();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi thêm vị trí mới.";
        }

        isProcessing = false;
    }

    // Sửa
    private void MoPopupSua(Department dept)
    {
        deptDangSua = new Department
        {
            DepartmentId = dept.DepartmentId,
            DepartmentCode = dept.DepartmentCode,
            DepartmentName = dept.DepartmentName,
            RoleTitle = dept.RoleTitle,
            ManagerName = dept.ManagerName,
            AvatarUrl = dept.AvatarUrl,
            ParentId = dept.ParentId,
            Level = dept.Level,
            DisplayOrder = dept.DisplayOrder
        };
        tenGocLucMoPopup = dept.ManagerName?.Trim() ?? "";
        isNewAvatarUploaded = false;
        pinXacNhan = "";
        lyDoSua = "";
        loiPopup = "";
        isHienThiPopupSua = true;
    }
    private void DongPopupSua() { isHienThiPopupSua = false; deptDangSua = null; }

    private async Task LuuSuaDeptAsync()
    {
        if (deptDangSua == null) return;
        if (string.IsNullOrWhiteSpace(pinXacNhan))
        {
            loiPopup = "Vui lòng nhập mã PIN xác nhận!";
            return;
        }

        loiPopup = "";
        isProcessing = true;

        var result = await DeptSvc.UpdateAsync(
            deptDangSua, 
            lyDoSua, 
            currentUserId, 
            pinXacNhan, 
            isNewAvatarUploaded, 
            tenGocLucMoPopup);

        if (result.Success)
        {
            DongPopupSua();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi cập nhật.";
        }

        isProcessing = false;
    }

    // Xóa
    private void MoPopupXoa(Department dept)
    {
        deptCanXoa = dept;
        pinXacNhan = "";
        loiPopup = "";
        isHienThiPopupXoa = true;
    }
    private void DongPopupXoa() { isHienThiPopupXoa = false; deptCanXoa = null; }

    private async Task XacNhanXoaDeptAsync()
    {
        if (deptCanXoa == null) return;
        if (string.IsNullOrWhiteSpace(pinXacNhan))
        {
            loiPopup = "Vui lòng nhập mã PIN xác nhận!";
            return;
        }

        loiPopup = "";
        isProcessing = true;

        var result = await DeptSvc.SoftDeleteAsync(deptCanXoa.DepartmentId, currentUserId, pinXacNhan);
        if (result.Success)
        {
            DongPopupXoa();
            await LoadDataAsync();
        }
        else
        {
            loiPopup = result.Error ?? "Lỗi xóa vị trí.";
        }

        isProcessing = false;
    }

    // Lịch sử
    private async Task MoPopupLichSu(Department dept)
    {
        deptDangXem = dept;
        isHienThiPopupLichSu = true;
        isLoadingLogs = true;
        danhSachLog = await DeptSvc.GetChangeLogsAsync(dept.DepartmentId);
        isLoadingLogs = false;
    }
    private void DongPopupLichSu() { isHienThiPopupLichSu = false; }
}