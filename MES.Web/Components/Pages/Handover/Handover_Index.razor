    /// <summary>Nơi gây lỗi đầu vào: phôi khách + các nhóm khác (nhóm đứng trước lên đầu).</summary>
    static List<string> NgCauses(string g)
    {
        var order = HandoverLedgerService.GroupCodes.ToList();
        var idx = order.IndexOf(g);
        var before = order.Take(Math.Max(0, idx)).Reverse();
        var after = order.Skip(idx + 1);
        return new[] { "KHACH" }.Concat(before).Concat(after).ToList();
    }

