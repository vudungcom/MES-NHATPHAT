    static string GcStepOkText(LedgerStepLine s) => HandoverLedgerService.IsVao(s.Code) ? "—" : s.Ok.ToString("0.##");
    // [PAGE-ERR 2026-10-31] Lỗi máy chủ lạ khi Giao / Nhận / Huỷ / Báo lỗi (lời báo nghiệp vụ đã trả qua (ok, err); deadlock đã tự thử lại [RS-D10]):
    //   hiện trong cửa sổ + bỏ dữ liệu dở khỏi DbContext dùng chung (để lần lưu sau không ghi kèm). Trước: không bắt → hỏng phiên trang, phải F5.
    // [PAGE-ERR2 2026-10-31] Lưu / nhận / huỷ ĐÃ ghi xong, chỉ bước tải lại số lỗi: trước rơi vào ServerErr ("…xem đã lưu chưa")
    //   và nhiều khi cửa sổ đã đóng nên không ai thấy. Nay báo rõ "Đã lưu" ở đầu trang (và trong cửa sổ nếu còn mở),
    //   dặn không bấm lưu lại (tránh ghi 2 lần). Số trên trang tự tính lại sau 2 phút / F5.
    string _pageError = "";
    int? _pageErrorDetailId;   // [PAGE-ERR2-PO 2026-11-01] PO của lần lưu bị lỗi tải lại
    void ClearPageError() => _pageError = "";
    // [PAGE-ERR2-PO] PO của cửa sổ đang mở (Nhận / Giao / Báo lỗi: _selectedRow; Lịch sử: _logDetailId)
    int? ModalDetailId => _selectedRow?.KhPlanDetailId ?? (_showLogModal ? _logDetailId : (int?)null);

    // Cửa sổ Nhận / Lịch sử vẫn mở sau khi lưu (lời báo đầu trang nằm dưới lớp phủ) → hiện thêm trong 2 cửa sổ đó.
    private RenderFragment PageErrorBanner() => __builder =>
    {
        // [PAGE-ERR2-PO 2026-11-01] trong cửa sổ chỉ hiện khi cửa sổ là của đúng PO vừa lưu (trước: mở Nhận / Lịch sử PO khác vẫn hiện
        //   "Đã lưu xong… không bấm lưu lại" cạnh lỗi thật của PO đó). Lời báo đầu trang giữ như cũ (X để tắt).
        if (!string.IsNullOrEmpty(_pageError) && _pageErrorDetailId == ModalDetailId)
        {
            <div class="alert alert-warning py-1 px-2 small m-2" style="white-space:pre-line">@_pageError</div>
        }
    };

    async Task ReloadAfterSaveAsync(Func<Task> reload)
    {
        try { await reload(); _pageError = ""; }   // lần lưu sau tải lại được → bỏ lời báo cũ
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            var msg = "Đã lưu xong. Chỉ phần tải lại số trên màn hình bị lỗi máy chủ: " + (ex.InnerException?.Message ?? ex.Message)
                    + " — bấm F5 để xem số mới (trang cũng tự tính lại sau 2 phút). Không bấm lưu lại (sẽ thành 2 lần).";
            _pageError = msg;
            _pageErrorDetailId = ModalDetailId;   // [PAGE-ERR2-PO]
            _modalError = msg;
        }
    }

    string ServerErr(Exception ex)
    {
        Db.ChangeTracker.Clear();
        return "Lỗi máy chủ: " + (ex.InnerException?.Message ?? ex.Message) + " — đóng cửa sổ, tải lại PO để xem đã lưu chưa rồi thử lại.";
    }

    // ── [GN-NG-AFTER] Huỷ phiếu báo lỗi (Lịch sử). Form báo lỗi cũ gộp vào GiaoXuLyModal [GN-FORM1]. ──
    bool ShowVoidNgBtn(HandoverNgReportItem b)
