        new("GiaoSua",   "Hàng Sửa",          "Giao", "Sửa hộ xong, trả về nơi phát hiện", "", g => g.GiaoSua, ""),
        new("GiaoLoiXl", "Hàng lỗi đã xử lý", "Giao", "Có trong Excel nhưng cả 3 tình huống không ghi vào đây (hàng đã xử lý chỉ nhận về rồi làm tiếp)", "", g => g.GiaoLoiXl, ""),
        new("ChuaLam",   "Chưa làm", "", "Trần nhập WTS (L3)", "Nhận mới + Nhận lỗi đã XL − Đã làm − NG (WTS) − Giao lỗi có tích", g => g.ChuaLam, "gn-calc"),
