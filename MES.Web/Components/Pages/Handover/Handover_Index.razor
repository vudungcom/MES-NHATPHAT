    // ── [GC-SUA-TAI-CHO 2026-11-04] KCS xác nhận hàng sửa (modal Nhận · KCS) + huỷ trong Lịch sử. Ghi Kết quả sửa gộp vào GiaoXuLyModal [GN-FORM1]. ──
    async Task LoadKcsRepairsAsync()
    {
        _kcsRepairs = new();
        _expandedRepairId = 0;
        if (_selectedRow == null || _receiveToGroup != HandoverService.RepairCheckGroup) return;
        _kcsRepairs = (await HandoverSvc.GetRepairsAsync(_selectedRow.KhPlanDetailId)).Where(r => r.Waiting > 0).OrderBy(r => r.CreatedAt).ToList();
    }

    void ToggleExpandRepair(long id)
    {
        _expandedRepairId = _expandedRepairId == id ? 0 : id;
        if (_expandedRepairId != 0) _expandedTxId = 0;   // chỉ mở 1 khối nhập
        var r = _kcsRepairs.FirstOrDefault(x => x.Id == id);
        _kcsOk = r?.Waiting ?? 0; _kcsNg = 0; _kcsNotes = ""; _modalError = "";
    }

    async Task ConfirmKcsAsync(long id)
    {
        if (_saving) return;
        if (_selectedRow == null) return;
        _modalError = "";
        if (_kcsOk < 0 || _kcsNg < 0 || _kcsOk + _kcsNg <= 0) { _modalError = "Nhập số KCS xác nhận đạt hoặc loại."; return; }
        _saving = true;
        var detailId = _selectedRow.KhPlanDetailId;
        try
        {
            (bool ok, string err) = await HandoverSvc.ConfirmRepairAsync(id, _kcsOk, _kcsNg, _kcsNotes, _currentUserId);
            _saving = false;
            if (!ok)
            {   // số chờ có thể vừa đổi (người KCS khác xác nhận) → tải lại danh sách, giữ khối đang mở nếu còn (rà độc lập T3)
                _modalError = err;
                var keep = id;
                await LoadKcsRepairsAsync();
                if (_kcsRepairs.Any(x => x.Id == keep)) _expandedRepairId = keep;
                return;
            }
            await ReloadAfterSaveAsync(async () =>
            {
                await ReloadRowAsync(detailId);
                await LoadKcsRepairsAsync();
            });
        }
        catch (Exception ex) { _modalError = ServerErr(ex); }
        finally { _saving = false; }
    }

    bool ShowVoidRepairBtn(HandoverRepairItem r)
