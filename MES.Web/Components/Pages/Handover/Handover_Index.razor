    async Task ConfirmIssueAsync()
    {
        if (_saving) return;   // [D10-DBLCLICK 29/10] bấm đúp: lần 2 tới trước khi nút kịp khoá → bỏ qua (trước: 2 phiếu / 2 lần nhận cùng lọt trần)
        if (_selectedRow == null) return;
        _modalError = "";
        var purpose = EffectivePurpose;
        if (string.IsNullOrEmpty(_issueFrom)) { _modalError = "Chọn nhóm giao."; return; }
        if (purpose == null)                  { _modalError = _issueSpecialMode ? "Chọn loại phiếu." : "Chọn phân loại hàng (Hàng mới / Hàng lỗi / Hàng sửa)." /* [GN-PLH] mục 36 */; return; }
        if (string.IsNullOrEmpty(_issueTo))   { _modalError = "Chọn nhóm nhận."; return; }
        if (RouteError != null)               { _modalError = RouteError; return; }
        // [VULOI] vụ lấy hàng / loại lỗi
        long? caseArg = null; int? catArg = null;
        if (TakesCaseNow(purpose))
        {
            var key = EffIssueCaseKey(purpose);
            if (key == null) { _modalError = $"Chọn {NgCaseNo.Term} đang giữ."; return; }
            caseArg = key == 0 ? null : key;
        }
        if (purpose == HandoverPurpose.NgReturn)
        {
            if (_issueCatId == null) { _modalError = NgCaseService.MsgPickCategory; return; }
            catArg = _issueCatId;
        }
        if (_issueQty <= 0)                   { _modalError = "Số lượng phải lớn hơn 0."; return; }
        _saving = true;
        var detailId = _selectedRow.KhPlanDetailId;
        (bool ok, string err) = _issueSpecialMode
            ? await HandoverSvc.IssueSpecialAsync(detailId, _issueFrom, _issueTo, _issueQty, _currentUserId, purpose,
                fromNC: string.IsNullOrEmpty(_issueFromNC) ? null : _issueFromNC,
                toNC:   string.IsNullOrEmpty(_issueToNC) ? null : _issueToNC,
                notes:  _issueNotes, reason: null, ngCaseId: caseArg)   // [VULOI] lỗi theo vụ (trước: _issueReason gõ tay)
            : await HandoverSvc.IssueByCellAsync(detailId, _issueFrom, _issueTo, _issueQty, _currentUserId,
                _issueCell, _issuePrev, IssueToCellNow,   // [GN-CELL2] trước: _issueRepaired
                fromNC: _issuePrev && _issueFrom == "GC" && !string.IsNullOrEmpty(_issueFromNC) ? _issueFromNC : null,   // [GN-NC-PIN]
                toNC:   string.IsNullOrEmpty(_issueToNC) ? null : _issueToNC,
                notes:  _issueNotes, reason: null, ngCategoryId: catArg, ngCaseId: caseArg);   // [VULOI]
        _saving = false;
        if (!ok) { _modalError = err; await ReloadRowAsync(detailId); return; }
        CloseModals();
        await ReloadRowAsync(detailId);
    }

