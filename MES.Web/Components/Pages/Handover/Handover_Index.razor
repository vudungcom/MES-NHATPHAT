                from == "KHO" ? "Phôi tốt cho Gia công." : "Hàng OK đã nhập WTS. Hàng lỗi không đi phiếu này."),
        };
        if (from != "KHO")
            list.Add(new(HandoverPurpose.NgReturn, "Trả hàng lỗi — về nơi gây lỗi",
                "Phát hiện lỗi do khâu trước, chưa làm chiếc đó. Lấy từ hàng chưa làm."));
        list.Add(new(HandoverPurpose.RepairSend, "Gửi sửa — chuyển hàng lỗi đang giữ cho nhóm sửa",
            "Nơi gây lỗi chuyển hàng lỗi mình đang giữ sang nhóm có khả năng sửa."));
        list.Add(new(HandoverPurpose.RepairReturn, "Trả hàng đã sửa — về nơi phát hiện",
            "Sửa xong (hàng nhờ sửa, hoặc lỗi của chính mình), trả về nơi phát hiện để làm tiếp."));
        if (from == "GC")
            list.Add(new(HandoverPurpose.HelpSend, "Gửi làm hộ — NC máy loại trừ",
                "Gia công gửi hàng giữa chừng cho nhóm khác làm hộ. Chọn NC nguồn, ghi chú bắt buộc."));
        if (from != "GC")
            list.Add(new(HandoverPurpose.HelpReturn, "Trả làm hộ — về Gia công",
                "Làm hộ xong, trả về Gia công. Chọn NC nhận vào."));
        // [GN-NG-OUT] L5: hàng lỗi đang giữ ra khỏi PO — mọi nhóm, lấy từ "Hàng lỗi / sửa đang giữ"
        list.Add(new(HandoverPurpose.Scrap, "Huỷ hàng lỗi — không sửa được",
            "Hàng lỗi đang giữ không sửa được: huỷ, ra khỏi PO. Bắt buộc ghi lỗi cụ thể."));
        list.Add(new(HandoverPurpose.CustReturn, "Trả khách hàng lỗi",
