    async Task ToggleExpandDetailAsync(int detailId)
    {
        if (_expandedDetailId == detailId) { _expandedDetailId = null; _steps = new(); _ngTrace = null; return; }
        _expandedDetailId = detailId;
        _steps = new();
        _ngTrace = null;   // [GN-NG-TRACE]
        StateHasChanged();
        await LoadStepsAsync(detailId);
    }

    int GetPendingCount(int id) => _pendingCountPerDetail.TryGetValue(id, out var c) ? c : 0;
    int GetPendingIssuedCount(int id) => _pendingIssuedCountPerDetail.TryGetValue(id, out var c) ? c : 0;

    IEnumerable<LedgerRow> FilteredRows
    {
        get
        {
            var q = _rows.AsEnumerable();
            if (_onlyWarn) q = q.Where(r => r.HasWarning || r.HasLoiGiu);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(r =>
                    r.PlanNo.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    r.PurchaseOrder.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    r.PartNo.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (r.CustomerName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            foreach (var (key, def) in _colFilters)
            {
                if (!def.IsActive) continue;
                q = key switch
                {
                    "PlanNo"        => q.Where(r => def.Passes(r.PlanNo)),
                    "PurchaseOrder" => q.Where(r => def.Passes(r.PurchaseOrder)),
                    "PartNo"        => q.Where(r => def.Passes(r.PartNo)),
                    _ => q
                };
            }
            if (_sortColHdv != null)
            {
                Func<LedgerRow, string> key = _sortColHdv switch
                {
                    "PurchaseOrder" => r => r.PurchaseOrder,
                    "PartNo"        => r => r.PartNo,
                    _               => r => r.PlanNo
                };
                q = _sortAscHdv ? q.OrderBy(key) : q.OrderByDescending(key);
            }
            return q;
        }
    }

    // ── Nút hiển thị ──────────────────────────────────────────────────
    void ToggleFormula()
    {
        _showFormula = !_showFormula;
        if (!_showFormula) CloseExplain();
    }
    void ClearSearch() => _search = string.Empty;

    // ── Khung công thức ───────────────────────────────────────────────
    void OpenExplain(LedgerRow row, LedgerGroup g, string colKey)
    {
        if (!_showFormula) return;
        if (!g.Explains.TryGetValue(colKey, out var e)) return;
        _explain    = e;
        _explainPo  = $"{row.PlanNo} · {row.PurchaseOrder} · {row.PartNo}";
        _explainKey = $"{row.KhPlanDetailId}|{g.Code}|{colKey}";
    }

    void OpenBalance(LedgerRow row)
    {
        if (!_showFormula) return;
        _explain    = row.BalanceExplain;
        _explainPo  = $"{row.PlanNo} · {row.PurchaseOrder} · {row.PartNo}";
        _explainKey = $"{row.KhPlanDetailId}|PO|balance";
    }

    void RefreshExplain()
    {
        var parts = _explainKey.Split('|');
        if (parts.Length != 3 || !int.TryParse(parts[0], out var id)) { CloseExplain(); return; }
        var row = _rows.FirstOrDefault(r => r.KhPlanDetailId == id);
        if (row == null) { CloseExplain(); return; }
        if (parts[1] == "PO") { _explain = row.BalanceExplain; return; }
        var g = row.G(parts[1]);
        _explain = g.Explains.TryGetValue(parts[2], out var e) ? e : null;
    }

    void CloseExplain() { _explain = null; _explainKey = ""; }

