    static List<ColDef> ColsFor(string group)
        => group == "KHO" ? ExcelCols.Where(c => c.Key is not ("ChuaLam" or "DaLam")).ToList() : ExcelCols;

    static string GroupBg(string grp) => grp switch
    {
        "KHO"  => "#fff176",   // vàng — như Excel xưởng
        "GC"   => "#a8d88a",   // xanh lá
        "HTSP" => "#8fcbf2",   // xanh dương
        "KCS"  => "#f8c88a",   // cam
        "PKG"  => "#d7b9f0",   // tím nhạt
        _      => "#f8f9fa"
    };

    /// <summary>1 ô số. prev = nhóm ở bước trước (dòng B) để tô ô vừa đổi; null = dòng PO.</summary>
    RenderFragment NumCell(LedgerRow row, LedgerGroup g, ColDef c, LedgerGroup? prev) => __builder =>
    {
        var v = c.Get(g);
        var isNeg = v < 0;
        var changed = prev != null ? c.Get(prev) != v : false;
        var isActive = prev == null && _explain != null && _explainKey == $"{row.KhPlanDetailId}|{g.Code}|{c.Key}";
        var first = c.Key is "NhanMoi" or "GiaoMoi" or "ChuaLam" || (g.IsKho && c.Key == "Ton");
        var dead = IsDeadCell(g.Code, c.Key) && v == 0;   // [GN-TEXT] ô quy trình không bao giờ ghi vào (có số thì vẫn hiện để lộ ra)
        var cls = $"gn-num {(first ? "gn-gl" : "")} {c.Css} {(isNeg ? "gn-neg" : "")} {(changed ? "gn-chg" : "")} {(dead ? "gn-dead" : "")} {(_showFormula && prev == null ? "gn-click" : "")} {(isActive ? "gn-active" : "")}";
        <td class="@cls" title="@(dead ? DeadCellTip(g.Code, c.Key) : null)" @onclick:stopPropagation @onclick="() => { if (prev == null) OpenExplain(row, g, c.Key); }">
            @(v == 0 ? (c.Band == "" ? "0" : "") : v.ToString("0.##"))
            @* [GN-RECV-NG] mục 37: phần Tồn là hàng đã giao tới nhưng nhóm chưa bấm Nhận *@
            @if (c.Key == "Ton" && g.ChoNhan > 0)
            {
                <span class="d-block text-nowrap" style="font-size:9.5px;color:#b45309" title="Đã giao tới nhóm, chưa bấm Nhận: tính vào Tồn nhưng chưa nhập WTS được">chờ nhận @g.ChoNhan.ToString("0.##")</span>
            }
            @if (c.Key == "Ton" && prev == null)
            {
                <div class="d-flex gap-1 justify-content-center flex-wrap">
                    @if (g.NhanLamHo > 0 || g.GiaoLamHo > 0)
                    {
                        <span class="badge bg-secondary gn-badge" title="Giao theo NC (máy loại trừ) — ngoài 8 ô Excel: nhận @g.NhanLamHo.ToString("0.##") · giao @g.GiaoLamHo.ToString("0.##") · tồn @g.LamHoGiu.ToString("0.##")">theo NC</span>
                    }
                    @if (g.PendingToIssue > 0)
                    {
                        <span class="badge bg-primary gn-badge" title="@g.PendingToIssue phiếu nhóm này giao chưa được nhận">⬆@g.PendingToIssue</span>
                    }
                    @if (g.PendingToReceive > 0)
                    {
                        <span class="badge bg-success gn-badge" title="@g.PendingToReceive phiếu đang chờ nhóm này nhận">⬇@g.PendingToReceive</span>
                    }
                </div>
            }
        </td>
    };

    /// <summary>[GN-TEXT] Ô Excel mà theo đúng các bước trong file Excel khách, quy trình không bao giờ ghi vào (bộ thử ngẫu nhiên xác nhận).</summary>
    static bool IsDeadCell(string grp, string key)
        => key == "GiaoLoiXl" || (grp == "KHO" && key is "NhanSua" or "GiaoSua");

    static string DeadCellTip(string grp, string key) => key == "GiaoLoiXl"
        ? "Excel có cột này nhưng cả 3 tình huống không ghi vào: hàng lỗi đã xử lý chỉ NHẬN về nơi phát hiện rồi làm tiếp (WTS), không giao đi từ ô này."
        : "Theo quy trình Excel Kho không nhận / giao Hàng Sửa (ô có số khi có nhóm gửi Kho sửa). Phôi lỗi ở Kho đi bằng ô Hàng lỗi (gửi nhờ sửa, huỷ, trả khách)."; // [GN-ROUTE-FREE]

    static string StepKind(string k) => k switch { "PHOI" => "Phôi", "GIAO" => "Giao", "NHAN" => "Nhận", "WTS" => "WTS", "DONG" => "Huỷ phần còn", "BAOLOI" => "Báo lỗi", _ => k };   // [GN-VOID-RULE] + DONG; [GN-NG-AFTER] + BAOLOI
