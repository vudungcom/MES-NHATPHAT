    async Task ConfirmReceiveAsync(long txId)
    {
        if (_saving) return;   // [D10-DBLCLICK 29/10] bấm đúp: lần 2 tới trước khi nút kịp khoá → bỏ qua (trước: 2 phiếu / 2 lần nhận cùng lọt trần)
        _modalError = "";
        _saving     = true;
        // [GN-CELL2] ô bên nhận chọn (null = phiếu không có ô: theo NC / phiếu tự lập); đổi khác chỉ định phải có lý do
        var pend = _pendingTxs.FirstOrDefault(x => x.HandoverTxId == txId);
        string? cell = pend == null ? null : RecvCellOf(pend);
        if (pend != null && cell != null && cell != pend.ToCell && string.IsNullOrWhiteSpace(_receiveCellReason))
        { _modalError = "Đổi phân loại khác bên giao chỉ định: bắt buộc ghi lý do."; _saving = false; return; }
        if (pend != null && pend.IsAutoReturn) cell = null;
        // [VULOI] lần nhận sinh vụ mới (phiếu không mang vụ + vào ô Hàng lỗi / Hàng sửa, hoặc có NG lúc nhận): bắt chọn loại lỗi
        if (pend != null && !RecvCarry(pend) && (RecvLoi(pend) || RecvSua(pend) || _receiveQtyNg > 0) && _receiveCatId == null)
        { _modalError = NgCaseService.MsgPickCategory; _saving = false; return; }
        // [GN-RECV-SUA] ô Hàng sửa không gửi NG (ô NG khoá xám)
        (bool ok, string err) = await HandoverSvc.ReceiveAsync(txId, cell == HandoverCell.Loi ? 0 : _receiveQtyOk, cell == HandoverCell.Sua ? 0 : _receiveQtyNg, null, _currentUserId, _receiveNotes,
            toCell: cell, toCellReason: cell != null && pend != null && cell != pend.ToCell ? _receiveCellReason : null,
            ngCategoryId: _receiveCatId);   // [VULOI] lỗi chọn từ DS Lỗi (trước: _receiveNgReason gõ tay)
        _saving = false;
        if (!ok) { _modalError = err; return; }
        _expandedTxId = 0;
        ResetReceiveInputs();
        if (_selectedRow != null)
        {
            var id = _selectedRow.KhPlanDetailId;
            _pendingTxs = await HandoverSvc.GetPendingForGroupAsync(id, _receiveToGroup);
            await ReloadRowAsync(id);
        }
    }

    static string PendingPurpose(HandoverTxPending p)
        => p.Purpose ?? (p.IsReturnNg ? HandoverPurpose.NgReturn : HandoverPurpose.New);

    // [GN-RECV-NG2] Nhận vào ô Hàng lỗi: ô "đạt" khoá xám, chỉ nhập ô Hàng lỗi. [GN-CELL2] xét theo ô bên nhận đang chọn (trước: theo loại phiếu)
    string? RecvCellOf(HandoverTxPending p) => p.ToCell == null ? null : p.IsAutoReturn ? HandoverCell.Loi
        : !string.IsNullOrEmpty(_receiveCell) ? _receiveCell : p.ToCell;
    bool RecvLoi(HandoverTxPending p) => RecvCellOf(p) == HandoverCell.Loi;
    bool RecvSua(HandoverTxPending p) => RecvCellOf(p) == HandoverCell.Sua;   // [GN-RECV-SUA] nhận hàng gửi sửa: chỉ 1 ô số lượng
    void SelectRecvCell(string c)
    {
        _receiveCell = c; _modalError = "";
        if (c == HandoverCell.Loi) { _receiveQtyNg += _receiveQtyOk; _receiveQtyOk = 0; }   // ô Hàng lỗi: dồn số sang ô Hàng lỗi
        if (c == HandoverCell.Sua) { _receiveQtyOk += _receiveQtyNg; _receiveQtyNg = 0; }   // [GN-RECV-SUA] ô Hàng sửa: dồn số sang ô Số lượng nhận
    }
