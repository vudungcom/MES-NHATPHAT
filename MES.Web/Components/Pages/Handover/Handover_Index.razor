    /// <summary>Sau khi loại phiếu đổi: tự điền nhóm nhận khi chỉ có 1 lựa chọn / là hàng mới, và điền số tối đa.</summary>
    void AfterPurposeChanged()
    {
        var purpose = EffectivePurpose;
        _issueTo = "";
        _issueCaseKey = null;   // [VULOI] đổi loại phiếu / ô → chọn lại vụ
        if (purpose == null || _selectedRow == null) { _issueQty = 0; return; }
        if (HandoverPurpose.IsOut(purpose)) _issueTo = HandoverPurpose.OutTarget(purpose)!;
        else
        {
            var targets = TargetOptions(purpose);
            if (purpose == HandoverPurpose.New)
            {
                var next = NextGroup(_issueFrom);   // [GN-ROUTE-FREE] dùng chung với dòng nhắc
                _issueTo = targets.Contains(next) ? next : (targets.Count == 1 ? targets[0] : "");
            }
            else if (purpose == HandoverPurpose.NgReturn)
            {
                // [GN-NGRET-TO] Chọn tự do, mặc định điền sẵn nhóm đứng trước (trường hợp hay gặp nhất)
                var prev = _issueFrom switch { "GC" => "KHO", "HTSP" => "GC", "KCS" => "HTSP", "PKG" => "KCS", _ => "" };
                _issueTo = targets.Contains(prev) ? prev : (targets.Count == 1 ? targets[0] : "");
            }
            else if (targets.Count == 1) _issueTo = targets[0];
        }
        _issueQty = IssueCapNow(purpose).Max;   // [VULOI] trước: IssueCap — nay theo vụ (chỉ 1 vụ thì tự chọn)
    }

    void OnFromNcChanged(ChangeEventArgs e)
    {
        _issueFromNC = e.Value?.ToString() ?? "";
        if (_selectedRow != null && !string.IsNullOrEmpty(_issueFromNC) && EffectivePurpose != null)
            _issueQty = HandoverLedgerService.IssueCap(_selectedRow, _issueFrom, EffectivePurpose, _issueFromNC).Max;
    }

    // [GN-NGRET-TO] nhóm nhận đứng sau nhóm giao trong dòng KHO → GC → HTSP → KCS → Đóng gói
    static int GrpOrder(string g) => Array.IndexOf(HandoverLedgerService.GroupCodes, g);
    // [GN-ROUTE-FREE] nhóm kế tiếp mặc định của Hàng mới + dòng nhắc khi chọn nhóm khác
    static string NextGroup(string from) => from switch { "KHO" => "GC", "GC" => "HTSP", "HTSP" => "KCS", "KCS" => "PKG", "PKG" => "KHO", _ => "" };
    static string NewRouteNote(string from, string to)
        => to == "KHO" ? $"Kho nhận vào ô Hàng mới như phôi (không phải nhập thành phẩm — chỉ Đóng gói → Kho mới là thành phẩm)."
         : GrpOrder(to) < GrpOrder(from) ? $"{HandoverLedgerService.GroupLabel(to)} đứng trước {HandoverLedgerService.GroupLabel(from)}: hàng vào Chưa làm của {HandoverLedgerService.GroupLabel(to)} và phải làm lại (nhập WTS lại)."
         : $"Không qua các nhóm ở giữa — {HandoverLedgerService.GroupLabel(to)} nhận thẳng từ {HandoverLedgerService.GroupLabel(from)}.";
    static bool IsLaterGroup(string from, string to) => !string.IsNullOrEmpty(from) && !string.IsNullOrEmpty(to) && GrpOrder(to) > GrpOrder(from);

