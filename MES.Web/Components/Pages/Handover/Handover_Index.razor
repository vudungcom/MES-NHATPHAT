    // ── [VULOI 2026-10-28] Vụ lỗi trên form Giao / Nhận ─────────────────────
    /// <summary>Ô lấy hàng của phiếu đang lập (Huỷ / Trả khách: ô Hàng lỗi).</summary>
    string? TakeCellOf(string purpose) => _issueSpecialMode ? (HandoverPurpose.IsOut(purpose) ? HandoverCell.Loi : null) : _issueCell;
    bool TakesCaseNow(string? purpose) => purpose != null && _selectedRow != null && HandoverLedgerService.TakesHeldCase(purpose, TakeCellOf(purpose));
    List<LedgerCase> HeldCasesNow(string purpose)
        => _selectedRow == null || TakeCellOf(purpose) is not string cell ? new() : _selectedRow.CasesHeldAt(_issueFrom, cell);
    /// <summary>Vụ đang dùng: vụ bấm chọn (nếu còn hàng), hoặc tự chọn khi chỉ có 1 vụ. Null = phải chọn.</summary>
    long? EffIssueCaseKey(string purpose)
    {
        var held = HeldCasesNow(purpose);
        if (_issueCaseKey != null && held.Any(h => h.Id == _issueCaseKey)) return _issueCaseKey;
        return held.Count == 1 ? held[0].Id : null;
    }
    (decimal Max, LedgerExplain Explain) IssueCapNow(string purpose)
    {
        if (_selectedRow == null) return (0m, new LedgerExplain());
        if (!TakesCaseNow(purpose))
            return HandoverLedgerService.IssueCap(_selectedRow, _issueFrom, purpose, _issueFromNC, _issueSpecialMode ? null : _issueCell);
        var key = EffIssueCaseKey(purpose);
        if (key == null)
            return (0m, new LedgerExplain { Title = $"Chọn {NgCaseNo.Term} ở trên", Note = "Số tối đa tính theo vụ đang chọn." });
        return HandoverLedgerService.IssueCapCase(_selectedRow, _issueFrom, purpose, _issueFromNC, TakeCellOf(purpose), key == 0 ? null : key);
    }
    void SelectIssueCase(long id)
    {
        _issueCaseKey = id;
        if (EffectivePurpose is string p) _issueQty = IssueCapNow(p).Max;
    }
    string CaseFrom(LedgerCase cs)
        => cs.Id == 0 ? "dữ liệu trước khi có mã vụ"
         : "phát hiện ở " + (cs.DetectGroup == null ? "?" : HandoverLedgerService.GroupLabel(cs.DetectGroup) + (string.IsNullOrEmpty(cs.DetectNc) ? "" : " " + cs.DetectNc))
           + (string.IsNullOrEmpty(cs.Cause) || cs.Cause == cs.DetectGroup ? "" : " · do " + HandoverNgSource.CauseLabel(cs.Cause));
    static string CaseRadioId(long id) => "vuIssue_" + id;

    RenderFragment VuPicker(string purpose) => __builder =>
    {
        var cell = TakeCellOf(purpose) ?? "";
        var held = HeldCasesNow(purpose);
        var eff = EffIssueCaseKey(purpose);
        <div class="mb-3 p-2 border border-danger-subtle rounded" style="background:#fff5f5;font-size:12px">
            <div class="fw-semibold text-danger mb-1">@NgCaseNo.TermCap <span class="text-danger">*</span> <span class="text-muted fw-normal">— 1 phiếu chỉ 1 vụ; lỗi ghi theo vụ</span></div>
            @if (held.Count == 0)
            {
                <div class="text-muted">Ô @HandoverCell.Label(cell) của @HandoverLedgerService.GroupLabel(_issueFrom) không có @NgCaseNo.Term nào đang giữ.</div>
            }
            @foreach (var cs in held)
            {
                var id = cs.Id;
                <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" name="vuIssue" id="@CaseRadioId(id)" checked="@(eff == id)" @onchange="() => SelectIssueCase(id)" />
                    <label class="form-check-label" for="@CaseRadioId(id)">
                        <strong>@(id == 0 ? "Hàng lỗi cũ" : cs.No)</strong> · @cs.CatLabel · <span class="text-muted">@CaseFrom(cs)</span> · còn <strong>@cs.HeldAt(_issueFrom, cell).ToString("0.##")</strong>
                    </label>
                </div>
            }
            @if (held.Count == 1)
            {
                <div class="text-muted fst-italic mt-1">Chỉ có 1 vụ — phần mềm tự chọn.</div>
            }
        </div>
    };

