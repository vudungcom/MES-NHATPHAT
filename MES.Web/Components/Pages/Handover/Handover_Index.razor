    static string LogPurpose(HandoverLogItem t)
        => t.Purpose ?? (t.IsReturnNg ? HandoverPurpose.NgReturn : HandoverPurpose.New);

    /// <summary>Nhãn theo ô Excel: "Giao · Hàng lỗi ☑ công đoạn trước", "Giao · Hàng Sửa", "Gửi làm hộ"…</summary>
    static string CellFlow(string purpose, string? sendCell, string? toCell = null)
    {
        var c = sendCell ?? HandoverCell.IssueCellOf(purpose, null);
        return purpose switch
        {
            HandoverPurpose.NgReturn     => "Giao · Hàng lỗi ☑ công đoạn trước",
            HandoverPurpose.RepairSend   => "Giao · Hàng lỗi (gửi nhờ sửa)",
            HandoverPurpose.RepairReturn => c == HandoverCell.Loi ? "Giao · Hàng lỗi (tự sửa xong)"
                                          : toCell == HandoverCell.Loi ? (c == HandoverCell.Xl ? "Giao · Hàng lỗi đã xử lý (trả lại — chưa đạt)" : "Giao · Hàng Sửa (trả lại — chưa sửa được)")   // [LS-THOIGIAN] khách TH6 ý 2: ghi rõ sửa đạt / chưa đạt ([XL-TRA-LAI] hàng đã xử lý trả lại ô Hàng lỗi)
                                          : c == HandoverCell.Xl ? "Giao · Hàng lỗi đã xử lý (đã sửa đạt)"
                                          : "Giao · Hàng Sửa (sửa hộ xong — đạt)",
            HandoverPurpose.New          => "Giao · Hàng Mới",
            HandoverPurpose.HelpSend when c == HandoverCell.Moi => HandoverLedgerService.KhoTaroLabel,   // [KHO-TARO-THANG 2026-11-12] chỉ phiếu Kho giao thẳng Taro có ô Hàng mới
            _ => HandoverPurpose.Label(purpose)
        };
    }

    /// <summary>[G19-HUYHIEU-NHAN 2026-11-12] Ô nhận thật của các lần nhận chưa huỷ khác ô bên giao chỉ định ("" = không lần nhận nào đổi ô).
    /// Chỉ hiển thị. Nguồn: CLAUDE rà độc lập Gói 19 12/11 (Thấp 3); HÙNG 12/11 20:02.</summary>
    static string RealRecvCellsText(HandoverLogItem tx, string? shownCell)
    {
        var live = tx.Receives.Where(r => !r.IsVoided).Select(r => r.ToCell ?? tx.ToCell ?? shownCell).ToList();   // phiếu cũ không ghi ô: lần nhận không ô = ô đang hiện (rà độc lập Gói 20 vòng 3 Thấp 2)
        var cells = live.Where(c => !string.IsNullOrEmpty(c) && c != shownCell).Distinct().ToList();
        if (cells.Count == 0) return "";
        var list = string.Join(", ", cells.Select(c => "ô " + HandoverCell.Label(c)));
        // rà độc lập Gói 20 (Thấp 1): còn lần nhận vào đúng ô chỉ định → "có lần nhận vào …" (không đọc như nhận hết vào ô khác)
        return live.Any(c => c == shownCell) ? "có lần nhận vào " + list : "nhận thật: " + list;
    }

