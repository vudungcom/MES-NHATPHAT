    // ── [GN-VOID-RULE] Luật huỷ trên Lịch sử phiếu (cùng hàm với máy chủ) ──
    static decimal ActiveRecv(HandoverLogItem tx) => tx.Receives.Where(r => !r.IsVoided).Sum(r => r.QtyOk + r.QtyNg);
    static decimal RemainOf(HandoverLogItem tx) => tx.QtyIssued - ActiveRecv(tx);
    bool CanIssueSide(HandoverLogItem tx) => HandoverService.CanVoidIssue(tx.IssuedBy, tx.FromGroupCode, _currentUserId, _myEditGroups);
    // Huỷ phiếu: chưa có lần nhận nào còn hiệu lực (lần nhận đã huỷ không tính) — phiếu chờ nhận, hoặc phiếu Huỷ / Trả khách
    bool ShowVoidIssueBtn(HandoverLogItem tx)
        => !tx.IsVoided && ActiveRecv(tx) <= 0 && (tx.Status == "PENDING" || HandoverPurpose.IsOut(tx.Purpose)) && CanIssueSide(tx);
    // Huỷ phần chưa nhận: phiếu nhận dở, không phải phiếu tự lập / Huỷ / Trả khách
    bool ShowCloseBtn(HandoverLogItem tx)
        => !tx.IsVoided && tx.SourceReceiveId == null && !HandoverPurpose.IsOut(tx.Purpose)
           && ActiveRecv(tx) > 0 && ActiveRecv(tx) < tx.QtyIssued && CanIssueSide(tx);
    bool ShowVoidRecvBtn(HandoverLogItem tx, HandoverReceiveItem r)
        => !tx.IsVoided && !r.IsVoided && HandoverService.CanVoidReceive(r.ReceivedBy, tx.ToGroupCode, _currentUserId, _myEditGroups);
    static string VoidIssueBtnText(HandoverLogItem tx) => tx.SourceReceiveId != null ? "Huỷ phiếu (huỷ lần nhận gốc)" : "Huỷ phiếu giao";
    static string ClosedText(HandoverLogItem tx)
        => $"Đã huỷ phần chưa nhận {tx.QtyClosed:0.##} chiếc (phiếu gốc {tx.QtyIssued + tx.QtyClosed:0.##})"
           + (string.IsNullOrEmpty(tx.ClosedByName) ? "" : $" · {tx.ClosedByName}")
           + (tx.ClosedAt != null ? $" · {tx.ClosedAt:dd/MM HH:mm}" : "")
           + (string.IsNullOrEmpty(tx.ClosedReason) ? "" : $" · {tx.ClosedReason}");
    string VoidTitle => _voidMode switch { "RECV" => "Huỷ lần nhận", "CLOSE" => "Huỷ phần chưa nhận", "NG" => "Huỷ báo lỗi", _ => "Huỷ phiếu giao" };   // [GN-NG-AFTER] + NG
    string VoidNote()
    {
        if (_voidMode == "NG")   // [GN-NG-AFTER]
        {
            var b = _ngLogs.FirstOrDefault(x => x.Id == _voidingNgId);
            return b == null ? "" : $"Huỷ báo lỗi #{b.Id} ({b.Qty:0.##} chiếc, {HandoverLedgerService.GroupLabel(b.GroupCode)}): số này về lại ô {HandoverNgSource.SourceLabel(b.SourceCell, b.GroupCode)}"
                + (string.IsNullOrEmpty(b.NC) ? "" : $" NC {b.NC}") + ". Nếu hàng lỗi này đã được giao / huỷ / trả khách thì phần mềm chặn — huỷ phiếu đó trước.";
        }
        var tx = _logItems.FirstOrDefault(x => x.HandoverTxId == _voidingTxId);
        if (tx == null) return "";
        if (_voidMode == "RECV")
        {
            var r = tx.Receives.FirstOrDefault(x => x.ReceiveId == _voidingReceiveId);
            var what = r == null ? "" : $"lần nhận {r.ReceivedAt:dd/MM HH:mm} (đạt {r.QtyOk:0.##} / NG {r.QtyNg:0.##})";
            return $"Huỷ {what} của phiếu #{tx.HandoverTxId}: phiếu về lại chờ {HandoverLedgerService.GroupLabel(tx.ToGroupCode)} nhận."
                 + (r != null && r.QtyNg > 0 ? " Phiếu trả hàng lỗi tự lập từ lần nhận này huỷ theo." : "")
                 + " Nếu số đã nhận đã được nhập WTS / giao tiếp thì phần mềm chặn — xoá / sửa từ cuối ngược lên.";
        }
        if (_voidMode == "CLOSE")
            return $"Phiếu #{tx.HandoverTxId} giao {tx.QtyIssued:0.##}, đã nhận {ActiveRecv(tx):0.##}: huỷ {RemainOf(tx):0.##} chiếc chưa nhận, số này về lại {HandoverLedgerService.GroupLabel(tx.FromGroupCode)}. Phiếu đóng ở {ActiveRecv(tx):0.##}.";
        if (tx.SourceReceiveId != null)
        {
            var src = _logItems.FirstOrDefault(x => x.Receives.Any(r => r.ReceiveId == tx.SourceReceiveId));
            var sr = src?.Receives.FirstOrDefault(r => r.ReceiveId == tx.SourceReceiveId);
            return $"Phiếu #{tx.HandoverTxId} do phần mềm tự lập khi nhận có NG. Huỷ phiếu này = huỷ lần nhận gốc"
                 + (src != null && sr != null ? $" của phiếu #{src.HandoverTxId} (đạt {sr.QtyOk:0.##} / NG {sr.QtyNg:0.##}) — phiếu #{src.HandoverTxId} về lại chờ nhận." : ".");
        }
        return $"Huỷ phiếu #{tx.HandoverTxId} ({tx.QtyIssued:0.##} chiếc): số lượng trả về ô của {HandoverLedgerService.GroupLabel(tx.FromGroupCode)}.";
    }

    string GetStatusBadge(string status) => status switch
    {
        "PENDING"   => "bg-warning text-dark",
        "PARTIAL"   => "bg-info text-dark",
        "COMPLETED" => "bg-success",
        _           => "bg-secondary"
    };

    // ── Lọc ───────────────────────────────────────────────────────────
    async Task ResetFilterAsync()
    {
        _filterCustomerId = 0; _filterMonth = 0; _filterYear = DateTime.Now.Year;
        await LoadDataAsync();
    }

    bool HasActiveColFilters => _colFilters.Any(kv => kv.Value.IsActive) || _sortColHdv != null;

    void ClearColFilters()
    {
        foreach (var d in _colFilters.Values) { d.ExcludedValues.Clear(); d.SearchText = string.Empty; }
        _sortColHdv = null;
    }

    void CloseColFilter() => _openColFilter = null;
    void SortAsc()  { _sortColHdv = _openColFilter; _sortAscHdv = true;  _openColFilter = null; }
    void SortDesc() { _sortColHdv = _openColFilter; _sortAscHdv = false; _openColFilter = null; }

    void ClearOpenColFilter()
    {
        if (_openColFilter != null && _colFilters.TryGetValue(_openColFilter, out var d))
        {
            d.ExcludedValues.Clear(); d.SearchText = string.Empty;
        }
        _openColFilter = null;
    }

    void ToggleAllValues(HandoverColFilterDef def, List<string> vis, ChangeEventArgs e)
    {
        var sel = (bool)(e.Value ?? false);
        foreach (var v in vis) { if (sel) def.ExcludedValues.Remove(v); else def.ExcludedValues.Add(v); }
    }

    void ToggleValue(HandoverColFilterDef def, string v, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) def.ExcludedValues.Remove(v); else def.ExcludedValues.Add(v);
    }

    void ToggleSortHeader(string colKey)
    {
        _sortAscHdv = _sortColHdv == colKey ? !_sortAscHdv : true;
        _sortColHdv = colKey;
    }

    void OpenColFilterAt(string colKey, MouseEventArgs e)
    {
        _openColFilter = _openColFilter == colKey ? null : colKey;
        _cfTop  = e.ClientY + 10;
        _cfLeft = Math.Min(e.ClientX - 10, 1200);
    }

    RenderFragment HdvColHeader(string colKey, string label) => __builder =>
    {
        var hasFilter = _colFilters.TryGetValue(colKey, out var def) && def.IsActive;
        var isSorted  = _sortColHdv == colKey;
        <span class="col-filter-wrap">
            <span style="cursor:pointer;user-select:none" @onclick="() => ToggleSortHeader(colKey)">
                @label
                @if (isSorted)
                {
                    <i class="bi @(_sortAscHdv ? "bi-arrow-up" : "bi-arrow-down") ms-1" style="font-size:0.65rem"></i>
                }
            </span>
            <button class="col-filter-btn @(hasFilter ? "active" : "")" @onclick:stopPropagation
                    @onclick="e => OpenColFilterAt(colKey, e)">
                <i class="bi @(hasFilter ? "bi-funnel-fill" : "bi-funnel")"></i>
            </button>
        </span>
    };

    void BuildColFilters()
    {
        if (!_rows.Any()) return;
        _colFilters = new Dictionary<string, HandoverColFilterDef>
        {
            ["PlanNo"]        = HandoverColFilterDef.Build(_rows, r => r.PlanNo),
            ["PurchaseOrder"] = HandoverColFilterDef.Build(_rows, r => r.PurchaseOrder),
            ["PartNo"]        = HandoverColFilterDef.Build(_rows, r => r.PartNo),
        };
    }

    private class HandoverColFilterDef
    {
        public List<string>    AllValues      { get; set; } = new();
        public HashSet<string> ExcludedValues { get; set; } = new();
        public string          SearchText     { get; set; } = string.Empty;
        public bool IsActive   => !string.IsNullOrEmpty(SearchText) || ExcludedValues.Count > 0;
        public bool IsChecked(string v) => !ExcludedValues.Contains(v);
        public bool Passes(string v) =>
            (string.IsNullOrEmpty(SearchText) || v.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            && !ExcludedValues.Contains(v);
        public static HandoverColFilterDef Build(List<LedgerRow> rows, Func<LedgerRow, string> selector)
            => new HandoverColFilterDef { AllValues = rows.Select(selector).Distinct().OrderBy(v => v).ToList() };
    }
}
