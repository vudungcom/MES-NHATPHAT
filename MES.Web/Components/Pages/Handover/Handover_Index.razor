    /// <summary>[VULOI] Phiếu chờ nhận có mang vụ không (phiếu trả tự lập, phiếu lấy từ ô Hàng lỗi / Hàng sửa). Bên nhận không chọn vụ.</summary>
    static bool RecvCarry(HandoverTxPending p)
        => p.IsAutoReturn || p.NgCaseId != null || HandoverCell.IssueCellOf(PendingPurpose(p), p.FromCell) is HandoverCell.Loi or HandoverCell.Sua;

    /// <summary>[VULOI] Nhãn mã vụ nhỏ trong Lịch sử phiếu.</summary>
    // ── [LS-THOIGIAN 2026-11-12] Lịch sử phiếu xếp theo giờ (cũ → mới / mới → cũ) + lọc theo mã vụ — chỉ hiển thị. Nguồn: KHÁCH 12/11 (test giao nhận TH4, TH6); HÙNG 12/11 17:50 ──
    bool _logAsc = true;
    long? _logCase;
    List<long> _logCaseIds = new();
    Dictionary<string, int> _logOrd = new();
    string LogOrderText => _logAsc ? "Cũ → mới" : "Mới → cũ";
    int OrdBu(long id) => _logOrd.TryGetValue("U" + id, out var o) ? o : 0;
    int OrdNg(long id) => _logOrd.TryGetValue("B" + id, out var o) ? o : 0;
    int OrdRp(long id) => _logOrd.TryGetValue("R" + id, out var o) ? o : 0;
    int OrdTx(long id) => _logOrd.TryGetValue("T" + id, out var o) ? o : 0;
    bool LogCaseOk(long? caseId) => _logCase == null || caseId == _logCase;
    bool TxCaseOk(HandoverLogItem t) => _logCase == null || t.NgCaseId == _logCase || t.Receives.Any(r => r.NgCaseId == _logCase);
    void RebuildLogOrder()
    {
        var all = new List<(string Key, DateTime At)>();
        all.AddRange(_buLogs.Select(x => ("U" + x.Id, x.ReceivedAt)));
        all.AddRange(_ngLogs.Select(x => ("B" + x.Id, x.CreatedAt)));
        all.AddRange(_repairLogs.Select(x => ("R" + x.Id, x.CreatedAt)));
        all.AddRange(_logItems.Select(x => ("T" + x.HandoverTxId, x.IssuedAt)));
        var sorted = _logAsc ? all.OrderBy(x => x.At).ThenBy(x => x.Key).ToList() : all.OrderByDescending(x => x.At).ThenByDescending(x => x.Key).ToList();
        _logOrd = sorted.Select((x, i) => (x.Key, i)).ToDictionary(x => x.Key, x => x.i);
        _logCaseIds = _buLogs.Select(x => (long?)x.NgCaseId).Concat(_ngLogs.Select(x => x.NgCaseId)).Concat(_repairLogs.Select(x => x.NgCaseId))
            .Concat(_logItems.Select(x => x.NgCaseId)).Concat(_logItems.SelectMany(x => x.Receives).Select(r => r.NgCaseId))
            .Where(x => x is > 0).Select(x => x!.Value).Distinct().OrderBy(x => x).ToList();
        if (_logCase is long lc && !_logCaseIds.Contains(lc)) _logCase = null;
    }
    void ToggleLogOrder() { _logAsc = !_logAsc; RebuildLogOrder(); }
