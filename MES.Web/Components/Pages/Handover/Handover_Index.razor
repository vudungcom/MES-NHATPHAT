    // ── Modal Nhận ────────────────────────────────────────────────────
    void OpenReceiveModal(LedgerRow row)
    {
        _selectedRow      = row;
        _receiveToGroup   = _myEditGroups.Count == 1 ? _myEditGroups[0] : "";
        _pendingTxs       = new();
        _expandedTxId     = 0;
        ResetReceiveInputs();
        _modalError       = "";
        _showReceiveModal = true;
        if (_myEditGroups.Count == 1) _ = LoadPendingAsync();
    }

    void ResetReceiveInputs()
    {
        _receiveQtyOk = 0; _receiveQtyNg = 0; _receiveNotes = "";
        _receiveCatId = null;   // [VULOI]
        _receiveCell = ""; _receiveCellReason = "";   // [GN-CELL2]
        _receiveNc = ""; _receiveNcReason = "";       // [NHAN-DOI-O-NC]
    }

    void ToggleExpandTx(long txId)
    {
        _expandedTxId = _expandedTxId == txId ? 0 : txId;
        if (_expandedTxId != 0) _expandedRepairId = 0;   // [GC-SUA-TAI-CHO] chỉ mở 1 khối nhập (lời báo không hiện 2 nơi)
        ResetReceiveInputs();
        _modalError = "";
        // [G16-NHAN-CHONSAN] phiếu Workflow ON không nhận được vào ô bên giao chỉ định → chọn sẵn ô Hàng lỗi + lý do điền sẵn (sửa được)
        var pendX = _pendingTxs.FirstOrDefault(x => x.HandoverTxId == _expandedTxId);
        if (pendX != null && RecvMustLoi(pendX)) { _receiveCell = HandoverCell.Loi; _receiveCellReason = RecvMustLoiReason; }
    }

    async Task LoadPendingAsync()
    {
        if (_selectedRow == null || string.IsNullOrEmpty(_receiveToGroup)) return;
        _expandedTxId = 0;
        ResetReceiveInputs();
        _pendingTxs = await HandoverSvc.GetPendingForGroupAsync(_selectedRow.KhPlanDetailId, _receiveToGroup);
        await LoadKcsRepairsAsync();   // [GC-SUA-TAI-CHO]
        await InvokeAsync(StateHasChanged);
    }

    async Task ConfirmReceiveAsync(long txId)
    {
        if (_saving) return;   // [D10-DBLCLICK 29/10] bấm đúp: lần 2 tới trước khi nút kịp khoá → bỏ qua (trước: 2 phiếu / 2 lần nhận cùng lọt trần)
        _modalError = "";
        _saving     = true;
        // [GN-CELL2] ô bên nhận chọn (null = phiếu không có ô: theo NC / phiếu tự lập); đổi khác chỉ định phải có lý do
        var pend = _pendingTxs.FirstOrDefault(x => x.HandoverTxId == txId);
        string? cell = pend == null ? null : RecvCellOf(pend);
        if (pend != null && cell != null && cell != pend.ToCell && string.IsNullOrWhiteSpace(_receiveCellReason))
        { _modalError = "Đổi phân loại khác bên giao chỉ định: bắt buộc ghi lý do."; _saving = false; return; }
        if (pend != null && pend.IsAutoReturn) cell = null;
        if (pend != null && RecvNcEarlier(pend) && _receiveNcReason.Trim().Length < HandoverForm.NcReasonMin)   // [NHAN-DOI-O-NC] máy chủ cũng kiểm
        { _modalError = $"Ghi lý do chọn NC này (ít nhất {HandoverForm.NcReasonMin} ký tự)."; _saving = false; return; }
        // [VULOI] lần nhận sinh vụ mới (phiếu không mang vụ + vào ô Hàng lỗi / Hàng sửa, hoặc có NG lúc nhận): bắt chọn loại lỗi
        if (pend != null && !RecvCarry(pend) && (RecvLoi(pend) || RecvSua(pend) || _receiveQtyNg > 0) && _receiveCatId == null)
        { _modalError = NgCaseService.MsgPickCategory; _saving = false; return; }
        // [GN-RECV-SUA] ô Hàng sửa không gửi NG (ô NG khoá xám)
        try   // [PAGE-ERR 2026-10-31]
        {
        (bool ok, string err) = await HandoverSvc.ReceiveAsync(txId, cell == HandoverCell.Loi ? 0 : _receiveQtyOk, cell == HandoverCell.Sua ? 0 : _receiveQtyNg, null, _currentUserId, _receiveNotes,
            toCell: cell, toCellReason: cell != null && pend != null && cell != pend.ToCell ? _receiveCellReason : null,
            ngCategoryId: _receiveCatId,   // [VULOI] lỗi chọn từ DS Lỗi (trước: _receiveNgReason gõ tay)
            toNc: pend != null && RecvNcApplies(pend) && !string.IsNullOrEmpty(_receiveNc) ? _receiveNc : null,   // [NHAN-DOI-O-NC] trống = máy chủ tự điền NC theo vụ
            toNcReason: pend != null && RecvNcEarlier(pend) ? _receiveNcReason : null);
        _saving = false;
        if (!ok) { _modalError = err; return; }
        _expandedTxId = 0;
        ResetReceiveInputs();
        if (_selectedRow != null)
        {
            var id = _selectedRow.KhPlanDetailId;
            await ReloadAfterSaveAsync(async () =>   // [PAGE-ERR2] đã nhận xong: lỗi tải lại không báo "xem đã lưu chưa"
            {
                _pendingTxs = await HandoverSvc.GetPendingForGroupAsync(id, _receiveToGroup);
                await ReloadRowAsync(id);
            });
        }
        }
        catch (Exception ex) { _modalError = ServerErr(ex); }   // [PAGE-ERR]
        finally { _saving = false; }
    }

    static string PendingPurpose(HandoverTxPending p)
        => p.Purpose ?? (p.IsReturnNg ? HandoverPurpose.NgReturn : HandoverPurpose.New);

    // [GN-RECV-NG2] Nhận vào ô Hàng lỗi: ô "đạt" khoá xám, chỉ nhập ô Hàng lỗi. [GN-CELL2] xét theo ô bên nhận đang chọn (trước: theo loại phiếu)
    // ── [NHAN-DOI-O-NC 2026-11-06] NC nhận vào Gia công của lần nhận (SQL 14): nhận vào Gia công ô Hàng lỗi đã xử lý / Hàng mới, phiếu không có NC
    //   (vd phiếu mang vụ giao ô Hàng lỗi, bên nhận đổi ô). Cùng hàm máy chủ kiểm (HandoverForm.CaseNextNc / NcOptions / CheckNextNc — K2):
    //   mặc định NC của vụ, chỉ lùi về NC trước kèm lý do; hàng lỗi cũ chưa mã vụ = như hàng mới, chọn NC khác kèm lý do. Trước: luôn vào NC đầu.
    bool RecvNcApplies(HandoverTxPending p)
        => _selectedRow != null && _receiveToGroup == "GC" && !p.IsAutoReturn && string.IsNullOrEmpty(p.ToNC)
           && RecvCellOf(p) is HandoverCell.Xl or HandoverCell.Moi
           && p.ToCell is HandoverCell.Loi or HandoverCell.Sua   // rà độc lập C1: chỉ khi đổi từ ô Hàng lỗi / Hàng sửa (phiếu chỉ định ô đạt: bên giao đã chọn NC)
           && p.Purpose is not (HandoverPurpose.HelpSend or HandoverPurpose.HelpReturn)
           && _selectedRow.G("GC").Steps.Any(s => !s.IsExcluded && !HandoverLedgerService.IsVao(s.Code));
    long RecvNcCase(HandoverTxPending p) => RecvCarry(p) ? (p.NgCaseId ?? 0) : 0;
    List<HandoverForm.NcOpt> RecvNcOpts(HandoverTxPending p)
        => !RecvNcApplies(p) ? new()
           : HandoverForm.NcOptions(_selectedRow!, HandoverForm.CaseNextNc(_selectedRow!, RecvNcCase(p), "GC"), free: RecvNcCase(p) == 0, allowEarlier: !_selectedRow!.ApplyWorkflow)   // [SUA-KHONG-LUI] ON: không làm lại NC trước
               // [KHO-NC-DAU 2026-11-10] (rà độc lập Gói 13 T2) phiếu Kho, hàng như hàng mới: chỉ NC đầu — cùng luật máy chủ ReceiveNc
               .Where(o => !(p.FromGroupCode == "KHO" && _selectedRow!.ApplyWorkflow && HandoverForm.CaseNextNc(_selectedRow!, RecvNcCase(p), "GC") == null) || HandoverForm.KhoNcOk(_selectedRow!, o.Code)).ToList();
    static string RecvNcKey(HandoverForm.NcOpt o) => o.Default ? "" : o.Code ?? HandoverService.FormNewNc;
    bool RecvNcEarlier(HandoverTxPending p) => !string.IsNullOrEmpty(_receiveNc) && RecvNcOpts(p).FirstOrDefault(o => RecvNcKey(o) == _receiveNc)?.Earlier == true;
    void OnRecvNcChanged(ChangeEventArgs e) { _receiveNc = e.Value?.ToString() ?? ""; _receiveNcReason = ""; _modalError = ""; }
    RenderFragment RecvNcPicker(HandoverTxPending p) => __builder =>
    {
        var opts = RecvNcOpts(p);
        if (opts.Count == 0) return;
        <div class="mb-2">
            <label class="form-label form-label-sm fw-semibold mb-1">Nhận vào NC (làm tiếp)</label>
            <select class="form-select form-select-sm" @onchange="OnRecvNcChanged">
                @foreach (var o in opts)
                {
                    <option value="@RecvNcKey(o)" selected="@(RecvNcKey(o) == _receiveNc)">@o.Label</option>
                }
            </select>
            @if (RecvNcEarlier(p))
            {
                <label class="form-label form-label-sm mt-1 mb-1">Lý do chọn NC này <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm" maxlength="200" @bind="_receiveNcReason" />
            }
        </div>
    };

    /// <summary>[SUA-QUA-KCS 2026-11-11] Ô nhận chọn được: Workflow ON, phiếu chỉ định ô Hàng lỗi / Hàng sửa không đổi sang ô Hàng lỗi đã xử lý / Hàng mới
    ///   (coi như đã sửa đạt mà chưa qua KCS xác nhận — máy chủ cũng chặn, HandoverService.ReceiveOnceAsync). OFF như cũ. Nguồn: HÙNG 11/11 15:34 (B1).</summary>
    IEnumerable<string> RecvCellOpts(HandoverTxPending p)
        => HandoverCell.ReceiveCells.Where(c => (c == p.ToCell && !RecvMustLoi(p)) || !(_selectedRow?.ApplyWorkflow == true   // [G16-NHAN-CHONSAN] ô chỉ định bị chặn thì ẩn
               && (HandoverForm.SuaQuaKcsBlocked(p.ToCell, c) || HandoverForm.SuaQuaKcsBlocked(p.IsAutoReturn ? null : PendFromCell(p), c)   // rà độc lập T3: theo cả ô bên giao lấy · [G16-NHAN-CHONSAN] ô như sổ
                   || (PendFromCell(p) == HandoverCell.Xl && c is not (HandoverCell.Xl or HandoverCell.Loi)))));   // rà độc lập T2: phiếu hàng đã sửa

    // [G16-NHAN-CHONSAN 2026-11-12] Workflow ON, phiếu lấy từ ô Hàng lỗi / Hàng sửa (chưa qua KCS xác nhận) mà bên giao chỉ định ô Hàng lỗi đã xử lý / Hàng mới
    //   (phiếu lập lúc OFF / trước Gói 16, hoặc phiếu "Trả hàng đã sửa" rất cũ không ghi ô bên giao): máy chủ chặn nhận vào ô đạt (HandoverService.ReceiveOnceAsync
    //   [SUA-QUA-KCS]) — trang chọn sẵn ô Hàng lỗi, ẩn ô chỉ định, hiện cảnh báo; trước: chọn sẵn ô chỉ định, bấm Nhận mới báo lỗi. Không đổi máy chủ / số.
    //   Nguồn: CLAUDE (rà độc lập Gói 16 vòng 2 L2, sổ G16-NHAN-CHONSAN); HÙNG 12/11 08:11 OK làm.
    /// <summary>[G16-NHAN-CHONSAN] Ô bên giao đã lấy, đọc như sổ (HandoverLedgerService TxFromCell — phiếu cũ không ghi ô thì suy theo loại phiếu); không có thì theo phiếu.</summary>
    string? PendFromCell(HandoverTxPending p)
        => _selectedRow != null && _selectedRow.TxFromCell.TryGetValue(p.HandoverTxId, out var f) ? f : p.FromCell;
    bool RecvMustLoi(HandoverTxPending p)
        => _selectedRow?.ApplyWorkflow == true && !p.IsAutoReturn
           && PendFromCell(p) is HandoverCell.Loi or HandoverCell.Sua && p.ToCell is HandoverCell.Xl or HandoverCell.Moi;
    const string RecvMustLoiReason = "Workflow ON: hàng chưa qua KCS xác nhận — nhận vào ô Hàng lỗi";
    string RecvMustLoiText(HandoverTxPending p)
        => $"Phiếu lấy từ ô {HandoverCell.Label(PendFromCell(p))} (chưa qua KCS xác nhận) mà chỉ định ô {HandoverCell.Label(p.ToCell)}. "
         + "Workflow ON không nhận vào ô hàng đạt — đã chọn sẵn ô Hàng lỗi (lý do điền sẵn, sửa được). "
         + "Hoặc báo bên giao huỷ phiếu rồi ghi Kết quả sửa để KCS xác nhận.";

    /// <summary>[XL-CHU-KCS 2026-11-11] Chữ cho phiếu hàng đã sửa (ô Hàng lỗi đã xử lý, mang vụ): giữ ô / đã làm / KCS kiểm lại (cùng hàm sổ XlDest).
    ///   Nguồn: KHÁCH 11/11 ("KCS nhận hàng đã sửa vẫn kiểm lại nhưng WTS ghi Việc không làm ra SP").</summary>
    string? PendingXlNote(HandoverTxPending p)
    {
        if (p.FromCell != HandoverCell.Xl || p.ToCell != HandoverCell.Xl || p.NgCaseId is not long id || _selectedRow == null
            || !_selectedRow.Cases.TryGetValue(id, out var cs) || string.IsNullOrEmpty(_receiveToGroup)) return null;
        // rà độc lập Gói 16 (Trung T1): Gia công là nơi phát hiện → cùng đích như sổ (RepairTarget ≡ HandoverLedgerService.GcXlBack), không chỉ XlDest
        string note;
        if (_receiveToGroup == "GC")
        {
            var tg = cs.DetectGroup == "GC" ? HandoverForm.RepairTarget(_selectedRow, id, "GC") : null;
            note = tg == HandoverLedgerService.RepXong ? "hàng đã sửa — tính là xong NC cuối, không ghi WTS số lượng"
                 : tg == HandoverLedgerService.RepOk ? "hàng đã sửa — tính là xong NC của chiếc lỗi, không ghi WTS lại"
                 : null!;
            if (note != null) return note;   // rà vòng 2 L1: không phải dấu → theo XlDest như sổ (giữ ô / đã làm / chữ thường)
        }
        var d = HandoverLedgerService.XlDest(_receiveToGroup, cs.DetectGroup, cs.FromDa);
        note = HandoverLedgerService.XlStepNote(d, _receiveToGroup).Trim();
        return note.Length > 2 ? note[1..^1] : null;
    }

    string? RecvCellOf(HandoverTxPending p) => p.ToCell == null ? null : p.IsAutoReturn ? HandoverCell.Loi
        : !string.IsNullOrEmpty(_receiveCell) ? _receiveCell : RecvMustLoi(p) ? HandoverCell.Loi : p.ToCell;   // [G16-NHAN-CHONSAN]
    bool RecvLoi(HandoverTxPending p) => RecvCellOf(p) == HandoverCell.Loi;
    bool RecvSua(HandoverTxPending p) => RecvCellOf(p) == HandoverCell.Sua;   // [GN-RECV-SUA] nhận hàng gửi sửa: chỉ 1 ô số lượng
    void SelectRecvCell(HandoverTxPending p, string c)
    {
        var _prevCell = RecvCellOf(p);   // [RA-CASCADE 2026-11-01] ô đang chọn trước khi đổi
        _receiveCell = c; _modalError = "";
        _receiveNc = ""; _receiveNcReason = "";   // [NHAN-DOI-O-NC] đổi ô → NC về mặc định theo vụ
        // [G16-NHAN-CHONSAN] rà độc lập Gói 17 (Thấp): lý do điền sẵn chỉ đúng cho ô Hàng lỗi — sang ô khác thì xoá (người dùng ghi lý do riêng), về lại thì điền lại
        if (RecvMustLoi(p))
        {
            if (c != HandoverCell.Loi && _receiveCellReason == RecvMustLoiReason) _receiveCellReason = "";
            else if (c == HandoverCell.Loi && string.IsNullOrWhiteSpace(_receiveCellReason)) _receiveCellReason = RecvMustLoiReason;
        }
        // [RA-CASCADE 2026-11-01] Rời ô Hàng lỗi sang ô đạt (Hàng mới / Hàng lỗi đã xử lý): số đã dồn sang ô Hàng lỗi trả về ô đạt
        //   (trước: chọn Hàng lỗi rồi chọn lại Hàng mới → OK 0, NG = cả số → lưu thành "NG đếm thấy", tự lập phiếu trả NG oan).
        if (_prevCell == HandoverCell.Loi && c != HandoverCell.Loi && c != HandoverCell.Sua) { _receiveQtyOk += _receiveQtyNg; _receiveQtyNg = 0; }
        if (c == HandoverCell.Loi) { _receiveQtyNg += _receiveQtyOk; _receiveQtyOk = 0; }   // ô Hàng lỗi: dồn số sang ô Hàng lỗi
        if (c == HandoverCell.Sua) { _receiveQtyOk += _receiveQtyNg; _receiveQtyNg = 0; }   // [GN-RECV-SUA] ô Hàng sửa: dồn số sang ô Số lượng nhận
    }
