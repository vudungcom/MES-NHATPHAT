    string RepairVoidNote()
    {
        if (_voidMode == "KQ")
        {
            var r = _repairLogs.FirstOrDefault(x => x.Id == _voidingRepairId);
            return r == null ? "" : $"Huỷ Kết quả sửa #{r.Id} ({HandoverLedgerService.GroupLabel(r.GroupCode)}): đạt {r.QtyPass:0.##} + không đạt {r.QtyFail:0.##} về lại ô {HandoverCell.Label(r.SourceCell)}. "
                + "Nếu chiếc không đạt đã được giao / huỷ / trả khách thì phần mềm chặn — huỷ chứng từ đó trước.";
        }
        var rc = _repairLogs.FirstOrDefault(x => x.Checks.Any(c => c.Id == _voidingRepairCheckId));
        var ck = rc?.Checks.FirstOrDefault(c => c.Id == _voidingRepairCheckId);
        return rc == null || ck == null ? "" : $"Huỷ lần KCS xác nhận #{ck.Id} (Kết quả sửa #{rc.Id}: đạt {ck.QtyOk:0.##} / loại {ck.QtyNg:0.##}): số này về lại chờ KCS xác nhận. "
            + "Nếu hàng đạt đã nhập WTS / giao tiếp thì phần mềm chặn — xoá / sửa từ cuối ngược lên.";
    }

