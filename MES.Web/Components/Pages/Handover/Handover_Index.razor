    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var claimUser = authState.User;
        var userIdStr = claimUser.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdStr, out _currentUserId))
        {
            Nav.NavigateTo("/login");
            return;
        }
        // [RS-C2 2026-10-29] Quyền nhóm lấy THEO DB (GetAllUserPermissionsAsync đã trả đủ quyền cho Admin) — cùng nguồn với máy chủ
        //   (HandoverService kiểm lại khi lập / nhận). Trước: thêm nhánh tin claim "ADMIN" → tài khoản admin có nhóm bị khoá / claim cũ
        //   vẫn thấy nút mà máy chủ từ chối. (Bản cũ: isAdmin = claim Role / GroupCode "ADMIN" hoặc tên "admin".)
        var allPerms = await UserSvc.GetAllUserPermissionsAsync(_currentUserId);
        foreach (var (grp, key) in GroupPermKey)
        {
            allPerms.TryGetValue(key, out var p);
            _canViewGroup[grp] = p.CanView;
            _canEditGroup[grp] = p.CanEdit;
        }
        _canView      = _canViewGroup.Values.Any(v => v);
        _canEditAny   = _canEditGroup.Values.Any(v => v);
        _myEditGroups = _canEditGroup.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        _loaded       = true;

        if (_canView)
        {
            _customers = await Db.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).ToListAsync();
            _ngCats = await NgSvc.GetCategoriesAsync(true);   // [DS-LOI]
            await LoadDataAsync();
            // [GN-LIVE] Nghe "PO vừa đổi" từ mọi người dùng → tự tính lại đúng dòng đó, không cần F5.
            HandoverChangeNotifier.Changed += OnHandoverChanged;
            // [GN-LIVE] Lưới an toàn: 2 phút tính lại cả bảng (phòng lỡ tín hiệu). Trước: 60 giây chỉ cập nhật huy hiệu, bảng vẫn cũ tới khi F5.
            _refreshTimer = new System.Threading.Timer(_ => QueueLive(null), null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
        }
    }

    public void Dispose()
    {
        HandoverChangeNotifier.Changed -= OnHandoverChanged;   // [GN-LIVE]
        _refreshTimer?.Dispose();
        _disposed = true;
    }

    // =================================================================
    // [GN-LIVE 2026-10-24] Tự cập nhật khi người khác Giao / Nhận / Huỷ / nhập WTS / nhập phôi
    //   - Gom tín hiệu ~0,3 giây (nhập WTS nhiều dòng một lúc → 1 lần tính).
    //   - Tính bằng DbContext RIÊNG (scope mới) để không đụng DbContext của trang đang dùng cho thao tác người dùng
    //     (Blazor Server: 2 lệnh chạy chồng trên 1 DbContext sẽ lỗi).
    //   - Chỉ thay số trên màn hình. Form đang nhập dở không bị xoá; lúc lưu máy chủ vẫn kiểm trần / K5 như cũ.
    // =================================================================
    [Inject] IServiceScopeFactory ScopeFactory { get; set; } = default!;
    readonly object _liveLock = new();
    readonly HashSet<int> _liveIds = new();
    bool _liveAll, _liveRunning, _disposed;

    void OnHandoverChanged(int? detailId) => QueueLive(detailId);

    void QueueLive(int? detailId)
    {
        lock (_liveLock)
        {
            if (detailId == null) _liveAll = true; else _liveIds.Add(detailId.Value);
            if (_liveRunning) return;   // vòng đang chạy sẽ lấy tiếp
            _liveRunning = true;
        }
        _ = Task.Run(LiveLoopAsync);
    }

    async Task LiveLoopAsync()
    {
        try
        {
            while (!_disposed)
            {
                await Task.Delay(300);
                bool all; List<int> ids;
                lock (_liveLock)
                {
                    all = _liveAll; ids = _liveIds.ToList();
                    _liveAll = false; _liveIds.Clear();
                    if (!all && ids.Count == 0) { _liveRunning = false; return; }
                }
                try { await LiveApplyAsync(all, ids); }
                catch { /* màn hình tự thử lại ở tín hiệu sau / lưới 2 phút; không làm hỏng trang */ }
            }
        }
        finally { lock (_liveLock) { if (_disposed) _liveRunning = false; } }
    }

    async Task LiveApplyAsync(bool all, List<int> ids)
    {
        // Chụp trạng thái trang (đọc trên luồng của trang)
        int? custId = null, month = null; int year = 0; HashSet<int> shown = new(); int? expanded = null;
        int? selId = null; bool recvOpen = false; string recvGroup = ""; long recvExpanded = 0;
        await InvokeAsync(() =>
        {
            custId = _filterCustomerId > 0 ? _filterCustomerId : null;
            month  = _filterMonth > 0 ? _filterMonth : null;
            year   = _filterYear;
            shown  = _rows.Select(r => r.KhPlanDetailId).ToHashSet();
            expanded = _expandedDetailId;
            selId = _selectedRow?.KhPlanDetailId;
            recvOpen = _showReceiveModal; recvGroup = _receiveToGroup; recvExpanded = _expandedTxId;
        });
        if (!all) ids = ids.Where(shown.Contains).ToList();   // PO ngoài bộ lọc hiện tại: bỏ qua
        if (!all && ids.Count == 0) return;

        using var scope = ScopeFactory.CreateScope();
        var db  = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var led = new HandoverLedgerService(db);
        var svc = new HandoverService(db);

        List<LedgerRow>? fullRows = null;
        var fresh = new Dictionary<int, LedgerRow>();
        if (all) fullRows = await led.GetLedgerAsync(customerId: custId, month: month, year: year);
        else foreach (var id in ids) { var r = await led.GetLedgerForDetailAsync(id); if (r != null) fresh[id] = r; }

        var badgeIds = (fullRows?.Select(r => r.KhPlanDetailId) ?? shown).ToList();
        Dictionary<int, int>? pc = null, pic = null;
        if (_myEditGroups.Any() && badgeIds.Any())
        {
            pc  = await AddRepairPendingAsync(svc, badgeIds, _myEditGroups, await svc.GetPendingCountPerDetailAsync(badgeIds, _myEditGroups));   // [GC-SUA-TAI-CHO]
            pic = await svc.GetPendingIssuedCountPerDetailAsync(badgeIds, _myEditGroups);
        }
        bool touched(int id) => all || ids.Contains(id);
        List<LedgerStepRow>? steps = expanded != null && touched(expanded.Value) ? await led.GetStepsForDetailAsync(expanded.Value) : null;
        NgTrace? ngTrace = steps != null ? await led.GetNgTraceAsync(expanded!.Value) : null;   // [GN-NG-TRACE]
        // Modal Nhận đang mở ở danh sách (chưa bung phiếu nào để nhập): làm mới danh sách phiếu chờ. Đang nhập dở thì để nguyên.
        List<HandoverTxPending>? pend = recvOpen && recvExpanded == 0 && selId != null && touched(selId.Value) && !string.IsNullOrEmpty(recvGroup)
            ? await svc.GetPendingForGroupAsync(selId.Value, recvGroup) : null;
        // [GC-SUA-TAI-CHO] danh sách hàng sửa chờ KCS trong modal Nhận · KCS
        List<HandoverRepairItem>? kcsList = recvOpen && recvExpanded == 0 && selId != null && touched(selId.Value) && recvGroup == HandoverService.RepairCheckGroup
            ? (await svc.GetRepairsAsync(selId.Value)).Where(r => r.Waiting > 0).OrderBy(r => r.CreatedAt).ToList() : null;

        await InvokeAsync(() =>
        {
            if (_disposed) return;
            if (fullRows != null) { _rows = fullRows; BuildColFilters(); }
            else
                foreach (var (id, r) in fresh)
                {
                    var idx = _rows.FindIndex(x => x.KhPlanDetailId == id);
                    if (idx >= 0) _rows[idx] = r;
                }
            if (_selectedRow != null)
            {
                var sr = _rows.FirstOrDefault(x => x.KhPlanDetailId == _selectedRow.KhPlanDetailId);
                if (sr != null) _selectedRow = sr;
            }
            if (pc != null) _pendingCountPerDetail = pc;
            if (pic != null) _pendingIssuedCountPerDetail = pic;
            if (steps != null && _expandedDetailId == expanded) { _steps = steps; _ngTrace = ngTrace; }   // [GN-NG-TRACE] + hàng lỗi
            if (pend != null && _showReceiveModal && _expandedTxId == 0 && _receiveToGroup == recvGroup && _selectedRow?.KhPlanDetailId == selId) _pendingTxs = pend;
            if (kcsList != null && _showReceiveModal && _expandedRepairId == 0 && _expandedTxId == 0 && _receiveToGroup == recvGroup && _selectedRow?.KhPlanDetailId == selId) _kcsRepairs = kcsList;   // [GC-SUA-TAI-CHO] (rà độc lập T3)
            if (_explain != null) RefreshExplain();
            StateHasChanged();
        });
    }

    async Task LoadDataAsync()
    {
        _rows = await LedgerSvc.GetLedgerAsync(
            customerId: _filterCustomerId > 0 ? _filterCustomerId : null,
            month:      _filterMonth > 0      ? _filterMonth      : null,
            year:       _filterYear);
        BuildColFilters();
        await LoadBadgesAsync();
        if (_explain != null) RefreshExplain();
        if (_expandedDetailId != null) await LoadStepsAsync(_expandedDetailId.Value);
        StateHasChanged();
    }

    async Task LoadBadgesAsync()
    {
        if (!_myEditGroups.Any() || !_rows.Any()) return;
        var ids = _rows.Select(r => r.KhPlanDetailId).ToList();
        _pendingCountPerDetail       = await AddRepairPendingAsync(HandoverSvc, ids, _myEditGroups,
                                           await HandoverSvc.GetPendingCountPerDetailAsync(ids, _myEditGroups));   // [GC-SUA-TAI-CHO] + hàng sửa chờ KCS
        _pendingIssuedCountPerDetail = await HandoverSvc.GetPendingIssuedCountPerDetailAsync(ids, _myEditGroups);
    }

    /// <summary>[GC-SUA-TAI-CHO] Người có quyền Sửa KCS: số trên nút Nhận cộng thêm số Kết quả sửa đang chờ KCS xác nhận.</summary>
    static async Task<Dictionary<int, int>> AddRepairPendingAsync(HandoverService svc, List<int> ids, List<string> groups, Dictionary<int, int> pc)
    {
        if (!groups.Contains(HandoverService.RepairCheckGroup)) return pc;
        var rp = await svc.GetRepairPendingCountPerDetailAsync(ids);
        var res = new Dictionary<int, int>(pc);
        foreach (var kv in rp) res[kv.Key] = (res.TryGetValue(kv.Key, out var v) ? v : 0) + kv.Value;
        return res;
    }

    async Task ReloadRowAsync(int detailId)
    {
        _ngCats = await NgSvc.GetCategoriesAsync(true);   // [DS-LOI] lấy lại danh mục (có thể vừa được thêm)
        var fresh = await LedgerSvc.GetLedgerForDetailAsync(detailId);
        var idx = _rows.FindIndex(r => r.KhPlanDetailId == detailId);
        if (fresh != null && idx >= 0) _rows[idx] = fresh;
        if (_selectedRow != null && _selectedRow.KhPlanDetailId == detailId && fresh != null) _selectedRow = fresh;
        await LoadBadgesAsync();
        if (_explain != null) RefreshExplain();
        if (_expandedDetailId == detailId) await LoadStepsAsync(detailId);
    }

    // [GN-CELL] các dòng B1..Bn
    async Task LoadStepsAsync(int detailId)
    {
        _stepsLoading = true;
        try
        {
            _steps = await LedgerSvc.GetStepsForDetailAsync(detailId);
            _ngTrace = await LedgerSvc.GetNgTraceAsync(detailId);   // [GN-NG-TRACE]
