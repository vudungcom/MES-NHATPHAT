                                <div class="text-muted" style="font-size:10px">Vào ô Hàng lỗi đã xử lý của @HandoverLedgerService.GroupLabel(r.GroupCode)@(string.IsNullOrEmpty(r.ToNC) ? "" : " · " + HandoverLedgerService.RepMarkText(r.ToNC))</div>   @* [SUA-XL-GIU] *@
                            </div>
                            <div class="col-6">
                                <label class="form-label form-label-sm fw-semibold text-danger">KCS loại (chưa đạt)</label>
