    static bool IsNgPurpose(string p) => p is HandoverPurpose.NgReturn or HandoverPurpose.RepairSend or HandoverPurpose.Scrap or HandoverPurpose.CustReturn; // [GN-NG-OUT]

    string? RouteError => string.IsNullOrEmpty(_issueFrom) || string.IsNullOrEmpty(_issueTo) || string.IsNullOrEmpty(_issuePurpose)
        ? null : HandoverLedgerService.CheckRoute(_issueFrom, _issueTo, _issuePurpose);

    void OpenIssueModal(LedgerRow row)
    {
        _selectedRow  = row;
        _issueGroups  = _myEditGroups.ToList();
        _issueFrom    = _issueGroups.Count == 1 ? _issueGroups[0] : "";
        _issueTo      = "";
        _issuePurpose = "";
        _issueFromNC  = "";
        _issueToNC    = "";
        _issueQty     = 0;
        _issueReason  = "";
        _issueNotes   = "";
        _modalError   = "";
        _showIssueModal = true;
    }

    void OnIssueFromChanged(ChangeEventArgs e)
    {
        _issueFrom = e.Value?.ToString() ?? "";
        _issuePurpose = ""; _issueTo = ""; _issueFromNC = ""; _issueToNC = ""; _issueQty = 0;
    }

    void SelectPurpose(string code)
    {
        _issuePurpose = code;
        _issueFromNC  = "";
        _issueToNC    = "";
        _modalError   = "";
        // Gợi ý nhóm nhận mặc định cho Hàng mới: nhóm kế tiếp
        if (code == HandoverPurpose.New)
            _issueTo = _issueFrom switch { "KHO" => "GC", "GC" => "HTSP", "HTSP" => "KCS", "KCS" => "PKG", "PKG" => "KHO", _ => "" };
        else if (code == HandoverPurpose.HelpReturn)
            _issueTo = "GC";
        else if (HandoverPurpose.IsOut(code))
            _issueTo = HandoverPurpose.OutTarget(code)!;   // [GN-NG-OUT]
        else
            _issueTo = "";
        if (_selectedRow != null)
            _issueQty = HandoverLedgerService.IssueCap(_selectedRow, _issueFrom, code, null).Max;
    }

    void OnFromNcChanged(ChangeEventArgs e)
    {
        _issueFromNC = e.Value?.ToString() ?? "";
        if (_selectedRow != null && !string.IsNullOrEmpty(_issueFromNC))
            _issueQty = HandoverLedgerService.IssueCap(_selectedRow, _issueFrom, _issuePurpose, _issueFromNC).Max;
    }

    void OnIssueToChanged(ChangeEventArgs e) { _issueTo = e.Value?.ToString() ?? ""; _issueToNC = ""; }
    void OnToNcChanged(ChangeEventArgs e) => _issueToNC = e.Value?.ToString() ?? "";

    async Task ConfirmIssueAsync()
    {
        if (_selectedRow == null) return;
        _modalError = "";
        if (string.IsNullOrEmpty(_issueFrom))    { _modalError = "Chọn nhóm giao."; return; }
        if (string.IsNullOrEmpty(_issuePurpose)) { _modalError = "Chọn loại phiếu."; return; }
        if (string.IsNullOrEmpty(_issueTo))      { _modalError = "Chọn nhóm nhận."; return; }
        if (RouteError != null)                  { _modalError = RouteError; return; }
        if (_issueQty <= 0)                      { _modalError = "Số lượng phải lớn hơn 0."; return; }
        _saving = true;
        var detailId = _selectedRow.KhPlanDetailId;
        (bool ok, string err) = await HandoverSvc.IssueAsync(
            detailId, _issueFrom, _issueTo, _issueQty, _currentUserId,
            fromNC:   string.IsNullOrEmpty(_issueFromNC) ? null : _issueFromNC,
            notes:    _issueNotes,
            toNC:     string.IsNullOrEmpty(_issueToNC) ? null : _issueToNC,
            ngReason: _issueReason,
            purpose:  _issuePurpose);
        _saving = false;
        if (!ok) { _modalError = err; await ReloadRowAsync(detailId); return; }
        CloseModals();
        await ReloadRowAsync(detailId);
    }

    // ── Modal Nhận ────────────────────────────────────────────────────
    void OpenReceiveModal(LedgerRow row)
    {
        _selectedRow      = row;
        _receiveToGroup   = _myEditGroups.Count == 1 ? _myEditGroups[0] : "";
        _pendingTxs       = new();
        _expandedTxId     = 0;
        ResetReceiveInputs();
        _modalError       = "";
        _showReceiveModal = true;
        if (_myEditGroups.Count == 1) _ = LoadPendingAsync();
    }

    void ResetReceiveInputs()
    {
        _receiveQtyOk = 0; _receiveQtyNg = 0; _receiveNgReason = ""; _receiveNotes = "";
    }

    void ToggleExpandTx(long txId)
    {
        _expandedTxId = _expandedTxId == txId ? 0 : txId;
        ResetReceiveInputs();
        _modalError = "";
    }

    async Task LoadPendingAsync()
    {
        if (_selectedRow == null || string.IsNullOrEmpty(_receiveToGroup)) return;
        _expandedTxId = 0;
        ResetReceiveInputs();
        _pendingTxs = await HandoverSvc.GetPendingForGroupAsync(_selectedRow.KhPlanDetailId, _receiveToGroup);
        await InvokeAsync(StateHasChanged);
    }

    async Task ConfirmReceiveAsync(long txId)
    {
        _modalError = "";
        _saving     = true;
        (bool ok, string err) = await HandoverSvc.ReceiveAsync(txId, _receiveQtyOk, _receiveQtyNg, _receiveNgReason, _currentUserId, _receiveNotes);
        _saving = false;
        if (!ok) { _modalError = err; return; }
        _expandedTxId = 0;
        ResetReceiveInputs();
        if (_selectedRow != null)
        {
            var id = _selectedRow.KhPlanDetailId;
            _pendingTxs = await HandoverSvc.GetPendingForGroupAsync(id, _receiveToGroup);
            await ReloadRowAsync(id);
        }
    }

