    void VoidBuFromLog(long id)
    {
        _voidMode = "BU"; _voidingBuId = id;
        _voidingTxId = 0; _voidingReceiveId = 0; _voidingNgId = 0; _voidingRepairId = 0; _voidingRepairCheckId = 0;
