    async Task ConfirmVoidIssueAsync()
    {
        if (string.IsNullOrWhiteSpace(_voidReason) || _voidReason.Trim().Length < 3)
        {
            _modalError = "Nhập lý do huỷ (ít nhất 3 ký tự).";
            return;
