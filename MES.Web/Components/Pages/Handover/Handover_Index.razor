    void CloseVoidConfirm() => _showVoidConfirm = false;

    async Task ConfirmVoidIssueAsync()
    {
        if (_saving) return;   // [D10-DBLCLICK 29/10] bấm đúp: lần 2 tới trước khi nút kịp khoá → bỏ qua (trước: 2 phiếu / 2 lần nhận cùng lọt trần)
        if (string.IsNullOrWhiteSpace(_voidReason) || _voidReason.Trim().Length < 3)
        {
            _modalError = "Nhập lý do huỷ (ít nhất 3 ký tự).";
            return;
        }
        _saving = true;
        // [GN-VOID-RULE] 3 kiểu huỷ; máy chủ kiểm quyền (người lập/nhận hoặc nhóm) + K5 (huỷ xong ô nào âm, kể cả WTS từng mã CV, thì không lưu)
        (bool ok, string err) result;
        if (_voidMode == "NG")   // [GN-NG-AFTER]
            result = await HandoverSvc.VoidNgReportAsync(_voidingNgId, _voidReason.Trim(), _currentUserId, _myEditGroups);
        else if (_voidMode == "RECV")
            result = await HandoverSvc.VoidReceiveAsync(_voidingReceiveId, _voidReason.Trim(), _currentUserId, _myEditGroups);
        else if (_voidMode == "CLOSE")
            result = await HandoverSvc.CloseRemainderAsync(_voidingTxId, _voidReason.Trim(), _currentUserId, _myEditGroups);
        else
            result = await HandoverSvc.VoidIssueAsync(_voidingTxId, _voidReason.Trim(), _currentUserId, _myEditGroups);
        (bool ok, string err) = result;
        _saving = false;
        if (!ok) { _modalError = err; return; }
        _showVoidConfirm = false;
        _voidingTxId     = 0;
        _voidingReceiveId = 0;
        _modalError      = "";
        _voidingNgId     = 0;   // [GN-NG-AFTER]
        _logItems = await HandoverSvc.GetLogsAsync(_logDetailId);
        _ngLogs   = await HandoverSvc.GetNgReportsAsync(_logDetailId);   // [GN-NG-AFTER]
        await ReloadRowAsync(_logDetailId);
    }

