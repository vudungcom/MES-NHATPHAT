        new("NhanSua",   "Hàng Sửa",          "Nhận", "Hàng nhóm khác gửi nhờ sửa — không tính vào số sản xuất", "", g => g.NhanSua, ""),
        new("NhanLoiXl", "Hàng lỗi đã xử lý", "Nhận", "Hàng sửa xong trả về nơi phát hiện — SP đã OK, nhập WTS tiếp được", "", g => g.NhanLoiXl, ""),
        new("GiaoMoi",   "Hàng Mới",          "Giao", "Phiếu Hàng mới đã lập (tính cả phiếu chờ nhận)", "", g => g.GiaoMoi, ""),
