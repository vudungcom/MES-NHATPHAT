        <span class="badge rounded-pill bg-primary me-1">@n</span>
    };

    // ── [KHACH-GUI-LAI 2026-11-11] Khách gửi bù ─────────────────────────────
    RenderFragment BuBlock() => __builder =>
    {
        <div class="mb-3">
            <div class="fw-semibold small mb-1">@StepNo(2) Bù cho @NgCaseNo.Term nào</div>
            @if (BuCaseList.Count == 0)
            {
                <div class="small text-muted">PO chưa có @NgCaseNo.Term nào đã trả khách / huỷ mà còn thiếu bù. Khách gửi dư thì sửa Số lượng thực nhận của phôi ở trang Kho.</div>
            }
