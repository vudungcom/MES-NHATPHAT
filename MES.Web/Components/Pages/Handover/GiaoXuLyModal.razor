@using MES.Web.Services
@using MES.Web.Data.Entities
@using MES.Web.Components.Shared
@inject HandoverService HandoverSvc
@inject MES.Web.Data.AppDbContext Db
@inject ILogger<GiaoXuLyModal> Logger

@* =====================================================================
   [GN-FORM1 2026-11-05] FORM "GIAO / XỬ LÝ HÀNG" — 1 form 4 bước (thay form Giao cũ + Báo lỗi sau khi nhận + Kết quả sửa + mục Khác)
   Nguồn: KHÁCH 05/11 15:43 (K1 gộp 1 form, mockup anh Ngọc duyệt https://claude.ai/artifact/NYkjoQBh4Pp8owvX38jLjD),
          KHÁCH 15:39 (K2 Gia công chọn theo "đã làm xong NC nào", sửa xong làm tiếp đúng NC kế), HÙNG 16:43 (K3 chữ bước 2),
          KHÁCH 04/11 16:09 + HÙNG 17:35 (K4 bỏ link đỏ Báo lỗi / link Kết quả sửa / mục Khác — gộp vào form này).
   Trang chỉ hiện + gửi lựa chọn. Số trên từng dòng đọc từ sổ chung (HandoverForm.FormPositions); máy chủ (HandoverService.SaveFormAsync)
   tự ánh xạ chứng từ, kiểm lại trần / quyền / vụ / NC làm tiếp, ghi 1 giao dịch + K5. Nhận (và KCS xác nhận chứng từ cũ ghi trước bản N17) vẫn ở nút Nhận.
   [N23-FORM6 2026-11-25] Luật N23 (khách chốt mockup 23/11 — Form chung, TH4, TH10): bước 2 mỗi mã vụ 1 dòng ("Đang giữ ở ô Hàng lỗi — VL… · Gia công trả"),
   hàng đã sửa chờ trả nằm ở "Hàng lỗi" (luật "hàng lỗi luôn đi từ ô Hàng lỗi"); bước 3 luôn đủ 6 nút (HandoverForm.FormButtons — nút xám ghi lý do ngay dưới);
   bước 4 ô bộ phận nhận luôn hiện + mặc định (Giao đến / Gửi đến / Trả đến); Sửa có "Đạt → giao đến"; nút Xác nhận chưa bấm được thì ghi rõ còn thiếu gì.
   Nguồn: KHÁCH 23/11 (mockup Form chung / TH4 / TH10, chat 16:03); HÙNG 23/11 16:24 (N23).
   ===================================================================== *@

<div class="mes-modal-backdrop">
    <div class="mes-modal" @onclick:stopPropagation style="width:560px;max-height:92vh;overflow-y:auto">
        <div class="mes-modal-header">
            <h6 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>Giao / xử lý hàng</h6>
            <button class="btn-close btn-sm" @onclick="CloseAsync"></button>
        </div>
        <div class="mes-modal-body">
            <div class="mb-2 p-2 bg-light rounded d-flex justify-content-between" style="font-size:12px">
                <span><strong>@Row.PartNo</strong> <span class="text-muted ms-1">@Row.PlanNo / @Row.PurchaseOrder</span></span>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-sm fw-semibold mb-1">Nhóm đang giữ hàng</label>
                @if (Groups.Count == 1)
                {
                    <div class="p-2 border rounded bg-light" style="font-size:13px"><strong>@HandoverLedgerService.GroupLabel(Groups[0])</strong></div>
                }
                else if (Groups.Count > 1)
                {
                    <select class="form-select form-select-sm" @onchange="OnGroupChanged">
                        <option value="" selected="@(string.IsNullOrEmpty(_group))">-- Chọn nhóm --</option>
                        @foreach (var g in Groups)
                        {
                            <option value="@g" selected="@(_group == g)">@HandoverLedgerService.GroupLabel(g)</option>
                        }
                    </select>
                }
                else
                {
                    <div class="alert alert-warning py-1 small mb-0">Tài khoản chưa được phân quyền nhóm Giao nhận. Liên hệ Admin cấp quyền HANDOVER_*.</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_group))
            {
                @StepKind()
                if (IsBu)
                {
                    @BuBlock()   @* [KHACH-GUI-LAI 2026-11-11] Kho nhận phôi khách gửi bù *@
                }
                else
                {
                    @StepPos()
                    @StepAction()
                    @StepDetail()
                }
            }

            @if (!string.IsNullOrEmpty(_err))
            {
                <div class="alert alert-danger py-1 small mt-2 mb-0" style="white-space:pre-line">@_err</div>
            }
            @if (!string.IsNullOrEmpty(_group) && string.IsNullOrEmpty(_err) && Missing() is string miss)
            {
                @* [N23-FORM6] nút Xác nhận chưa bấm được → ghi rõ còn thiếu gì (mockup Form chung) *@
                <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>@miss</div>
            }
        </div>
        <div class="mes-modal-footer">
            <button class="btn btn-sm btn-secondary" @onclick="CloseAsync">Huỷ</button>
            <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(_saving || !CanSave)">
                @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span><span>Đang xử lý...</span> }
                else { <span>Xác nhận</span> }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public LedgerRow Row { get; set; } = new();
    /// <summary>Nhóm người dùng có quyền Sửa (ma trận HANDOVER_*, đọc DB ở trang; máy chủ kiểm lại).</summary>
    [Parameter] public List<string> Groups { get; set; } = new();
    [Parameter] public int UserId { get; set; }
    [Parameter] public List<NgCategory> Cats { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Đã lưu (trang đóng form + tải lại PO).</summary>
    [Parameter] public EventCallback<int> OnSaved { get; set; }
    /// <summary>Lưu không được (trang tải lại số PO, form giữ nguyên lựa chọn).</summary>
    [Parameter] public EventCallback<int> OnFailed { get; set; }

    string  _err = "";        // lời báo của lần lưu (máy chủ trả về)

    string  _group = "";
    string  _kind  = "";      // TOT | LOI
    string  _pos   = "";      // FormPos.Id
    long?   _caseId;          // vụ (0 = hàng lỗi cũ)
    bool    _prev;
    string  _cause = "";
    string  _action = "";
    string  _to    = "";      // "" = mặc định
    string  _toCell = "";     // "" = theo lựa chọn
    string  _toNc  = "";
    decimal _qty;
    decimal _pass;
    decimal _fail;
    string  _ncNext = "";     // "" = mặc định của vụ; "@NEW" = như hàng mới; còn lại = mã NC
    string  _ncReason = "";
    int?    _catId;
    string  _notes = "";
    string  _suaTo = "";      // [N23-SUA-GIAO] "" = mặc định (nơi báo lỗi), NoGive = chưa giao, còn lại = mã nhóm
    bool    _posTot;          // [N23-FORM6] dòng đang chọn lấy từ danh sách Hàng tốt (hàng đã sửa chờ trả, hiện ở "Hàng lỗi")
    const string NoGive = "@NO";
    bool    _showOpt;
    bool    _saving;

    protected override void OnInitialized()
    {
        _group = Groups.Count == 1 ? Groups[0] : "";
    }

    // ── [KHACH-GUI-LAI 2026-11-11] Kho: "Khách gửi bù" — nhận phôi bù cho lần lỗi đã trả khách / huỷ (bảng HandoverReplacements).
    //   Nguồn: KHÁCH 10/11 vòng 1 câu 1a A + 1b A; HÙNG 11/11 14:39 duyệt. Trần cùng hàm máy chủ (HandoverLedgerService.BuCap), chặn cả Workflow OFF.
    const string BuKind = "BU";
    bool IsBu => _kind == BuKind && _group == HandoverService.BuGroup;
    List<LedgerCase> BuCaseList => IsBu ? HandoverLedgerService.BuCases(Row) : new();
    decimal BuMax => IsBu && _caseId is long bc ? HandoverLedgerService.BuCap(Row, bc).Max : 0;

    // ── Dữ liệu suy từ sổ (đọc lại mỗi lần vẽ: trang tự cập nhật số khi người khác lưu) ──
    // [N23-FORM6] Hàng tốt: không còn dòng hàng đã sửa chờ trả (chuyển sang "Hàng lỗi" — mockup TH10 bước 4); máy chủ vẫn nhận Kind TOT + TONXL như cũ.
    List<FormPos> Positions => string.IsNullOrEmpty(_group) || string.IsNullOrEmpty(_kind) || _kind == BuKind ? new()
        : HandoverForm.FormPositions(Row, _group, _kind == HandoverForm.Tot).Where(p => !(_kind == HandoverForm.Tot && p.HeldCell == HandoverCell.Xl)).ToList();
    /// <summary>[N23-FORM6] Dòng hàng đã sửa chờ trả (danh sách Hàng tốt của sổ) — hiện ở bước 2 của "Hàng lỗi".</summary>
    List<FormPos> TotXlPositions => string.IsNullOrEmpty(_group) || _kind != HandoverForm.Loi ? new()
        : HandoverForm.FormPositions(Row, _group, true).Where(p => p.HeldCell == HandoverCell.Xl).ToList();
    FormPos? Pos => _posTot ? TotXlPositions.FirstOrDefault(p => p.Id == _pos) : Positions.FirstOrDefault(p => p.Id == _pos);
    bool IsTot => _kind == HandoverForm.Tot || _posTot;
    bool IsFresh => !IsTot && Pos is { Fresh: true };
    bool IsHeld => Pos?.HeldCell != null && (!IsTot || IsXl);   // [SUA-XL-GIU] hàng tốt: dòng hàng đã sửa (theo vụ)
    /// <summary>[SUA-XL-GIU 2026-11-10] Dòng hàng đã sửa (Tồn hàng lỗi đã xử lý, theo vụ): Hàng tốt = trả tiếp nơi phát hiện; Hàng lỗi = trả lại ô Hàng lỗi [XL-TRA-LAI].
    ///   Nguồn: KHÁCH 10/11 vòng 1 (docx câu 2, hỏi tiếp 2.1 A); HÙNG 10/11 19:22.</summary>
    bool IsXl => Pos?.HeldCell == HandoverCell.Xl;
    List<LedgerCase> HeldCases => IsHeld ? Row.CasesHeldAt(_group, Pos!.HeldCell!) : new();
    LedgerCase? Case => _caseId == null ? null : HeldCases.FirstOrDefault(c => c.Id == _caseId);
    bool Ready => Pos != null && (!IsHeld || Case != null);
    // [N23-FORM6] nút Gửi bộ phận khác sửa / Trả nơi làm lỗi = Giao (máy chủ: Purpose NHO / TRA)
    string Act => !Ready ? "" : IsTot ? HandoverForm.AGiao : _action is HandoverForm.BNho or HandoverForm.BTra ? HandoverForm.AGiao : _action;
    bool IsGiao => Act == HandoverForm.AGiao;
    bool IsNho => !IsTot && _action == HandoverForm.BNho;
    bool IsTra => !IsTot && _action == HandoverForm.BTra;
    bool IsSua => Act == HandoverForm.ASua;
    bool HelpFrom => Pos?.HelpFrom != null;
    bool LamHo => IsTot && Pos is { LamHo: true };
    /// <summary>[TARO-LAMHO-NC] Hàng làm hộ bị lỗi (vụ giữ ô LAMHO): chỉ trả Gia công vào ô Hàng lỗi, cùng vụ.</summary>
    bool LamHoLoi => (IsHeld && Pos!.HeldCell == HandoverCell.LamHo) || (IsFresh && Pos is { LamHoNgW: true });   // [N21-NGW] + NG ở WTS Taro làm hộ chưa báo lỗi
    /// <summary>[N21-NGW 2026-11-25] Dòng "NG ở WTS chưa báo lỗi" (báo lỗi riêng — WTS không tự sinh mã vụ). Nguồn: KHÁCH 23/11 (mockup TH10 bước 2); HÙNG 23/11 16:24 (N21).</summary>
    bool IsNgW => IsFresh && Pos is { NgSource: HandoverNgSource.NgW };
    string FreshOrigin => IsNgW ? NgOrigin.WtsBao : NgOrigin.BaoLoi;
    // [KHO-TARO-THANG 2026-11-12] NC đầu Gia công là Taro (máy loại trừ): Kho giao phôi thẳng Taro (nhóm nhận HTSP, chọn sẵn — khách 12/11 3.3 b = A).
    //   Workflow ON: không giao Gia công (máy chủ chặn — KTT-CHI-TARO); OFF: Gia công vẫn chọn được, có cảnh báo (HÙNG 12/11 14:00 câu B1).
    bool KhoTaroPo => _group == "KHO" && HandoverLedgerService.KhoTaroRun(Row) != null;
    bool KhoTaro => IsTot && KhoTaroPo && Pos?.Id == "PHOI" && Dest == "HTSP";
    /// <summary>[KTT-PHOILOI 2026-11-12] HTSP: phôi lỗi Taro phát hiện khi đang làm hàng đoạn đầu chuỗi → chỉ trả Kho ô Hàng lỗi, nơi gây lỗi Khách hàng (khách 12/11 a = A).</summary>
    bool IsTaroPhoi => !IsTot && Pos is { TaroPhoi: true };

    // [TARO-LAMHO-NC] trả hàng làm hộ (hàng tốt): trần theo NC nhận (câu 1 — OK bộ Taro làm hộ của đoạn trước NC đó), cùng hàm máy chủ kiểm
    decimal Have => Pos == null ? 0 : IsHeld ? (Case == null ? 0 : Math.Max(0, Case.HeldAt(_group, Pos.HeldCell!)))
                  : LamHo ? HandoverLedgerService.IssueCap(Row, _group, HandoverPurpose.HelpReturn, null, null, string.IsNullOrEmpty(_toNc) ? null : _toNc).Max
                  : Pos.Have;

    /// <summary>[N23-FORM6] Nơi gây lỗi đã chọn (lỗi mới, có tích; Kho = khách) — đầu vào của 6 nút / "Trả đến".</summary>
    string? TraCause => IsFresh && PrevOn ? EffCause : null;
    List<HandoverForm.FormBtn> Btns => !Ready || IsTot || Pos == null ? new() : HandoverForm.FormButtons(Row, _group, Pos, Case, TraCause, PrevOn);
    // [CAUSE-BAT-BUOC 2026-11-10] "Lỗi công đoạn trước": người dùng BẮT BUỘC tự chọn nơi gây lỗi, không điền sẵn (trước: mặc định nhóm trước).
    //   Nguồn: HÙNG 10/11 16:52 "họ bắt buộc phải chọn mà, mình cũng ko cần gợi ý sẵn đâu, kệ họ". Kho: lỗi có sẵn = phôi khách (không chọn).
    string EffCause => _group == "KHO" ? "KHACH" : _cause;   // (trước [CAUSE-BAT-BUOC]: [LAMHO-L2-KCS] trống = nhóm trước theo PO)
    // [CAUSE-BAT-BUOC] (rà độc lập Thấp 1) tích "Lỗi công đoạn trước" chỉ tính khi dòng còn cho tích (PrevOk) — sổ vẽ lại làm ô tích ẩn thì không kẹt nút Lưu
    bool PrevOn => IsFresh && _prev && (Pos == null || Pos.PrevOk);
    // [CAUSE-BAT-BUOC] (rà độc lập Thấp 2) chưa chọn nơi gây lỗi → chưa xem trước chứng từ / ô nhận (sẽ đổi theo nơi chọn)
    bool CauseMissing => PrevOn && _group != "KHO" && string.IsNullOrEmpty(_cause);
    string EffPurpose => IsTra ? HandoverForm.PTra : HandoverForm.PNho;   // [N23-FORM6] theo nút (trước: 2 nút Trả nơi gây lỗi / Gửi nhờ sửa ở Chi tiết)

    string DefaultDest
    {
        get
        {
            if (LamHo || LamHoLoi) return "GC";   // [TARO-LAMHO-NC]
            if (IsTaroPhoi) return "KHO";   // [KTT-PHOILOI]
            if (IsXl) return Case == null ? "" : IsTot ? (Case.DetectGroup ?? "") : HandoverForm.XlTraLaiDefault(Case, _group);   // mặc định nơi phát hiện [SUA-XL-GIU] · hỏng lại: bộ phận làm lỗi [XL-TRA-NOILOI] / nhóm đã sửa [XL-TRA-NHOMSUA]
            if (IsTot && HelpFrom) return HandoverForm.NextGroup(_group);   // [GOI8-THAP-E rà độc lập Gói 10 T2] giao theo NC (làm hộ) mặc định HTSP như cũ — không theo "PO không có HTSP / HTSP chỉ làm hộ" (trước: ra KCS, máy chủ chặn). Nguồn: CLAUDE (rà độc lập Gói 10)
            if (IsTot) return HandoverForm.NextGroup(_group, Row);   // [TARO-LAMHO-NC] HTSP chỉ làm hộ: giao thẳng KCS · [GOI8-THAP-E] + PO không có công đoạn HTSP
            // [N23-FORM6] Trả đến = nơi làm lỗi (tự điền); Gửi đến = bộ phận kế tiếp theo quy trình (chọn lại được) — mockup Bước 4. Trước: theo 2 nút Trả / Nhờ ở Chi tiết.
            if (IsTra) return HandoverForm.TraTarget(_group, Pos!, Case, TraCause) ?? "";
            if (IsNho) return HandoverForm.NhoDefault(_group, Row);
            return "";
        }
    }
    // [N23-FORM6] "Trả đến" tự điền (không chọn), trừ hàng đã sửa bị hỏng lại (nhiều nhóm đã sửa — chọn được như cũ [XL-TRA-NHOMSUA])
    string Dest => LamHo || LamHoLoi ? "GC" : IsTaroPhoi ? "KHO" : IsTra && !IsXl ? DefaultDest : !string.IsNullOrEmpty(_to) ? _to : DefaultDest;   // [TARO-LAMHO-NC] · [KTT-PHOILOI] chỉ trả Kho

    /// <summary>Ô bên nhận theo lựa chọn (có thể đổi ở Tuỳ chọn).</summary>
    string DefaultToCell => IsXl ? (IsTot ? HandoverCell.Xl : HandoverCell.Loi)   // [SUA-XL-GIU][XL-TRA-LAI]
        : IsTot ? HandoverCell.Moi
        : LamHoLoi || IsTaroPhoi ? HandoverCell.Loi   // [TARO-LAMHO-NC] · [KTT-PHOILOI]
        : IsTra ? HandoverCell.Loi : HandoverCell.Sua;   // [N23-FORM6] Trả nơi làm lỗi → ô Hàng lỗi · Gửi bộ phận khác sửa → ô Hàng sửa
    string ToCellNow => !string.IsNullOrEmpty(_toCell) ? _toCell : DefaultToCell;
    // [N23-FORM6] hàng lỗi: ô nhận theo nút (Workflow ON không đổi); Workflow OFF vẫn cho đổi ô như cũ
    bool CanPickCell => !IsXl && !KhoTaro && !IsTaroPhoi && ((IsTot && !HelpFrom && !LamHo) || (!IsTot && !Row.ApplyWorkflow && IsGiao && !LamHoLoi));   // [TARO-LAMHO-NC] · [SUA-XL-GIU] ô cố định · [KHO-TARO-THANG][KTT-PHOILOI]
    bool GcHasNc => Row.G("GC").Steps.Any(s => !s.IsExcluded && !HandoverLedgerService.IsVao(s.Code));
    /// <summary>[K2] Hàng của vụ (đã xử lý) giao vào Gia công ô Hàng lỗi đã xử lý / Hàng mới: NC nhận theo vụ, như sửa tại nhóm (rà độc lập V3).</summary>
    bool CaseToGc => !IsTot && !IsXl && IsGiao && Dest == "GC" && GcHasNc && ToCellNow is HandoverCell.Moi or HandoverCell.Xl;
    bool NeedToNc => !CaseToGc && !IsXl && Dest == "GC" && GcHasNc
                     && (LamHo || (!HelpFrom && ToCellNow is HandoverCell.Moi or HandoverCell.Xl))
                     && !(_group == "KHO" && Row.ApplyWorkflow && !LamHo);   // [KHO-NC-DAU 2026-11-10] phôi Kho luôn vào NC đầu (máy chủ kiểm)
    bool NcForSua => IsSua && _group == "GC" && _pass > 0;

    /// <summary>[SUA-XL-GIU][SUA-OK-NC 2026-11-10] Đích hàng sửa đạt (cùng hàm máy chủ): dấu (không chọn NC) / NC / null. Chỉ khi sửa có số đạt.</summary>
    string? RepTarget => !(IsSua && _pass > 0) ? null
        : IsFresh ? HandoverForm.RepairTarget(Row, _group, _group, Pos!.NgNc, FreshOrigin, PrevOn ? EffCause : _group, Pos!.NgSource == HandoverNgSource.Da)   // [N21-NGW] FreshOrigin
        : HandoverForm.RepairTarget(Row, _caseId ?? 0, _group);
    bool RepMark => HandoverLedgerService.IsRepMark(RepTarget);
    string? RepDetect => IsFresh ? _group : Case?.DetectGroup;

    /// <summary>NC làm tiếp mặc định (Gia công: sửa đạt / hàng của vụ vào Gia công) — cùng hàm máy chủ kiểm.</summary>
    string? NcDefault => !(NcForSua || CaseToGc) ? null
        : IsFresh ? HandoverForm.CaseNextNc(Row, _group, Pos!.NgNc, FreshOrigin)   // [N21-NGW]
        : HandoverForm.CaseNextNc(Row, _caseId ?? 0, _group);   // [GN-FORM1] vòng 2 C1
    List<HandoverForm.NcOpt> NcOpts => ((NcForSua && !RepMark) || CaseToGc) && GcHasNc   // [SUA-XL-GIU] đích là dấu: không chọn NC
        ? HandoverForm.NcOptions(Row, NcDefault, free: !IsFresh && (_caseId ?? 0) == 0, allowEarlier: !Row.ApplyWorkflow)   // [SUA-KHONG-LUI] ON: không làm lại NC trước
              .Where(o => !(_group == "KHO" && Row.ApplyWorkflow && NcDefault == null) || HandoverForm.KhoNcOk(Row, o.Code)).ToList()   // [KHO-NC-DAU] Kho: hàng như hàng mới chỉ NC đầu
        : NcForSua && RepMark && !Row.ApplyWorkflow && GcHasNc ? HandoverForm.OffMarkOptions(Row, NcDefault)   // [SUA-OFF-LUI] Workflow OFF: mặc định không làm lại NC, vẫn chọn được làm lại (như cũ)
        : new();   // [GN-FORM1] vòng 3 C1b: hàng cũ chưa mã vụ
    HandoverForm.NcOpt? NcChosen => NcOpts.FirstOrDefault(o => OptKey(o) == _ncNext);
    bool NcEarlier => NcChosen?.Earlier == true;
    bool NcLater => NcChosen?.Label.StartsWith("Làm tiếp ở") == true;   // [GN-FORM1] rà vòng 4 L-a: chữ ô lý do khi chọn NC sau (hàng cũ chưa mã vụ)
    static string OptKey(HandoverForm.NcOpt? o) => o == null ? "" : o.Default ? "" : o.Code ?? HandoverService.FormNewNc;

    bool NeedCat => (IsFresh || IsTaroPhoi) && !string.IsNullOrEmpty(Act)   // [KTT-PHOILOI] phôi lỗi: vụ mới, chọn loại lỗi
                    && !(IsSua && _pass + _fail <= 0);
    // [N20-GHICHU 2026-11-23] Ghi chú không bắt buộc cả khi giao theo NC (trước: bắt buộc, nút Xác nhận xám không báo lý do — khách TH8).
    //   Nguồn: KHÁCH 23/11 (mockup TH8); HÙNG 23/11 16:24 (N20).
    bool NotesRequired => false;

    bool CanSave => Missing() == null;

    /// <summary>[N23-FORM6] Nút Xác nhận chưa bấm được thì còn thiếu gì (null = đủ). Cùng điều kiện CanSave cũ, thêm chữ (mockup Form chung).</summary>
    string? Missing()
    {
        if (string.IsNullOrEmpty(_kind)) return "Chọn hàng gì (bước 1).";
        if (IsBu)   // [KHACH-GUI-LAI]
            return _caseId is not long ? $"Chọn {NgCaseNo.Term} cần bù (bước 2)." : _qty <= 0 ? "Nhập số phôi khách gửi bù." : _qty > BuMax ? $"Số phôi bù vượt tối đa {BuMax:0.##}." : null;
        if (Pos == null) return "Chọn hàng đang ở đâu (bước 2).";
        if (IsHeld && Case == null) return $"Chọn {NgCaseNo.Term} ở bước 2.";
        if (string.IsNullOrEmpty(Act)) return "Chọn làm gì (bước 3).";
        if (Btns.FirstOrDefault(b => b.Code == _action) is { On: false } bo) return $"\"{bo.Label}\" đang xám: {bo.Why}.";
        if (_action == HandoverForm.AGiu && Pos != null && HandoverForm.GiuNoop(Pos)) return "Hàng đã nằm sẵn ở ô này (đã có mã vụ) — giữ lại không cần ghi gì, bấm Huỷ để đóng.";   // [N23-FORM6 rà độc lập T3]
        if (CauseMissing) return "Chọn nơi gây lỗi (bắt buộc khi tích \"Lỗi công đoạn trước\").";   // [CAUSE-BAT-BUOC]
        if (IsSua)
        {
            if (_pass < 0 || _fail < 0) return "Số sửa đạt / chưa đạt không được âm.";
            if (_pass + SuaFailSent <= 0) return "Nhập số sửa đạt" + (SuaFailInput ? " hoặc chưa đạt." : ".");
            if (_pass + SuaFailSent > Have) return $"Sửa đạt + chưa đạt vượt tối đa {Have:0.##}.";
        }
        else if (_qty <= 0) return "Nhập số lượng.";
        else if (_qty > Have) return $"Số lượng vượt tối đa {Have:0.##}.";
        if (IsGiao && string.IsNullOrEmpty(Dest)) return "Chọn bộ phận nhận.";
        if (IsGiao && Dest == _group) return "Bộ phận nhận phải khác bộ phận đang giữ hàng.";
        if (NeedCat && _catId == null) return "Chọn loại lỗi.";
        if (NcEarlier && _ncReason.Trim().Length < HandoverForm.NcReasonMin) return $"Ghi lý do làm lại NC (ít nhất {HandoverForm.NcReasonMin} ký tự).";
        if (LamHo && NeedToNc && string.IsNullOrEmpty(_toNc)) return "Chọn NC nhận vào.";   // (rà độc lập T2) PO không có NC thường: không bắt chọn
        if (NotesRequired && string.IsNullOrWhiteSpace(_notes)) return "Ghi chú.";
        return null;
    }

    // ── Bước 1 ──────────────────────────────────────────────────────────
    RenderFragment StepKind() => __builder =>
    {
        <div class="mb-3">
            <div class="fw-semibold small mb-1">@StepNo(1) Hàng gì</div>
            <div class="d-flex gap-2">
                <button type="button" class="gn-cellbtn @(_kind == HandoverForm.Tot ? "on" : "")" @onclick="PickTot">
                    <div class="fw-semibold">Hàng tốt</div>
                    <div class="small text-muted">@(_group == "KHO" ? "phôi còn, giao đi" : "đã làm, giao tiếp")</div>
                </button>
                <button type="button" class="gn-cellbtn @(_kind == HandoverForm.Loi ? "on border-danger" : "")" @onclick="PickLoi">
                    <div class="fw-semibold">Hàng lỗi</div>
                    <div class="small text-muted">mới phát hiện, hoặc đang giữ</div>
                </button>
                @if (_group == HandoverService.BuGroup)
                {
                    @* [KHACH-GUI-LAI 2026-11-11] Kho nhận phôi khách gửi bù *@
                    <button type="button" class="gn-cellbtn @(_kind == BuKind ? "on border-warning" : "")" @onclick="PickBu">
                        <div class="fw-semibold">Khách gửi bù</div>
