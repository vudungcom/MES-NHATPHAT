                <div class="fw-semibold small mb-1">@StepNo(3) Chi tiết</div>
                <label class="form-label form-label-sm mb-1">Số phôi khách gửi bù <span class="text-muted">(tối đa @BuMax.ToString("0.##"))</span></label>
                <input type="number" class="form-control form-control-sm @(_qty > BuMax ? "border-danger" : "")" min="0" step="1" @bind="_qty" @bind:after="ClearError" />
                @if (_qty > BuMax)
                {
                    <div class="small text-danger">Vượt tối đa @BuMax.ToString("0.##") — khách gửi dư thì sửa Số lượng thực nhận của phôi ở trang Kho.</div>
