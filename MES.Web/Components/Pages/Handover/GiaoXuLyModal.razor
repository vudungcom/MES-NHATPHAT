    // ── Bước 2 ──────────────────────────────────────────────────────────
    // [N23-FORM6] Bước 2: dòng đang giữ theo vụ (ô Hàng lỗi / Hàng sửa / hàng đã sửa / hàng làm hộ bị lỗi) — MỖI MÃ VỤ 1 DÒNG (mockup TH4 bước 3:
    //   "Đang giữ ở ô Hàng lỗi — VL000316 · Gia công trả"); không có vụ thì 1 dòng "có 0". Hàng lỗi: thêm dòng hàng đã sửa chờ trả (lấy từ danh sách Hàng tốt).
    record ViewRow(string Key, FormPos P, bool FromTot, long? CaseId, string Label, string Sub, decimal Have, decimal? Show = null);   // [N21-NGW] + số hiện (NG chưa báo) khác trần

    List<ViewRow> ViewRows()
    {
        var list = new List<ViewRow>();
        void AddPos(FormPos p, bool fromTot)
        {
            if (p.HeldCell == null) { list.Add(new ViewRow(p.Id, p, fromTot, null, p.Label, p.Sub, p.Have, p.Show)); return; }   // [N21-NGW] + Show
            var cs = Row.CasesHeldAt(_group, p.HeldCell);
            if (cs.Count == 0) { list.Add(new ViewRow(p.Id, p, fromTot, null, HeldHead(p, fromTot), "", 0)); return; }
            foreach (var c in cs)
                list.Add(new ViewRow(p.Id + "|" + c.Id, p, fromTot, c.Id, HeldHead(p, fromTot) + " — " + CaseWho(p, fromTot, c), CaseSub(c), Math.Max(0, c.HeldAt(_group, p.HeldCell))));
        }
        // hàng đã sửa chờ trả (mockup TH10 bước 4) đứng trước dòng "hàng đã sửa bị hỏng lại"
        bool xlDone = false;
        foreach (var p in Positions)
        {
            if (!xlDone && p.HeldCell is HandoverCell.Xl or HandoverCell.LamHo) { foreach (var x in TotXlPositions) AddPos(x, true); xlDone = true; }
            AddPos(p, false);
        }
        if (!xlDone) foreach (var x in TotXlPositions) AddPos(x, true);
        return list;
    }

    static string HeldHead(FormPos p, bool fromTot) => p.HeldCell switch
    {
        HandoverCell.Loi   => "Đang giữ ở ô Hàng lỗi",
        HandoverCell.Sua   => "Đang giữ ở ô Hàng sửa (bộ phận khác gửi sửa)",
        HandoverCell.Xl    => fromTot ? "Đang giữ ở ô Hàng lỗi đã xử lý" : HandoverForm.TonXlLoiText,
        HandoverCell.LamHo => HandoverForm.LamHoLoiText,
        _                  => p.Label
    };

    /// <summary>"VL000316 · Gia công trả" · "VL000320 · KCS gửi sửa" · "VL000325 · về KCS".</summary>
    string CaseWho(FormPos p, bool fromTot, LedgerCase c)
    {
        var no = c.Id == 0 ? "hàng lỗi cũ (chưa có mã vụ)" : c.No;
        if (p.HeldCell == HandoverCell.Xl && fromTot) return no + (c.DetectGroup != null ? " · về " + HandoverLedgerService.GroupLabel(c.DetectGroup) : "");
        if (p.HeldCell == HandoverCell.Sua) return no + (HandoverForm.CaseSender(c, _group) is string sd ? " · " + HandoverLedgerService.GroupLabel(sd) + " gửi sửa" : "");
        if (p.HeldCell == HandoverCell.Loi)
        {
            var hop = c.Hops.LastOrDefault(h => h.Kind == "NHAN" && h.Group == _group && h.Cell == HandoverCell.Loi && !string.IsNullOrEmpty(h.Other) && HandoverLedgerService.GroupCodes.Contains(h.Other!));
            if (hop != null) return no + " · " + HandoverLedgerService.GroupLabel(hop.Other!) + (hop.TraVe ? " sửa chưa đạt trả về" : " trả");   // [N18-TRAVE]
        }
        return no;
    }

    string CaseSub(LedgerCase c) => c.Id == 0 ? HandoverForm.CaseOriginText(Row, c) : c.CatLabel + " — " + HandoverForm.CaseOriginText(Row, c);

    bool RowOn(ViewRow v) => _pos == v.P.Id && _posTot == v.FromTot && (v.CaseId == null || _caseId == v.CaseId);

    RenderFragment StepPos() => __builder =>
    {
        if (string.IsNullOrEmpty(_kind)) return;
        <div class="mb-3">
            <div class="fw-semibold small mb-1">@StepNo(2) Hàng đang ở đâu</div>
            <div class="d-flex flex-column gap-1">
                @foreach (var v in ViewRows())
                {
                    var vr = v;
                    <button type="button" class="gn-cellbtn w-100 d-flex justify-content-between align-items-center @(RowOn(vr) ? "on" : "")"
                            disabled="@(vr.Have <= 0)" @onclick="() => PickRow(vr)">
                        @RowText(vr)
                        <span class="small text-nowrap @(vr.Have > 0 ? "text-success" : "text-muted")">có @((vr.Show ?? vr.Have).ToString("0.##"))</span>
                    </button>
                }
            </div>
            @PrevBox()
        </div>
    };

    RenderFragment RowText(ViewRow v) => __builder =>
    {
        <span>
            @v.Label
            @if (!string.IsNullOrEmpty(v.Sub))
            {
                <br /><span class="small text-muted">@v.Sub</span>
            }
        </span>
    };

    RenderFragment PrevBox() => __builder =>
    {
        if (IsTaroPhoi)   // [KTT-PHOILOI] phôi lỗi: Lỗi công đoạn trước cố định, nơi gây lỗi Khách hàng
        {
            <div class="mt-2 p-2 border rounded border-danger small">
                <span class="fw-semibold text-danger">Lỗi công đoạn trước (phôi lỗi)</span> — nơi gây lỗi: <strong>Khách hàng</strong>.
                <div class="text-muted mt-1">Chiếc Taro làm hỏng thì không chọn ở đây: ghi NG ở WTS Taro (trả Gia công như cũ).</div>
            </div>
            return;
        }
        if (!IsFresh) return;
        // [GC-LOI-TRUOC-NCDAU 2026-11-10] Gia công (Workflow ON): hàng đã gia công → lỗi của Gia công, không tích "Lỗi công đoạn trước"
        if (Pos is { PrevOk: false })
        {
            <div class="mt-2 p-2 border rounded small text-muted">Hàng đã qua NC: lỗi tính cho Gia công (lỗi đầu ra). "Lỗi công đoạn trước" chỉ chọn được ở hàng chưa gia công (chờ NC đầu / hàng làm hộ trả về).</div>
            return;
        }
        <div class="mt-2 p-2 border rounded @(_prev ? "border-danger" : "")">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="gxlPrev" checked="@_prev" @onchange="OnPrevChanged" />
                <label class="form-check-label fw-semibold text-danger" for="gxlPrev">@(_group == "KHO" ? "Lỗi có sẵn (phôi khách)" : "Lỗi công đoạn trước")</label>
            </div>
            @if (_prev && _group != "KHO")
            {
                <div class="mt-1">
                    <label class="form-label form-label-sm mb-1">Nơi gây lỗi</label>
                    <select class="form-select form-select-sm @(string.IsNullOrEmpty(_cause) ? "is-invalid" : "")" @onchange="OnCauseChanged">
                        <option value="" selected="@(string.IsNullOrEmpty(_cause))">-- Chọn nơi gây lỗi --</option>
                        @foreach (var c in CauseOptions())
                        {
                            <option value="@c" selected="@(EffCause == c)">@HandoverNgSource.CauseLabel(c)</option>
                        }
                    </select>
                </div>
            }
            <div class="small text-muted mt-1">@PrevHint</div>
        </div>
    };

    string PrevHint => _prev
        ? (_group == "KHO" ? "Lỗi đầu vào: phôi khách lỗi sẵn — không phải Kho làm hỏng."
           : string.IsNullOrEmpty(EffCause) ? "Chọn nơi gây lỗi (bắt buộc)."
           : $"Lỗi đầu vào: có sẵn khi nhận, do {HandoverNgSource.CauseLabel(EffCause)} — không phải {HandoverLedgerService.GroupLabel(_group)} làm hỏng.")
        : $"Không tích = {HandoverLedgerService.GroupLabel(_group)} làm hỏng (lỗi đầu ra).";

    List<string> CauseOptions()
    {
        var order = HandoverLedgerService.GroupCodes.ToList();
        var idx = order.IndexOf(_group);
        return new[] { "KHACH" }.Concat(order.Take(Math.Max(0, idx)).Reverse()).Concat(order.Skip(idx + 1)).ToList();
    }


    // ── Bước 3 ──────────────────────────────────────────────────────────
    // [N23-FORM6] luôn đủ 6 nút (HandoverForm.FormButtons); nút xám ghi lý do ngay dưới. Trước [GN-FORM1]: danh sách nút đổi theo dòng bước 2.
    RenderFragment StepAction() => __builder =>
    {
        if (!Ready || IsTot) return;
        var bs = Btns;
        <div class="mb-3">
            <div class="fw-semibold small mb-1">@StepNo(3) Làm gì <span class="small text-muted fw-normal">(6 nút giống nhau ở mọi bộ phận)</span></div>
            <div class="row g-1">
                @foreach (var a in bs)
                {
                    var code = a.Code;
                    var ab = a;
                    <div class="col-6">
                        <button type="button" class="@BtnClass(ab)" style="@BtnStyle(ab)" disabled="@(!ab.On)" @onclick="() => PickAction(code)">@ab.Label</button>
                    </div>
                }
            </div>
            @foreach (var a in bs.Where(x => !x.On))
            {
                <div class="small text-muted mt-1"><em>@a.Label</em> xám: @a.Why</div>
            }
        </div>
    };

    // ── Bước 4 ──────────────────────────────────────────────────────────
    RenderFragment StepDetail() => __builder =>
    {
        if (string.IsNullOrEmpty(Act)) return;
        <div class="mb-2">
            <div class="fw-semibold small mb-1">@StepNo(IsTot ? 3 : 4) Chi tiết</div>
            @GiaoBlock()
            @SuaBlock()
            @if (!IsSua)
            {
                <div class="mb-2">
                    <label class="form-label form-label-sm mb-1">Số lượng <span class="text-muted">@QtyHint</span></label>
                    <input type="number" class="form-control form-control-sm @(_qty > Have ? "border-danger" : "")" min="0" step="1" @bind="_qty" @bind:after="ClearError" />
                    @if (_qty > Have)
                    {
                        <div class="small text-danger">Vượt tối đa @Have.ToString("0.##") — phần mềm sẽ không cho lưu.</div>
                    }
                </div>
            }
            @if (NeedCat)
            {
                <div class="mb-2">
                    <label class="form-label form-label-sm mb-1 text-danger fw-semibold">Loại lỗi (DS Lỗi) *</label>
                    <NgCategoryPicker Categories="Cats" @bind-Value="_catId" Required="true" />
                </div>
            }
            <div class="mb-2">
                <label class="form-label form-label-sm mb-1 @(NotesRequired ? "fw-semibold text-danger" : "")">Ghi chú @(NotesRequired ? "*" : "(tuỳ chọn)")</label>
                <input type="text" class="form-control form-control-sm" maxlength="500" @bind="_notes" @bind:after="ClearError" />
            </div>
            <div class="small text-muted border-top pt-1">@WillWrite()</div>
        </div>
    };

    // [N20-O-NC 2026-11-23] Ô "Giao làm NC" ở Chi tiết khi giao theo NC: liệt kê các dòng giao theo NC (bước 2), chọn ô nào = chọn dòng đó (giữ nhóm nhận,
    //   số điền lại theo trần dòng mới). Không thêm luật: NC giao = NC kế tiếp sau NC nguồn như cũ. Nguồn: KHÁCH 23/11 (mockup TH8 "muốn thêm ô chọn NC giao riêng"); HÙNG 23/11 16:24.
    RenderFragment HelpNcSelect() => __builder =>
    {
        <div class="mb-2">
            <label class="form-label form-label-sm mb-1">Giao làm NC</label>
            <select class="form-select form-select-sm" @onchange="OnHelpNcChanged">
                @foreach (var p in Positions.Where(x => x.HelpFrom != null))
                {
                    <option value="@p.Id" selected="@(_pos == p.Id)" disabled="@(p.Have <= 0)">@HelpNcLabel(p)</option>
                }
            </select>
        </div>
    };

    static string HelpNcLabel(FormPos p) => (string.IsNullOrEmpty(p.HelpTo) ? p.Label : p.HelpTo) + " — có " + p.Have.ToString("0.##");

    string HelpNcWill => Pos?.HelpTo is { Length: > 0 } t ? ", làm " + t : "";   // [N20-O-NC] câu "Sẽ ghi" nói rõ NC giao

    void OnHelpNcChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? "";
        if (id == _pos || !Positions.Any(x => x.Id == id && x.HelpFrom != null)) return;
        var keepTo = _to; var keepNotes = _notes;
        PickPos(id);
        _to = keepTo; _notes = keepNotes;
    }

    RenderFragment GiaoBlock() => __builder =>
    {
        if (!IsGiao) return;
        <div class="mb-2">
            <label class="form-label form-label-sm mb-1">@DestTitle</label>
            @if (LamHo || LamHoLoi)
            {
                <div class="p-2 border rounded bg-light small"><strong>Gia công</strong> <span class="text-muted">— @(LamHoLoi ? "trả hàng làm hộ bị lỗi về Gia công, vào ô Hàng lỗi (cùng vụ)" : "trả hàng làm hộ về Gia công")</span></div>
            }
            else if (IsTaroPhoi)
            {
                @* [KTT-PHOILOI] chỉ trả Kho *@
                <div class="p-2 border rounded bg-light small"><strong>Kho</strong> <span class="text-muted">— vào ô Hàng lỗi (phôi lỗi, nơi gây lỗi Khách hàng)</span></div>
            }
            else if (IsTra && !IsXl)
            {
                @* [N23-FORM6] "Trả đến" tự điền = nơi làm lỗi, vào ô Hàng lỗi bên đó (mockup Bước 4) *@
                <div class="p-2 border rounded bg-light small"><strong>@HandoverLedgerService.GroupLabel(Dest)</strong> <span class="text-muted">(nơi làm lỗi) — ô Hàng lỗi</span></div>
            }
            else
            {
                <select class="form-select form-select-sm" @onchange="OnDestChanged">
                    <option value="" selected="@(string.IsNullOrEmpty(Dest))">-- Chọn nhóm nhận --</option>
                    @* [GN-NGUOC-CHAN 2026-11-10] Hàng tốt (Workflow ON) không giao ngược về bộ phận trước *@
                    @foreach (var g in DestOptions())
                    {
                        <option value="@g" selected="@(Dest == g)">@DestLabel(g)</option>
                    }
                </select>
            }
        </div>
        if (IsTot && HelpFrom)   // [N20-O-NC] ô riêng "Giao làm NC" (chọn dòng giao theo NC ở bước 2 — cùng 1 nguồn)
        {
            @HelpNcSelect()
        }
        if (NeedToNc)
        {
            <div class="mb-2">
                <label class="form-label form-label-sm mb-1">Nhận vào NC @(LamHo ? "*" : "(tuỳ chọn)")</label>
                <select class="form-select form-select-sm" @onchange="OnToNcChanged">
                    <option value="" selected="@(string.IsNullOrEmpty(_toNc))">@ToNcDefaultLabel</option>
                    @foreach (var s in Row.G("GC").Steps.Where(x => !x.IsExcluded && !HandoverLedgerService.IsVao(x.Code)
                                                                    && (!LamHo || !Row.ApplyWorkflow || !Row.LamHoRuns.Any(r => r.HasTaro) || (_group == "HTSP" && Row.LamHoRuns.Any(r => r.NextNc == x.Code))
                                                                        || HandoverLedgerService.IssueCap(Row, _group, HandoverPurpose.HelpReturn, null, null, x.Code).Max > 0)))   @* [TARO-LAMHO-NC] PO có Taro làm hộ: NC sau đoạn + NC còn trả được (hàng không thuộc đoạn) *@
                    {
                        <option value="@s.Code" selected="@(_toNc == s.Code)">@HandoverLedgerService.NcName(s.Code)@(s.IsLast ? " (cuối)" : "")</option>
                    }
                </select>
            </div>
        }
        if (CaseToGc)
        {
            @NcSelect("Gia công nhận vào NC (theo vụ)")
        }
        if (KhoTaro)   // [KHO-TARO-THANG]
        {
            <div class="small p-2 rounded mb-2" style="background:#e8f5ee;color:#0f5132">Kho giao thẳng Taro: HTSP nhận theo NC, làm @(HandoverForm.KhoTaroText(Row).Replace("Taro — làm ", "")) rồi trả về Gia công NC sau. Bảng Giao nhận tính Gia công đã nhận vào và giao theo NC cùng số khi Taro nhận.</div>
        }
        else if (IsTot && KhoTaroPo && Pos?.Id == "PHOI" && Dest == "GC")   // [KHO-TARO-THANG] Workflow OFF: vẫn giao Gia công được, cảnh báo (câu B1)
        {
            <div class="small p-2 rounded mb-2 text-warning-emphasis" style="background:#fff3cd"><i class="bi bi-exclamation-triangle me-1"></i>@HandoverForm.KhoTaroOffWarn(Row)</div>
        }
        if (!string.IsNullOrEmpty(Dest) && !HelpFrom && !LamHo && !LamHoLoi && !CauseMissing && !KhoTaro && !(IsTra && !IsXl))   // [CAUSE-BAT-BUOC] (rà Thấp 2) · [KHO-TARO-THANG] chữ riêng ở trên
        {
            <div class="small p-2 rounded mb-2" style="background:#e8f5ee;color:#0f5132">@HandoverLedgerService.GroupLabel(Dest) sẽ nhận vào ô @HandoverCell.Label(ToCellNow)@TailNote — bên nhận đếm lại và được đổi ô khi bấm Nhận.</div>
        }
        if (!string.IsNullOrEmpty(XlNote()))   // [SUA-XL-GIU]
        {
            <div class="small p-2 rounded mb-2" style="background:#e0f2fe;color:#075985">@XlNote()</div>
        }
        if (HelpFrom)
        {
            <div class="small p-2 rounded mb-2" style="background:#e8f5ee;color:#0f5132">Giao theo NC: @HandoverLedgerService.GroupLabel(Dest) làm hộ rồi trả về Gia công (chọn NC nhận lúc trả).</div>
        }
        if (CanPickCell)
        {
            <div class="mb-2">
                <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11.5px" @onclick="ToggleOpt">@(_showOpt ? "Ẩn tuỳ chọn ▾" : "Tuỳ chọn: đổi ô bên nhận ▸")</button>
                @if (_showOpt)
                {
                    <div class="d-flex gap-1 flex-wrap mt-1">
                        @foreach (var c in ToCellOpts)
                        {
                            var cc = c;
                            <button type="button" class="gn-cellbtn @(ToCellNow == cc ? "on" : "")" style="flex:1;min-width:92px;padding:4px 6px" @onclick="() => PickToCell(cc)">
                                <span class="small fw-semibold">@HandoverCell.Label(cc)</span>
                            </button>
                        }
                    </div>
                    @if (ToCellNow != DefaultToCell)
                    {
                        <div class="small text-warning-emphasis mt-1"><i class="bi bi-exclamation-triangle me-1"></i>Cặp ô ít gặp: bên nhận vào @HandoverCell.Label(ToCellNow) thay vì @HandoverCell.Label(DefaultToCell). Kiểm lại trước khi giao.</div>
                    }
                }
            </div>
        }
    };

    /// <summary>Nhóm nhận chọn được. [GN-NGUOC-CHAN] Hàng tốt (ON) không ngược · [XL-VUOT-CHAN] hàng đã sửa (ON) chỉ xuôi tới nơi phát hiện.</summary>
    List<string> DestOptions()
        => HandoverLedgerService.GroupCodes.Where(x => x != _group
               && !(IsXl && IsTot && Row.ApplyWorkflow && !HandoverForm.XlToOk(_group, x, Case?.DetectGroup, Row))   // [XL-HTSP-LAMHO]
               && !(IsXl && !IsTot && Row.ApplyWorkflow && Case != null && HandoverForm.XlTraLaiGroups(Case, _group) is { Count: > 0 } rg && !rg.Contains(x))   // [XL-TRA-NHOMSUA] trả lại nhóm đã sửa
               && !(IsTot && !IsXl && !HelpFrom && Row.ApplyWorkflow && HandoverForm.IsBackward(_group, x))
               && !(IsTot && KhoTaroPo && Pos?.Id == "PHOI" && Row.ApplyWorkflow && x == "GC")).ToList();   // [KTT-CHI-TARO] Workflow ON: NC đầu là Taro → Kho chỉ giao Taro

    /// <summary>[KHO-TARO-THANG] Chữ nhóm nhận: Kho giao phôi cho HTSP khi NC đầu là Taro = "HTSP — Taro làm NC01 (máy loại trừ H04)".</summary>
    string DestLabel(string g) => g == "HTSP" && IsTot && KhoTaroPo && Pos?.Id == "PHOI"
        ? HandoverLedgerService.GroupLabel(g) + " — " + HandoverForm.KhoTaroText(Row) : HandoverLedgerService.GroupLabel(g);

    /// <summary>[N23-FORM6] Tên ô bộ phận nhận (mockup Bước 4): Giao đến / Gửi đến / Trả đến.</summary>
    string DestTitle => IsNho || LamHoLoi ? "Gửi đến" : IsTra || (IsXl && !IsTot) || IsTaroPhoi ? "Trả đến" : "Giao đến";

    /// <summary>[SUA-QUA-KCS 2026-11-11] Ô bên nhận chọn được: Workflow ON, hàng lỗi / hàng sửa không vào ô Hàng lỗi đã xử lý / Hàng mới (phải qua Kết quả sửa — [N17-KCS-BO] không còn KCS).</summary>
    IEnumerable<string> ToCellOpts => HandoverCell.ReceiveCells.Where(c => !(Row.ApplyWorkflow && !IsTot && HandoverForm.SuaQuaKcsBlocked(HandoverCell.Loi, c)));

    /// <summary>[SUA-XL-GIU] Chữ: bên nhận hàng đã sửa sẽ tính thế nào (cùng hàm sổ XlDest).</summary>
    string XlNote()
    {
        if (!IsXl || !IsTot || Case == null || string.IsNullOrEmpty(Dest)) return "";
        var d = HandoverLedgerService.XlDest(Dest, Case.DetectGroup, Case.FromDa);
        var D = HandoverLedgerService.GroupLabel(Dest);
        return d == "GIU" ? $"{D} nhận vào Tồn hàng lỗi đã xử lý: không ghi WTS số lượng (giờ làm lại ghi \"Việc không làm ra SP\"), rồi giao tiếp về {HandoverLedgerService.GroupLabel(Case.DetectGroup)}."
             : d == "XONG" && Dest == "KCS" ? "KCS là nơi phát hiện: KCS kiểm lại, giờ ghi \"Việc không làm ra SP\" (không ghi WTS số lượng) — nhận vào tính là đã kiểm xong, giao tiếp như hàng thường."   // [XL-CHU-KCS 2026-11-11] khách 11/11
             : Dest == "GC" && Case.DetectGroup == "GC" ? GcBackNote(Case)   // [SUA-HO-TRA-NGUOC] Gia công là nơi phát hiện: cùng đích như Gia công tự sửa
             : d == "XONG" ? $"{D} là nơi phát hiện: nhận vào tính là đã làm xong (không ghi WTS), giao tiếp như hàng thường."
             : $"{D} nhận vào Chưa làm, ghi WTS như hàng thường.";
    }

    /// <summary>[SUA-HO-TRA-NGUOC 2026-11-11] Chữ: hàng đã sửa trả ngược về Gia công (nơi phát hiện) — cùng hàm máy chủ (HandoverForm.RepairTarget / CaseNextNc).</summary>
    string GcBackNote(LedgerCase c)
    {
        var t = HandoverForm.RepairTarget(Row, c.Id, "GC");
        if (t == HandoverLedgerService.RepXong) return "Gia công là nơi phát hiện: nhận vào tính là đã làm xong NC cuối (không ghi WTS số lượng), giao tiếp như hàng thường.";
        if (t == HandoverLedgerService.RepOk) return "Gia công là nơi phát hiện (làm hỏng ở NC của chiếc lỗi): nhận vào tính là xong NC đó (không ghi WTS lại), làm tiếp công đoạn sau như hàng thường.";   // rà độc lập Thấp L1
        return t != null ? $"Gia công là nơi phát hiện: hàng về lại chờ {HandoverLedgerService.NcName(t)} (NC của chiếc lỗi, không làm lại NC trước), ghi WTS như hàng thường."
                         : "Gia công nhận vào như hàng mới, ghi WTS như hàng thường.";
    }

    /// <summary>[GC-HTSP-NC-HIEN 2026-11-10] Gia công giao Hàng tốt cho HTSP khi sau NC cuối còn NC máy loại trừ: " · để làm NC5 (Taro)" (chỉ hiển thị).</summary>
    string TailNote => _group == "GC" && IsTot && !HelpFrom && Dest == "HTSP" && HandoverForm.TailExclText(Row) is string t ? " · " + t : "";

    string ToNcDefaultLabel => Row.G("GC").Steps.Any(x => HandoverLedgerService.IsVao(x.Code))
        ? (LamHo ? "-- Chọn NC --" : $"-- {HandoverLedgerService.VaoLabel} (mặc định) --")
        : (LamHo ? "-- Chọn NC --" : "-- NC đầu (mặc định) --");

    // [N23-FORM6][N23-SUA-GIAO][N23-SUA-CHUADAT 2026-11-25] Sửa tại bộ phận mình / XXN KH: Sửa đạt + Sửa chưa đạt (mockup TH4 / TH10 bước 3).
    //   Ô Hàng lỗi: chưa đạt = phần còn lại, chỉ xem (vẫn ở ô Hàng lỗi). Ô Hàng sửa: chưa đạt nhập được → phần mềm tự trả nơi làm lỗi (ô Hàng lỗi).
    //   Phần đạt giữ ô Tồn hàng lỗi đã xử lý (HandoverForm.SuaGiveDefault) → ô "Sửa đạt → giao đến" (mặc định nơi báo lỗi; chọn "chưa giao" được).
    bool SuaFailInput => IsFresh || Pos?.HeldCell == HandoverCell.Sua;
    decimal SuaFailSent => SuaFailInput ? _fail : 0;
    (string Dest, string Cell)? Give => IsSua && IsHeld ? HandoverForm.SuaGive(Row, _group, Case) : null;
    string? GiveDefault => Give?.Dest;
    // [N23-SUA-GIAO rà độc lập T1/T2] Workflow OFF chọn làm lại NC (khác dấu mặc định) → phần đạt không vào giữ ô → không giao kèm; mặc định không có trong danh sách được
    //   giao (luật máy chủ) → coi như "Chưa giao".
    bool GiveOff => GiveDefault == null || _pass <= 0 || _suaTo == NoGive || (NcForSua && !string.IsNullOrEmpty(_ncNext));
    string? SuaToEff => GiveOff ? null : string.IsNullOrEmpty(_suaTo) ? (GiveOptions.Contains(GiveDefault!) ? GiveDefault : null) : _suaTo;
    /// <summary>[N23-SUA-CHUADAT] Nơi tự trả chiếc sửa chưa đạt (ô Hàng sửa) — cùng hàm máy chủ.</summary>
    string? FailTo => IsSua && Pos?.HeldCell == HandoverCell.Sua && Case != null && HandoverService.SuaFailReturnGroup(Row, Case.Id, _group) is string f && f != _group ? f : null;
    List<string> GiveOptions => GiveDefault == null || Case == null ? new()
        : HandoverLedgerService.GroupCodes.Where(x => x != _group && (Give?.Cell == HandoverCell.Xl ? !Row.ApplyWorkflow || HandoverForm.XlToOk(_group, x, Case.DetectGroup, Row)
              // [N23-KHO-SUA rà độc lập T2] Kho giao Hàng mới: cùng luật máy chủ — NC đầu là Taro (ON) không giao Gia công / HTSP Hàng mới, HTSP chỉ làm hộ (ON) không nhận Hàng mới
              : !(Row.ApplyWorkflow && HandoverLedgerService.KhoTaroRun(Row) != null && x is "GC" or "HTSP") && !(Row.ApplyWorkflow && x == "HTSP" && HandoverLedgerService.HtspOnlyLamHo(Row)))).ToList();

    string SuaFailHint => FailTo != null ? $"Chưa đạt → phần mềm tự trả {HandoverLedgerService.GroupLabel(FailTo)} ({FailToRole}), vào ô Hàng lỗi, cùng vụ."
        : SuaFailInput ? "Chưa đạt → ở lại ô Hàng lỗi, cùng vụ." : "Chưa đạt vẫn ở ô Hàng lỗi.";
    string GiveVal(string g) => g == GiveDefault ? "" : g;
    string NoGiveLabel => Give?.Cell == HandoverCell.Moi ? "Chưa giao — để ở phôi còn" : "Chưa giao — giữ ở Tồn hàng lỗi đã xử lý";   // [N23-KHO-SUA rà độc lập L2]
    /// <summary>[N23-SUA-CHUADAT rà độc lập L1] nơi tự trả chiếc chưa đạt là nơi làm lỗi hay nơi gửi.</summary>
    string FailToRole => Case != null && FailTo == HandoverForm.CaseCauseGroup(Case, _group) ? "nơi làm lỗi" : "nơi gửi";
    string GiveCellText => SuaToEff == null || Give == null ? "—" : HandoverCell.Label(Give.Value.Cell);
    string GiveLabel(string g) => HandoverLedgerService.GroupLabel(g) + (g == GiveDefault ? " (nơi báo lỗi)" : "");
    static string BtnStyle(HandoverForm.FormBtn a) => a.On ? "" : "border-style:dashed";
    string BtnClass(HandoverForm.FormBtn a) => "gn-cellbtn w-100" + (_action == a.Code ? " on" : "") + (_action == a.Code && a.Code is HandoverForm.AHuy or HandoverForm.AKhach ? " border-danger" : "");

    RenderFragment SuaBlock() => __builder =>
    {
        if (!IsSua) return;
        bool kho = _group == "KHO";
        <div class="row g-2 mb-1">
            <div class="col-6">
                <label class="form-label form-label-sm mb-1 text-success fw-semibold">@(kho ? "Sửa / xác nhận đạt" : "Sửa đạt")</label>
                <input type="number" class="form-control form-control-sm border-success" min="0" @bind="_pass" @bind:after="ClearError" />
            </div>
            <div class="col-6">
                <label class="form-label form-label-sm mb-1 @(SuaFailInput ? "text-danger fw-semibold" : "text-muted")">@(kho ? "Chưa đạt" : "Sửa chưa đạt")</label>
                @if (SuaFailInput)
                {
                    <input type="number" class="form-control form-control-sm border-danger" min="0" @bind="_fail" @bind:after="ClearError" />
                }
                else
                {
                    <div class="form-control form-control-sm bg-light text-muted">@Math.Max(0, Have - _pass).ToString("0.##")</div>
                }
            </div>
        </div>
        <div class="small text-muted mb-2">
            @* [N17-KCS-BO 2026-11-23] khách 23/11: sửa đạt không cần KCS xác nhận — trước: "Đạt → chờ KCS xác nhận (người KCS khác người ghi)." *@
            Tối đa @Have.ToString("0.##"). Đạt → vào thẳng ô đạt (không cần KCS xác nhận).
            @SuaFailHint
        </div>
        if (_pass + SuaFailSent > Have)
        {
            <div class="small text-danger mb-2">Đạt + chưa đạt vượt tối đa @Have.ToString("0.##") — phần mềm sẽ không cho lưu.</div>
        }
        if (GiveDefault != null && _pass > 0)
        {
            <div class="row g-2 mb-1">
                <div class="col-6">
                    <label class="form-label form-label-sm mb-1">@(kho ? "Đạt → giao đến" : "Sửa đạt → giao đến")</label>
                    <select class="form-select form-select-sm" @onchange="OnSuaToChanged">
                        @foreach (var g in GiveOptions)
                        {
                            <option value="@GiveVal(g)" selected="@(SuaToEff == g)">@GiveLabel(g)</option>
                        }
                        <option value="@NoGive" selected="@(SuaToEff == null)">@NoGiveLabel</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label form-label-sm mb-1">vào ô</label>
                    <div class="form-control form-control-sm bg-light">@GiveCellText</div>
                </div>
            </div>
            if (SuaToEff != null)
            {
                <div class="small text-muted mb-2">@SuaGiveNote()</div>
            }
        }
        if (RepMark && SuaToEff == null)   // [SUA-XL-GIU][SUA-OK-NC] khách 10/11: sửa xong không quay lại NC · [N23-SUA-GIAO] chưa giao: chữ đích như cũ
        {
            <div class="small p-2 rounded mb-2" style="background:#e0f2fe;color:#075985">@HandoverForm.RepairTargetText(Row, _group, RepTarget, RepDetect)</div>
        }
        if (NcOpts.Count > 0)   // [SUA-OFF-LUI] dấu + Workflow OFF: vẫn hiện ô chọn (mặc định = không làm lại NC)
        {
            @NcSelect(RepMark ? "Workflow OFF — sửa đạt thì" : "Sửa đạt thì làm tiếp ở")
        }
    };

    /// <summary>[N23-SUA-GIAO] Chữ dưới ô "Sửa đạt → giao đến" (mockup TH4: "Gia công đã từng nhận 2 chiếc này → vào Hàng lỗi đã xử lý, làm tiếp từ NC 1. Giao từ ô Hàng lỗi…").</summary>
    string SuaGiveNote()
    {
        if (SuaToEff == null) return Give?.Cell == HandoverCell.Moi ? "Hàng sửa đạt thành phôi còn — giao sau như Hàng tốt."
            : "Hàng sửa đạt giữ ở Tồn hàng lỗi đã xử lý của " + HandoverLedgerService.GroupLabel(_group) + " — giao sau ở dòng \"Đang giữ ở ô Hàng lỗi đã xử lý\".";
        var d = SuaToEff;
        if (Give?.Cell == HandoverCell.Moi)   // [N23-KHO-SUA] mockup TH3 bước 3
            return $"{HandoverLedgerService.GroupLabel(d)} chưa từng nhận chiếc này (lỗi lúc nhận) → vào ô Hàng mới. Chọn được bộ phận khác (vd HTSP để Bavia + Rửa).";
        var tail = d == GiveDefault ? $"Mặc định là {HandoverLedgerService.GroupLabel(d)} (nơi báo lỗi)." : $"Đổi sang {HandoverLedgerService.GroupLabel(d)} (làm lại công đoạn trước khi về nơi báo lỗi {HandoverLedgerService.GroupLabel(GiveDefault!)}).";
        if (d == "GC" && Case != null && Case.DetectGroup == "GC") return GcBackNote(Case) + " " + tail;
        var x = HandoverLedgerService.XlDest(d, Case?.DetectGroup, Case?.FromDa == true);
        var D = HandoverLedgerService.GroupLabel(d);
        var how = x == "GIU" ? $"{D} nhận vào ô Hàng lỗi đã xử lý (không ghi WTS số lượng, giờ làm lại ghi \"Việc không làm ra SP\") rồi giao tiếp về nơi báo lỗi."
                : x == "XONG" && d == "KCS" ? "KCS nhận vào ô Hàng lỗi đã xử lý, kiểm lại — giờ ghi \"Việc không làm ra SP\"."
                : x == "XONG" ? $"{D} nhận vào ô Hàng lỗi đã xử lý, tính là đã làm (không ghi WTS số lượng)."
                : $"{D} nhận vào ô Hàng lỗi đã xử lý.";
        return how + " " + tail;
    }

    /// <summary>[K2] Ô chọn NC làm tiếp (mặc định của vụ + NC đứng trước, bắt lý do) — dùng cho sửa tại nhóm và hàng của vụ vào Gia công.</summary>
    RenderFragment NcSelect(string label) => __builder =>
    {
        if (NcOpts.Count == 0) return;
        <div class="mb-2">
            <label class="form-label form-label-sm mb-1">@label</label>
            <select class="form-select form-select-sm" @onchange="OnNcNextChanged">
                @foreach (var o in NcOpts)
                {
                    <option value="@OptKey(o)" selected="@(OptKey(o) == _ncNext)">@o.Label</option>
                }
            </select>
            @if (NcEarlier)
            {
                <label class="form-label form-label-sm mt-1 mb-1">@(NcLater ? "Lý do chọn NC này (hàng cũ chưa mã vụ: đã qua NC nào)" : "Lý do làm lại NC trước") <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm" maxlength="200" @bind="_ncReason" @bind:after="ClearError" />
            }
        </div>
    };

    /// <summary>Dòng "Sẽ ghi" — chỉ chữ, máy chủ ánh xạ thật (SaveFormAsync).</summary>
    string WillWrite()
    {
        if (CauseMissing) return "Chọn nơi gây lỗi ở trên trước — chứng từ sẽ ghi tuỳ nơi chọn.";   // [CAUSE-BAT-BUOC] (rà Thấp 2)
        var G = HandoverLedgerService.GroupLabel(_group);
        var D = HandoverLedgerService.GroupLabel(Dest);
        if (KhoTaro) return "Sẽ ghi: phiếu Kho giao thẳng Taro → HTSP (chờ HTSP nhận; NG lúc nhận tự trả về Kho).";   // [KHO-TARO-THANG]
        if (IsTaroPhoi) return $"Sẽ ghi: phiếu Hàng lỗi công đoạn trước {G} → Kho, ô Hàng lỗi (phôi lỗi, nơi gây lỗi Khách hàng — 1 chứng từ, sinh vụ mới).";   // [KTT-PHOILOI]
        if (IsTot)
            return LamHo ? $"Sẽ ghi: phiếu trả hàng làm hộ về Gia công (chờ Gia công nhận)."
                 : HelpFrom ? $"Sẽ ghi: phiếu giao theo NC {G} → {D}{HelpNcWill} (chờ {D} nhận)."
                 : $"Sẽ ghi: phiếu Hàng mới {G} → {D} (chờ {D} nhận).";
        if (LamHoLoi && IsFresh)   // [N21-NGW]
            return $"Sẽ ghi: báo lỗi {_qty:0.##} chiếc NG ở WTS Taro làm hộ (mã vụ mới)" + (Act == HandoverForm.AGiu ? "" : " + phiếu trả về Gia công (ô Hàng lỗi, cùng vụ — chờ Gia công nhận)") + " — cùng 1 lần lưu.";
        if (LamHoLoi) return "Sẽ ghi: phiếu trả hàng làm hộ bị lỗi về Gia công (ô Hàng lỗi, cùng vụ — chờ Gia công nhận).";   // [TARO-LAMHO-NC]
        if (IsXl)   // [SUA-XL-GIU][XL-TRA-LAI]
            return IsTot ? $"Sẽ ghi: phiếu trả hàng đã sửa {G} → {D} (ô Hàng lỗi đã xử lý, cùng vụ — chờ {D} nhận)."
                         : $"Sẽ ghi: phiếu trả lại hàng đã sửa bị hỏng {G} → {D} (ô Hàng lỗi, cùng vụ — chờ {D} nhận).";
        if (IsHeld)
            return Act switch
            {
                HandoverForm.ASua     => SuaWill(G),   // [N17-KCS-BO][N23-SUA-GIAO][N23-SUA-CHUADAT]
                HandoverForm.AHuy     => "Sẽ ghi: phiếu Huỷ hàng lỗi (ra khỏi PO).",
                HandoverForm.AKhach   => "Sẽ ghi: phiếu Trả khách hàng lỗi (ra khỏi PO).",
                _                     => $"Sẽ ghi: phiếu {G} → {D}, ô {HandoverCell.Label(ToCellNow)} {_qty:0.##}, cùng vụ."   // [N23-FORM6] chữ theo mockup TH4
            };
        bool one = Act == HandoverForm.AGiao && PrevOn && Pos!.Unworked && _group != "KHO" && EffPurpose == HandoverForm.PTra && Dest == EffCause && ToCellNow == HandoverCell.Loi;
        if (one) return $"Sẽ ghi: phiếu {G} → {D}, ô Hàng lỗi {_qty:0.##}, mã vụ mới (Hàng lỗi công đoạn trước — 1 chứng từ).";   // [N23-FORM6] chữ theo mockup TH4 bước 1
        var tail = Act switch
        {
            HandoverForm.AGiu   => "",
            HandoverForm.ASua   => " + Kết quả sửa (đạt vào thẳng ô đạt)",   // [N17-KCS-BO]
            HandoverForm.AHuy   => " + phiếu Huỷ",
            HandoverForm.AKhach => " + phiếu Trả khách",
            _                   => (ToCellNow is HandoverCell.Xl or HandoverCell.Moi ? " + phiếu trả hàng đã sửa " : " + phiếu giao hàng lỗi ") + $"{G} → {D}"
        };
        if (IsNgW)   // [N21-NGW] chữ theo mockup TH10 bước 2
        {
            var n = IsSua ? _pass + _fail : _qty;
            var pend = Pos!.Show ?? 0;
            var noi = PrevOn ? HandoverNgSource.CauseLabel(EffCause) : G;
            return $"Sẽ ghi: báo lỗi {n:0.##} chiếc (mã vụ mới, nơi làm lỗi {noi})" + (tail == "" ? "" : " + " + tail.TrimStart(' ', '+')) + $" — cùng 1 lần lưu. NG chưa báo lỗi của {G}"
                 + (n > pend ? $" về 0; báo dư {n - pend:0.##} trừ vào hàng đã làm xong chưa giao." : n == pend ? " về 0." : $" còn {pend - n:0.##}.");
        }
        return "Sẽ ghi: báo hàng lỗi phát hiện sau khi nhận (sinh vụ mới)" + tail + " — cùng 1 lần lưu.";
    }

    /// <summary>[N21-NGW] Chữ cạnh ô Số lượng: dòng NG ở WTS ghi NG chưa báo + báo thêm thì trừ hàng đã làm xong (mockup TH10 bước 2).</summary>
    string QtyHint => IsNgW && Pos!.Show is decimal sh
        ? $"({sh:0.##} NG chưa báo" + (Have > sh ? $"; báo thêm thì trừ vào hàng đã làm xong chưa giao — tối đa {Have:0.##})" : ")")
        : $"(tối đa {Have:0.##})";

    /// <summary>[N23-SUA-GIAO][N23-SUA-CHUADAT] "Sẽ ghi" của Sửa tại bộ phận mình (vụ đang giữ).</summary>
    string SuaWill(string G)
    {
        var s = _pass > 0 ? $"Sẽ ghi: sửa đạt {_pass:0.##} — đạt vào thẳng ô đạt (không cần KCS xác nhận)" : "Sẽ ghi:";
        if (SuaToEff is string d) s = $"Sẽ ghi: sửa đạt {_pass:0.##} + phiếu {G} → {HandoverLedgerService.GroupLabel(d)} ô {GiveCellText} {_pass:0.##}" + (Give?.Cell == HandoverCell.Xl ? ", cùng vụ" : "");
        if (FailTo != null && _fail > 0) s += (_pass > 0 ? " · " : " ") + $"chưa đạt {_fail:0.##}: phiếu {G} → {HandoverLedgerService.GroupLabel(FailTo)} ô Hàng lỗi ({FailToRole}), cùng vụ — {HandoverLedgerService.GroupLabel(FailTo)} bấm Nhận, đếm ở cột Hàng sửa trả về chưa đạt";   // [N18-TRAVE] mockup TH6 bước 2
        else if (SuaFailInput && _fail > 0) s += (_pass > 0 ? " · " : " ") + $"chưa đạt {_fail:0.##} ở lại ô Hàng lỗi";
        return s + ".";
    }

    // ── Sự kiện ─────────────────────────────────────────────────────────
    void OnGroupChanged(ChangeEventArgs e) { _group = e.Value?.ToString() ?? ""; ResetFrom(1); }
    void PickTot() { _kind = HandoverForm.Tot; ResetFrom(2); }
    void PickLoi() { _kind = HandoverForm.Loi; ResetFrom(2); }
    void PickBu() { _kind = BuKind; ResetFrom(2); var l = BuCaseList; if (l.Count == 1) PickBuCase(l[0].Id); }   // [KHACH-GUI-LAI 2026-11-11]
    void PickBuCase(long id) { _caseId = id; _qty = HandoverLedgerService.BuCap(Row, id).Max; ClearError(); }   // [KHACH-GUI-LAI] điền sẵn số còn bù

    /// <summary>[N23-FORM6] Chọn 1 dòng bước 2 (dòng theo vụ: chọn luôn vụ).</summary>
    void PickRow(ViewRow v)
    {
        _posTot = v.FromTot;
        PickPos(v.P.Id);
        if (v.CaseId != null) { _caseId = v.CaseId; if (IsTot) _qty = Have; }
    }

    void PickPos(string id)
    {
        _pos = id; ResetFrom(3);
        _prev = false; _cause = "";
        var hc = HeldCases;
        _caseId = hc.Count == 1 ? hc[0].Id : null;
        // [TARO-LAMHO-NC] trả hàng làm hộ: NC nhận mặc định = NC sau đoạn Taro làm hộ (khi PO chỉ có 1 đoạn như vậy)
        if (LamHo && Row.LamHoRuns.Any(r => r.HasTaro))
        {   // NC sau đoạn Taro (HTSP, 1 đoạn) nếu còn trả được; không thì NC đầu còn trả được (rà vòng 3 T1, L1)
            var ncs = Row.G("GC").Steps.Where(x => !x.IsExcluded && !HandoverLedgerService.IsVao(x.Code)).Select(x => x.Code).ToList();
            decimal Cap(string nc) => HandoverLedgerService.IssueCap(Row, _group, HandoverPurpose.HelpReturn, null, null, nc).Max;
            var tr = Row.LamHoRuns.Where(r => r.HasTaro).ToList();
            _toNc = _group == "HTSP" && tr.Count == 1 && Cap(tr[0].NextNc) > 0 ? tr[0].NextNc : ncs.FirstOrDefault(n => Cap(n) > 0) ?? "";
        }
        if (IsTot) _qty = Have;
    }

    void OnPrevChanged(ChangeEventArgs e) { _prev = e.Value is bool b && b; _cause = ""; _to = ""; ClearError(); }
    void OnCauseChanged(ChangeEventArgs e) { _cause = e.Value?.ToString() ?? ""; _to = ""; ClearError(); }

    void PickAction(string code)
    {
        if (Btns.FirstOrDefault(b => b.Code == code) is { On: false }) return;   // [N23-FORM6] nút xám
        _action = code;
        _to = ""; _toCell = ""; _toNc = ""; _ncNext = ""; _ncReason = ""; _showOpt = false; _suaTo = "";
        _qty = code == HandoverForm.ASua ? 0 : Have; _pass = 0; _fail = 0;
        ClearError();
    }

    void OnDestChanged(ChangeEventArgs e) { _to = e.Value?.ToString() ?? ""; _toNc = ""; _ncNext = ""; _ncReason = ""; ClearError(); }
    void OnSuaToChanged(ChangeEventArgs e) { _suaTo = e.Value?.ToString() ?? ""; ClearError(); }   // [N23-SUA-GIAO]
    void OnToNcChanged(ChangeEventArgs e) { _toNc = e.Value?.ToString() ?? ""; ClearError(); }
    void ToggleOpt() => _showOpt = !_showOpt;
    void PickToCell(string c) { _toCell = c == DefaultToCell ? "" : c; _toNc = ""; _ncNext = ""; _ncReason = ""; ClearError(); }
    void OnNcNextChanged(ChangeEventArgs e) { _ncNext = e.Value?.ToString() ?? ""; _ncReason = ""; ClearError(); }

    /// <summary>Đổi bước trên thì bỏ lựa chọn các bước dưới.</summary>
    void ResetFrom(int step)
    {
        if (step <= 1) _kind = "";
        if (step <= 2) { _pos = ""; _posTot = false; _caseId = null; _prev = false; _cause = ""; }
        if (step <= 3) _action = "";
        _to = ""; _toCell = ""; _toNc = ""; _qty = 0; _pass = 0; _fail = 0;
        _ncNext = ""; _ncReason = ""; _catId = null; _showOpt = false; _suaTo = "";
        ClearError();
    }

    void ClearError() => _err = "";

    async Task CloseAsync() => await OnClose.InvokeAsync();

    async Task SaveAsync()
    {
        if (_saving) return;   // [D10-DBLCLICK] bấm đúp
        if (!CanSave) return;
        _saving = true;
        var detailId = Row.KhPlanDetailId;
        if (IsBu)   // [KHACH-GUI-LAI 2026-11-11] Kho nhận phôi khách gửi bù (máy chủ kiểm lại quyền Kho + trần + khoá PO)
        {
            try
            {
                var (bok, berr) = await HandoverSvc.ReceiveReplacementAsync(detailId, _caseId!.Value, _qty, _notes, UserId);
                _saving = false;
                if (!bok) { _err = berr; await OnFailed.InvokeAsync(detailId); return; }
                await OnSaved.InvokeAsync(detailId);
            }
            catch (Exception ex)   // [PAGE-ERR]
            {
                Db.ChangeTracker.Clear();
                _err = "Lỗi máy chủ: " + UiSafe.Text(ex, Logger, "lưu") + " — đóng cửa sổ, tải lại PO để xem đã lưu chưa rồi thử lại.";
            }
            finally { _saving = false; }
            return;
        }
        var req = new FormGiaoRequest
        {
            KhPlanDetailId = detailId, Group = _group, UserId = UserId, Kind = _posTot ? HandoverForm.Tot : _kind, Pos = _pos,   // [N23-FORM6] hàng đã sửa chờ trả: sổ để ở danh sách Hàng tốt
            CaseId = IsHeld ? _caseId : null,
            Prev = PrevOn || IsTaroPhoi, Cause = IsTaroPhoi ? "KHACH" : PrevOn ? EffCause : null,   // [CAUSE-BAT-BUOC] (rà Thấp 1) · [KTT-PHOILOI] phôi lỗi
            Action = Act,
            ToGroup = IsGiao ? Dest : null,
            Purpose = IsNho || IsTra ? EffPurpose : null,   // [N23-FORM6] theo nút (máy chủ: TRA → ô Hàng lỗi, NHO → ô Hàng sửa; Kho lỗi mới luôn ô Hàng sửa như cũ)
            ToCell = string.IsNullOrEmpty(_toCell) || KhoTaro || IsTaroPhoi ? null : _toCell,   // [KHO-TARO-THANG][KTT-PHOILOI] ô nhận cố định (ô chọn bị ẩn) — không gửi ô chọn từ trước khi đổi nhóm (rà độc lập Gói 18 Thấp 1)
            ToNC = CaseToGc ? (NcOpts.Count == 0 || string.IsNullOrEmpty(_ncNext) ? null : _ncNext)   // [K2] "" = mặc định của vụ (máy chủ tự điền)
                 : NeedToNc && !string.IsNullOrEmpty(_toNc) ? _toNc : null,
            Qty = IsSua ? 0 : _qty, Pass = IsSua ? _pass : 0, Fail = IsSua ? SuaFailSent : 0,
            SuaTo = IsSua ? SuaToEff : null, SuaFailTra = IsSua && Pos?.HeldCell == HandoverCell.Sua,   // [N23-SUA-GIAO][N23-SUA-CHUADAT]
            NcNext = !NcForSua || NcOpts.Count == 0 || string.IsNullOrEmpty(_ncNext) ? null : _ncNext,
            NcReason = NcEarlier ? _ncReason : null,
            CatId = NeedCat ? _catId : null,
            Notes = _notes,
        };
        try
        {
            var (ok, err) = await HandoverSvc.SaveFormAsync(req);
            _saving = false;
            if (!ok)
            {
                _err = err;
                await OnFailed.InvokeAsync(detailId);   // trang tải lại số PO (form giữ lựa chọn)
                return;
            }
            await OnSaved.InvokeAsync(detailId);
        }
        catch (Exception ex)   // [PAGE-ERR] lỗi máy chủ lạ: bỏ dữ liệu dở khỏi DbContext dùng chung
        {
            Db.ChangeTracker.Clear();
            _err = "Lỗi máy chủ: " + UiSafe.Text(ex, Logger, "lưu") + " — đóng cửa sổ, tải lại PO để xem đã lưu chưa rồi thử lại.";
        }
        finally { _saving = false; }
    }
}
