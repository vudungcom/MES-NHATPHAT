    @* ==================== REASON + SAVE ==================== *@
    @if (CanEditAnyArea)
    {
        <div class="card mb-5 @(RequiresReason ? "border-danger shadow-sm" : "border-primary shadow-sm")">
            <div class="card-header @(RequiresReason ? "bg-danger" : "bg-primary") text-white fw-bold">
                <i class="bi bi-pencil-square"></i> 
                @(RequiresReason ? "Xác nhận & Lý do thay đổi *" : "Ghi chú / Lý do (Tùy chọn khi nhập lần đầu)")
            </div>
            <div class="card-body bg-light">
                <textarea class="form-control @(RequiresReason ? "border-danger" : "")" @bind="_reason" rows="2" 
                          placeholder="@(RequiresReason ? "Nhập tóm tắt lý do sửa đổi (bắt buộc khi sửa dữ liệu đã có)..." : "Nhập ghi chú nếu có (không bắt buộc đối với lần đầu nhập)...")"></textarea>
                <small class="text-muted mt-1 d-block">
                    <i class="bi bi-info-circle"></i> 
                    @(RequiresReason 
                        ? "Tối thiểu 3 ký tự. Dữ liệu sẽ được ký điện tử và lưu vào sổ Audit Trail." 
                        : "Lần đầu nhập không bắt buộc điền lý do. Hệ thống sẽ tự động lưu 'Khởi tạo quy trình ban đầu' vào Audit Trail.")
                </small>
                
                @if (!string.IsNullOrEmpty(_saveResult))
                {
                    <div class="alert @(_saveHasError ? "alert-danger" : "alert-success") small mt-3 mb-0">
                        <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@_saveResult</pre>
                    </div>
                }
            </div>
            <div class="card-footer bg-white text-end py-3 d-flex justify-content-end gap-2 align-items-start">
                <a href="/part-master" class="btn btn-outline-secondary">Hủy bỏ</a>
                <div class="d-flex flex-column align-items-center">
                    <button class="btn @(_hasChanges ? "btn-warning" : "btn-outline-secondary") px-4"
                            @onclick="TrySaveDraftAsync"
                            disabled="@(_draftSaving || !_hasChanges)">
                        <i class="bi bi-floppy me-1"></i>
                        @(_draftSaving ? "Đang lưu..." : "Lưu nháp")
                    </button>
                    @if (_isDraftSaved && !_hasChanges)
                    {
                        <small class="text-danger fw-bold mt-1">Đã lưu nháp (Trạng thái: NG)</small>
                    }
                </div>
                <button class="btn @(_savedSuccessfully ? "btn-outline-success" : "btn-primary") px-4 fw-bold" style="height: 38px;"
                        @onclick="TrySaveAsync" disabled="@(_saving || _savedSuccessfully || !HasUnsavedChanges)">
                    <i class="bi @(_savedSuccessfully ? "bi-check2-all" : "bi-check2-circle") me-1"></i>
                    @(_saving ? "Đang xử lý..." : (_savedSuccessfully ? "Đã lưu & Xác nhận OK ✓" : "Lưu & Xác nhận OK"))
                </button>
            </div>
        </div>
    }
}

@* ==================== MODAL CHỌN NHIỀU MÁY ĐỒNG DẠNG ==================== *@
@if (_showAltMachineModal && _currentEditingAltMachining != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1055;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title mb-0">
                        <i class="bi bi-cpu"></i> Chọn máy đồng dạng cho công đoạn <b>@_currentEditingAltMachining.NC</b>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAlternativeModal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="Tìm theo Số máy / Tên máy / Bộ phận..." 
                               @bind="_altMachineSearch" @bind:event="oninput" />
                    </div>
                    <div class="list-group list-group-flush border rounded" style="max-height: 320px; overflow-y: auto;">
                        @if (!FilteredAltMachines.Any())
                        {
                            <div class="p-3 text-center text-muted small"><em>Không tìm thấy thiết bị phù hợp</em></div>
                        }
                        @foreach (var m in FilteredAltMachines)
                        {
                            var isSelected = _selectedAltMachines.Contains(m.SoMay);
                            <label class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-3" style="cursor: pointer;">
                                <div class="form-check mb-0">
                                    <input class="form-check-input me-2" type="checkbox" 
                                           checked="@isSelected" 
                                           @onchange="(e) => ToggleAltMachineSelection(m.SoMay, (bool)(e.Value ?? false))" />
                                    <strong class="text-primary">@m.SoMay</strong>
                                    <span class="text-dark ms-2">@m.TenMay</span>
                                    <span class="badge bg-light text-secondary ms-2 border">@m.BoPhan</span>
                                </div>
                                <span class="small text-muted">@m.LoaiMay</span>
                            </label>
                        }
                    </div>
                    <div class="small text-muted mt-2">
                        Đã chọn: <strong class="text-primary">@(_selectedAltMachines.Count > 0 ? string.Join(", ", _selectedAltMachines) : "Chưa chọn")</strong>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseAlternativeModal">Hủy</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAlternativeModal">
                        <i class="bi bi-check-lg"></i> Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>
}

