            WasActiveInDb = s.IsActive,
            CreatedByName = s.CreatedByUser?.FullName,
            CreatedAt = s.CreatedAt,
            UpdatedByName = s.UpdatedByUser?.FullName,
            UpdatedAt = s.UpdatedAt
        };

        public PartPackagingStep ToEntity() => new PartPackagingStep
        {
            StepId = StepId,
            NC = NC,
            StepName = StepName,
            StandardTime = StandardTime,
            IsBackup = IsBackup,
            ParentNC = ParentNC
        };
    }
}