    // ================================================================
    // SAVE
    // ================================================================
    private async Task TrySaveAsync()
    {
        _saveResult = string.Empty;
        _saveHasError = false;

        if (string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 3)
        {
            _saveResult = "Lý do thay đổi là bắt buộc, tối thiểu 3 ký tự.";
            _saveHasError = true;
            return;
        }

        _pendingDefaultChanges = CollectDefaultChanges();
        if (_pendingDefaultChanges.Count > 0)
        {
            _showPinModal = true;
        }
        else
        {
            await DoSaveAsync(applyDefaultChanges: false);
        }
    }

    private async Task OnPinConfirmed()
    {
        _showPinModal = false;
        await DoSaveAsync(applyDefaultChanges: true);
    }

    private void OnPinCancelled()
    {
        _showPinModal = false;
    }

    private List<PinConfirmModal.DefaultChangeInfo> CollectDefaultChanges()
    {
        var list = new List<PinConfirmModal.DefaultChangeInfo>();
        if (!_canEditA) return list;

        if (_setDefaultMaterial && !string.IsNullOrWhiteSpace(_material) && _material != _originalMaterial)
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "Material", OldValue = _originalMaterial, NewValue = _material! });
        if (_setDefaultConfig && !string.IsNullOrWhiteSpace(_materialConfig) && _materialConfig != _originalConfig)
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "MaterialConfig", OldValue = _originalConfig, NewValue = _materialConfig! });
        if (_setDefaultNote && !string.IsNullOrWhiteSpace(_materialNote) && _materialNote != _originalNote)
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "MaterialNote", OldValue = _originalNote, NewValue = _materialNote! });
        return list;
    }

    private async Task DoSaveAsync(bool applyDefaultChanges)
    {
        _saving = true;
        var log = new List<string>();
        var errors = new List<string>();
        var reason = _reason.Trim();
        var uid = _ctx!.UserId;

        try
        {
            if (_canEditA)
            {
                if (_partName != _originalPartName)
                {
                    try
                    {
                        await PmSvc.UpdatePartNameAsync(_part!.PartId, _partName, uid);
                        log.Add("✓ Đã cập nhật Tên chi tiết");
                    }
                    catch (Exception ex) { errors.Add("✗ Tên chi tiết: " + ex.Message); }
                }

                await TryAddAttrValue("Material", _material, uid, log, errors);
                await TryAddAttrValue("MaterialConfig", _materialConfig, uid, log, errors);
                await TryAddAttrValue("MaterialNote", _materialNote, uid, log, errors);

                if (applyDefaultChanges)
                {
                    foreach (var chg in _pendingDefaultChanges)
                    {
                        try
                        {
                            await PmSvc.SetAsDefaultAsync(_part!.PartId, chg.AttributeType, chg.NewValue, uid);
                            log.Add($"✓ Đã đặt default {chg.AttributeType} = {chg.NewValue}");
                        }
                        catch (Exception ex) { errors.Add($"✗ Đặt default {chg.AttributeType}: {ex.Message}"); }
                    }
                }
            }

            // VÙNG B: Machining
            await SaveStepListAsync(_machiningEdits,
                addFn: e => MachiningSvc.AddAsync(_part!.PartId, e.ToEntity(), uid, reason),
                updateFn: (id, e) => MachiningSvc.UpdateAsync(id, e.ToEntity(), uid, reason),
                deleteFn: id => MachiningSvc.SoftDeleteAsync(id, uid, reason),
                restoreFn: id => MachiningSvc.RestoreAsync(id, uid, reason),
                areaLabel: "Machining", log: log, errors: errors);

            // VÙNG C: Taro / Bavia / Washing
            await SaveStepListAsync(_taroEdits,
                addFn: e => TaroSvc.AddAsync(_part!.PartId, e.ToEntity(), uid, reason),
                updateFn: (id, e) => TaroSvc.UpdateAsync(id, e.ToEntity(), uid, reason),
                deleteFn: id => TaroSvc.SoftDeleteAsync(id, uid, reason),
                restoreFn: id => TaroSvc.RestoreAsync(id, uid, reason),
                areaLabel: "Taro", log: log, errors: errors);

            await SaveStepListAsync(_baviaEdits,
                addFn: e => BaviaSvc.AddAsync(_part!.PartId, e.ToEntity(), uid, reason),
                updateFn: (id, e) => BaviaSvc.UpdateAsync(id, e.ToEntity(), uid, reason),
                deleteFn: id => BaviaSvc.SoftDeleteAsync(id, uid, reason),
                restoreFn: id => BaviaSvc.RestoreAsync(id, uid, reason),
                areaLabel: "Bavia", log: log, errors: errors);

            await SaveStepListAsync(_washingEdits,
                addFn: e => WashingSvc.AddAsync(_part!.PartId, e.ToEntity(), uid, reason),
                updateFn: (id, e) => WashingSvc.UpdateAsync(id, e.ToEntity(), uid, reason),
                deleteFn: id => WashingSvc.SoftDeleteAsync(id, uid, reason),
                restoreFn: id => WashingSvc.RestoreAsync(id, uid, reason),
                areaLabel: "Rửa", log: log, errors: errors);

            // VÙNG D: Inspection
            await SaveStepListAsync(_inspectionEdits,
                addFn: e => InspectionSvc.AddAsync(_part!.PartId, e.ToEntity(), uid, reason),
                updateFn: (id, e) => InspectionSvc.UpdateAsync(id, e.ToEntity(), uid, reason),
                deleteFn: id => InspectionSvc.SoftDeleteAsync(id, uid, reason),
                restoreFn: id => InspectionSvc.RestoreAsync(id, uid, reason),
                areaLabel: "Kiểm tra", log: log, errors: errors);
        }
        finally
        {
            _saving = false;
        }

        _saveHasError = errors.Count > 0;
        var messages = new List<string>();
        if (log.Count > 0) messages.Add("Thành công:\n" + string.Join("\n", log));
        if (errors.Count > 0) messages.Add("Lỗi:\n" + string.Join("\n", errors));
        if (messages.Count == 0) messages.Add("Không có thay đổi nào để lưu.");
        _saveResult = string.Join("\n\n", messages);

        if (log.Count > 0)
        {
            _reason = string.Empty;
            _setDefaultMaterial = _setDefaultConfig = _setDefaultNote = false;
            await LoadAllAsync();
        }
    }

    private async Task TryAddAttrValue(string type, string? value, int uid, List<string> log, List<string> errors)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var attrs = _attrGroups.GetValueOrDefault(type);
        if (attrs != null && attrs.Any(a => a.Value == value && a.IsActive)) return;
        try
        {
            await PmSvc.AddValueAsync(_part!.PartId, type, value, uid);
            log.Add($"✓ Đã thêm giá trị mới cho {type}: {value}");
        }
        catch (Exception ex) { errors.Add($"✗ Thêm {type}: {ex.Message}"); }
    }

    private async Task SaveStepListAsync<T>(List<T> edits,
        Func<T, Task<long>> addFn,
        Func<long, T, Task> updateFn,
        Func<long, Task> deleteFn,
        Func<long, Task> restoreFn,
        string areaLabel, List<string> log, List<string> errors) where T : StepEditBase
    {
        foreach (var e in edits.ToList())
        {
            try
            {
                switch (e.State)
                {
                    case EditState.New:
                        if (string.IsNullOrWhiteSpace(e.NC)) continue;
                        var newId = await addFn(e);
                        log.Add($"✓ [{areaLabel}] Thêm dòng NC={e.NC}, StepId={newId}");
                        break;
                    case EditState.Deleted when e.StepId > 0 && e.WasActiveInDb:
                        await deleteFn(e.StepId);
                        log.Add($"✓ [{areaLabel}] Xóa dòng NC={e.NC}, StepId={e.StepId}");
                        break;
                    case EditState.Restored when e.StepId > 0:
                        await restoreFn(e.StepId);
                        log.Add($"✓ [{areaLabel}] Khôi phục dòng NC={e.NC}, StepId={e.StepId}");
                        break;
                    default:
                        if (e.StepId > 0 && e.State != EditState.Deleted && e.HasChanges)
                        {
                            await updateFn(e.StepId, e);
                            log.Add($"✓ [{areaLabel}] Sửa dòng NC={e.NC}, StepId={e.StepId}");
                        }
                        break;
                }
            }
            catch (Exception ex)
            {
                errors.Add($"✗ [{areaLabel}] NC={e.NC}: {ex.Message}");
            }
        }
    }

    public enum EditState { Unchanged, Modified, New, Deleted, Restored }

    public abstract class StepEditBase
    {
        public long StepId { get; set; }
        public string NC { get; set; } = "";
        public EditState State { get; set; } = EditState.Unchanged;
        public bool WasActiveInDb { get; set; }
        public virtual bool HasChanges => true;
    }

