@page "/part-master/detail"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using MES.Web.Components.Shared
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject PartMasterService PmSvc
@inject PartMasterListService ListSvc
@inject PartMachiningService MachiningSvc
@inject PartTaroService TaroSvc
@inject PartBaviaService BaviaSvc
@inject PartWashingService WashingSvc
@inject PartInspectionService InspectionSvc
@inject PartPackagingService PackagingSvc
@inject StandardWtsTaskService WtsSvc
@inject ThietBiService ThietBiSvc
@inject DoGaService DoGaSvc
@inject DaoService DaoSvc
@inject UserService UserSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject AppDbContext Db

<style>
    /* Hiệu ứng làm mờ các vùng Chỉ Xem, sáng lại khi di chuột vào */
    .section-readonly {
        opacity: 0.6;
        filter: grayscale(40%);
        transition: all 0.3s ease;
    }
    .section-readonly:hover {
        opacity: 1;
        filter: grayscale(0%);
    }

    /* Ẩn nút mũi tên tăng giảm trên ô input number */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<PageTitle>@(_part?.PartNo ?? "Part Master") - Chi tiết</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span> Đang tải dữ liệu...</div>
}
else if (_part == null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle-fill"></i> Không tìm thấy Part No: <code>@PartNo</code>
    </div>
    <a href="/part-master" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
}
else if (!CanViewAnyArea)
{
    <div class="alert alert-danger shadow-sm my-4">
        <h4><i class="bi bi-shield-lock-fill"></i> Truy cập bị từ chối</h4>
        <p>Tài khoản của bạn chưa được cấp quyền xem bất kỳ vùng nào của <b>Part Master</b> trên Ma trận phân quyền.</p>
    </div>
    <a href="/part-master" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
}
else
{
    @* ==================== HEADER ==================== *@
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">
                <code class="text-primary">@_part.PartNo</code>
                @if (!string.IsNullOrEmpty(_part.PartName))
                {
                    <span class="text-muted fs-4"> — @_part.PartName</span>
                }
            </h1>
            <div class="small text-muted">
                <i class="bi bi-building"></i> Khách hàng: <strong class="text-dark">@(_part.Customer?.CustomerName ?? "—")</strong>
            </div>
            <div class="mt-2 d-flex gap-2">
                @if (_part.IsPlanConfirmed) { <span class="badge bg-success">KH: OK</span> } else { <span class="badge bg-danger">KH: NG</span> }
                @if (_part.IsMachiningConfirmed) { <span class="badge bg-success">Gia công: OK</span> } else { <span class="badge bg-danger">Gia công: NG</span> }
                @if (_part.IsHtspConfirmed) { <span class="badge bg-success">HTSP: OK</span> } else { <span class="badge bg-danger">HTSP: NG</span> }
                @if (_part.IsKcsConfirmed) { <span class="badge bg-success">KCS: OK</span> } else { <span class="badge bg-danger">KCS: NG</span> }
                @if (_part.IsPkgConfirmed) { <span class="badge bg-success">Đóng gói: OK</span> } else { <span class="badge bg-danger">Đóng gói: NG</span> }
            </div>
        </div>
        <div class="d-flex gap-2 align-items-start">
            <a href="/part-master" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
            @if (CanEditAnyArea)
            {
                <div class="d-flex flex-column align-items-center">
                    <button class="btn @(_hasChanges ? "btn-warning" : "btn-outline-secondary") shadow-sm w-100"
                            @onclick="TrySaveDraftAsync"
                            disabled="@(_draftSaving || !_hasChanges)">
                        <i class="bi bi-floppy"></i>
                        @(_draftSaving ? "Đang lưu..." : "Lưu nháp")
                    </button>
                    @if (_isDraftSaved && !_hasChanges)
                    {
                        <small class="text-danger fw-bold mt-1" style="font-size: 0.75rem;">Đã lưu nháp (NG)</small>
                    }
                </div>
                <button class="btn @(_savedSuccessfully ? "btn-outline-success" : "btn-primary") shadow-sm" style="height: 38px;"
                        @onclick="TrySaveAsync" disabled="@(_saving || _savedSuccessfully || !HasUnsavedChanges)">
                    <i class="bi @(_savedSuccessfully ? "bi-check2-all" : "bi-check2-circle")"></i>
                    @(_saving ? "Đang xử lý..." : (_savedSuccessfully ? "Đã lưu & Xác nhận OK ✓" : "Lưu & Xác nhận OK"))
                </button>
            }
        </div>
    </div>

    @if (!CanEditAnyArea)
    {
        <div class="alert alert-warning py-2 small mb-3 border-0 shadow-sm">
            <i class="bi bi-shield-lock-fill text-warning me-2"></i> Bạn đang ở chế độ <b>Chỉ xem (Read-only)</b>. Các vùng sẽ bị làm mờ.
        </div>
    }

    @if (CanEditAnyArea)
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="chkShowDeleted" @bind="_showDeleted" @bind:after="ReloadDeletedAsync" />
            <label class="form-check-label small fw-bold text-muted" for="chkShowDeleted">Hiển thị lịch sử các dòng công đoạn đã xóa (Soft-deleted)</label>
        </div>
    }

    @* ==================== VÙNG A ==================== *@
    @if (_canViewA)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditA ? "" : "section-readonly")">
            <div class="card-header text-white fw-bold d-flex justify-content-between align-items-center" style="background-color: #0ea5e9;">
                <span><i class="bi bi-info-square"></i> A. Kế hoạch nhập</span>
                @if (!_canEditA) { <span class="badge bg-light text-dark">Chỉ xem</span> }
            </div>
            <div class="card-body bg-light">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Tên chi tiết</label>
                        <input class="form-control form-control-sm" @bind="_partName" @oninput="() => { _savedSuccessfully = false; _hasChanges = true; }" disabled="@(!_canEditA)" placeholder="Nhập tên chi tiết đầy đủ..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Mã VL (Material)</label>
                        <AttributePicker Label="" Placeholder="VD: SS400, AL6061..." Attributes="@(_attrGroups.GetValueOrDefault("Material"))" @bind-Value="_material" @bind-IsSetAsDefault="_setDefaultMaterial" Disabled="@(!_canEditA)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Cấu hình phôi (Material Config)</label>
                        <AttributePicker Label="" Placeholder="VD: B12x82x97..." Attributes="@(_attrGroups.GetValueOrDefault("MaterialConfig"))" @bind-Value="_materialConfig" @bind-IsSetAsDefault="_setDefaultConfig" Disabled="@(!_canEditA)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Ghi chú phôi</label>
                        <AttributePicker Label="" Placeholder="Nhập ghi chú bổ sung..." Attributes="@(_attrGroups.GetValueOrDefault("MaterialNote"))" @bind-Value="_materialNote" @bind-IsSetAsDefault="_setDefaultNote" Disabled="@(!_canEditA)" />
                    </div>
                </div>
            </div>
        </div>
    }

    @* ==================== VÙNG B: QUY TRÌNH GIA CÔNG ==================== *@
    @if (_canViewB)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditB ? "" : "section-readonly")">
            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-gear-wide-connected"></i> B. Quy trình gia công (@ActiveMachiningCount)
                    @if (!_canEditB) { <span class="badge bg-light text-dark ms-2">Chỉ xem</span> }
                </span>
                @if (_canEditB)
                {
                    <button class="btn btn-sm btn-light text-primary fw-bold" @onclick="AddMachiningRow" title="Thêm dòng">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.75rem;">
                        <thead class="table-light">
                            <tr class="text-center">
                                <th style="width: 45px;">#</th>
                                <th style="width: 100px;">NC *</th>
                                <th style="min-width: 140px;">Máy đăng ký</th>
                                <th style="min-width: 160px;">Máy đồng dạng</th>
                                <th style="min-width: 130px;">Đồ gá</th>
                                <th style="min-width: 140px;">Loại dao (Cột B)</th>
                                <th style="min-width: 120px;">Máy bấm giờ</th>
                                <th style="width: 80px;">T.Gá lắp<br/><span class="text-muted fw-normal">(phút)</span></th>
                                <th style="width: 80px;">T.Gia công<br/><span class="text-muted fw-normal">(phút)</span></th>
                                <th style="width: 80px;">T.Kiểm tra<br/><span class="text-muted fw-normal">(phút)</span></th>
                                <th style="width: 80px;">T.Chuẩn bị<br/><span class="text-muted fw-normal">(phút)</span></th>
                                <th style="width: 80px;">T.Chạy thử<br/><span class="text-muted fw-normal">(phút)</span></th>
                                <th style="width: @(_canEditB ? "90px" : "40px");">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_machiningEdits.Count == 0)
                            {
                                <tr><td colspan="13" class="text-center text-muted py-3"><em>Chưa thiết lập quy trình gia công.</em></td></tr>
                            }
                            @foreach (var (edit, idx) in _machiningEdits.Select((e, i) => (e, i)))
                            {
                                <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)" title="@RowTooltip(edit)">
                                    <td class="text-center">
                                        @(idx + 1)@StateBadge(edit)
                                        @if (edit.IsBackup) { <span class="badge bg-warning text-dark mt-1" style="font-size: 0.65rem;">Dự phòng</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                            <input class="form-control form-control-sm text-center @(edit.IsBackup ? "fw-bold text-dark" : "fw-bold text-primary")" 
                                                   @bind="edit.NC" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" />
                                        </div>
                                    </td>

                                    <td>
                                        <select class="form-select form-select-sm" @bind="edit.MachineRegistered" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))">
                                            <option value="">-- Chọn máy --</option>
                                            @if (!string.IsNullOrEmpty(edit.MachineRegistered) && !_thietBiList.Any(m => m.SoMay == edit.MachineRegistered))
                                            {
                                                <option value="@edit.MachineRegistered">@edit.MachineRegistered (Khác)</option>
                                            }
                                            @foreach (var m in _thietBiList)
                                            {
                                                <option value="@m.SoMay">@m.SoMay - @m.TenMay</option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input class="form-control form-control-sm" 
                                                   @bind="edit.MachineAlternative" @bind:after="() => MarkAsModified(edit)"
                                                   placeholder="Chọn máy..." 
                                                   disabled="@(!_canEditB || RowLocked(edit))" />
                                            @if (_canEditB && !RowLocked(edit))
                                            {
                                                <button class="btn btn-outline-secondary" type="button" 
                                                        title="Chọn nhiều máy đồng dạng" 
                                                        @onclick="() => OpenAlternativeModal(edit)">
                                                    <i class="bi bi-list-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <select class="form-select form-select-sm" @bind="edit.FixtureType" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))">
                                            <option value="">-- Chọn đồ gá --</option>
                                            @if (!string.IsNullOrEmpty(edit.FixtureType) && !_doGaList.Any(d => d.TenDoGa == edit.FixtureType))
                                            {
                                                <option value="@edit.FixtureType">@edit.FixtureType (Khác)</option>
                                            }
                                            @foreach (var g in _doGaList)
                                            {
                                                <option value="@g.TenDoGa">@g.TenDoGa</option>
                                            }
                                        </select>
                                    </td>

                                    @* Cột Loại Dao: Dropdown giống Đồ gá *@
                                    <td>
                                        <select class="form-select form-select-sm font-monospace"
                                                @bind="edit.ToolType" @bind:after="() => MarkAsModified(edit)"
                                                disabled="@(!_canEditB || RowLocked(edit))">
                                            <option value="">-- Chọn dao --</option>
                                            @if (!string.IsNullOrEmpty(edit.ToolType) && !_daoList.Any(d => d.TenDao == edit.ToolType))
                                            {
                                                <option value="@edit.ToolType">@edit.ToolType (Khác)</option>
                                            }
                                            @foreach (var d in _daoList)
                                            {
                                                <option value="@d.TenDao">@d.TenDao</option>
                                            }
                                        </select>
                                    </td>

                                    @* Cột Máy bấm giờ: Nhập tay tự do *@
                                    <td>
                                        <input class="form-control form-control-sm" 
                                               @bind="edit.TimingMachine" 
                                               @bind:after="() => MarkAsModified(edit)" 
                                               placeholder="Nhập máy bấm giờ..." 
                                               disabled="@(!_canEditB || RowLocked(edit))" />
                                    </td>

                                    <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.SetupTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.MachiningTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.InspectionTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.PreparationTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.TrialRunTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    
                                    <td class="text-center text-nowrap">
                                        @if (edit.StepId > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" title="Xem lịch sử thay đổi" 
                                                    @onclick="@(() => ShowHistoryAsync(edit.StepId, "Machining", edit.NC ?? "NC"))">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                        }
                                        @if (_canEditB)
                                        {
                                            <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" title="Tạo dự phòng" 
                                                    @onclick="() => AddBackupRow(_machiningEdits, edit, (nc, parent) => new MachiningEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, Drawing = edit.Drawing, FixtureType = edit.FixtureType, ToolType = edit.ToolType, TimingMachine = edit.TimingMachine, MachineAlternative = edit.MachineAlternative, SetupTime = edit.SetupTime, MachiningTime = edit.MachiningTime, InspectionTime = edit.InspectionTime, PreparationTime = edit.PreparationTime, TrialRunTime = edit.TrialRunTime })">
                                                <i class="bi bi-diagram-3"></i>
                                            </button>
                                            @RowActionButton(edit, () => ToggleDelete(edit, _machiningEdits))
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* --- DANH SÁCH MÁY LOẠI TRỪ (global setting — áp dụng cho tất cả Part) --- *@
                @if (_canViewB)
                {
                    <div class="border-top px-3 py-2 d-flex align-items-start gap-3" style="background: #fff8f0;">
                        <div class="flex-shrink-0 pt-1" style="min-width: 210px;">
                            <div class="fw-bold text-danger" style="font-size: 0.82rem;">
                                <i class="bi bi-slash-circle me-1"></i>Máy loại trừ (không tính TG và đẩy xuống nguyên công dưới)
                            </div>
                            <div class="text-muted mt-1" style="font-size: 0.7rem; line-height: 1.4;">
                                Cài đặt chung — áp dụng cho <strong>tất cả Part</strong>.<br/>
                                NC chạy trên máy này <strong>không tính vào chu kỳ gia công chính</strong>.
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-wrap gap-1 align-items-center py-1 min-height-28">
                            @if (!_excludeSettings.Any())
                            {
                                <span class="fst-italic text-muted" style="font-size: 0.8rem;">Chưa có máy nào bị loại trừ</span>
                            }
                            else
                            {
                                @foreach (var ex in _excludeSettings)
                                {
                                    <span class="badge rounded-pill border border-danger text-danger bg-white px-2"
                                          style="font-size: 0.75rem; font-weight: 500;">
                                        <i class="bi bi-slash-circle me-1" style="font-size: 0.65rem;"></i>@ex.SoMay
                                    </span>
                                }
                            }
                        </div>
                        @if (_canEditB)
                        {
                            <div class="flex-shrink-0 pt-1">
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="OpenExcludeModal"
                                        title="Cài đặt danh sách máy loại trừ (toàn hệ thống)">
                                    <i class="bi bi-gear me-1"></i>Cài đặt
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ==================== VÙNG C: HOÀN THIỆN SP ==================== *@
    @if (_canViewC)
    {
        <div class="row g-3 mb-4 @(_canEditC ? "" : "section-readonly")">
            @* C.1 Taro *@
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-nut"></i> C.1 Taro (@ActiveTaroCount)
                            @if (!_canEditC) { <span class="badge bg-light text-dark ms-1">Chỉ xem</span> }
                        </span>
                        @if (_canEditC) { <button class="btn btn-sm btn-light text-success fw-bold" @onclick="AddTaroRow" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width: 70px;">NC</th>
                                    <th>Công đoạn chuẩn (WTS)</th>
                                    <th style="width: 85px;">T.Chuẩn<br/><span class="text-muted fw-normal">(phút)</span></th>
                                    <th style="width: @(_canEditC ? "85px" : "40px");">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_taroEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2"><em>Trống</em></td></tr> }
                                @foreach (var edit in _taroEdits)
                                {
                                    <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)" title="@RowTooltip(edit)">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                                <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-success")" 
                                                       value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditC || RowLocked(edit))" />
                                            </div>
                                        </td>
                                        <td>
                                            @if (edit.State == EditState.New && !edit.IsBackup && _canEditC)
                                            {
                                                <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _taroTasks)">
                                                    <option value="">-- Chọn WTS Taro --</option>
                                                    @foreach (var t in _taroTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm" value="@edit.StepName" @bind:event="oninput" @bind:after="() => MarkAsModified(edit)" readonly disabled="@(!_canEditC || RowLocked(edit))" />
                                            }
                                        </td>
                                        <td><input type="number" step="0.1" class="form-control form-control-sm text-end px-1" @bind="edit.StandardTime" @bind:after="() => MarkAsModified(edit)" disabled="@(!_canEditC || RowLocked(edit))" /></td>
                                        
                                        <td class="text-center text-nowrap">
                                            @if (edit.StepId > 0)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary p-0 px-1 me-1" title="Xem lịch sử thay đổi" 
                                                        @onclick="@(() => ShowHistoryAsync(edit.StepId, "Taro", edit.NC ?? "NC"))">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                            }
                                            @if (_canEditC)
                                            {
                                                <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" 
                                                        @onclick="() => AddBackupRow(_taroEdits, edit, (nc, parent) => new TaroEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                                    <i class="bi bi-diagram-3"></i>
                                                </button>
                                                @RowActionButton(edit, () => ToggleDelete(edit, _taroEdits))
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* C.2 Bavia *@
            <div class="col-lg-4">
