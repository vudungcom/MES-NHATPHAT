        else if (e.CreatedAt.HasValue && !string.IsNullOrEmpty(e.CreatedByName))
        {
            msg = $"Tạo bởi: {e.CreatedByName} lúc {e.CreatedAt.Value:dd/MM/yyyy HH:mm}";
        }
        return msg;
    }

