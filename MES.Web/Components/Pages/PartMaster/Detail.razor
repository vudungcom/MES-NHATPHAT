@page "/part-master/detail"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Components.Shared
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject PartMasterService PmSvc
@inject PartMasterListService ListSvc
@inject PartMachiningService MachiningSvc
@inject PartTaroService TaroSvc
@inject PartBaviaService BaviaSvc
@inject PartWashingService WashingSvc
@inject PartInspectionService InspectionSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@(_part?.PartNo ?? "Part Master") - Chi tiết</PageTitle>

@if (_loading)
{
    <p><em>Đang tải...</em></p>
}
else if (_part == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        Không tìm thấy Part với Part No: <code>@PartNo</code>
    </div>
    <a href="/part-master" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Về trang Part Master
    </a>
}
else
{
    @* ==================== HEADER ==================== *@
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">
                <code>@_part.PartNo</code>
                @if (!string.IsNullOrEmpty(_part.PartName))
                {
                    <span class="text-muted fs-4"> — @_part.PartName</span>
                }
            </h1>
            <div class="small text-muted">
                <i class="bi bi-building"></i> Khách hàng:
                <strong>@(_part.Customer?.CustomerName ?? "—")</strong>
                <span class="ms-3">
                    <i class="bi bi-person-badge"></i> Bạn:
                    <span class="badge bg-secondary">@(_ctx?.DisplayRoleBadge ?? "?")</span>
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/part-master" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            @if (CanEditAnyArea)
            {
                <button class="btn btn-primary" @onclick="TrySaveAsync" disabled="@_saving">
                    <i class="bi bi-save"></i>
                    @(_saving ? "Đang lưu..." : "Lưu tất cả")
                </button>
            }
        </div>
    </div>

    @if (!CanEditAnyArea)
    {
        <div class="alert alert-info py-2 small mb-3">
            <i class="bi bi-info-circle"></i>
            Bạn chỉ có quyền xem. Để sửa cần ADMIN hoặc nhóm có quyền sửa tương ứng trên Ma trận RBAC.
        </div>
    }

    @if (CanEditAnyArea)
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="chkShowDeleted"
                   @bind="_showDeleted" @bind:after="ReloadDeletedAsync" />
            <label class="form-check-label small" for="chkShowDeleted">
                Hiện dòng đã xóa (để xem hoặc khôi phục)
            </label>
        </div>
    }

    @* ==================== VÙNG A ==================== *@
    <div class="card mb-4">
        <div class="card-header bg-info text-white fw-bold">
            <i class="bi bi-stars"></i> A. Kế hoạch nhập
            @if (!_canEditA)
            {
                <span class="badge bg-light text-dark ms-2">Chỉ xem</span>
            }
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small mb-1">Tên chi tiết</label>
                    <input class="form-control form-control-sm" @bind="_partName"
                           disabled="@(!_canEditA)"
                           placeholder="Tên đầy đủ của chi tiết" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-1">Mã VL (Material)</label>
                    <AttributePicker Label="" Placeholder="VD: SS400"
                                     Attributes="@(_attrGroups.GetValueOrDefault("Material"))"
                                     @bind-Value="_material"
                                     @bind-IsSetAsDefault="_setDefaultMaterial" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-1">Cấu hình phôi (Material Config)</label>
                    <AttributePicker Label="" Placeholder="VD: 100x50x20"
                                     Attributes="@(_attrGroups.GetValueOrDefault("MaterialConfig"))"
                                     @bind-Value="_materialConfig"
                                     @bind-IsSetAsDefault="_setDefaultConfig" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-1">Ghi chú phôi</label>
                    <AttributePicker Label="" Placeholder="Ghi chú"
                                     Attributes="@(_attrGroups.GetValueOrDefault("MaterialNote"))"
                                     @bind-Value="_materialNote"
                                     @bind-IsSetAsDefault="_setDefaultNote" />
                </div>
            </div>
        </div>
    </div>

    @* ==================== VÙNG B: Machining ==================== *@
    <div class="card mb-4">
        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-gear-wide-connected"></i> B. Quy trình gia công (@ActiveMachiningCount)
                @if (!_canEditB) { <span class="badge bg-light text-dark ms-2">Chỉ xem</span> }
            </span>
            @if (_canEditB)
            {
                <button class="btn btn-sm btn-light" @onclick="AddMachiningRow">
                    <i class="bi bi-plus-lg"></i> Thêm dòng chính thức
                </button>
            }
        </div>
        <div class="card-body p-0">
            @if (_machiningEdits.Count == 0)
            {
                <div class="p-3 text-muted small"><em>Chưa có công đoạn nào. Bấm "Thêm dòng" để bắt đầu.</em></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.75rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;">#</th>
                                <th style="width: 105px;">NC *</th>
                                <th>Bản vẽ</th>
                                <th>Máy đăng ký</th>
                                <th>Máy đồng dạng</th>
                                <th>Đồ gá</th>
                                <th>Loại dao</th>
                                <th>Máy bấm giờ</th>
                                <th class="text-end" style="width: 65px;">T.Gá lắp</th>
                                <th class="text-end" style="width: 65px;">T.Gia công</th>
                                <th class="text-end" style="width: 65px;">T.Kiểm tra</th>
                                <th class="text-end" style="width: 65px;">T.Chuẩn bị</th>
                                <th class="text-end" style="width: 65px;">T.Chạy thử</th>
                                @if (_canEditB) { <th style="width: 80px;" class="text-center">Thao tác</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (edit, idx) in _machiningEdits.Select((e, i) => (e, i)))
                            {
                                <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                    <td>
                                        @(idx + 1)@StateBadge(edit)
                                        @if (edit.IsBackup)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;" title="Phương án dự phòng cho @edit.ParentNC">DP</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (edit.IsBackup)
                                            {
                                                <i class="bi bi-arrow-return-right text-warning me-1" title="Dự phòng cho @edit.ParentNC"></i>
                                            }
                                            <input class="form-control form-control-sm @(edit.IsBackup ? "fw-bold text-dark" : "fw-bold text-primary")" 
                                                   @bind="edit.NC" disabled="@RowLocked(edit)" placeholder="Mã NC..." />
                                        </div>
                                    </td>
                                    <td><input class="form-control form-control-sm" @bind="edit.Drawing" disabled="@RowLocked(edit)" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.MachineRegistered" placeholder="VD: PHAY08..." disabled="@RowLocked(edit)" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.MachineAlternative" placeholder="VD: P04, P05..." disabled="@RowLocked(edit)" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.FixtureType" placeholder="VD: VJ45..." disabled="@RowLocked(edit)" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.ToolType" placeholder="Loại dao cụ..." disabled="@RowLocked(edit)" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.TimingMachine" placeholder="Máy bấm giờ..." disabled="@RowLocked(edit)" /></td>
                                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.SetupTime" disabled="@RowLocked(edit)" /></td>
                                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.MachiningTime" disabled="@RowLocked(edit)" /></td>
                                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.InspectionTime" disabled="@RowLocked(edit)" /></td>
                                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.PreparationTime" disabled="@RowLocked(edit)" /></td>
                                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.TrialRunTime" disabled="@RowLocked(edit)" /></td>
                                    @if (_canEditB)
                                    {
                                        <td class="text-center text-nowrap">
                                            <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" type="button" 
                                                    title="Tạo phương án dự phòng (NC-DP) từ dòng này" 
                                                    @onclick="() => AddMachiningBackupRow(edit)">
                                                <i class="bi bi-diagram-3"></i>
                                            </button>
                                            @RowActionButton(edit, () => MachiningToggleDelete(edit))
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ==================== VÙNG C: Hoàn thiện SP ==================== *@
    <div class="row g-3 mb-4">
        @* C.1 Taro *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-nut"></i> C.1 Taro (@ActiveTaroCount)</span>
                    @if (_canEditC)
                    {
                        <button class="btn btn-sm btn-light" @onclick="AddTaroRow">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (_taroEdits.Count == 0)
                    {
                        <div class="p-3 text-muted small"><em>Chưa có.</em></div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">NC *</th>
                                    <th>Tên công đoạn</th>
                                    <th class="text-end" style="width: 80px;">T.Chuẩn</th>
                                    @if (_canEditC) { <th style="width: 40px;"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edit in _taroEdits)
                                {
                                    <tr class="@RowCssClass(edit)">
                                        <td><input class="form-control form-control-sm" @bind="edit.NC" disabled="@RowLocked(edit)" /></td>
                                        <td><input class="form-control form-control-sm" @bind="edit.StepName" disabled="@RowLocked(edit)" /></td>
                                        <td><input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@RowLocked(edit)" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center">@RowActionButton(edit, () => TaroToggleDelete(edit))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        @* C.2 Bavia *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-scissors"></i> C.2 Bavia (@ActiveBaviaCount)</span>
                    @if (_canEditC)
                    {
                        <button class="btn btn-sm btn-light" @onclick="AddBaviaRow">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (_baviaEdits.Count == 0)
                    {
                        <div class="p-3 text-muted small"><em>Chưa có.</em></div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">NC *</th>
                                    <th>Tên công đoạn</th>
                                    @if (_canEditC) { <th style="width: 40px;"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edit in _baviaEdits)
                                {
                                    <tr class="@RowCssClass(edit)">
                                        <td><input class="form-control form-control-sm" @bind="edit.NC" disabled="@RowLocked(edit)" /></td>
                                        <td><input class="form-control form-control-sm" @bind="edit.StepName" disabled="@RowLocked(edit)" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center">@RowActionButton(edit, () => BaviaToggleDelete(edit))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        @* C.3 Rửa *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-droplet"></i> C.3 Rửa (@ActiveWashingCount)</span>
                    @if (_canEditC)
                    {
                        <button class="btn btn-sm btn-light" @onclick="AddWashingRow">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (_washingEdits.Count == 0)
                    {
                        <div class="p-3 text-muted small"><em>Chưa có.</em></div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">NC *</th>
                                    <th>Tên công đoạn</th>
                                    @if (_canEditC) { <th style="width: 40px;"></th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edit in _washingEdits)
                                {
                                    <tr class="@RowCssClass(edit)">
                                        <td><input class="form-control form-control-sm" @bind="edit.NC" disabled="@RowLocked(edit)" /></td>
                                        <td><input class="form-control form-control-sm" @bind="edit.StepName" disabled="@RowLocked(edit)" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center">@RowActionButton(edit, () => WashingToggleDelete(edit))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ==================== VÙNG D: Kiểm tra ==================== *@
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-search"></i> D. Kiểm tra (@ActiveInspectionCount)
                @if (!_canEditD) { <span class="badge bg-dark text-white ms-2">Chỉ xem</span> }
            </span>
            @if (_canEditD)
            {
                <button class="btn btn-sm btn-dark" @onclick="AddInspectionRow">
                    <i class="bi bi-plus-lg"></i> Thêm dòng
                </button>
            }
        </div>
        <div class="card-body p-0">
            @if (_inspectionEdits.Count == 0)
            {
                <div class="p-3 text-muted small"><em>Chưa có công đoạn nào.</em></div>
            }
            else
            {
                <table class="table table-sm mb-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">NC *</th>
                            <th>Tên công đoạn</th>
                            @if (_canEditD) { <th style="width: 50px;"></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var edit in _inspectionEdits)
                        {
                            <tr class="@RowCssClass(edit)">
                                <td><input class="form-control form-control-sm" @bind="edit.NC" disabled="@RowLocked(edit)" /></td>
                                <td><input class="form-control form-control-sm" @bind="edit.StepName" disabled="@RowLocked(edit)" /></td>
                                @if (_canEditD)
                                {
                                    <td class="text-center">@RowActionButton(edit, () => InspectionToggleDelete(edit))</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ==================== REASON + SAVE ==================== *@
    @if (CanEditAnyArea)
    {
        <div class="card mb-4 border-danger">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-pencil-square"></i> Lý do thay đổi <span class="text-warning">*</span> (bắt buộc khi Save)
            </div>
            <div class="card-body">
                <textarea class="form-control" @bind="_reason" rows="2"
                          placeholder="VD: Cập nhật loại dao và thời gian chạy thử cho máy mới, bổ sung phương án gia công dự phòng..."></textarea>
                <small class="text-muted">Tối thiểu 3 ký tự. Lý do sẽ được ghi nhận vào lịch sử PartProcessStepChangeLogs.</small>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_saveResult))
        {
            <div class="alert @(_saveHasError ? "alert-danger" : "alert-success") small">
                <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@_saveResult</pre>
            </div>
        }

        <div class="d-flex gap-2 mb-4">
            <button class="btn btn-primary btn-lg" @onclick="TrySaveAsync" disabled="@_saving">
                <i class="bi bi-save"></i>
                @(_saving ? "Đang lưu..." : "Lưu tất cả thay đổi")
            </button>
            <a href="/part-master" class="btn btn-outline-secondary btn-lg">Hủy, về danh sách</a>
        </div>
    }
}

<PinConfirmModal IsOpen="_showPinModal"
                 Title="Xác nhận đổi giá trị default"
                 Description="Bạn đang đổi giá trị default của Part Master. Cần nhập PIN để xác nhận."
                 Changes="@_pendingDefaultChanges"
                 OnConfirmed="OnPinConfirmed"
                 OnCancelled="OnPinCancelled" />

@code {
    [SupplyParameterFromQuery(Name = "partNo")]
    public string? PartNo { get; set; }

    private bool _loading = true;
    private bool _saving = false;
    private PartMaster? _part;
    private UserContext? _ctx;

    private bool _canEditA;
    private bool _canEditB;
    private bool _canEditC;
    private bool _canEditD;
    private bool CanEditAnyArea => _canEditA || _canEditB || _canEditC || _canEditD;

    private string? _partName;
    private Dictionary<string, List<PartMasterAttribute>> _attrGroups = new();
    private string? _material;
    private string? _materialConfig;
    private string? _materialNote;
    private bool _setDefaultMaterial;
    private bool _setDefaultConfig;
    private bool _setDefaultNote;
    private string? _originalPartName;
    private string? _originalMaterial;
    private string? _originalConfig;
    private string? _originalNote;

    private List<MachiningEdit> _machiningEdits = new();
    private List<TaroEdit> _taroEdits = new();
    private List<BaviaEdit> _baviaEdits = new();
    private List<WashingEdit> _washingEdits = new();
    private List<InspectionEdit> _inspectionEdits = new();

    private int ActiveMachiningCount => _machiningEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveTaroCount => _taroEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveBaviaCount => _baviaEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveWashingCount => _washingEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveInspectionCount => _inspectionEdits.Count(e => e.State != EditState.Deleted);

    private string _reason = string.Empty;
    private bool _showDeleted = false;

    private bool _showPinModal = false;
    private List<PinConfirmModal.DefaultChangeInfo> _pendingDefaultChanges = new();

    private string _saveResult = string.Empty;
    private bool _saveHasError = false;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(PartNo))
        {
            _loading = false;
            return;
        }

        var auth = await AuthState.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var uid))
        {
            _ctx = await PmSvc.GetUserContextAsync(uid);
        }

        _canEditA = PartMasterPermissionHelper.CanEditArea(_ctx?.GroupCode, _ctx?.Role, PartMasterArea.A_KeHoach);
        _canEditB = PartMasterPermissionHelper.CanEditArea(_ctx?.GroupCode, _ctx?.Role, PartMasterArea.B_Machining);
        _canEditC = PartMasterPermissionHelper.CanEditArea(_ctx?.GroupCode, _ctx?.Role, PartMasterArea.C_HoanThienSP);
        _canEditD = PartMasterPermissionHelper.CanEditArea(_ctx?.GroupCode, _ctx?.Role, PartMasterArea.D_KiemTra);

        _part = await PmSvc.GetByPartNoAsync(PartNo);
        if (_part == null)
        {
            _loading = false;
            return;
        }

        await LoadAllAsync();
        _loading = false;
    }

    private async Task LoadAllAsync()
    {
        _partName = _part!.PartName;
        _originalPartName = _partName;

        _attrGroups = await PmSvc.GetAttributesGroupedAsync(_part.PartId);
        _material = _attrGroups.GetValueOrDefault("Material")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _materialConfig = _attrGroups.GetValueOrDefault("MaterialConfig")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _materialNote = _attrGroups.GetValueOrDefault("MaterialNote")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _originalMaterial = _material;
        _originalConfig = _materialConfig;
        _originalNote = _materialNote;

        await ReloadStepsAsync();
    }

    private async Task ReloadStepsAsync()
    {
        List<PartMachiningStep> mSteps;
        List<PartTaroStep> tSteps;
        List<PartBaviaStep> bSteps;
        List<PartWashingStep> wSteps;
        List<PartInspectionStep> iSteps;

        if (_showDeleted)
        {
            mSteps = await MachiningSvc.GetAllByPartAsync(_part!.PartId);
            tSteps = await TaroSvc.GetAllByPartAsync(_part.PartId);
            bSteps = await BaviaSvc.GetAllByPartAsync(_part.PartId);
            wSteps = await WashingSvc.GetAllByPartAsync(_part.PartId);
            iSteps = await InspectionSvc.GetAllByPartAsync(_part.PartId);
        }
        else
        {
            mSteps = await MachiningSvc.GetActiveByPartAsync(_part!.PartId);
            tSteps = await TaroSvc.GetActiveByPartAsync(_part.PartId);
            bSteps = await BaviaSvc.GetActiveByPartAsync(_part.PartId);
            wSteps = await WashingSvc.GetActiveByPartAsync(_part.PartId);
            iSteps = await InspectionSvc.GetActiveByPartAsync(_part.PartId);
        }

        _machiningEdits = mSteps.Select(MachiningEdit.FromEntity).ToList();
        _taroEdits = tSteps.Select(TaroEdit.FromEntity).ToList();
        _baviaEdits = bSteps.Select(BaviaEdit.FromEntity).ToList();
        _washingEdits = wSteps.Select(WashingEdit.FromEntity).ToList();
        _inspectionEdits = iSteps.Select(InspectionEdit.FromEntity).ToList();
    }

