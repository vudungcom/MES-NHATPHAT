    private void AddMachiningRow() => _machiningEdits.Add(new MachiningEdit { State = EditState.New, IsBackup = false });

    private void AddMachiningBackupRow(MachiningEdit parentEdit)
    {
        // Xác định mã gốc
        var baseNC = !string.IsNullOrWhiteSpace(parentEdit.ParentNC)
            ? parentEdit.ParentNC
            : (parentEdit.NC?.Split("-DP-")[0].Trim() ?? "NC01");

        // Đếm số lượng dòng dự phòng hiện có của baseNC này
        var existingDpCount = _machiningEdits
            .Count(e => (e.ParentNC == baseNC || e.NC.StartsWith($"{baseNC}-DP-")) && e.NC != baseNC);

        var nextDpIndex = existingDpCount + 1;
        var newNC = $"{baseNC}-DP-{nextDpIndex:D2}";

        var newBackup = new MachiningEdit
        {
            State = EditState.New,
            NC = newNC,
            ParentNC = baseNC,
            IsBackup = true,
            Drawing = parentEdit.Drawing,
            FixtureType = parentEdit.FixtureType,
            ToolType = parentEdit.ToolType,
            MachineRegistered = "", // Để trống để nhập máy khác
            MachineAlternative = parentEdit.MachineAlternative,
            SetupTime = parentEdit.SetupTime,
            MachiningTime = parentEdit.MachiningTime,
            InspectionTime = parentEdit.InspectionTime,
            PreparationTime = parentEdit.PreparationTime,
            TrialRunTime = parentEdit.TrialRunTime
        };

        // Chèn vào ngay dưới dòng cha hoặc các dòng dự phòng trước đó của nó
        var insertIdx = _machiningEdits.IndexOf(parentEdit);
        if (insertIdx >= 0)
        {
            while (insertIdx + 1 < _machiningEdits.Count &&
                   (_machiningEdits[insertIdx + 1].ParentNC == baseNC || _machiningEdits[insertIdx + 1].NC.StartsWith($"{baseNC}-DP-")))
            {
                insertIdx++;
            }
            _machiningEdits.Insert(insertIdx + 1, newBackup);
        }
        else
        {
            _machiningEdits.Add(newBackup);
        }
    }

