    // ===== DANH SÁCH MÁY LOẠI TRỪ (global setting) =====

    private IEnumerable<ThietBi> FilteredExcludeMachines
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_excludeMachineSearch)) return _thietBiList;
            var s = _excludeMachineSearch.Trim();
            return _thietBiList.Where(m =>
                m.SoMay.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                m.TenMay.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                m.BoPhan.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                m.LoaiMay.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OpenExcludeModal()
    {
        _selectedExcludeMachines = _excludeSettings
            .Select(x => x.SoMay)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _excludeMachineSearch = string.Empty;
        _showExcludeModal = true;
    }

    private void CloseExcludeModal()
    {
        _showExcludeModal = false;
    }

    private void ToggleExcludeMachineSelection(string soMay, bool isChecked)
    {
        if (isChecked) _selectedExcludeMachines.Add(soMay);
        else _selectedExcludeMachines.Remove(soMay);
    }

    private async Task SaveExcludeModalAsync()
    {
        _excludeSaving = true;
        try
        {
            // Fresh read để tránh EF tracking conflict
            var current = await Db.MachineExcludeSettings.ToListAsync();
            var currentSet = current.Select(x => x.SoMay).ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Xóa máy bị bỏ tick
            var toRemove = current.Where(x => !_selectedExcludeMachines.Contains(x.SoMay)).ToList();
            if (toRemove.Any())
                Db.MachineExcludeSettings.RemoveRange(toRemove);

            // Thêm máy mới được tick
            foreach (var soMay in _selectedExcludeMachines.Where(s => !currentSet.Contains(s)))
            {
                await Db.MachineExcludeSettings.AddAsync(new MachineExcludeSetting
                {
                    SoMay = soMay,
                    AddedAt = DateTime.Now,
                    AddedByUserId = _currentUserId > 0 ? _currentUserId : null
                });
            }

            await Db.SaveChangesAsync();

            // Reload list hiển thị
            _excludeSettings = await Db.MachineExcludeSettings
                .OrderBy(x => x.SoMay)
                .AsNoTracking()
                .ToListAsync();

            _showExcludeModal = false;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[MachineExclude] SaveError: {ex.Message}");
        }
        finally
        {
            _excludeSaving = false;
        }
    }

    private void OnSelectWtsTask(SimpleStepEditBase edit, string? taskCode, List<StandardWtsTask> list)
    {
        var task = list.FirstOrDefault(t => t.TaskCode == taskCode);
        if (task != null)
        {
            edit.NC = task.TaskCode;
            edit.StepName = task.TaskName;
            if (task.StandardTimeSec.HasValue && task.StandardTimeSec > 0 && edit.StandardTime == null)
            {
                edit.StandardTime = Math.Round((decimal)task.StandardTimeSec.Value / 60m, 1);
            }
            MarkAsModified(edit);
        }
        else
        {
            edit.NC = ""; 
            edit.StepName = "";
        }
    }

    private void MarkAsModified(StepEditBase edit)
    {
        if (edit.State == EditState.Unchanged)
            edit.State = EditState.Modified;
        _hasChanges = true;
        _savedSuccessfully = false;
        _isDraftSaved = false;
    }

    private void ToggleDelete<T>(T edit, List<T> list) where T : StepEditBase
    {
        if (edit.State == EditState.New)
        {
            list.Remove(edit);
        }
        else if (edit.State == EditState.Deleted)
        {
            edit.State = edit.WasActiveInDb ? EditState.Unchanged : EditState.Restored;
        }
        else
        {
            edit.State = EditState.Deleted;
        }
        _hasChanges = true;
        _isDraftSaved = false;
    }

