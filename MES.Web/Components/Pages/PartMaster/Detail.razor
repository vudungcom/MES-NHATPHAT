                        Cài đặt này áp dụng cho <strong>toàn bộ Part</strong> trong hệ thống.
                        Nguyên công chạy trên máy được chọn sẽ <strong>không tính vào thời gian chu kỳ gia công chính</strong>.
                    </div>
                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="Tìm theo Số máy / Tên máy / Bộ phận..."
                               @bind="_excludeMachineSearch" @bind:event="oninput" />
                    </div>
                    <div class="list-group list-group-flush border rounded" style="max-height: 340px; overflow-y: auto;">
                        @if (!FilteredExcludeMachines.Any())
                        {
                            <div class="p-3 text-center text-muted small"><em>Không tìm thấy thiết bị phù hợp</em></div>
                        }
                        @foreach (var m in FilteredExcludeMachines)
                        {
                            var isSelected = _selectedExcludeMachines.Contains(m.SoMay);
                            <label class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-3" style="cursor: pointer;">
                                <div class="form-check mb-0">
                                    <input class="form-check-input me-2" type="checkbox"
                                           checked="@isSelected"
                                           @onchange="(e) => ToggleExcludeMachineSelection(m.SoMay, (bool)(e.Value ?? false))" />
                                    <strong class="text-danger">@m.SoMay</strong>
                                    <span class="text-dark ms-2">@m.TenMay</span>
                                    <span class="badge bg-light text-secondary ms-2 border">@m.BoPhan</span>
                                </div>
                                <span class="small text-muted">@m.LoaiMay</span>
                            </label>
                        }
                    </div>
                    <div class="small text-muted mt-2">
                        Đang loại trừ: <strong class="text-danger">
                            @(_selectedExcludeMachines.Count > 0
                                ? string.Join(", ", _selectedExcludeMachines.OrderBy(x => x))
                                : "Chưa có")
                        </strong>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseExcludeModal" disabled="@_excludeSaving">Hủy</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="SaveExcludeModalAsync" disabled="@_excludeSaving">
                        @if (_excludeSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Xác nhận & Lưu</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==================== MODAL LỊCH SỬ THAY ĐỔI (AUDIT TRAIL) ==================== *@
@if (_showHistoryModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-light py-2 border-bottom">
                    <h6 class="modal-title mb-0 text-dark fw-bold">
                        <i class="bi bi-clock-history text-secondary me-1"></i> @_historyTitle
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseHistoryModal"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_historyLoading)
                    {
                        <div class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm"></span> Đang tải lịch sử...
                        </div>
                    }
                    else if (_historyLogs.Count == 0)
                    {
                        <div class="text-center py-4 text-muted">
                            <em>Chưa có lịch sử thay đổi nào cho công đoạn này.</em>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mb-0">
                            <table class="table table-sm table-hover table-bordered align-middle mb-0" style="font-size: 0.8rem;">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 130px;">Thời gian</th>
                                        <th style="width: 140px;">Trường (Field)</th>
                                        <th>Giá trị cũ</th>
                                        <th>Giá trị mới</th>
                                        <th style="width: 150px;">Người sửa</th>
                                        <th>Lý do</th>
                                    </tr>
                                </thead>
                                <tbody>
