    private void AddBaviaRow()       { _baviaEdits.Add(new BaviaEdit { State = EditState.New });             _hasChanges = true; _isDraftSaved = false; StateHasChanged(); }
    private void AddWashingRow()     { _washingEdits.Add(new WashingEdit { State = EditState.New });         _hasChanges = true; _isDraftSaved = false; StateHasChanged(); }
    private void AddInspectionRow()  { _inspectionEdits.Add(new InspectionEdit { State = EditState.New });   _hasChanges = true; _isDraftSaved = false; StateHasChanged(); }
    private void AddPackagingRow()   { _packagingEdits.Add(new PackagingEdit { State = EditState.New });     _hasChanges = true; _isDraftSaved = false; StateHasChanged(); }

    private void AddBackupRow<T>(List<T> list, T parent, Func<string, string, T> factory) where T : StepEditBase
    {
        var baseNC = !string.IsNullOrWhiteSpace(parent.ParentNC) ? parent.ParentNC : (parent.NC?.Split("-DP-")[0].Trim() ?? "NC");
        if (string.IsNullOrWhiteSpace(baseNC) || baseNC == "NC") return;

        var count = list.Count(e => (e.ParentNC == baseNC || (e.NC != null && e.NC.StartsWith($"{baseNC}-DP-"))) && e.NC != baseNC);
        var newBackup = factory($"{baseNC}-DP-{count + 1:D2}", baseNC);
        
        var idx = list.IndexOf(parent);
        if (idx >= 0)
        {
            while (idx + 1 < list.Count && list[idx + 1].NC != null && list[idx + 1].NC.StartsWith($"{baseNC}-DP-"))
            {
                idx++;
            }
            list.Insert(idx + 1, newBackup);
        }
        else
        {
            list.Add(newBackup);
        }
        _hasChanges = true;
        _isDraftSaved = false;
    }

    private void OpenAlternativeModal(MachiningEdit edit)
