        if (e.State == EditState.Deleted) return "Dòng này đã bị xóa (chưa lưu).";
        if (e.State == EditState.New) return "Dòng mới thêm (chưa lưu).";

        var msg = "";
        if (e.UpdatedAt.HasValue && !string.IsNullOrEmpty(e.UpdatedByName))
        {
            msg = $"Sửa lần cuối bởi: {e.UpdatedByName} lúc {e.UpdatedAt.Value:dd/MM/yyyy HH:mm}";
