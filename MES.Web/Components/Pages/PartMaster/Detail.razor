@code {
    [SupplyParameterFromQuery(Name = "partNo")]
    public string? PartNo { get; set; }

    private bool _loading = true;
    private bool _saving = false;
    private bool _draftSaving = false;
    private bool _savedSuccessfully = false;
    private bool _hasChanges = false;
    private bool _isDraftSaved = false;
    private bool _isDraftConfirming = false; // Theo dõi xem popup PIN được mở từ Lưu Nháp hay Lưu OK

    private PartMaster? _part;
    private int _currentUserId;

    private bool _canViewA, _canViewB, _canViewC, _canViewD, _canViewE;
    private bool _canEditA, _canEditB, _canEditC, _canEditD, _canEditE;

    private bool CanViewAnyArea => _canViewA || _canViewB || _canViewC || _canViewD || _canViewE;
    private bool CanEditAnyArea => _canEditA || _canEditB || _canEditC || _canEditD || _canEditE;

    private bool HasUnsavedChanges
    {
        get
        {
            if (_canEditA)
            {
                if (_partName != _originalPartName) return true;
                if (_material != _originalMaterial) return true;
                if (_materialConfig != _originalConfig) return true;
                if (_materialNote != _originalNote) return true;
                if (_setDefaultMaterial || _setDefaultConfig || _setDefaultNote) return true;
            }

            if (_canEditB && _machiningEdits.Any(e => e.State != EditState.Unchanged)) return true;

            if (_canEditC)
            {
                if (_taroEdits.Any(e => e.State != EditState.Unchanged)) return true;
                if (_baviaEdits.Any(e => e.State != EditState.Unchanged)) return true;
                if (_washingEdits.Any(e => e.State != EditState.Unchanged)) return true;
            }

            if (_canEditD && _inspectionEdits.Any(e => e.State != EditState.Unchanged)) return true;
            if (_canEditE && _packagingEdits.Any(e => e.State != EditState.Unchanged)) return true;

            return false;
        }
    }

    private bool RequiresReason
    {
        get
        {
            if (_partName != _originalPartName && !string.IsNullOrWhiteSpace(_originalPartName)) return true;

            if (!string.IsNullOrWhiteSpace(_originalMaterial) && _material != _originalMaterial) return true;
            if (!string.IsNullOrWhiteSpace(_originalConfig) && _materialConfig != _originalConfig) return true;
            if (!string.IsNullOrWhiteSpace(_originalNote) && _materialNote != _originalNote) return true;

            if (_machiningEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;
            if (_taroEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;
            if (_baviaEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;
            if (_washingEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;
            if (_inspectionEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;
            if (_packagingEdits.Any(e => e.StepId > 0 && e.State != EditState.Unchanged && e.State != EditState.New)) return true;

            return false;
        }
    }

