    /// <summary>
    /// Chỉ bật Popup Modal nhập PIN khi người dùng CHỦ ĐỘNG tích chọn Checkbox Đặt làm mặc định.
    /// Logic này đã trả lại sự nhất quán cho cả 3 cột Vùng A.
    /// </summary>
    private List<PinConfirmModal.DefaultChangeInfo> CollectDefaultChanges()
    {
        var list = new List<PinConfirmModal.DefaultChangeInfo>();
        if (!_canEditA) return list;

        if (_setDefaultMaterial && _material != _originalMaterial)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "Mã VL (Material)", OldValue = _originalMaterial ?? "(Trống)", NewValue = _material ?? "(Trống)" });
        }
        if (_setDefaultConfig && _materialConfig != _originalConfig)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "Cấu hình phôi", OldValue = _originalConfig ?? "(Trống)", NewValue = _materialConfig ?? "(Trống)" });
        }
        if (_setDefaultNote && _materialNote != _originalNote)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "Ghi chú phôi", OldValue = _originalNote ?? "(Trống)", NewValue = _materialNote ?? "(Trống)" });
        }
        return list;
    }

    private async Task TrySaveDraftAsync() => await InitiateSaveAsync(isDraft: true);
    private async Task TrySaveAsync() => await InitiateSaveAsync(isDraft: false);

    private async Task InitiateSaveAsync(bool isDraft)
    {
        _saveResult = string.Empty;
        _saveHasError = false;

        if (RequiresReason && (string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 3))
        {
            _saveResult = "Lý do thay đổi là bắt buộc (tối thiểu 3 ký tự) khi chỉnh sửa dữ liệu đã có.";
            _saveHasError = true;
            return;
        }

        _pendingDefaultChanges = CollectDefaultChanges();

        // Mở popup khi có check ô Default, hoặc có sửa các dòng quy trình.
        if (_pendingDefaultChanges.Count > 0 || RequiresReason)
        {
            if (_pendingDefaultChanges.Count == 0)
            {
                _pendingDefaultChanges.Add(new PinConfirmModal.DefaultChangeInfo 
                { 
                    PartNo = _part!.PartNo, 
                    AttributeType = "Cập nhật Quy trình", 
                    OldValue = "Dữ liệu cũ", 
                    NewValue = "Đã thay đổi/Xóa" 
                });
            }
            _isDraftConfirming = isDraft;
            _showPinModal = true;
        }
        else
        {
            if (isDraft) _draftSaving = true; else _saving = true;
            try
            {
                await DoSaveAsync(confirmOk: !isDraft);
            }
            finally
            {
                if (isDraft) _draftSaving = false; else _saving = false;
            }
        }
    }

    private async Task OnPinConfirmed()
    {
        _showPinModal = false;
        
        if (_isDraftConfirming)
        {
            _draftSaving = true;
            try { await DoSaveAsync(confirmOk: false); }
            finally { _draftSaving = false; }
        }
        else
        {
            _saving = true;
            try { await DoSaveAsync(confirmOk: true); }
            finally { _saving = false; }
        }
    }

    private void OnPinCancelled()
    {
        _showPinModal = false;
    }

    /// <summary>
    /// HÀM SỬA LỖI MẤT "ssss": Cập nhật cờ Default trực tiếp qua EF Core,
    /// TUYỆT ĐỐI KHÔNG ghi đè giá trị cũ, để đảm bảo danh sách vẫn giữ đủ mọi lịch sử.
    /// </summary>
    private async Task SafeSetDefaultAsync(string attrType, string? newValue)
    {
        if (string.IsNullOrWhiteSpace(newValue)) return;

        var attrs = await Db.PartMasterAttributes
            .Where(a => a.PartId == _part!.PartId && a.AttributeType == attrType)
            .ToListAsync();

        var target = attrs.FirstOrDefault(x => x.Value == newValue) 
                  ?? Db.PartMasterAttributes.Local.FirstOrDefault(x => x.PartId == _part!.PartId && x.AttributeType == attrType && x.Value == newValue);

        // Chỉ tắt các cờ cũ nếu như tìm thấy record mới để bật
        if (target != null)
        {
            bool hasChanges = false;
            foreach (var a in attrs.Where(x => x.IsDefault && x.Value != newValue))
            {
                a.IsDefault = false;
                Db.PartMasterAttributes.Update(a);
                hasChanges = true;
            }

            if (!target.IsDefault)
            {
                target.IsDefault = true;
                Db.PartMasterAttributes.Update(target);
                hasChanges = true;
            }

            if (hasChanges)
            {
                await Db.SaveChangesAsync();
            }
        }
    }

    private async Task DoSaveAsync(bool confirmOk)
    {
        var log = new List<string>();
        var errors = new List<string>();
        var reason = string.IsNullOrWhiteSpace(_reason) ? "Khởi tạo quy trình ban đầu" : _reason.Trim();

        try
        {
            if (_canEditA)
            {
                if (_partName != _originalPartName)
                {
                    try
                    {
                        await PmSvc.UpdatePartNameAsync(_part!.PartId, _partName, _currentUserId);
                        log.Add("✓ Cập nhật Tên chi tiết");
                    }
                    catch (Exception ex)
                    {
                        errors.Add("✗ Tên chi tiết: " + ex.Message);
                    }
                }

                // LƯU CÁC GIÁ TRỊ VÀO DATABASE (NẾU CHƯA CÓ TRONG LIST)
                await TryAddAttrValue("Material", _material, _currentUserId, log, errors);
                await TryAddAttrValue("MaterialConfig", _materialConfig, _currentUserId, log, errors);
                await TryAddAttrValue("MaterialNote", _materialNote, _currentUserId, log, errors);

                // ÉP DB LƯU TỨC THÌ ĐỂ CÁC RECORD MỚI SINH RA ID TRƯỚC KHI CHẠY DEFAULT
                await Db.SaveChangesAsync();

                // CẬP NHẬT DEFAULT (CHỈ KHI NGƯỜI DÙNG TÍCH CHỌN)
                if (_setDefaultMaterial)
                {
                    try { await SafeSetDefaultAsync("Material", _material); log.Add($"✓ Đặt default Material = {_material}"); }
                    catch (Exception ex) { errors.Add($"✗ Đặt default Material: {ex.Message}"); }
                }

                if (_setDefaultConfig)
                {
                    try { await SafeSetDefaultAsync("MaterialConfig", _materialConfig); log.Add($"✓ Đặt default MaterialConfig = {_materialConfig}"); }
                    catch (Exception ex) { errors.Add($"✗ Đặt default MaterialConfig: {ex.Message}"); }
                }

                if (_setDefaultNote)
                {
                    try { await SafeSetDefaultAsync("MaterialNote", _materialNote); log.Add($"✓ Đặt default MaterialNote = {_materialNote}"); }
                    catch (Exception ex) { errors.Add($"✗ Đặt default MaterialNote: {ex.Message}"); }
                }

                _part!.IsPlanConfirmed = confirmOk;
                Db.PartMasters.Update(_part);
            }

            if (_canEditB)
            {
                await SaveStepListAsync(_machiningEdits,
                    e => MachiningSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => MachiningSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => MachiningSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => MachiningSvc.RestoreAsync(id, _currentUserId, reason),
                    "Machining", log, errors);

                _part!.IsMachiningConfirmed = confirmOk;
                Db.PartMasters.Update(_part);
            }

            if (_canEditC)
            {
                await SaveStepListAsync(_taroEdits,
                    e => TaroSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => TaroSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => TaroSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => TaroSvc.RestoreAsync(id, _currentUserId, reason),
                    "Taro", log, errors);

                await SaveStepListAsync(_baviaEdits,
                    e => BaviaSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => BaviaSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => BaviaSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => BaviaSvc.RestoreAsync(id, _currentUserId, reason),
                    "Bavia", log, errors);

                await SaveStepListAsync(_washingEdits,
                    e => WashingSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => WashingSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => WashingSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => WashingSvc.RestoreAsync(id, _currentUserId, reason),
                    "Rửa", log, errors);

                _part!.IsHtspConfirmed = confirmOk;
                Db.PartMasters.Update(_part);
            }

            if (_canEditD)
            {
                await SaveStepListAsync(_inspectionEdits,
                    e => InspectionSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => InspectionSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => InspectionSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => InspectionSvc.RestoreAsync(id, _currentUserId, reason),
                    "Kiểm tra", log, errors);

                _part!.IsKcsConfirmed = confirmOk;
                Db.PartMasters.Update(_part);
            }

            if (_canEditE)
            {
                await SaveStepListAsync(_packagingEdits,
                    e => PackagingSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => PackagingSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => PackagingSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => PackagingSvc.RestoreAsync(id, _currentUserId, reason),
                    "Đóng gói", log, errors);

                _part!.IsPkgConfirmed = confirmOk;
                Db.PartMasters.Update(_part);
            }

            if (_canEditA || _canEditB || _canEditC || _canEditD || _canEditE)
            {
                await Db.SaveChangesAsync();
                log.Add(confirmOk ? "✓ Đã lưu & Xác nhận OK." : "✓ Đã lưu nháp (trạng thái chuyển về NG).");
            }
        }
        finally
        {
            _saving = false;
        }

        _saveHasError = errors.Count > 0;
        var msg = new List<string>();
        if (log.Count > 0) msg.Add("Thành công:\n" + string.Join("\n", log));
        if (errors.Count > 0) msg.Add("Lỗi:\n" + string.Join("\n", errors));
        if (msg.Count == 0) msg.Add("Không có thay đổi nào để lưu.");
        
        _saveResult = string.Join("\n\n", msg);

        if (log.Count > 0)
        {
            _reason = string.Empty;
            _setDefaultMaterial = false;
            _setDefaultConfig = false;
            _setDefaultNote = false;
            _savedSuccessfully = confirmOk;
            _isDraftSaved = !confirmOk; 
            _hasChanges = false;
            await LoadAllAsync();
        }
    }

    private async Task TryAddAttrValue(string type, string? value, int uid, List<string> log, List<string> errors)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var attrs = _attrGroups.GetValueOrDefault(type);
        if (attrs != null && attrs.Any(a => a.Value == value && a.IsActive)) return;

        try
        {
            await PmSvc.AddValueAsync(_part!.PartId, type, value, uid);
            log.Add($"✓ Thêm giá trị mới {type}: {value}");
        }
        catch (Exception ex)
        {
            errors.Add($"✗ Thêm {type}: {ex.Message}");
        }
    }

    private async Task SaveStepListAsync<T>(List<T> edits, Func<T, Task<long>> addFn, Func<long, T, Task> updateFn, Func<long, Task> deleteFn, Func<long, Task> restoreFn, string label, List<string> log, List<string> errors) where T : StepEditBase
    {
        foreach (var e in edits.ToList())
        {
            try
            {
                if (e.State == EditState.New)
                {
                    if (string.IsNullOrWhiteSpace(e.NC)) e.NC = "-";
                    var id = await addFn(e);
                    log.Add($"✓ [{label}] Thêm NC={e.NC}");
                }
                else if (e.State == EditState.Deleted && e.StepId > 0 && e.WasActiveInDb)
                {
                    await deleteFn(e.StepId);
                    log.Add($"✓ [{label}] Xóa NC={e.NC}");
                }
                else if (e.State == EditState.Restored && e.StepId > 0)
                {
                    await restoreFn(e.StepId);
                    log.Add($"✓ [{label}] Khôi phục NC={e.NC}");
                }
                else if (e.StepId > 0 && e.State == EditState.Modified)
                {
                    await updateFn(e.StepId, e);
                    log.Add($"✓ [{label}] Sửa NC={e.NC}");
                }
            }
            catch (Exception ex)
            {
                errors.Add($"✗ [{label}] NC={e.NC}: {ex.Message}");
            }
        }
    }

