    private void MachiningToggleDelete(MachiningEdit e) => ToggleDelete(e, _machiningEdits);
    private void TaroToggleDelete(TaroEdit e) => ToggleDelete(e, _taroEdits);
    private void BaviaToggleDelete(BaviaEdit e) => ToggleDelete(e, _baviaEdits);
    private void WashingToggleDelete(WashingEdit e) => ToggleDelete(e, _washingEdits);
    private void InspectionToggleDelete(InspectionEdit e) => ToggleDelete(e, _inspectionEdits);

    private void ToggleDelete<T>(T edit, List<T> list) where T : StepEditBase
    {
        if (edit.State == EditState.New)
        {
            list.Remove(edit);
        }
        else if (edit.State == EditState.Deleted)
        {
            edit.State = edit.WasActiveInDb ? EditState.Unchanged : EditState.Restored;
        }
        else
        {
            edit.State = EditState.Deleted;
        }
    }

