@page "/part-master/detail"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using MES.Web.Components.Shared
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject PartMasterService PmSvc
@inject PartMasterListService ListSvc
@inject PartMachiningService MachiningSvc
@inject PartTaroService TaroSvc
@inject PartBaviaService BaviaSvc
@inject PartWashingService WashingSvc
@inject PartInspectionService InspectionSvc
@inject PartPackagingService PackagingSvc
@inject StandardWtsTaskService WtsSvc
@inject UserService UserSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<style>
    /* Hiệu ứng làm mờ các vùng Chỉ Xem, sáng lại khi di chuột vào */
    .section-readonly {
        opacity: 0.6;
        filter: grayscale(40%);
        transition: all 0.3s ease;
    }
    .section-readonly:hover {
        opacity: 1;
        filter: grayscale(0%);
    }

    /* Chuẩn hóa chiều cao và căn phẳng hàng cho Vùng A */
    .form-group-custom {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }
    .form-group-custom label {
        height: 18px;
        line-height: 18px;
        margin-bottom: 4px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .form-group-custom .form-control-sm,
    .form-group-custom .attribute-picker-container {
        height: 31px;
    }
</style>

<PageTitle>@(_part?.PartNo ?? "Part Master") - Chi tiết</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span> Đang tải dữ liệu...</div>
}
else if (_part == null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle-fill"></i> Không tìm thấy Part No: <code>@PartNo</code>
    </div>
    <a href="/part-master" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
}
else if (!CanViewAnyArea)
{
    <div class="alert alert-danger shadow-sm my-4">
        <h4><i class="bi bi-shield-lock-fill"></i> Truy cập bị từ chối</h4>
        <p>Tài khoản của bạn chưa được cấp quyền xem bất kỳ vùng nào của <b>Part Master</b> trên Ma trận phân quyền.</p>
    </div>
    <a href="/part-master" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
}
else
{
    @* ==================== HEADER ==================== *@
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">
                <code class="text-primary">@_part.PartNo</code>
                @if (!string.IsNullOrEmpty(_part.PartName))
                {
                    <span class="text-muted fs-4"> — @_part.PartName</span>
                }
            </h1>
            <div class="small text-muted">
                <i class="bi bi-building"></i> Khách hàng: <strong class="text-dark">@(_part.Customer?.CustomerName ?? "—")</strong>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/part-master" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
            @if (CanEditAnyArea)
            {
                <button class="btn btn-primary shadow-sm" @onclick="TrySaveAsync" disabled="@(_saving || !HasUnsavedChanges)">
                    <i class="bi bi-save"></i> @(_saving ? "Đang lưu..." : "Lưu tất cả thay đổi")
                </button>
            }
        </div>
    </div>

    @if (!CanEditAnyArea)
    {
        <div class="alert alert-warning py-2 small mb-3 border-0 shadow-sm">
            <i class="bi bi-shield-lock-fill text-warning me-2"></i> Bạn đang ở chế độ <b>Chỉ xem (Read-only)</b>. Các vùng sẽ bị làm mờ.
        </div>
    }

    @if (CanEditAnyArea)
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="chkShowDeleted" @bind="_showDeleted" @bind:after="ReloadDeletedAsync" />
            <label class="form-check-label small fw-bold text-muted" for="chkShowDeleted">Hiển thị lịch sử các dòng công đoạn đã xóa (Soft-deleted)</label>
        </div>
    }

    @* ==================== VÙNG A ==================== *@
    @if (_canViewA)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditA ? "" : "section-readonly")">
            <div class="card-header text-white fw-bold d-flex justify-content-between align-items-center" style="background-color: #0ea5e9;">
                <span><i class="bi bi-info-square"></i> A. Kế hoạch nhập</span>
                @if (!_canEditA) { <span class="badge bg-light text-dark">Chỉ xem</span> }
            </div>
            <div class="card-body bg-light">
                @* Hàng 1: Tên chi tiết & Mã VL *@
                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-group-custom">
                        <label class="form-label small fw-bold">Tên chi tiết</label>
                        <input class="form-control form-control-sm" @bind="_partName" disabled="@(!_canEditA)" placeholder="Nhập tên chi tiết đầy đủ..." />
                    </div>
                    <div class="col-md-6 form-group-custom">
                        <label class="form-label small fw-bold">Mã VL (Material)</label>
                        <AttributePicker Label="" Placeholder="VD: SS400, AL6061..." Attributes="@(_attrGroups.GetValueOrDefault("Material"))" @bind-Value="_material" @bind-IsSetAsDefault="_setDefaultMaterial" />
                    </div>
                </div>

                @* Hàng 2: Cấu hình phôi & Ghi chú phôi *@
                <div class="row g-3">
                    <div class="col-md-6 form-group-custom">
                        <label class="form-label small fw-bold">Cấu hình phôi (Material Config)</label>
                        <AttributePicker Label="" Placeholder="VD: B12x82x97..." Attributes="@(_attrGroups.GetValueOrDefault("MaterialConfig"))" @bind-Value="_materialConfig" @bind-IsSetAsDefault="_setDefaultConfig" />
                    </div>
                    <div class="col-md-6 form-group-custom">
                        <label class="form-label small fw-bold">Ghi chú phôi</label>
                        <AttributePicker Label="" Placeholder="Nhập ghi chú bổ sung..." Attributes="@(_attrGroups.GetValueOrDefault("MaterialNote"))" @bind-Value="_materialNote" @bind-IsSetAsDefault="_setDefaultNote" />
                    </div>
                </div>
            </div>
        </div>
    }

    @* ==================== VÙNG B: QUY TRÌNH GIA CÔNG ==================== *@
    @if (_canViewB)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditB ? "" : "section-readonly")">
            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-gear-wide-connected"></i> B. Quy trình gia công (@ActiveMachiningCount)
                    @if (!_canEditB) { <span class="badge bg-light text-dark ms-2">Chỉ xem</span> }
                </span>
                @if (_canEditB)
                {
                    <button class="btn btn-sm btn-light text-primary fw-bold" @onclick="AddMachiningRow" title="Thêm dòng">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.75rem;">
                        <thead class="table-light">
                            <tr class="text-center">
                                <th style="width: 45px;">#</th>
                                <th style="width: 110px;">NC *</th>
                                <th>Bản vẽ</th>
                                <th>Máy đăng ký</th>
                                <th>Máy đồng dạng</th>
                                <th>Đồ gá</th>
                                <th>Loại dao</th>
                                <th>Máy bấm giờ</th>
                                <th style="width: 65px;">T.Gá lắp</th>
                                <th style="width: 65px;">T.Gia công</th>
                                <th style="width: 65px;">T.Kiểm tra</th>
                                <th style="width: 65px;">T.Chuẩn bị</th>
                                <th style="width: 65px;">T.Chạy thử</th>
                                @if (_canEditB) { <th style="width: 80px;">Thao tác</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_machiningEdits.Count == 0)
                            {
                                <tr><td colspan="14" class="text-center text-muted py-3"><em>Chưa thiết lập quy trình gia công.</em></td></tr>
                            }
                            @foreach (var (edit, idx) in _machiningEdits.Select((e, i) => (e, i)))
                            {
                                <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                    <td class="text-center">
                                        @(idx + 1)@StateBadge(edit)
                                        @if (edit.IsBackup) { <span class="badge bg-warning text-dark mt-1" style="font-size: 0.65rem;">Dự phòng</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                            <input class="form-control form-control-sm text-center @(edit.IsBackup ? "fw-bold text-dark" : "fw-bold text-primary")" @bind="edit.NC" disabled="@(!_canEditB || RowLocked(edit))" />
                                        </div>
                                    </td>
                                    <td><input class="form-control form-control-sm" @bind="edit.Drawing" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input class="form-control form-control-sm text-uppercase" @bind="edit.MachineRegistered" placeholder="VD: PHAY08" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input class="form-control form-control-sm text-uppercase" @bind="edit.MachineAlternative" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.FixtureType" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.ToolType" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input class="form-control form-control-sm" @bind="edit.TimingMachine" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.SetupTime" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.MachiningTime" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.InspectionTime" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.PreparationTime" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.TrialRunTime" disabled="@(!_canEditB || RowLocked(edit))" /></td>
                                    @if (_canEditB)
                                    {
                                        <td class="text-center text-nowrap">
                                            <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" title="Thêm phương án chạy máy dự phòng" 
                                                    @onclick="() => AddBackupRow(_machiningEdits, edit, (nc, parent) => new MachiningEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, Drawing = edit.Drawing, FixtureType = edit.FixtureType, ToolType = edit.ToolType, MachineAlternative = edit.MachineAlternative, SetupTime = edit.SetupTime, MachiningTime = edit.MachiningTime, InspectionTime = edit.InspectionTime, PreparationTime = edit.PreparationTime, TrialRunTime = edit.TrialRunTime })">
                                                <i class="bi bi-diagram-3"></i>
                                            </button>
                                            @RowActionButton(edit, () => ToggleDelete(edit, _machiningEdits))
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ==================== VÙNG C: HOÀN THIỆN SP ==================== *@
    @if (_canViewC)
    {
        <div class="row g-3 mb-4 @(_canEditC ? "" : "section-readonly")">
            @* C.1 Taro *@
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-nut"></i> C.1 Taro (@ActiveTaroCount)
                            @if (!_canEditC) { <span class="badge bg-light text-dark ms-1">Chỉ xem</span> }
                        </span>
                        @if (_canEditC) { <button class="btn btn-sm btn-light text-success fw-bold" @onclick="() => _taroEdits.Add(new TaroEdit { State = EditState.New })" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light text-center">
                                <tr><th style="width: 80px;">NC</th><th>Công đoạn chuẩn (WTS)</th><th style="width: 65px;">T.Chuẩn</th>@if (_canEditC){<th style="width: 55px;"></th>}</tr>
                            </thead>
                            <tbody>
                                @if (_taroEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2"><em>Trống</em></td></tr> }
                                @foreach (var edit in _taroEdits)
                                {
                                    <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                                <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-success")" value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditC || RowLocked(edit))" />
                                            </div>
                                        </td>
                                        <td>
                                            @if (edit.State == EditState.New && !edit.IsBackup && _canEditC)
                                            {
                                                <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _taroTasks)">
                                                    <option value="">-- Chọn WTS Taro --</option>
                                                    @foreach (var t in _taroTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm" value="@edit.StepName" readonly disabled="@(!_canEditC || RowLocked(edit))" title="@edit.StepName" />
                                            }
                                        </td>
                                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@(!_canEditC || RowLocked(edit))" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center text-nowrap">
                                                <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" 
                                                        @onclick="() => AddBackupRow(_taroEdits, edit, (nc, parent) => new TaroEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                                    <i class="bi bi-diagram-3"></i>
                                                </button>
                                                @RowActionButton(edit, () => ToggleDelete(edit, _taroEdits))
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* C.2 Bavia *@
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-scissors"></i> C.2 Bavia (@ActiveBaviaCount)
                            @if (!_canEditC) { <span class="badge bg-light text-dark ms-1">Chỉ xem</span> }
                        </span>
                        @if (_canEditC) { <button class="btn btn-sm btn-light text-success fw-bold" @onclick="() => _baviaEdits.Add(new BaviaEdit { State = EditState.New })" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light text-center">
                                <tr><th style="width: 80px;">NC</th><th>Công đoạn chuẩn (WTS)</th><th style="width: 65px;">T.Chuẩn</th>@if (_canEditC){<th style="width: 55px;"></th>}</tr>
                            </thead>
                            <tbody>
                                @if (_baviaEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2"><em>Trống</em></td></tr> }
                                @foreach (var edit in _baviaEdits)
                                {
                                    <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                                <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-success")" value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditC || RowLocked(edit))" />
                                            </div>
                                        </td>
                                        <td>
                                            @if (edit.State == EditState.New && !edit.IsBackup && _canEditC)
                                            {
                                                <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _baviaTasks)">
                                                    <option value="">-- Chọn WTS Bavia --</option>
                                                    @foreach (var t in _baviaTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm" value="@edit.StepName" readonly disabled="@(!_canEditC || RowLocked(edit))" title="@edit.StepName" />
                                            }
                                        </td>
                                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@(!_canEditC || RowLocked(edit))" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center text-nowrap">
                                                <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" 
                                                        @onclick="() => AddBackupRow(_baviaEdits, edit, (nc, parent) => new BaviaEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                                    <i class="bi bi-diagram-3"></i>
                                                </button>
                                                @RowActionButton(edit, () => ToggleDelete(edit, _baviaEdits))
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* C.3 Rửa *@
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-droplet"></i> C.3 Rửa (@ActiveWashingCount)
                            @if (!_canEditC) { <span class="badge bg-light text-dark ms-1">Chỉ xem</span> }
                        </span>
                        @if (_canEditC) { <button class="btn btn-sm btn-light text-success fw-bold" @onclick="() => _washingEdits.Add(new WashingEdit { State = EditState.New })" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.75rem;">
                            <thead class="table-light text-center">
                                <tr><th style="width: 80px;">NC</th><th>Công đoạn chuẩn (WTS)</th><th style="width: 65px;">T.Chuẩn</th>@if (_canEditC){<th style="width: 55px;"></th>}</tr>
                            </thead>
                            <tbody>
                                @if (_washingEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-2"><em>Trống</em></td></tr> }
                                @foreach (var edit in _washingEdits)
                                {
                                    <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                                <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-success")" value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditC || RowLocked(edit))" />
                                            </div>
                                        </td>
                                        <td>
                                            @if (edit.State == EditState.New && !edit.IsBackup && _canEditC)
                                            {
                                                <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _washingTasks)">
                                                    <option value="">-- Chọn WTS Rửa --</option>
                                                    @foreach (var t in _washingTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm" value="@edit.StepName" readonly disabled="@(!_canEditC || RowLocked(edit))" title="@edit.StepName" />
                                            }
                                        </td>
                                        <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@(!_canEditC || RowLocked(edit))" /></td>
                                        @if (_canEditC)
                                        {
                                            <td class="text-center text-nowrap">
                                                <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" 
                                                        @onclick="() => AddBackupRow(_washingEdits, edit, (nc, parent) => new WashingEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                                    <i class="bi bi-diagram-3"></i>
                                                </button>
                                                @RowActionButton(edit, () => ToggleDelete(edit, _washingEdits))
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ==================== VÙNG D: KIỂM TRA KCS ==================== *@
    @if (_canViewD)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditD ? "" : "section-readonly")" style="border-top: 4px solid #eab308;">
            <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-search"></i> D. Kiểm tra chất lượng (KCS) (@ActiveInspectionCount)
                    @if (!_canEditD) { <span class="badge bg-dark text-white ms-2">Chỉ xem</span> }
                </span>
                @if (_canEditD) { <button class="btn btn-sm btn-dark" @onclick="() => _inspectionEdits.Add(new InspectionEdit { State = EditState.New })" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
            </div>
            <div class="card-body p-0">
                <table class="table table-sm align-middle mb-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;" class="text-center">NC *</th>
                            <th>Nội dung công việc (WTS Chuẩn)</th>
                            <th class="text-end" style="width: 120px;">T.Chuẩn (phút)</th>
                            @if (_canEditD) { <th style="width: 80px;" class="text-center">Thao tác</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_inspectionEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3"><em>Chưa thiết lập quy trình kiểm tra KCS.</em></td></tr> }
                        @foreach (var edit in _inspectionEdits)
                        {
                            <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                <td>
                                    <div class="d-flex align-items-center justify-content-center">
                                        @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                        <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-warning")" value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditD || RowLocked(edit))" />
                                    </div>
                                </td>
                                <td>
                                    @if (edit.State == EditState.New && !edit.IsBackup && _canEditD)
                                    {
                                        <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _inspectionTasks)">
                                            <option value="">-- Chọn công việc Kiểm tra từ danh mục --</option>
                                            @foreach (var t in _inspectionTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" value="@edit.StepName" readonly disabled="@(!_canEditD || RowLocked(edit))" title="@edit.StepName" />
                                    }
                                </td>
                                <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@(!_canEditD || RowLocked(edit))" /></td>
                                @if (_canEditD)
                                {
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" title="Tạo dự phòng" 
                                                @onclick="() => AddBackupRow(_inspectionEdits, edit, (nc, parent) => new InspectionEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>
                                        @RowActionButton(edit, () => ToggleDelete(edit, _inspectionEdits))
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ==================== VÙNG E: ĐÓNG GÓI ==================== *@
    @if (_canViewE)
    {
        <div class="card mb-4 border-0 shadow-sm @(_canEditE ? "" : "section-readonly")" style="border-top: 4px solid #8b5cf6;">
            <div class="card-header text-white fw-bold d-flex justify-content-between align-items-center" style="background-color: #8b5cf6;">
                <span>
                    <i class="bi bi-box-seam"></i> E. Quy trình Đóng gói (@ActivePackagingCount)
                    @if (!_canEditE) { <span class="badge bg-light text-dark ms-2">Chỉ xem</span> }
                </span>
                @if (_canEditE) { <button class="btn btn-sm btn-light text-primary fw-bold" @onclick="() => _packagingEdits.Add(new PackagingEdit { State = EditState.New })" title="Thêm dòng"><i class="bi bi-plus-lg"></i></button> }
            </div>
            <div class="card-body p-0">
                <table class="table table-sm align-middle mb-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;" class="text-center">NC *</th>
                            <th>Nội dung đóng gói (WTS Chuẩn)</th>
                            <th class="text-end" style="width: 120px;">T.Chuẩn (phút)</th>
                            @if (_canEditE) { <th style="width: 80px;" class="text-center">Thao tác</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_packagingEdits.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3"><em>Chưa thiết lập quy trình đóng gói.</em></td></tr> }
                        @foreach (var edit in _packagingEdits)
                        {
                            <tr class="@(edit.IsBackup ? "bg-warning bg-opacity-10" : "") @RowCssClass(edit)">
                                <td>
                                    <div class="d-flex align-items-center justify-content-center">
                                        @if (edit.IsBackup) { <i class="bi bi-arrow-return-right text-warning me-1"></i> }
                                        <input class="form-control form-control-sm text-center fw-bold @(edit.IsBackup ? "text-dark" : "text-primary")" value="@(string.IsNullOrEmpty(edit.NC) ? "..." : edit.NC)" readonly disabled="@(!_canEditE || RowLocked(edit))" />
                                    </div>
                                </td>
                                <td>
                                    @if (edit.State == EditState.New && !edit.IsBackup && _canEditE)
                                    {
                                        <select class="form-select form-select-sm" @onchange="(e) => OnSelectWtsTask(edit, e.Value?.ToString(), _packagingTasks)">
                                            <option value="">-- Chọn công việc Đóng gói từ danh mục --</option>
                                            @foreach (var t in _packagingTasks) { <option value="@t.TaskCode">[@t.TaskCode] @t.TaskName</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" value="@edit.StepName" readonly disabled="@(!_canEditE || RowLocked(edit))" title="@edit.StepName" />
                                    }
                                </td>
                                <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="edit.StandardTime" disabled="@(!_canEditE || RowLocked(edit))" /></td>
                                @if (_canEditE)
                                {
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-outline-warning p-0 px-1 me-1" title="Tạo dự phòng" 
                                                @onclick="() => AddBackupRow(_packagingEdits, edit, (nc, parent) => new PackagingEdit { State = EditState.New, NC = nc, ParentNC = parent, IsBackup = true, StepName = edit.StepName, StandardTime = edit.StandardTime })">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>
                                        @RowActionButton(edit, () => ToggleDelete(edit, _packagingEdits))
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ==================== REASON + SAVE ==================== *@
    @if (CanEditAnyArea)
    {
        <div class="card mb-5 border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-pencil-square"></i> Xác nhận & Lý do thay đổi <span class="text-warning">*</span>
            </div>
            <div class="card-body bg-light">
                <textarea class="form-control border-danger" @bind="_reason" rows="2" placeholder="Nhập tóm tắt lý do sửa đổi (bắt buộc). VD: Thêm công đoạn rửa cho mã hàng mới, chỉnh lại thời gian chạy máy CNC..."></textarea>
                <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle"></i> Tối thiểu 3 ký tự. Dữ liệu sẽ được ký điện tử và lưu vào sổ Audit Trail.</small>
                
                @if (!string.IsNullOrEmpty(_saveResult))
                {
                    <div class="alert @(_saveHasError ? "alert-danger" : "alert-success") small mt-3 mb-0">
                        <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@_saveResult</pre>
                    </div>
                }
            </div>
            <div class="card-footer bg-white text-end py-3">
                <a href="/part-master" class="btn btn-outline-secondary me-2">Hủy bỏ</a>
                <button class="btn btn-primary px-4 fw-bold" @onclick="TrySaveAsync" disabled="@(_saving || !HasUnsavedChanges)">
                    <i class="bi bi-save me-1"></i> @(_saving ? "Đang lưu..." : "LƯU TẤT CẢ THAY ĐỔI")
                </button>
            </div>
        </div>
    }
}

<PinConfirmModal IsOpen="_showPinModal" Title="Xác nhận đổi Master Data" Description="Việc thay đổi tham số chuẩn sẽ ảnh hưởng đến các Kế hoạch trong tương lai. Vui lòng nhập mã PIN." Changes="@_pendingDefaultChanges" OnConfirmed="OnPinConfirmed" OnCancelled="OnPinCancelled" />

@code {
    [SupplyParameterFromQuery(Name = "partNo")]
    public string? PartNo { get; set; }

    private bool _loading = true;
    private bool _saving = false;
    private PartMaster? _part;
    private int _currentUserId;

    private bool _canViewA, _canViewB, _canViewC, _canViewD, _canViewE;
    private bool _canEditA, _canEditB, _canEditC, _canEditD, _canEditE;

    private bool CanViewAnyArea => _canViewA || _canViewB || _canViewC || _canViewD || _canViewE;
    private bool CanEditAnyArea => _canEditA || _canEditB || _canEditC || _canEditD || _canEditE;

    private bool HasUnsavedChanges
    {
        get
        {
            if (_canEditA)
            {
                if (_partName != _originalPartName) return true;
                if (_material != _originalMaterial) return true;
                if (_materialConfig != _originalConfig) return true;
                if (_materialNote != _originalNote) return true;
                if (_setDefaultMaterial || _setDefaultConfig || _setDefaultNote) return true;
            }

            if (_canEditB && _machiningEdits.Any(e => e.State != EditState.Unchanged)) return true;

            if (_canEditC)
            {
                if (_taroEdits.Any(e => e.State != EditState.Unchanged)) return true;
                if (_baviaEdits.Any(e => e.State != EditState.Unchanged)) return true;
                if (_washingEdits.Any(e => e.State != EditState.Unchanged)) return true;
            }

            if (_canEditD && _inspectionEdits.Any(e => e.State != EditState.Unchanged)) return true;
            if (_canEditE && _packagingEdits.Any(e => e.State != EditState.Unchanged)) return true;

            return false;
        }
    }

    private string? _partName;
    private Dictionary<string, List<PartMasterAttribute>> _attrGroups = new();
    private string? _material;
    private string? _materialConfig;
    private string? _materialNote;
    private bool _setDefaultMaterial;
    private bool _setDefaultConfig;
    private bool _setDefaultNote;
    private string? _originalPartName;
    private string? _originalMaterial;
    private string? _originalConfig;
    private string? _originalNote;

    private List<MachiningEdit> _machiningEdits = new();
    private List<TaroEdit> _taroEdits = new();
    private List<BaviaEdit> _baviaEdits = new();
    private List<WashingEdit> _washingEdits = new();
    private List<InspectionEdit> _inspectionEdits = new();
    private List<PackagingEdit> _packagingEdits = new();

    private List<StandardWtsTask> _allWtsTasks = new();
    private List<StandardWtsTask> _taroTasks = new();
    private List<StandardWtsTask> _baviaTasks = new();
    private List<StandardWtsTask> _washingTasks = new();
    private List<StandardWtsTask> _inspectionTasks = new();
    private List<StandardWtsTask> _packagingTasks = new();

    private int ActiveMachiningCount => _machiningEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveTaroCount => _taroEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveBaviaCount => _baviaEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveWashingCount => _washingEdits.Count(e => e.State != EditState.Deleted);
    private int ActiveInspectionCount => _inspectionEdits.Count(e => e.State != EditState.Deleted);
    private int ActivePackagingCount => _packagingEdits.Count(e => e.State != EditState.Deleted);

    private string _reason = string.Empty;
    private bool _showDeleted = false;

    private bool _showPinModal = false;
    private List<PinConfirmModal.DefaultChangeInfo> _pendingDefaultChanges = new();
    private string _saveResult = string.Empty;
    private bool _saveHasError = false;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(PartNo))
        {
            _loading = false;
            return;
        }

        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdStr, out _currentUserId);

        var isAdmin = user.IsInRole("ADMIN") 
                   || user.FindFirst("GroupCode")?.Value == "ADMIN" 
                   || user.FindFirst(ClaimTypes.Role)?.Value == "ADMIN"
                   || user.Identity?.Name?.ToLower() == "admin";

        if (isAdmin)
        {
            _canViewA = _canViewB = _canViewC = _canViewD = _canViewE = true;
            _canEditA = _canEditB = _canEditC = _canEditD = _canEditE = true;
        }
        else if (_currentUserId > 0)
        {
            var perms = await UserSvc.GetAllUserPermissionsAsync(_currentUserId);
            
            _canViewA = perms.TryGetValue("PART_TAO_MOI", out var pvA) && pvA.CanView;
            _canEditA = perms.TryGetValue("PART_TAO_MOI", out var pA) && pA.CanEdit;

            _canViewB = perms.TryGetValue("PART_GC", out var pvB) && pvB.CanView;
            _canEditB = perms.TryGetValue("PART_GC", out var pB) && pB.CanEdit;

            _canViewC = perms.TryGetValue("PART_HTSP", out var pvC) && pvC.CanView;
            _canEditC = perms.TryGetValue("PART_HTSP", out var pC) && pC.CanEdit;

            _canViewD = perms.TryGetValue("PART_KCS", out var pvD) && pvD.CanView;
            _canEditD = perms.TryGetValue("PART_KCS", out var pD) && pD.CanEdit;

            _canViewE = perms.TryGetValue("PART_DONGGOI", out var pvE) && pvE.CanView;
            _canEditE = perms.TryGetValue("PART_DONGGOI", out var pE) && pE.CanEdit;
        }

        _allWtsTasks = await WtsSvc.GetAllActiveAsync();
        _taroTasks = _allWtsTasks.Where(t => t.CategoryCode == "TARO").ToList();
        _baviaTasks = _allWtsTasks.Where(t => t.CategoryCode == "BAVIA").ToList();
        _washingTasks = _allWtsTasks.Where(t => t.CategoryCode == "RUA").ToList();
        _inspectionTasks = _allWtsTasks.Where(t => t.CategoryCode == "KCS" || t.CategoryCode == "KT_NC").ToList();
        _packagingTasks = _allWtsTasks.Where(t => t.CategoryCode == "DONG_GOI").ToList();

        _part = await PmSvc.GetByPartNoAsync(PartNo);
        if (_part == null)
        {
            _loading = false;
            return;
        }

        await LoadAllAsync();
        _loading = false;
    }

    private async Task LoadAllAsync()
    {
        _partName = _part!.PartName;
        _originalPartName = _partName;

        _attrGroups = await PmSvc.GetAttributesGroupedAsync(_part.PartId);
        _material = _attrGroups.GetValueOrDefault("Material")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _materialConfig = _attrGroups.GetValueOrDefault("MaterialConfig")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _materialNote = _attrGroups.GetValueOrDefault("MaterialNote")?.FirstOrDefault(a => a.IsDefault)?.Value;
        _originalMaterial = _material;
        _originalConfig = _materialConfig;
        _originalNote = _materialNote;

        await ReloadStepsAsync();
    }

    private async Task ReloadStepsAsync()
    {
        var pid = _part!.PartId;
        List<PartMachiningStep> mSteps;
        List<PartTaroStep> tSteps;
        List<PartBaviaStep> bSteps;
        List<PartWashingStep> wSteps;
        List<PartInspectionStep> iSteps;
        List<PartPackagingStep> pSteps;

        if (_showDeleted)
        {
            mSteps = await MachiningSvc.GetAllByPartAsync(pid);
            tSteps = await TaroSvc.GetAllByPartAsync(pid);
            bSteps = await BaviaSvc.GetAllByPartAsync(pid);
            wSteps = await WashingSvc.GetAllByPartAsync(pid);
            iSteps = await InspectionSvc.GetAllByPartAsync(pid);
            pSteps = await PackagingSvc.GetAllByPartAsync(pid);
        }
        else
        {
            mSteps = await MachiningSvc.GetActiveByPartAsync(pid);
            tSteps = await TaroSvc.GetActiveByPartAsync(pid);
            bSteps = await BaviaSvc.GetActiveByPartAsync(pid);
            wSteps = await WashingSvc.GetActiveByPartAsync(pid);
            iSteps = await InspectionSvc.GetActiveByPartAsync(pid);
            pSteps = await PackagingSvc.GetActiveByPartAsync(pid);
        }

        _machiningEdits = mSteps.Select(MachiningEdit.FromEntity).ToList();
        _taroEdits = tSteps.Select(TaroEdit.FromEntity).ToList();
        _baviaEdits = bSteps.Select(BaviaEdit.FromEntity).ToList();
        _washingEdits = wSteps.Select(WashingEdit.FromEntity).ToList();
        _inspectionEdits = iSteps.Select(InspectionEdit.FromEntity).ToList();
        _packagingEdits = pSteps.Select(PackagingEdit.FromEntity).ToList();
    }

    private async Task ReloadDeletedAsync()
    {
        await ReloadStepsAsync();
    }

    private void AddMachiningRow()
    {
        _machiningEdits.Add(new MachiningEdit { State = EditState.New, IsBackup = false });
    }

    private void AddBackupRow<T>(List<T> list, T parent, Func<string, string, T> factory) where T : StepEditBase
    {
        var baseNC = !string.IsNullOrWhiteSpace(parent.ParentNC) ? parent.ParentNC : (parent.NC?.Split("-DP-")[0].Trim() ?? "NC");
        if (string.IsNullOrWhiteSpace(baseNC) || baseNC == "NC") return;

        var count = list.Count(e => (e.ParentNC == baseNC || (e.NC != null && e.NC.StartsWith($"{baseNC}-DP-"))) && e.NC != baseNC);
        var newBackup = factory($"{baseNC}-DP-{count + 1:D2}", baseNC);
        
        var idx = list.IndexOf(parent);
        if (idx >= 0)
        {
            while (idx + 1 < list.Count && list[idx + 1].NC != null && list[idx + 1].NC.StartsWith($"{baseNC}-DP-"))
            {
                idx++;
            }
            list.Insert(idx + 1, newBackup);
        }
        else
        {
            list.Add(newBackup);
        }
    }

    private void OnSelectWtsTask(SimpleStepEditBase edit, string? taskCode, List<StandardWtsTask> list)
    {
        var task = list.FirstOrDefault(t => t.TaskCode == taskCode);
        if (task != null)
        {
            edit.NC = task.TaskCode;
            edit.StepName = task.TaskName;
            if (task.StandardTimeSec.HasValue && task.StandardTimeSec > 0 && edit.StandardTime == null)
            {
                edit.StandardTime = Math.Round((decimal)task.StandardTimeSec.Value / 60m, 2);
            }
        }
        else
        {
            edit.NC = ""; 
            edit.StepName = "";
        }
    }

    private void ToggleDelete<T>(T edit, List<T> list) where T : StepEditBase
    {
        if (edit.State == EditState.New)
        {
            list.Remove(edit);
        }
        else if (edit.State == EditState.Deleted)
        {
            edit.State = edit.WasActiveInDb ? EditState.Unchanged : EditState.Restored;
        }
        else
        {
            edit.State = EditState.Deleted;
        }
    }

    private string RowCssClass(StepEditBase e)
    {
        return e.State switch
        {
            EditState.New => "table-success",
            EditState.Deleted => "table-secondary text-muted text-decoration-line-through",
            EditState.Restored => "table-info",
            _ => ""
        };
    }

    private bool RowLocked(StepEditBase e)
    {
        return e.State == EditState.Deleted;
    }

    private RenderFragment StateBadge(StepEditBase e) => builder =>
    {
        var (text, css) = e.State switch
        {
            EditState.New => ("MỚI", "success"),
            EditState.Deleted => ("ĐÃ XÓA", "secondary"),
            EditState.Restored => ("KHÔI PHỤC", "info"),
            _ => ((string?)null, (string?)null)
        };

        if (text != null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"badge bg-{css} ms-1");
            builder.AddContent(2, text);
            builder.CloseElement();
        }
    };

    private RenderFragment RowActionButton(StepEditBase e, Action onClick) => builder =>
    {
        var isDel = e.State == EditState.Deleted;
        var btnClass = isDel ? "btn-outline-success" : "btn-outline-danger";
        var iconClass = isDel ? "bi-arrow-counterclockwise" : "bi-trash";
        var title = isDel ? "Khôi phục" : "Xóa";

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", $"btn btn-sm {btnClass} p-0 px-1");
        builder.AddAttribute(2, "title", title);
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, onClick));
        builder.OpenElement(4, "i");
        builder.AddAttribute(5, "class", $"bi {iconClass}");
        builder.CloseElement();
        builder.CloseElement();
    };

    private async Task TrySaveAsync()
    {
        _saveResult = string.Empty;
        _saveHasError = false;

        if (string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 3)
        {
            _saveResult = "Lý do thay đổi là bắt buộc, tối thiểu 3 ký tự.";
            _saveHasError = true;
            return;
        }

        _pendingDefaultChanges = CollectDefaultChanges();
        if (_pendingDefaultChanges.Count > 0)
        {
            _showPinModal = true;
        }
        else
        {
            await DoSaveAsync(applyDefaultChanges: false);
        }
    }

    private async Task OnPinConfirmed()
    {
        _showPinModal = false;
        await DoSaveAsync(applyDefaultChanges: true);
    }

    private void OnPinCancelled()
    {
        _showPinModal = false;
    }

    private List<PinConfirmModal.DefaultChangeInfo> CollectDefaultChanges()
    {
        var list = new List<PinConfirmModal.DefaultChangeInfo>();
        if (!_canEditA) return list;

        if (_setDefaultMaterial && _material != _originalMaterial)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "Material", OldValue = _originalMaterial, NewValue = _material! });
        }
        if (_setDefaultConfig && _materialConfig != _originalConfig)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "MaterialConfig", OldValue = _originalConfig, NewValue = _materialConfig! });
        }
        if (_setDefaultNote && _materialNote != _originalNote)
        {
            list.Add(new PinConfirmModal.DefaultChangeInfo { PartNo = _part!.PartNo, AttributeType = "MaterialNote", OldValue = _originalNote, NewValue = _materialNote! });
        }
        return list;
    }

    private async Task DoSaveAsync(bool applyDefaultChanges)
    {
        _saving = true;
        var log = new List<string>();
        var errors = new List<string>();
        var reason = _reason.Trim();

        try
        {
            if (_canEditA)
            {
                if (_partName != _originalPartName)
                {
                    try
                    {
                        await PmSvc.UpdatePartNameAsync(_part!.PartId, _partName, _currentUserId);
                        log.Add("✓ Cập nhật Tên chi tiết");
                    }
                    catch (Exception ex)
                    {
                        errors.Add("✗ Tên chi tiết: " + ex.Message);
                    }
                }

                await TryAddAttrValue("Material", _material, _currentUserId, log, errors);
                await TryAddAttrValue("MaterialConfig", _materialConfig, _currentUserId, log, errors);
                await TryAddAttrValue("MaterialNote", _materialNote, _currentUserId, log, errors);

                if (applyDefaultChanges)
                {
                    foreach (var chg in _pendingDefaultChanges)
                    {
                        try
                        {
                            await PmSvc.SetAsDefaultAsync(_part!.PartId, chg.AttributeType, chg.NewValue, _currentUserId);
                            log.Add($"✓ Đặt default {chg.AttributeType} = {chg.NewValue}");
                        }
                        catch (Exception ex)
                        {
                            errors.Add($"✗ Đặt default {chg.AttributeType}: {ex.Message}");
                        }
                    }
                }
            }

            if (_canEditB)
            {
                await SaveStepListAsync(_machiningEdits,
                    e => MachiningSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => MachiningSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => MachiningSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => MachiningSvc.RestoreAsync(id, _currentUserId, reason),
                    "Machining", log, errors);
            }

            if (_canEditC)
            {
                await SaveStepListAsync(_taroEdits,
                    e => TaroSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => TaroSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => TaroSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => TaroSvc.RestoreAsync(id, _currentUserId, reason),
                    "Taro", log, errors);

                await SaveStepListAsync(_baviaEdits,
                    e => BaviaSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => BaviaSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => BaviaSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => BaviaSvc.RestoreAsync(id, _currentUserId, reason),
                    "Bavia", log, errors);

                await SaveStepListAsync(_washingEdits,
                    e => WashingSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => WashingSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => WashingSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => WashingSvc.RestoreAsync(id, _currentUserId, reason),
                    "Rửa", log, errors);
            }

            if (_canEditD)
            {
                await SaveStepListAsync(_inspectionEdits,
                    e => InspectionSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => InspectionSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => InspectionSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => InspectionSvc.RestoreAsync(id, _currentUserId, reason),
                    "Kiểm tra", log, errors);
            }

            if (_canEditE)
            {
                await SaveStepListAsync(_packagingEdits,
                    e => PackagingSvc.AddAsync(_part!.PartId, e.ToEntity(), _currentUserId, reason),
                    (id, e) => PackagingSvc.UpdateAsync(id, e.ToEntity(), _currentUserId, reason),
                    id => PackagingSvc.SoftDeleteAsync(id, _currentUserId, reason),
                    id => PackagingSvc.RestoreAsync(id, _currentUserId, reason),
                    "Đóng gói", log, errors);
            }
        }
        finally
        {
            _saving = false;
        }

        _saveHasError = errors.Count > 0;
        var msg = new List<string>();
        if (log.Count > 0) msg.Add("Thành công:\n" + string.Join("\n", log));
        if (errors.Count > 0) msg.Add("Lỗi:\n" + string.Join("\n", errors));
        if (msg.Count == 0) msg.Add("Không có thay đổi nào để lưu.");
        
        _saveResult = string.Join("\n\n", msg);

        if (log.Count > 0)
        {
            _reason = string.Empty;
            _setDefaultMaterial = false;
            _setDefaultConfig = false;
            _setDefaultNote = false;
            await LoadAllAsync();
        }
    }

    private async Task TryAddAttrValue(string type, string? value, int uid, List<string> log, List<string> errors)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        var attrs = _attrGroups.GetValueOrDefault(type);
        if (attrs != null && attrs.Any(a => a.Value == value && a.IsActive)) return;

        try
        {
            await PmSvc.AddValueAsync(_part!.PartId, type, value, uid);
            log.Add($"✓ Thêm giá trị {type}: {value}");
        }
        catch (Exception ex)
        {
            errors.Add($"✗ Thêm {type}: {ex.Message}");
        }
    }

    private async Task SaveStepListAsync<T>(List<T> edits, Func<T, Task<long>> addFn, Func<long, T, Task> updateFn, Func<long, Task> deleteFn, Func<long, Task> restoreFn, string label, List<string> log, List<string> errors) where T : StepEditBase
    {
        foreach (var e in edits.ToList())
        {
            try
            {
                if (e.State == EditState.New)
                {
                    if (string.IsNullOrWhiteSpace(e.NC)) continue;
                    var id = await addFn(e);
                    log.Add($"✓ [{label}] Thêm NC={e.NC}");
                }
                else if (e.State == EditState.Deleted && e.StepId > 0 && e.WasActiveInDb)
                {
                    await deleteFn(e.StepId);
                    log.Add($"✓ [{label}] Xóa NC={e.NC}");
                }
                else if (e.State == EditState.Restored && e.StepId > 0)
                {
                    await restoreFn(e.StepId);
                    log.Add($"✓ [{label}] Khôi phục NC={e.NC}");
                }
                else if (e.StepId > 0 && e.State != EditState.Deleted && e.HasChanges)
                {
                    await updateFn(e.StepId, e);
                    log.Add($"✓ [{label}] Sửa NC={e.NC}");
                }
            }
            catch (Exception ex)
            {
                errors.Add($"✗ [{label}] NC={e.NC}: {ex.Message}");
            }
        }
    }

    public enum EditState { Unchanged, Modified, New, Deleted, Restored }

    public abstract class StepEditBase
    {
        public long StepId { get; set; }
        public string NC { get; set; } = "";
        public bool IsBackup { get; set; }
        public string? ParentNC { get; set; }
        public EditState State { get; set; } = EditState.Unchanged;
        public bool WasActiveInDb { get; set; }
        public virtual bool HasChanges => true;
    }

    public abstract class SimpleStepEditBase : StepEditBase
    {
        public string? StepName { get; set; }
        public decimal? StandardTime { get; set; }
    }

