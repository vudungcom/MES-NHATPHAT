    private static string FmtTime(decimal? t) => t.HasValue ? t.Value.ToString("0.##") : "—";

    // ================================================================
    // ColFilterDef — model cho 1 cột
    // ================================================================
    private class ColFilterDef
    {
        public List<string> AllValues { get; set; } = new();
        public HashSet<string> SelectedValues { get; set; } = new();
        public string SearchText { get; set; } = string.Empty;

        public static ColFilterDef Build(List<PartMasterListRow> rows, Func<PartMasterListRow, string> selector)
        {
            var all = rows.Select(selector).Distinct().OrderBy(v => v).ToList();
            return new ColFilterDef
            {
                AllValues = all,
                SelectedValues = new HashSet<string>(all) // mặc định chọn tất cả
            };
        }
    }
}
