@page "/part-master"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using MES.Web.Data.Entities
@using MES.Web.Services
@inject PartMasterListService ListSvc
@inject PartMasterService PmSvc
@inject UserService UserSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Part Master - MES</PageTitle>

@if (_isLoading)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span> Đang tải dữ liệu Part Master...</div>
}
else if (!_canView)
{
    <div class="alert alert-danger shadow-sm my-4">
        <h4><i class="bi bi-shield-lock-fill"></i> Truy cập bị từ chối</h4>
        <p>Tài khoản của bạn không có quyền xem danh mục <b>Part Master</b>. Vui lòng liên hệ Admin để được cấp quyền trên Ma trận phân quyền.</p>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">Part Master</h1>
            <p class="text-muted small mb-0">
                Mỗi dòng = 1 Part. Click <i class="bi bi-caret-right-fill"></i> để xem chi tiết,
                <strong>double-click</strong> hoặc bấm "Chi tiết" để mở trang sửa.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExportExcelAsync" disabled="@_exporting">
                <i class="bi bi-file-earmark-excel"></i>
                @(_exporting ? "Đang xuất..." : "Xuất Excel")
            </button>
            @if (_canCreate)
            {
                <a href="/part-master/create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Tạo Part mới
                </a>
            }
        </div>
    </div>

    <div class="row mb-2 g-2">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Tìm theo Part No / Tên chi tiết / Khách hàng..."
                       @bind="_search" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button class="btn btn-outline-secondary" @onclick="() => _search = string.Empty">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="_customerFilter">
                <option value="">-- Tất cả khách hàng --</option>
                @foreach (var c in CustomerOptions)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select class="form-select form-select-sm" @bind="_statusFilter" @bind:after="OnStatusFilterChanged">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="ok">✅ Hoàn thành (5/5 OK)</option>
                <option value="ng">❌ Chưa hoàn thành</option>
            </select>
        </div>
    </div>

    @* Bộ lọc bộ phận — chỉ hiện khi chọn "Chưa hoàn thành" *@
    @if (_statusFilter == "ng")
    {
        <div class="d-flex align-items-center gap-3 mb-2 px-2 py-2 bg-light rounded border">
            <small class="text-muted fw-bold text-nowrap">Lọc bộ phận chưa OK:</small>
            <div class="d-flex gap-3 flex-wrap">
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fKH" @bind="_filterKH" />
                    <label class="form-check-label small" for="fKH">KH</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fGC" @bind="_filterGC" />
                    <label class="form-check-label small" for="fGC">Gia công</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fHTSP" @bind="_filterHTSP" />
                    <label class="form-check-label small" for="fHTSP">HTSP</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fKCS" @bind="_filterKCS" />
                    <label class="form-check-label small" for="fKCS">KCS</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fPKG" @bind="_filterPKG" />
                    <label class="form-check-label small" for="fPKG">Đóng gói</label>
                </div>
            </div>
            <small class="text-muted ms-auto">
                (Không tick = hiện tất cả chưa hoàn thành. Tick = chỉ hiện Part chưa OK ở bộ phận đó)
            </small>
        </div>
    }

    <div class="text-end mb-2">
        <small class="text-muted">
            Hiển thị @Filtered.Count() / @(_rows?.Count ?? 0) Part
        </small>
    </div>

    @if (_rows == null)
    {
        <p><em>Đang tải...</em></p>
    }
    else if (_rows.Count == 0)
    {
        <div class="alert alert-secondary">
            <i class="bi bi-inbox"></i> Chưa có Part Master nào trong hệ thống.
            Khi Kế hoạch tạo phiếu KH với Part No mới, Part Master sẽ tự động được tạo.
            @if (_canCreate)
            {
                <span>Hoặc bấm <strong>"Tạo Part mới"</strong> ở góc trên để tạo Part sạch.</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered align-middle small" style="font-size: 0.8rem;">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th style="width: 30px;"></th>
                        <th><strong>Part No</strong></th>
                        @* Cột Tên chi tiết tạm ẩn - mở lại khi cần *@
                        @* <th>Tên chi tiết</th> *@
                        <th>Khách hàng</th>
                        <th>Mã VL</th>
                        <th>Cấu hình phôi</th>
                        <th>Ghi chú phôi</th>
                        <th class="text-center" style="width: 70px;">KH</th>
                        <th class="text-center" style="width: 80px;">Gia công</th>
                        <th class="text-center" style="width: 60px;">HTSP</th>
                        <th class="text-center" style="width: 60px;">KCS</th>
                        <th class="text-center" style="width: 75px;">Đóng gói</th>
                        <th style="width: 90px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Filtered)
                    {
                        <tr @ondblclick="() => OpenDetail(row.PartNo)"
                            style="cursor: pointer;"
                            title="Double-click để mở trang chi tiết">
                            <td class="text-center" @onclick:stopPropagation @ondblclick:stopPropagation>
                                <button class="btn btn-sm btn-link p-0" @onclick="async () => await ToggleExpandAsync(row.PartId)"
                                        title="@(IsExpanded(row.PartId) ? "Thu gọn" : "Xem chi tiết inline")">
                                    @if (IsExpanded(row.PartId))
                                    {
                                        <i class="bi bi-caret-down-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-caret-right-fill"></i>
                                    }
                                </button>
                            </td>
                            <td><code class="fw-bold">@row.PartNo</code></td>
                            @* Dữ liệu Tên chi tiết tạm ẩn - mở lại khi cần *@
                            @* <td>@(row.PartName ?? "—")</td> *@
                            <td>@(row.CustomerName ?? "—")</td>
                            <td>@(row.Material ?? "—")</td>
                            <td>@(row.MaterialConfig ?? "—")</td>
                            <td>@(row.MaterialNote ?? "—")</td>
                            <td class="text-center">@ConfirmBadge(row.IsPlanConfirmed)</td>
                            <td class="text-center">@ConfirmBadge(row.IsMachiningConfirmed)</td>
                            <td class="text-center">@ConfirmBadge(row.IsHtspConfirmed)</td>
                            <td class="text-center">@ConfirmBadge(row.IsKcsConfirmed)</td>
                            <td class="text-center">@ConfirmBadge(row.IsPkgConfirmed)</td>
                            <td @onclick:stopPropagation @ondblclick:stopPropagation>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenDetail(row.PartNo)"
                                        title="Mở trang chi tiết">
                                    <i class="bi bi-arrow-right-circle"></i> Chi tiết
                                </button>
                            </td>
                        </tr>

                        @if (IsExpanded(row.PartId))
                        {
                            <tr>
                                <td colspan="12" class="bg-light p-3">
                                    @if (_detailByPart.TryGetValue(row.PartId, out var detail))
                                    {
                                        @RenderExpandedDetail(row, detail)
                                    }
                                    else
                                    {
                                        <em class="text-muted small">Đang tải chi tiết...</em>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private bool _canView = false;
    private bool _canCreate = false;
    private bool _exporting = false;

    private List<PartMasterListRow>? _rows;
    private HashSet<int> _expanded = new();
    private Dictionary<int, PartMasterExpandDetail> _detailByPart = new();
    private string _search = string.Empty;
    private string _customerFilter = string.Empty;

    // Bộ lọc trạng thái
    private string _statusFilter = string.Empty; // "" | "ok" | "ng"
    private bool _filterKH = false;
    private bool _filterGC = false;
    private bool _filterHTSP = false;
    private bool _filterKCS = false;
    private bool _filterPKG = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        var isAdmin = user.IsInRole("ADMIN") 
                   || user.FindFirst("GroupCode")?.Value == "ADMIN" 
                   || user.FindFirst(ClaimTypes.Role)?.Value == "ADMIN"
                   || user.Identity?.Name?.ToLower() == "admin";

        if (isAdmin)
        {
            _canView = true;
            _canCreate = true;
        }
        else if (int.TryParse(userIdStr, out var uid))
        {
            var perms = await UserSvc.GetAllUserPermissionsAsync(uid);
            
            _canView = perms.Values.Any(p => p.CanView);

            if (perms.TryGetValue("PART_TAO_MOI", out var pTaoMoi))
            {
                _canCreate = pTaoMoi.CanEdit;
            }
        }

        if (_canView)
        {
            _rows = await ListSvc.GetAllRowsAsync();
        }
        _isLoading = false;
    }

    private bool IsExpanded(int partId) => _expanded.Contains(partId);

    private async Task ToggleExpandAsync(int partId)
    {
        if (_expanded.Contains(partId))
        {
            _expanded.Remove(partId);
        }
        else
        {
            _expanded.Add(partId);
            if (!_detailByPart.ContainsKey(partId))
            {
                _detailByPart[partId] = await ListSvc.GetDetailForExpandAsync(partId);
            }
        }
    }

    private void OpenDetail(string partNo)
    {
        Nav.NavigateTo($"/part-master/detail?partNo={Uri.EscapeDataString(partNo)}");
    }

    // Badge OK/NG cho 5 cột xác nhận
    private RenderFragment ConfirmBadge(bool confirmed) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", confirmed
            ? "badge bg-success"
            : "badge bg-danger");
        builder.AddContent(2, confirmed ? "OK" : "NG");
        builder.CloseElement();
    };

    // Vẫn giữ RenderNcs để dùng trong phần expand detail bên dưới
    private RenderFragment RenderNcs(List<string> ncs) => builder =>
    {
        if (ncs.Count == 0)
        {
            builder.AddContent(0, "—");
            return;
        }
        var text = string.Join(" → ", ncs);
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "text-muted");
        builder.AddContent(3, text);
        builder.CloseElement();
    };

    private void OnStatusFilterChanged()
    {
        // Reset checkbox bộ phận khi đổi filter tổng
        _filterKH = _filterGC = _filterHTSP = _filterKCS = _filterPKG = false;
    }

    private async Task ExportExcelAsync()
    {
        _exporting = true;
        try
        {
            var data = Filtered.ToList();
            var label = BuildFilterLabel();
            var bytes = ExcelHelper.ExportPartMasterList(data, label);
            var fileName = $"PartMaster_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        finally
        {
            _exporting = false;
        }
    }

    private string BuildFilterLabel()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) parts.Add($"Tìm: \"{_search}\"");
        if (!string.IsNullOrEmpty(_customerFilter)) parts.Add("Lọc khách hàng");
        if (_statusFilter == "ok") parts.Add("Hoàn thành");
        if (_statusFilter == "ng")
        {
            var bps = new List<string>();
            if (_filterKH) bps.Add("KH");
            if (_filterGC) bps.Add("Gia công");
            if (_filterHTSP) bps.Add("HTSP");
            if (_filterKCS) bps.Add("KCS");
            if (_filterPKG) bps.Add("Đóng gói");
            parts.Add(bps.Count > 0 ? $"Chưa OK: {string.Join(", ", bps)}" : "Chưa hoàn thành");
        }
        return parts.Count > 0 ? string.Join(" | ", parts) : "Tất cả";
    }

    private IEnumerable<PartMasterListRow> Filtered
    {
        get
        {
            if (_rows == null) return Enumerable.Empty<PartMasterListRow>();
            IEnumerable<PartMasterListRow> q = _rows;

            // Tìm kiếm text
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(r =>
                    r.PartNo.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (r.PartName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.CustomerName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            // Lọc khách hàng
            if (!string.IsNullOrEmpty(_customerFilter) && int.TryParse(_customerFilter, out var cid))
            {
                q = q.Where(r => r.CustomerId == cid);
            }

            // Lọc trạng thái tổng
            if (_statusFilter == "ok")
            {
                q = q.Where(r => r.IsFullyConfirmed);
            }
            else if (_statusFilter == "ng")
            {
                q = q.Where(r => !r.IsFullyConfirmed);

                // Lọc thêm theo bộ phận cụ thể (OR logic — Part chưa OK ở ít nhất 1 bộ phận đã tick)
                bool anyChecked = _filterKH || _filterGC || _filterHTSP || _filterKCS || _filterPKG;
                if (anyChecked)
                {
                    q = q.Where(r =>
                        (_filterKH   && !r.IsPlanConfirmed) ||
                        (_filterGC   && !r.IsMachiningConfirmed) ||
                        (_filterHTSP && !r.IsHtspConfirmed) ||
                        (_filterKCS  && !r.IsKcsConfirmed) ||
                        (_filterPKG  && !r.IsPkgConfirmed)
                    );
                }
            }

            return q;
        }
    }

    private IEnumerable<(int Id, string Name)> CustomerOptions
    {
        get
        {
            if (_rows == null) return Enumerable.Empty<(int, string)>();
            return _rows
                .Where(r => r.CustomerId.HasValue && !string.IsNullOrEmpty(r.CustomerName))
                .Select(r => (r.CustomerId!.Value, r.CustomerName!))
                .Distinct()
                .OrderBy(x => x.Item2);
        }
    }

    private RenderFragment RenderExpandedDetail(PartMasterListRow row, PartMasterExpandDetail detail) => __builder =>
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="fw-bold text-primary mb-2">
                    <i class="bi bi-file-earmark-ruled"></i>
                    Chi tiết Part Master: <code>@row.PartNo</code>
                    @if (!string.IsNullOrEmpty(row.PartName))
                    {
                        <span class="text-muted"> — @row.PartName</span>
                    }
                    <a href="/part-master/detail?partNo=@Uri.EscapeDataString(row.PartNo)"
                       class="btn btn-sm btn-outline-primary ms-2">
                        <i class="bi bi-arrow-right-circle"></i> Mở trang chi tiết
                    </a>
                </div>
                @if (detail.TotalSteps == 0)
                {
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        Part này chưa có công đoạn nào. Vào trang chi tiết để thêm.
                    </div>
                }
            </div>

            @if (detail.Machining.Count > 0)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-header py-1 px-2 bg-primary text-white small fw-bold">
                            <i class="bi bi-gear-wide-connected"></i>
                            B. Quy trình gia công (@detail.Machining.Count công đoạn)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-bordered mb-0" style="font-size: 0.75rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 5%;">#</th>
                                        <th style="width: 7%;">NC</th>
                                        <th style="width: 15%;">Bản vẽ</th>
                                        <th style="width: 10%;">Máy đăng ký</th>
                                        <th style="width: 15%;">Máy đồng dạng</th>
                                        <th style="width: 8%;">Đồ gá</th>
                                        <th class="text-end" style="width: 7%;">T.Gá lắp</th>
                                        <th class="text-end" style="width: 7%;">T.Gia công</th>
                                        <th class="text-end" style="width: 7%;">T.Kiểm tra</th>
                                        <th class="text-end" style="width: 7%;">T.Chuẩn bị</th>
                                        <th class="text-end" style="width: 7%;">T.Chạy thử</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in detail.Machining)
                                    {
                                        <tr>
                                            <td>@s.StepOrder</td>
                                            <td><code>@s.NC</code></td>
                                            <td>@(s.Drawing ?? "—")</td>
                                            <td>@(s.MachineRegistered ?? "—")</td>
                                            <td>@(s.MachineAlternative ?? "—")</td>
                                            <td>@(s.FixtureType ?? "—")</td>
                                            <td class="text-end">@FmtTime(s.SetupTime)</td>
                                            <td class="text-end">@FmtTime(s.MachiningTime)</td>
                                            <td class="text-end">@FmtTime(s.InspectionTime)</td>
                                            <td class="text-end">@FmtTime(s.PreparationTime)</td>
                                            <td class="text-end">@FmtTime(s.TrialRunTime)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (detail.Taro.Count > 0)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1 px-2 bg-success text-white small fw-bold">
                            <i class="bi bi-nut"></i> C.1 Taro (@detail.Taro.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">NC</th>
                                        <th>Tên công đoạn</th>
                                        <th class="text-end" style="width: 20%;">Thời gian chuẩn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in detail.Taro)
                                    {
                                        <tr>
                                            <td><code>@s.NC</code></td>
                                            <td>@(s.StepName ?? "—")</td>
                                            <td class="text-end">@FmtTime(s.StandardTime)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (detail.Bavia.Count > 0)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1 px-2 bg-success text-white small fw-bold">
                            <i class="bi bi-scissors"></i> C.2 Bavia (@detail.Bavia.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">NC</th>
                                        <th>Tên công đoạn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in detail.Bavia)
                                    {
                                        <tr>
                                            <td><code>@s.NC</code></td>
                                            <td>@(s.StepName ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (detail.Washing.Count > 0)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1 px-2 bg-success text-white small fw-bold">
                            <i class="bi bi-droplet"></i> C.3 Rửa (@detail.Washing.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">NC</th>
                                        <th>Tên công đoạn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in detail.Washing)
                                    {
                                        <tr>
                                            <td><code>@s.NC</code></td>
                                            <td>@(s.StepName ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (detail.Inspection.Count > 0)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-1 px-2 bg-warning text-dark small fw-bold">
                            <i class="bi bi-search"></i> D. Kiểm tra (@detail.Inspection.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0" style="font-size: 0.75rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">NC</th>
                                        <th>Tên công đoạn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in detail.Inspection)
                                    {
                                        <tr>
                                            <td><code>@s.NC</code></td>
                                            <td>@(s.StepName ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    private static string FmtTime(decimal? t) => t.HasValue ? t.Value.ToString("0.##") : "—";
}