@page "/about"
@attribute [Authorize]
@rendermode InteractiveServer
@using MES.Web.Services
@inject IJSRuntime JS

<PageTitle>Thông tin bản quyền Máy chủ - MES</PageTitle>

<div class="container-fluid pt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header text-white d-flex align-items-center py-3" style="background-color: #1e293b;">
                    <i class="bi bi-info-circle fs-5 me-2"></i>
                    <h5 class="mb-0 fw-bold">Thông tin Bản quyền Máy chủ (Server License)</h5>
                </div>
                
                <div class="card-body p-4 bg-light">
                    <div class="mb-4 text-center">
                        <img src="/images/Logo.jpg" alt="Logo" style="height: 50px; border-radius: 4px;" class="mb-3 shadow-sm" />
                        <h4 class="fw-bold text-dark mb-0">Hệ thống Nhật Phát MES</h4>
                        <p class="text-muted small">Phiên bản Máy chủ (Server Build)</p>
                    </div>

                    <div class="list-group shadow-sm mb-4">
                        <div class="list-group-item py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-muted small fw-bold">MÃ MÁY CHỦ (HARDWARE ID)</div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyHardwareId">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                            <div class="fs-5 fw-bold text-primary font-monospace mt-1">@_hwid</div>
                        </div>
                        
                        <div class="list-group-item py-3">
                            <div class="text-muted small fw-bold mb-1">TRẠNG THÁI BẢN QUYỀN</div>
                            @if (_licenseInfo.Status == ServerLicenseHelper.LicenseStatus.Active)
                            {
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle"></i> ĐÃ KÍCH HOẠT</span>
                            }
                            else if (_licenseInfo.Status == ServerLicenseHelper.LicenseStatus.Error)
                            {
                                <span class="badge bg-danger fs-6"><i class="bi bi-x-circle"></i> LỖI KẾT NỐI / CẤU HÌNH</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6"><i class="bi bi-dash-circle"></i> CHƯA KÍCH HOẠT</span>
                            }

                            @if (_licenseInfo.IsTrial)
                            {
                                <div class="mt-2 text-warning fw-bold small">
                                    <i class="bi bi-exclamation-triangle"></i> @_licenseInfo.Message
                                </div>
                            }
                        </div>
                        
                        <div class="list-group-item py-3">
                            <div class="text-muted small fw-bold mb-1">CẤP PHÉP CHO</div>
                            <div class="fw-bold">@(string.IsNullOrEmpty(_licenseInfo.LicensedTo) ? "—" : _licenseInfo.LicensedTo)</div>
                        </div>
                        
                        <div class="list-group-item py-3">
                            <div class="text-muted small fw-bold mb-1">NGÀY HẾT HẠN</div>
                            <div class="fw-bold @(_licenseInfo.ExpirationDate.Contains("Lifetime") ? "text-success" : "text-dark")">
                                @(string.IsNullOrEmpty(_licenseInfo.ExpirationDate) ? "—" : _licenseInfo.ExpirationDate)
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_message))
                    {
                        <div class="alert alert-info py-2 small mb-4 shadow-sm border-0">
                            <i class="bi bi-info-circle-fill me-2"></i> @_message
                        </div>
                    }

                    <div class="d-grid mb-4">
                        <button class="btn btn-dark fw-bold py-2 shadow-sm" @onclick="CheckLicenseOnline" disabled="@_isChecking">
                            @if (_isChecking)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Đang kết nối Máy chủ cấp phép...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-arrow-down me-1"></i> <span>Cập nhật Bản quyền Online</span>
                            }
                        </button>
                    </div>
                    
                    <!-- THẺ THÔNG TIN TÁC GIẢ -->
                    <div class="p-3 bg-white border border-primary border-opacity-25 rounded-3 shadow-sm d-flex flex-column flex-sm-row align-items-center justify-content-between position-relative overflow-hidden">
                        <div class="position-absolute bg-primary opacity-10" style="top: 0; bottom: 0; left: 0; width: 4px;"></div>
                        <div class="d-flex align-items-center mb-3 mb-sm-0 ms-2">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px;">
                                <i class="bi bi-person-badge-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">NHÀ PHÁT TRIỂN HỆ THỐNG</div>
                                <h6 class="mb-0 fw-bold text-dark fs-5">Dư Ngọc</h6>
                            </div>
                        </div>
                        <div class="text-center text-sm-end">
                            <div class="mb-2">
                                <a href="tel:0963058858" class="text-decoration-none bg-light px-3 py-1 rounded-pill text-dark fw-bold border" style="font-size: 0.85rem; transition: all 0.2s;">
                                    <i class="bi bi-telephone-fill text-success me-1"></i> 0963.058.858
                                </a>
                            </div>
                            <div>
                                <a href="mailto:duvanngoc@gmail.com" class="text-decoration-none bg-light px-3 py-1 rounded-pill text-dark fw-bold border" style="font-size: 0.85rem; transition: all 0.2s;">
                                    <i class="bi bi-envelope-fill text-danger me-1"></i> duvanngoc@gmail.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    a.rounded-pill:hover {
        background-color: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        transform: translateY(-1px);
    }
</style>

@code {
    private bool _isChecking = false;
    private string _hwid = string.Empty;
    private string _message = string.Empty;
    private ServerLicenseHelper.LicenseInfo _licenseInfo = new();

    // Dùng OnInitialized đồng bộ để load file Cache Offline ngay lập tức
    protected override void OnInitialized()
    {
        _hwid = ServerLicenseHelper.GetHardwareId();
        _licenseInfo = ServerLicenseHelper.GetCachedLicenseState();
    }

    private async Task CheckLicenseOnline()
    {
        _isChecking = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            _licenseInfo = await ServerLicenseHelper.CheckLicenseAsync(true);
            _message = "Đã cập nhật bản quyền lúc " + DateTime.Now.ToString("HH:mm:ss");
        }
        catch (Exception ex)
        {
            _message = "Lỗi kết nối: " + ex.Message;
        }
        finally
        {
            _isChecking = false;
        }
    }

    private async Task CopyHardwareId()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _hwid);
            _message = "Đã copy Hardware ID vào Clipboard.";
        }
        catch
        {
            _message = "Trình duyệt không hỗ trợ copy tự động.";
        }
    }
}